---
import Navbar from "../../components/admin/Navbar.astro";
import Sidebar from "../../components/admin/Sidebar.astro";
import AdminDocument from "../../layouts/AdminDocument.astro";
---

<AdminDocument title="Tambah Artikel">

<style>
.wrapper{
    display:flex;
    height:100vh;
    overflow:hidden;
}

.content{
    flex:1;
    display:flex;
    flex-direction:column;
    height:100vh;
    overflow:hidden;
    background:#f4f7fc;
}

.isi{
    flex:1;
    overflow-y:auto;
    padding:32px 36px 48px;
}

.box{
    background:#ffffff;
    border-radius:20px;
    padding:32px;
    border:1px solid #eef1f6;
    box-shadow:0 1px 2px rgba(15,23,42,.03), 0 20px 40px -18px rgba(15,23,42,.10);
}

h2{
    margin-bottom:26px;
    font-size:19px;
    font-weight:800;
    letter-spacing:-0.01em;
    color:#0f172a;
}

.form-group{
    margin-bottom:20px;
}

label{
    display:block;
    margin-bottom:8px;
    font-weight:600;
    font-size:13.5px;
    color:#334155;
}

input,
select,
textarea{
    width:100%;
    padding:12px 14px;
    border:1.5px solid #e2e8f0;
    border-radius:12px;
    background:#f8fafc;
    font-size:14px;
    box-sizing:border-box;
    outline:none;
    transition:border-color .15s ease, box-shadow .15s ease, background .15s ease;
}

input:focus,
select:focus,
textarea:focus{
    border-color:#2563eb;
    background:#ffffff;
    box-shadow:0 0 0 4px rgba(37,99,235,.12);
}

input[type="file"] {
    padding:10px 14px;
    cursor:pointer;
}

textarea{
    height:180px;
    resize:vertical;
}

.button-group{
    display:flex;
    gap:12px;
    margin-top:30px;
}

.btn-simpan{
    background:linear-gradient(135deg,#2563eb,#1d4ed8);
    color:white;
    border:none;
    padding:12px 24px;
    border-radius:12px;
    cursor:pointer;
    font-size:14px;
    font-weight:700;
    box-shadow:0 8px 18px -8px rgba(37,99,235,.5);
    transition:transform .15s ease, box-shadow .15s ease;
}

.btn-simpan:hover{
    transform:translateY(-1px);
    box-shadow:0 12px 22px -8px rgba(37,99,235,.55);
}

.btn-batal{
    background:#f1f5f9;
    color:#334155;
    padding:12px 24px;
    border-radius:12px;
    text-decoration:none;
    font-size:14px;
    font-weight:700;
    transition:background .15s ease;
    display:inline-flex;
    align-items:center;
}

.btn-batal:hover{
    background:#e2e8f0;
}
</style>

<div class="wrapper">

    <Sidebar />

    <div class="content">

        <Navbar />

        <div class="isi">

            <div class="box">

                <h2>Tambah Artikel / Berita</h2>

           <form 
method="POST" 
action="/api/artikel"
enctype="multipart/form-data"
>

                    <div class="form-group">
                        <label>Judul Artikel</label>
                       <input
 type="text"
 name="title"
 placeholder="Masukkan judul artikel"
>
                    </div>

                    <div class="form-group">
                        <label>Kategori</label>

                       <select name="category">
    <option value="8">Berita Baru</option>
    <option value="2">Artikel Penanaman Modal</option>
    <option value="3">Artikel Perizinan</option>
</select>
                    </div>

                    <div class="form-group">
                        <label>Isi Artikel</label>

                       <textarea
 name="content"
 placeholder="Masukkan isi artikel..."
></textarea>
                    </div>

                    <div class="form-group">
                        <label>Upload Gambar</label>

                    <input type="file" name="picture">
                    </div>

                    <div class="form-group">
                        <label>Status Berita</label>

                       <select name="active">
    <option value="Y">Aktif</option>
    <option value="N">Nonaktif</option>
</select>
                    </div>

                    <div class="button-group">

                        <button
                            type="submit"
                            class="btn-simpan"
                        >
                            Simpan
                        </button>

                        <a
                            href="/admin/artikel"
                            class="btn-batal"
                        >
                            Batal
                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

</AdminDocument>
