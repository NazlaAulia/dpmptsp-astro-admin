---
// Logout. POST only.
export const prerender = false;

import { clearSession } from "../../lib/session";

if (Astro.request.method !== "POST") {
  return new Response("Method Not Allowed", {
    status: 405,
    headers: { allow: "POST" },
  });
}

clearSession(Astro.cookies);
return Astro.redirect("/admin/login", 303);
---
