---
// Logout. POST only.
export const prerender = false;

import { clearSession, readSession } from "../../lib/session";
import { revokeSession } from "../../lib/services/auth.service";

if (Astro.request.method !== "POST") {
  return new Response("Method Not Allowed", {
    status: 405,
    headers: { allow: "POST" },
  });
}

// Revoke in the API first: clearing only the cookie would leave the id
// usable by anyone who had copied it.
const current = readSession(Astro.cookies);
if (current?.sid) await revokeSession(current.sid);

clearSession(Astro.cookies);
return Astro.redirect("/admin/login", 303);
---
