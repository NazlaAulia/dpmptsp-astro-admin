---
// Delete an article. POST only, with a CSRF token.
//
// This route previously ran `DELETE FROM post WHERE id_post = ?` on a GET
// request reached from a plain link. Any crawler following links, any browser
// prefetching them, or any third-party <img src="/admin/hapus-artikel?id=1">
// deleted content. It also had no authentication of any kind.
export const prerender = false;

import { db } from "../../lib/db.js";
import { verifyCsrf } from "../../lib/session";

if (Astro.request.method !== "POST") {
  return new Response("Method Not Allowed", {
    status: 405,
    headers: { allow: "POST" },
  });
}

const formData = await Astro.request.formData();

if (!verifyCsrf(Astro.locals.session, formData.get("_csrf"))) {
  return new Response("Invalid CSRF token.", { status: 403 });
}

const id = formData.get("id");
if (typeof id !== "string" || !/^\d+$/.test(id)) {
  return new Response("Invalid id.", { status: 400 });
}

await db.query("DELETE FROM post WHERE id_post = ?", [id]);

// POST/redirect/GET so a refresh does not attempt the delete again.
return Astro.redirect("/admin/artikel", 303);
---
