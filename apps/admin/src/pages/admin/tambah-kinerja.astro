---

import AdminShell from "../../components/admin/AdminShell.astro";
import { createPerformanceDoc, hasFile, uploadFile } from "../../lib/services/content.service";

export const prerender = false;

let error = "";

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const judul = formData.get("judul")?.toString() ?? "";
  const file = formData.get("file");

  if (!hasFile(file)) {
    error = "Berkas wajib diunggah.";
  } else {
    // Stored through the API rather than written into public/pdf under the
    // client's own filename.
    const uploaded = await uploadFile(file, "kinerja", "public");
    if (!uploaded.ok) {
      error = uploaded.message;
    } else {
      const result = await createPerformanceDoc({ tw_option: judul, file_path: uploaded.key });
      if (result.ok) return Astro.redirect("/admin/kinerja", 303);
      error = result.message;
    }
  }
}
---

<AdminShell 
title="Tambah Kinerja Investasi"
subtitle="Tambahkan dokumen kinerja investasi baru."
>


<div class="form-box">


<h2>Form Tambah Kinerja</h2>


<form method="POST" enctype="multipart/form-data">


<div class="form-group">

<label>
Judul Kinerja
</label>

<input 
type="text"
name="judul"
placeholder="Masukkan judul kinerja"
/>

</div>



<div class="form-group">

<label>
Upload Dokumen PDF
</label>

<input 
type="file"
name="file"
accept=".pdf"
/>

</div>



<button type="submit">
Simpan Kinerja
</button>


</form>


</div>



</AdminShell>



