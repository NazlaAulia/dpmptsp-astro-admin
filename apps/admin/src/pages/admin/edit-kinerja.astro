---

import AdminShell from "../../components/admin/AdminShell.astro";
import {
  findPerformanceDoc,
  hasFile,
  updatePerformanceDoc,
  uploadFile,
} from "../../lib/services/content.service";

export const prerender = false;

const id = Number(Astro.url.searchParams.get("id"));
if (!Number.isInteger(id) || id <= 0) {
  return Astro.redirect("/admin/kinerja");
}

const found = await findPerformanceDoc(id);
if (!found.ok) {
  return Astro.redirect("/admin/kinerja");
}
const data = found.data;

let error = "";

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const judul = formData.get("judul")?.toString() ?? "";
  const file = formData.get("file");

  // Keep the existing file when no replacement was supplied.
  let filePath = data.file_path;

  if (hasFile(file)) {
    const uploaded = await uploadFile(file, "kinerja", "public");
    if (!uploaded.ok) error = uploaded.message;
    else filePath = uploaded.key;
  }

  if (!error) {
    const result = await updatePerformanceDoc(id, { tw_option: judul, file_path: filePath });
    if (result.ok) return Astro.redirect("/admin/kinerja", 303);
    error = result.message;
  }
}
---

<AdminShell
  title="Edit Kinerja Investasi"
  subtitle="Perbarui data kinerja investasi."
  showHeader={false}
>


<div class="form-box">


<h2>Edit Kinerja</h2>


<form method="POST" enctype="multipart/form-data">


<div class="form-group">

<label>
Judul Kinerja
</label>

<input 
type="text"
name="judul"
value={data.tw_option}
/>

</div>


<div class="form-group">

<label>
Dokumen Saat Ini
</label>

<input 
type="text"
value={data.file_path}
readonly
/>

</div>


<div class="form-group">

<label>
Upload Dokumen Baru
</label>

<input 
type="file"
name="file"
accept=".pdf"
/>

</div>


<button type="submit">
Simpan Perubahan
</button>


</form>


</div>


</AdminShell>



<style>

.form-box{

background:white;

padding:30px;

border-radius:20px;

box-shadow:0 12px 30px rgba(15,23,42,.06);

}


.form-group{

display:flex;

flex-direction:column;

gap:8px;

margin-bottom:20px;

}


input{

padding:12px;

border-radius:10px;

border:1px solid #ddd;

}


button{

background:#2563eb;

color:white;

border:none;

padding:12px 20px;

border-radius:10px;

cursor:pointer;

}

</style>