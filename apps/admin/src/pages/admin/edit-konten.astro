---

import AdminShell from "../../components/admin/AdminShell.astro";
import { getKonten, hasFile, updateAboutContent, uploadFile } from "../../lib/services/content.service";

export const prerender = false;

const id = Number(Astro.url.searchParams.get("id"));
if (!Number.isInteger(id) || id <= 0) {
  return Astro.redirect("/admin/konten");
}

const kontenItem = await getKonten(id);
if (!kontenItem) {
  return Astro.redirect("/admin/konten");
}

let errorMessage = "";

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();

  // Keep the existing photo unless a new one was supplied.
  let foto = kontenItem.Foto_Konten;
  const file = formData.get("Foto_Konten");
  if (hasFile(file)) {
    const uploaded = await uploadFile(file, "konten", "public");
    if (!uploaded.ok) errorMessage = uploaded.message;
    else foto = uploaded.key;
  }

  if (!errorMessage) {
    const result = await updateAboutContent(id, {
      nama: formData.get("Nama_Konten")?.toString() ?? "",
      isi: formData.get("Isi_Konten")?.toString() ?? "",
      judul: formData.get("Judul_Konten")?.toString() ?? "",
      keterangan: formData.get("Keterangan")?.toString() ?? "",
      tags: formData.get("tags")?.toString() ?? "",
      foto,
    });
    if (result.ok) return Astro.redirect("/admin/konten", 303);
    errorMessage = result.message;
  }
}
---

<AdminShell
  title="Edit Konten"
  subtitle={`Mengubah data konten dengan ID: ${id}`}
>
  <div class="form-card">
    <div class="form-header-top">
      <div>
        <h2>Form Edit Konten</h2>
        <p>Silakan ubah informasi di bawah ini sesuai kebutuhan.</p>
      </div>
      <div class="form-actions-top">
        <a href="/admin/konten" class="btn-cancel">Kembali</a>
        <button type="submit" form="editForm" class="btn-submit">Simpan Perubahan</button>
      </div>
    </div>

    {errorMessage && <div class="alert error">{errorMessage}</div>}

    <form method="POST" enctype="multipart/form-data" class="styled-form" id="editForm">
      <div class="form-row">
        <div class="form-group">
          <label for="Nama_Konten">Nama Konten</label>
          <input 
            type="text" 
            id="Nama_Konten" 
            name="Nama_Konten" 
            value={kontenItem.Nama_Konten || ""} 
            required 
          />
        </div>

        <div class="form-group">
          <label for="Foto_Konten">Ganti Foto (Choose File)</label>
          <input 
            type="file" 
            id="Foto_Konten" 
            name="Foto_Konten" 
            accept="image/*"
          />
          {kontenItem.Foto_Konten && (
            <span class="file-info">File saat ini: {kontenItem.Foto_Konten}</span>
          )}
        </div>
      </div>

      <div class="form-group">
        <label for="Isi_Konten">Isi Konten</label>
        <textarea 
          id="Isi_Konten" 
          name="Isi_Konten" 
          rows="3"
        >{kontenItem.Isi_Konten || ""}</textarea>
      </div>

      <div class="form-group">
        <label for="Judul_Konten">Judul Konten</label>
        <input 
          type="text" 
          id="Judul_Konten" 
          name="Judul_Konten" 
          value={kontenItem.Judul_Konten || ""} 
        />
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="Keterangan">Keterangan</label>
          <input 
            type="text" 
            id="Keterangan" 
            name="Keterangan" 
            value={kontenItem.Keterangan || ""} 
          />
        </div>

        <div class="form-group">
          <label for="tags">Tags</label>
          <input 
            type="text" 
            id="tags" 
            name="tags" 
            value={kontenItem.tags || ""} 
          />
        </div>
      </div>
    </form>
  </div>
</AdminShell>

<style>
  .form-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 20px 24px;
    box-shadow: 0 4px 20px rgba(15, 23, 42, 0.03);
    width: 100%;
    box-sizing: border-box;
    margin-bottom: 40px;
  }

  .form-header-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
    border-bottom: 1px solid #e2e8f0;
    padding-bottom: 12px;
    gap: 12px;
  }

  .form-header-top h2 {
    margin: 0 0 2px;
    color: #0f172a;
    font-size: 17px;
    font-weight: 700;
  }

  .form-header-top p {
    margin: 0;
    color: #64748b;
    font-size: 12.5px;
  }

  .form-actions-top {
    display: flex;
    gap: 8px;
  }

  .styled-form {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .form-group label {
    font-size: 12.5px;
    font-weight: 600;
    color: #475569;
  }

  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 8px 12px;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    font-size: 13px;
    color: #1e293b;
    background: #f8fafc;
    outline: none;
    box-sizing: border-box;
    transition: all 0.15s ease;
  }

  .form-group input[type="file"] {
    padding: 5px 8px;
    background: #ffffff;
    cursor: pointer;
  }

  .file-info {
    font-size: 11px;
    color: #64748b;
    margin-top: 2px;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    border-color: #2563eb;
    background: #ffffff;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
  }

  .btn-cancel {
    padding: 7px 16px;
    background: #f1f5f9;
    color: #334155;
    border-radius: 8px;
    font-size: 12.5px;
    font-weight: 600;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    transition: background 0.15s ease;
  }

  .btn-cancel:hover {
    background: #e2e8f0;
  }

  .btn-submit {
    padding: 7px 18px;
    background: #2563eb;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    font-size: 12.5px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .btn-submit:hover {
    background: #1d4ed8;
  }

  .alert {
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 12.5px;
    margin-bottom: 12px;
  }

  .alert.error {
    background: #fee2e2;
    color: #991b1b;
  }

  @media (max-width: 768px) {
    .form-row {
      grid-template-columns: 1fr;
    }
    .form-header-top {
      flex-direction: column;
      align-items: flex-start;
    }
    .form-actions-top {
      width: 100%;
      justify-content: flex-end;
    }
  }
</style>