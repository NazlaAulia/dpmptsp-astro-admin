---
export const prerender = false;

import AdminShell from "../../components/admin/AdminShell.astro";
import { getSlider, updateSlider } from "../../lib/services/slider.service";
import { hasFile, uploadFile } from "../../lib/repositories/upload.repository";
import { uploadUrl } from "../../lib/media";
import { verifyCsrf } from "../../lib/session";

const id = Number(Astro.url.searchParams.get("id"));
if (!Number.isInteger(id) || id <= 0) {
  return Astro.redirect("/admin/carousel", 303);
}

let errorMsg = "";

if (Astro.request.method === "POST") {
  const data = await Astro.request.formData();

  if (!verifyCsrf(Astro.locals.session, data.get("_csrf"))) {
    return new Response("Invalid CSRF token.", { status: 403 });
  }

  // Keeps the current image when no replacement is chosen.
  let gambar = String(data.get("gambar_lama") ?? "");
  const file = data.get("gambar");
  if (hasFile(file)) {
    const uploaded = await uploadFile(file, "slider");
    if (!uploaded.ok) errorMsg = uploaded.message;
    else gambar = uploaded.key;
  }

  if (!errorMsg) {
    const res = await updateSlider(id, {
      gambar,
      judul: String(data.get("judul") ?? ""),
      deskripsi: String(data.get("deskripsi") ?? ""),
      urutan: Number(data.get("urutan")) || 0,
    });
    if (res.ok) return Astro.redirect("/admin/carousel", 303);
    errorMsg = res.message;
  }
}

const slide = await getSlider(id);
if (!slide) {
  return Astro.redirect("/admin/carousel", 303);
}

const csrf = Astro.locals.csrfToken ?? "";
---


<AdminShell
  title="Edit Slide"
  subtitle="Perbarui banner carousel beranda."
  actionLabel="Kembali ke Carousel"
  actionHref="/admin/carousel"
  actionIcon="<"
>
  <div class="panel">
    {errorMsg && <p class="error">{errorMsg}</p>}

    <div class="preview">
      <img src={uploadUrl(slide.gambar)} alt={slide.judul} />
      <span>Gambar saat ini</span>
    </div>

    <form method="POST" enctype="multipart/form-data" class="slide-form">
      <input type="hidden" name="_csrf" value={csrf} />
      <input type="hidden" name="gambar_lama" value={slide.gambar} />

      <div class="field">
        <label>Ganti Gambar (opsional)</label>
        <input type="file" name="gambar" accept="image/jpeg,image/png,image/webp" />
      </div>
      <div class="field">
        <label>Judul</label>
        <input type="text" name="judul" value={slide.judul} />
      </div>
      <div class="field">
        <label>Deskripsi</label>
        <textarea name="deskripsi" rows="3">{slide.deskripsi}</textarea>
      </div>
      <div class="field small">
        <label>Urutan</label>
        <input type="number" name="urutan" value={slide.urutan} />
      </div>
      <button type="submit" class="btn-primary">Simpan Perubahan</button>
    </form>
  </div>
</AdminShell>

<style>
.panel {
  background: white;
  padding: 20px;
  border-radius: 18px;
  box-shadow: 0 12px 30px rgba(15, 23, 42, 0.06);
  max-width: 560px;
}
.preview { margin-bottom: 18px; }
.preview img {
  width: 100%;
  max-width: 320px;
  border-radius: 10px;
  display: block;
  margin-bottom: 6px;
}
.preview span { font-size: 0.8rem; color: #94a3b8; }
.slide-form { display: grid; gap: 14px; }
.field label { display: block; font-size: 0.82rem; font-weight: 700; margin-bottom: 4px; color: #475569; }
.field input, .field textarea {
  width: 100%;
  padding: 9px 12px;
  border: 1px solid #e2e8f0;
  border-radius: 10px;
  font: inherit;
}
.field.small input { max-width: 120px; }
.btn-primary {
  justify-self: start;
  padding: 10px 18px;
  border: 0;
  border-radius: 10px;
  background: #1d4ed8;
  color: white;
  font-weight: 700;
  cursor: pointer;
}
.error {
  background: #fee2e2;
  color: #b91c1c;
  padding: 10px 14px;
  border-radius: 10px;
  margin-bottom: 14px;
  font-size: 0.85rem;
}
</style>