---

export const prerender = false;

import Navbar from "../../components/admin/Navbar.astro";
import Sidebar from "../../components/admin/Sidebar.astro";
import AdminDocument from "../../layouts/AdminDocument.astro";
import { getArtikelLegacy, updateArticle } from "../../lib/services/article.service";
import { verifyCsrf } from "../../lib/session";

const id = Number(Astro.url.searchParams.get("id"));
if (!Number.isInteger(id) || id <= 0) {
  return Astro.redirect("/admin/artikel");
}

const artikel = await getArtikelLegacy(id);
if (!artikel) {
  return Astro.redirect("/admin/artikel");
}

let error = "";

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();

  if (!verifyCsrf(Astro.locals.session, formData.get("_csrf"))) {
    return new Response("Invalid CSRF token.", { status: 403 });
  }

  const result = await updateArticle(id, {
    title: formData.get("title")?.toString() ?? "",
    category_id: Number(formData.get("category")),
    content: formData.get("content")?.toString() ?? "",
    is_active: (formData.get("active")?.toString() ?? "Y") === "Y",
    picture: artikel.picture,
  });

  if (result.ok) {
    return Astro.redirect("/admin/artikel", 303);
  }
  error = result.message;
}
---

<AdminDocument title="Edit Artikel">


<style>
.wrapper{
    display:flex;
}


.content{
    flex:1;
    background:#f5f7fb;
    min-height:100vh;
}


.isi{
    padding:30px;
}


.box{
    background:white;
    border-radius:12px;
    padding:30px;
    box-shadow:0 2px 8px rgba(0,0,0,.08);
}


h2{
    margin-bottom:25px;
    color:#1e293b;
}


.form-group{
    margin-bottom:20px;
}


label{
    display:block;
    margin-bottom:8px;
    font-weight:600;
    color:#334155;
}


input,
select,
textarea{
    width:100%;
    padding:12px;
    border:1px solid #cbd5e1;
    border-radius:8px;
    font-size:14px;
    box-sizing:border-box;
    outline:none;
}


input:focus,
select:focus,
textarea:focus{
    border-color:#2563eb;
}


textarea{
    height:180px;
    resize:vertical;
}


.button-group{
    display:flex;
    gap:10px;
    margin-top:30px;
}


.btn-simpan{
    background:#2563eb;
    color:white;
    border:none;
    padding:12px 22px;
    border-radius:8px;
    cursor:pointer;
    font-size:14px;
    font-weight:600;
}


.btn-simpan:hover{
    background:#1d4ed8;
}


.btn-batal{
    background:#e2e8f0;
    color:#334155;
    padding:12px 22px;
    border-radius:8px;
    text-decoration:none;
    font-size:14px;
    font-weight:600;
}


.btn-batal:hover{
    background:#cbd5e1;
}
</style>


<div class="wrapper">

    <Sidebar />

    <div class="content">

        <Navbar />

        <div class="isi">

            <div class="box">

                <h2>Edit Artikel / Berita</h2>


                <form method="POST">

                    <div class="form-group">

                        <label>Judul Artikel</label>

                        <input
                            type="text"
                            name="title"
                            value={artikel.title}
                            placeholder="Masukkan judul artikel"
                            required
                        >

                    </div>


                    <div class="form-group">

                        <label>Kategori</label>

                        <select name="category">

                            <option
                                value="8"
                                selected={String(artikel.id_category) === "8"}
                            >
                                Berita Baru
                            </option>

                            <option
                                value="2"
                                selected={String(artikel.id_category) === "2"}
                            >
                                Artikel Penanaman Modal
                            </option>

                            <option
                                value="3"
                                selected={String(artikel.id_category) === "3"}
                            >
                                Artikel Perizinan
                            </option>

                        </select>

                    </div>


                    <div class="form-group">

                        <label>Isi Artikel</label>

                        <textarea
                            name="content"
                            placeholder="Masukkan isi artikel..."
                            required
                        >{artikel.content}</textarea>

                    </div>


                    <div class="form-group">

                        <label>Status Berita</label>

                        <select name="active">

                            <option
                                value="Y"
                                selected={artikel.active === "Y"}
                            >
                                Aktif
                            </option>

                            <option
                                value="N"
                                selected={artikel.active === "N"}
                            >
                                Nonaktif
                            </option>

                        </select>

                    </div>


                    <div class="button-group">

                        <button
                            type="submit"
                            class="btn-simpan"
                        >
                            Simpan Perubahan
                        </button>


                        <a
                            href="/admin/artikel"
                            class="btn-batal"
                        >
                            Batal
                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

</AdminDocument>
