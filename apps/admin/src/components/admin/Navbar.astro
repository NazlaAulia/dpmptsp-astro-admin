---
const now = new Date();
const formattedDate = now.toLocaleDateString("id-ID", {
    day: "numeric",
    month: "long",
    year: "numeric",
});
---

<div class="navbar">
    <div>
        <p class="welcome">Selamat datang</p>
        <h3>Admin DPMPTSP</h3>
    </div>

    <div class="nav-right">
        <div class="nav-date">
            <svg class="nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
            <span>{formattedDate}</span>
        </div>

        <button class="theme-toggle" id="admin-theme-toggle" type="button" aria-label="Ganti tema" title="Ganti tema">
            <svg class="theme-icon theme-icon-light" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m12.728 0l-.707-.707M6.343 6.343l-.707-.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
            </svg>
            <svg class="theme-icon theme-icon-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
            </svg>
        </button>

        <div class="notification-wrapper">
            <button class="notification-btn" title="Pemberitahuan">
                <svg class="nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
                </svg>
                <span class="notification-badge"></span>
            </button>
        </div>
    </div>
</div>

<style>
.navbar {
    height: 74px;
    background: #ffffff;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 26px;
    border-bottom: 1px solid rgba(2,6,23,0.04);
    backdrop-filter: blur(8px);
}

.navbar h3 {
    font-size: 1rem;
    color: #0f172a;
    margin: 0;
    font-weight: 800;
}

.welcome {
    margin: 0 0 2px;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #64748b;
}

.nav-right {
    display: flex;
    align-items: center;
    gap: 16px;
}

.theme-toggle {
    width: 42px;
    height: 42px;
    border: 1px solid rgba(2,6,23,0.08);
    border-radius: 999px;
    background: #f8fafc;
    color: #475569;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background .2s ease, color .2s ease, transform .2s ease;
}

.theme-toggle:hover {
    background: #e2e8f0;
    transform: translateY(-1px);
}

.theme-icon {
    width: 18px;
    height: 18px;
}

.theme-icon-dark { display: none; }

.nav-date {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: #334155;
    background: #ffffff;
    padding: 8px 12px;
    border-radius: 999px;
    border: 1px solid rgba(2,6,23,0.06);
    font-weight: 600;
}

.notification-wrapper {
    position: relative;
}

.notification-btn {
    width: 42px;
    height: 42px;
    background: transparent;
    border: 1px solid rgba(2,6,23,0.06);
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #1d4ed8;
    transition: all 0.16s ease;
}

.notification-btn:hover {
    background: rgba(37,99,235,0.06);
    transform: translateY(-2px);
}

.nav-icon {
    width: 18px;
    height: 18px;
}

.notification-badge {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 8px;
    height: 8px;
    background: #ef4444;
    border-radius: 50%;
    border: 2px solid white;
}

@media (max-width: 900px) {
    .navbar {
        padding: 0 18px;
        height: auto;
        padding-top: 14px;
        padding-bottom: 14px;
        gap: 10px;
        flex-wrap: wrap;
    }
}
</style>

<style is:global>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

    :root {
        --admin-bg: #f4f7fb;
        --admin-surface: #ffffff;
        --admin-surface-muted: #f8fafc;
        --admin-border: #e5eaf2;
        --admin-text: #172033;
        --admin-muted: #718096;
        --admin-accent: #315eea;
    }

    html[data-admin-theme],
    html[data-admin-theme] body,
    html[data-admin-theme] .admin-shell,
    html[data-admin-theme] .admin,
    html[data-admin-theme] .wrapper {
        font-family: 'Inter', sans-serif !important;
        letter-spacing: 0;
    }

    html[data-admin-theme] .brand-text,
    html[data-admin-theme] .navbar h3,
    html[data-admin-theme] .content h1,
    html[data-admin-theme] .page-header h1,
    html[data-admin-theme] .table-header h2,
    html[data-admin-theme] .card p,
    html[data-admin-theme] .info-card p {
        letter-spacing: -0.02em;
    }

    html[data-admin-theme] .menu a,
    html[data-admin-theme] .nav-date,
    html[data-admin-theme] .data-table,
    html[data-admin-theme] .table-box,
    html[data-admin-theme] .info-card,
    html[data-admin-theme] .list-card,
    html[data-admin-theme] .panel {
        font-family: 'Inter', sans-serif !important;
    }

    html[data-admin-theme="dark"] {
        --admin-bg: #0b1020;
        --admin-surface: #151b31;
        --admin-surface-muted: #10162a;
        --admin-border: #29324d;
        --admin-text: #f4f7ff;
        --admin-muted: #9aa6c1;
        --admin-accent: #6c8cff;
        color-scheme: dark;
    }

    html[data-admin-theme="dark"] .theme-icon-light { display: none; }
    html[data-admin-theme="dark"] .theme-icon-dark { display: block; }
    html[data-admin-theme="dark"] .admin-shell,
    html[data-admin-theme="dark"] .admin,
    html[data-admin-theme="dark"] .wrapper { background: var(--admin-bg) !important; }
    html[data-admin-theme="dark"] .main-panel,
    html[data-admin-theme="dark"] .main,
    html[data-admin-theme="dark"] .content { background: var(--admin-bg) !important; color: var(--admin-text); }
    html[data-admin-theme="dark"] .navbar { background: var(--admin-surface) !important; border-color: var(--admin-border) !important; }
    html[data-admin-theme="dark"] .navbar h3,
    html[data-admin-theme="dark"] .content h1,
    html[data-admin-theme="dark"] .page-header h1,
    html[data-admin-theme="dark"] .card p,
    html[data-admin-theme="dark"] .chart-header h3 { color: var(--admin-text) !important; }
    html[data-admin-theme="dark"] .welcome,
    html[data-admin-theme="dark"] .page-header .subtitle,
    html[data-admin-theme="dark"] .page-header .eyebrow,
    html[data-admin-theme="dark"] .card h3,
    html[data-admin-theme="dark"] .chart-header p,
    html[data-admin-theme="dark"] .chart-bar span { color: var(--admin-muted) !important; }
    html[data-admin-theme="dark"] .nav-date,
    html[data-admin-theme="dark"] .theme-toggle,
    html[data-admin-theme="dark"] .notification-btn { background: var(--admin-surface-muted) !important; border-color: var(--admin-border) !important; color: var(--admin-muted) !important; }
    html[data-admin-theme="dark"] .card,
    html[data-admin-theme="dark"] .chart-section,
    html[data-admin-theme="dark"] .box,
    html[data-admin-theme="dark"] .page-header,
    html[data-admin-theme="dark"] .info-card,
    html[data-admin-theme="dark"] .list-card .item,
    html[data-admin-theme="dark"] .panel,
    html[data-admin-theme="dark"] .table-box { background: var(--admin-surface) !important; border-color: var(--admin-border) !important; box-shadow: 0 12px 28px rgba(0,0,0,.18) !important; }
    html[data-admin-theme="dark"] .form-box,
    html[data-admin-theme="dark"] .form-container { background: var(--admin-surface) !important; border-color: var(--admin-border) !important; box-shadow: 0 12px 28px rgba(0,0,0,.18) !important; }
    html[data-admin-theme="dark"] .form-box h2,
    html[data-admin-theme="dark"] .form-container h1,
    html[data-admin-theme="dark"] form label,
    html[data-admin-theme="dark"] .form-group label { color: var(--admin-text) !important; }
    html[data-admin-theme="dark"] .form-info { color: var(--admin-muted) !important; }
    html[data-admin-theme="dark"] form input:not([type="submit"]),
    html[data-admin-theme="dark"] form select,
    html[data-admin-theme="dark"] form textarea,
    html[data-admin-theme="dark"] .file-upload,
    html[data-admin-theme="dark"] .file-label { background: var(--admin-surface-muted) !important; border-color: var(--admin-border) !important; color: #e6edfb !important; }
    html[data-admin-theme="dark"] form input::placeholder,
    html[data-admin-theme="dark"] form textarea::placeholder { color: #7f8cab !important; }
    html[data-admin-theme="dark"] form option { background: var(--admin-surface); color: var(--admin-text); }
    html[data-admin-theme="dark"] input[type="file"]::file-selector-button { background: #2a3552; color: #e6edfb; border: 1px solid var(--admin-border); }
    html[data-admin-theme="dark"] .btn-batal,
    html[data-admin-theme="dark"] .btn-kembali { background: #2a3552 !important; color: #e6edfb !important; }
    html[data-admin-theme="dark"] .info-card h3,
    html[data-admin-theme="dark"] .list-card .item h3,
    html[data-admin-theme="dark"] .panel h3,
    html[data-admin-theme="dark"] .table-header h2 { color: var(--admin-text) !important; }
    html[data-admin-theme="dark"] .info-card p,
    html[data-admin-theme="dark"] .list-card .item p,
    html[data-admin-theme="dark"] .panel p { color: var(--admin-muted) !important; }
    html[data-admin-theme="dark"] .chips span { background: #202d50 !important; color: #a9c1ff !important; }
    html[data-admin-theme="dark"] .table-box th,
    html[data-admin-theme="dark"] .table-box td { background: transparent !important; color: #dbe4f7 !important; border-color: var(--admin-border) !important; }
    html[data-admin-theme="dark"] .table-box th { color: var(--admin-muted) !important; }
    html[data-admin-theme="dark"] .table-header a { background: #315eea !important; color: #ffffff !important; }
    html[data-admin-theme="dark"] .pdf-preview { border-color: var(--admin-border) !important; background: var(--admin-surface-muted) !important; }
    html[data-admin-theme="dark"] .pagination-container { border-color: var(--admin-border) !important; }
    html[data-admin-theme="dark"] .pagination-info { color: var(--admin-muted) !important; }
    html[data-admin-theme="dark"] .pagination-buttons .page-btn { background: var(--admin-surface-muted) !important; color: #dbe4f7 !important; border-color: var(--admin-border) !important; }
    html[data-admin-theme="dark"] .pagination-buttons .page-btn.active { background: #315eea !important; color: #ffffff !important; border-color: #315eea !important; }
    html[data-admin-theme="dark"] .modal-content { background: var(--admin-surface) !important; }
    html[data-admin-theme="dark"] .modal-content h3 { color: var(--admin-text) !important; }
    html[data-admin-theme="dark"] .modal-content p { color: var(--admin-muted) !important; }
    html[data-admin-theme="dark"] .modal-content .cancel { background: #2a3552 !important; color: #e5ecfb !important; }
    html[data-admin-theme="dark"] .table-wrap { border-color: var(--admin-border) !important; }
    html[data-admin-theme="dark"] .table-scroll { border-color: var(--admin-border) !important; }
    html[data-admin-theme="dark"] th { background: var(--admin-surface-muted) !important; color: var(--admin-muted) !important; box-shadow: inset 0 -1px 0 var(--admin-border) !important; }
    html[data-admin-theme="dark"] td { color: #d7deef !important; border-color: var(--admin-border) !important; }
    html[data-admin-theme="dark"] .table-container { background: var(--admin-surface) !important; box-shadow: 0 12px 28px rgba(0,0,0,.18) !important; }
    html[data-admin-theme="dark"] .data-table th { background: var(--admin-surface-muted) !important; color: #dbe4f7 !important; border-color: var(--admin-border) !important; }
    html[data-admin-theme="dark"] .data-table td,
    html[data-admin-theme="dark"] .data-table td.fw-bold { color: #dbe4f7 !important; border-color: var(--admin-border) !important; }
    html[data-admin-theme="dark"] .data-table .map-link { color: #8fb0ff !important; }
    html[data-admin-theme="dark"] .pagination-footer { color: var(--admin-muted) !important; border-color: var(--admin-border) !important; }
    html[data-admin-theme="dark"] .page-btn { background: var(--admin-surface-muted) !important; color: #dbe4f7 !important; border-color: var(--admin-border) !important; }
    html[data-admin-theme="dark"] .page-btn:hover:not(.disabled):not(.active) { background: #253252 !important; }
    html[data-admin-theme="dark"] .page-btn.disabled { color: #697895 !important; background: #11182b !important; }
    html[data-admin-theme="dark"] .modal-card { background: var(--admin-surface) !important; }
    html[data-admin-theme="dark"] .modal-card h2 { color: var(--admin-text) !important; }
    html[data-admin-theme="dark"] .modal-card p { color: var(--admin-muted) !important; }
    html[data-admin-theme="dark"] .judul-cell { color: var(--admin-text) !important; }
    html[data-admin-theme="dark"] tbody tr:hover { background: #1d2640 !important; }
    html[data-admin-theme="dark"] .entries select,
    html[data-admin-theme="dark"] .search-box input { background: var(--admin-surface-muted) !important; border-color: var(--admin-border) !important; color: var(--admin-text) !important; }
    html[data-admin-theme="dark"] .sidebar { background: #121a2b !important; border-color: #26304a !important; box-shadow: 12px 0 30px rgba(0,0,0,.12) !important; }
    html[data-admin-theme="dark"] .brand-text { color: #f4f7ff !important; }
    html[data-admin-theme="dark"] .menu a { color: #aeb9d0 !important; }
    html[data-admin-theme="dark"] .menu a:hover { color: #f4f7ff !important; background: #1b2540 !important; box-shadow: none !important; }
    html[data-admin-theme="dark"] .menu a.active { color: #ffffff !important; background: #315eea !important; }
    html[data-admin-theme="dark"] .sidebar-footer { border-color: #26304a !important; }
    html[data-admin-theme="dark"] .logout { background: #1b2540 !important; border-color: #33405f !important; }
    html[data-admin-theme="dark"] .logout-modal__card { background: var(--admin-surface) !important; }
    html[data-admin-theme="dark"] .logout-modal__card h3 { color: var(--admin-text) !important; }
    html[data-admin-theme="dark"] .logout-modal__card p { color: var(--admin-muted) !important; }
</style>

<script is:inline>
        const themeToggle = document.getElementById('admin-theme-toggle');
        const storedTheme = localStorage.getItem('admin-theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const initialTheme = storedTheme || (prefersDark ? 'dark' : 'light');

        document.documentElement.dataset.adminTheme = initialTheme;

        themeToggle?.addEventListener('click', () => {
                const isDark = document.documentElement.dataset.adminTheme === 'dark';
                document.documentElement.dataset.adminTheme = isDark ? 'light' : 'dark';
                localStorage.setItem('admin-theme', isDark ? 'light' : 'dark');
        });
</script>