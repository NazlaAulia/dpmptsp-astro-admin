---
// Minimal document shell for the admin panel.
const { title = "Admin" } = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <title>{title} · Admin DPMPTSP</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Admin panel: never index. -->
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body>
    <slot />
  </body>
</html>
