---
// Minimal document shell for the admin panel.
//
// Admin pages previously rendered as bare fragments with no <html>, <head> or
// <body> at all, leaving the browser to invent a document. This supplies one.
//
// It deliberately does NOT import global.css: the admin panel styles itself
// with scoped <style> blocks and does not use Tailwind, so pulling in
// Tailwind's preflight here would restyle every admin screen.
const { title = "Admin" } = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <title>{title} · Admin DPMPTSP</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Admin panel: never index. -->
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body>
    <slot />
  </body>
</html>
