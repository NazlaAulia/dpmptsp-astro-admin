---
import MainLayout from "../layouts/MainLayout.astro";
import { getPPIDLists } from "../lib/services/content.service";

const { kategori, items } = await getPPIDLists();
---

<MainLayout
  title="PPID - DPMPTSP Kota Surabaya"
  description="Platform layanan keterbukaan informasi publik DPMPTSP Kota Surabaya."
>

  <main class="ppid-page">

    <!-- =====================================================
         HERO
    ====================================================== -->

    <section class="ppid-hero">

      <div class="container">

        <div class="hero-grid">

          <div class="hero-content">

            <div class="hero-badge">

              <span class="hero-badge-icon">
                <i class="fa-solid fa-circle-info"></i>
              </span>

              PPID DPMPTSP KOTA SURABAYA

            </div>


            <h1>
              Keterbukaan
              <span>Informasi Publik</span>
            </h1>


            <p>
              Platform layanan keterbukaan informasi publik
              DPMPTSP Kota Surabaya. Anda dapat mengunduh
              berbagai dokumen dan informasi secara mudah,
              cepat, dan transparan.
            </p>


            <div class="hero-actions">

              <a
                href="#informasi"
                class="hero-button primary"
              >
                <i class="fa-solid fa-folder-open"></i>
                Jelajahi Informasi
              </a>

              <a
                href="#kontak"
                class="hero-button secondary"
              >
                <i class="fa-solid fa-phone"></i>
                Hubungi PPID
              </a>

            </div>

          </div>


          <div class="hero-information">

            <div class="hero-information-icon">
              <i class="fa-solid fa-building-columns"></i>
            </div>

            <div>

              <span>
                Pejabat Pengelola
                Informasi dan Dokumentasi
              </span>

              <strong>
                PPID DPMPTSP
              </strong>

              <p>
                Menyediakan akses informasi publik
                yang mudah dan transparan.
              </p>

            </div>

          </div>

        </div>

      </div>

    </section>


    <!-- =====================================================
         KATEGORI DATABASE
    ====================================================== -->

    <section
      id="informasi"
      class="category-section"
    >

      <div class="container">

        <div class="section-heading">

          <div>

            <span class="section-eyebrow">
              INFORMASI PUBLIK
            </span>

            <h2>
              Akses informasi
              <span>secara mudah</span>
            </h2>

          </div>

          <p>
            Pilih kategori informasi yang ingin
            Anda lihat atau unduh.
          </p>

        </div>


        <div class="category-grid">

          {
            kategori.map((kat) => (

              <a
                href={`#kategori-${kat.slug}`}
                class="category-card"
              >

                <div class="category-icon">

                  <i
                    class={`fa-solid ${getIcon(kat.slug)}`}
                  ></i>

                </div>


                <div class="category-content">

                  <h3>
                    {kat.nama_kategori}
                  </h3>

                  <p>
                    {getDescription(kat.slug)}
                  </p>


                  <div class="category-bottom">

                    <span>
                      {getKategoriCount(kat.id)}
                      Dokumen
                    </span>

                    <i class="fa-solid fa-arrow-right"></i>

                  </div>

                </div>

              </a>

            ))
          }

        </div>

      </div>

    </section>


    <!-- =====================================================
         KONTEN DATABASE
    ====================================================== -->

    <section class="information-section">

      <div class="container">

        <div class="information-layout">

          <div class="information-main">

            <div class="section-heading left">

              <div>

                <span class="section-eyebrow">
                  DOKUMEN & INFORMASI
                </span>

                <h2>
                  Informasi yang
                  <span>tersedia</span>
                </h2>

              </div>

            </div>


            <!-- =============================================
                 SETIAP KATEGORI DARI DATABASE
            ============================================== -->

            {
              kategori.map((kat) => {

                const data = getItems(kat.id);

                return (

                  <section
                    id={`kategori-${kat.slug}`}
                    class="db-category"
                  >

                    <div class="db-category-header">

                      <div class="db-category-icon">

                        <i
                          class={`fa-solid ${getIcon(kat.slug)}`}
                        ></i>

                      </div>

                      <div>

                        <span>
                          {data.length} INFORMASI
                        </span>

                        <h3>
                          {kat.nama_kategori}
                        </h3>

                      </div>

                    </div>


                    {
                      data.length > 0 ? (

                        <div class="db-item-list">

                          {
                            data.map((item) => (

                              <article class="db-item">

                                <div class="db-item-icon">

                                  <i
                                    class="fa-solid fa-file-lines"
                                  ></i>

                                </div>


                                <div class="db-item-content">

                                  <h4>
                                    {item.judul}
                                  </h4>


                                  {
                                    item.isi && (

                                      <p>
                                        {item.isi}
                                      </p>

                                    )
                                  }


                                  <small>
                                    {kat.nama_kategori}
                                  </small>

                                </div>


                                {
                                  item.file_url ? (

                                    <a
                                      href={item.file_url}
                                      target="_blank"
                                      rel="noopener"
                                      class="download-button"
                                    >

                                      <span>
                                        Unduh
                                      </span>

                                      <i
                                        class="fa-solid fa-download"
                                      ></i>

                                    </a>

                                  ) : (

                                    <button
                                      type="button"
                                      class="detail-button"
                                      data-title={item.judul}
                                      data-content={item.isi || ""}
                                    >

                                      <span>
                                        Detail
                                      </span>

                                      <i
                                        class="fa-solid fa-arrow-right"
                                      ></i>

                                    </button>

                                  )
                                }

                              </article>

                            ))
                          }

                        </div>

                      ) : (

                        <div class="empty-data">

                          <i
                            class="fa-regular fa-folder-open"
                          ></i>

                          <p>
                            Belum ada informasi pada kategori ini.
                          </p>

                        </div>

                      )
                    }

                  </section>

                );

              })
            }

          </div>


          <!-- =================================================
               SIDEBAR
          ================================================== -->

          <aside
            id="kontak"
            class="ppid-sidebar"
          >

            <div class="contact-card">

              <div class="contact-card-header">

                <div class="contact-icon">
                  <i class="fa-solid fa-address-card"></i>
                </div>

                <div>

                  <span>
                    INFORMASI PPID
                  </span>

                  <h3>
                    Kontak & Alamat
                  </h3>

                </div>

              </div>


              <div class="contact-list">

                <div class="contact-item">

                  <div>
                    <i class="fa-solid fa-location-dot"></i>
                  </div>

                  <section>

                    <small>
                      Alamat
                    </small>

                    <p>
                      Jl. Tunjungan No. 1–3,
                      Genteng, Surabaya,
                      Jawa Timur 60275
                    </p>

                  </section>

                </div>


                <div class="contact-item">

                  <div>
                    <i class="fa-solid fa-phone"></i>
                  </div>

                  <section>

                    <small>
                      Telepon
                    </small>

                    <a href="tel:+623199243924">
                      +62 31 99243924
                    </a>

                  </section>

                </div>


                <div class="contact-item">

                  <div>
                    <i class="fa-solid fa-envelope"></i>
                  </div>

                  <section>

                    <small>
                      Email
                    </small>

                    <a href="mailto:dpm-ptsp@surabaya.go.id">
                      dpm-ptsp@surabaya.go.id
                    </a>

                  </section>

                </div>


                <div class="contact-item">

                  <div>
                    <i class="fa-solid fa-globe"></i>
                  </div>

                  <section>

                    <small>
                      Website
                    </small>

                    <a
                      href="https://dpm-ptsp.surabaya.go.id"
                      target="_blank"
                      rel="noopener"
                    >
                      dpm-ptsp.surabaya.go.id
                    </a>

                  </section>

                </div>

              </div>


              <div class="social-section">

                <span>
                  Sosial Media
                </span>


                <div class="social-list">

                  <a href="#" aria-label="Instagram">
                    <i class="fa-brands fa-instagram"></i>
                  </a>

                  <a href="#" aria-label="Facebook">
                    <i class="fa-brands fa-facebook-f"></i>
                  </a>

                  <a href="#" aria-label="Youtube">
                    <i class="fa-brands fa-youtube"></i>
                  </a>

                </div>


                <div class="social-names">

                  <p>
                    <strong>Instagram</strong>
                    @dpmptspsby
                  </p>

                  <p>
                    <strong>Facebook</strong>
                    DPMPTSP Surabaya
                  </p>

                  <p>
                    <strong>Youtube</strong>
                    @dpm-ptspsurabaya1991
                  </p>

                </div>

              </div>

            </div>


            <div class="request-card">

              <div class="request-icon">
                <i class="fa-solid fa-file-circle-question"></i>
              </div>

              <h3>
                Butuh Informasi?
              </h3>

              <p>
                Ajukan permohonan informasi publik
                melalui PPID DPMPTSP Kota Surabaya.
              </p>

              <a href="#">
                Ajukan Permohonan
                <i class="fa-solid fa-arrow-right"></i>
              </a>

            </div>

          </aside>

        </div>

      </div>

    </section>


    <!-- =====================================================
         FOOTER INFO
    ====================================================== -->

    <section class="bottom-section">

      <div class="container">

        <div class="bottom-card">

          <div class="bottom-icon">
            <i class="fa-solid fa-shield-halved"></i>
          </div>

          <div>

            <span>
              KOMITMEN KETERBUKAAN INFORMASI
            </span>

            <h2>
              Transparansi untuk pelayanan
              publik yang lebih baik.
            </h2>

            <p>
              DPMPTSP Kota Surabaya berkomitmen menyediakan
              informasi publik secara mudah, cepat, dan
              transparan sesuai dengan ketentuan yang berlaku.
            </p>

          </div>

        </div>

      </div>

    </section>

  </main>


  <!-- =====================================================
       MODAL DETAIL
  ====================================================== -->

  <div
    id="ppidModal"
    class="ppid-modal"
    aria-hidden="true"
  >

    <div
      class="modal-backdrop"
      data-close-modal
    ></div>


    <div class="modal-box">

      <button
        type="button"
        class="modal-close"
        data-close-modal
        aria-label="Tutup"
      >
        <i class="fa-solid fa-xmark"></i>
      </button>


      <div class="modal-icon">
        <i class="fa-solid fa-file-lines"></i>
      </div>


      <span class="modal-label">
        INFORMASI PUBLIK
      </span>


      <h3 id="modalTitle">
        Detail Informasi
      </h3>


      <div
        id="modalContent"
        class="modal-content"
      >
      </div>

    </div>

  </div>


  <!-- =====================================================
       SCRIPT
  ====================================================== -->

  <script>

    const modal =
      document.getElementById("ppidModal");

    const modalTitle =
      document.getElementById("modalTitle");

    const modalContent =
      document.getElementById("modalContent");


    const detailButtons =
      document.querySelectorAll(
        ".detail-button"
      );


    const closeModal = () => {

      modal?.classList.remove("show");

      modal?.setAttribute(
        "aria-hidden",
        "true"
      );

      document.body.classList.remove(
        "modal-open"
      );

    };


    detailButtons.forEach((button) => {

      button.addEventListener(
        "click",
        () => {

          const title =
            button.dataset.title || "";

          const content =
            button.dataset.content || "";


          modalTitle.textContent =
            title;


          modalContent.innerHTML =
            content
              ? content.replace(/\n/g, "<br>")
              : "<p>Informasi belum tersedia.</p>";


          modal.classList.add("show");

          modal.setAttribute(
            "aria-hidden",
            "false"
          );

          document.body.classList.add(
            "modal-open"
          );

        }
      );

    });


    document
      .querySelectorAll("[data-close-modal]")
      .forEach((element) => {

        element.addEventListener(
          "click",
          closeModal
        );

      });


    document.addEventListener(
      "keydown",
      (event) => {

        if (
          event.key === "Escape" &&
          modal?.classList.contains("show")
        ) {

          closeModal();

        }

      }
    );

  </script>


  <!-- =====================================================
       STYLE
  ====================================================== -->

  <style>

    :global(*) {
      box-sizing: border-box;
    }


    :global(html) {
      scroll-behavior: smooth;
    }


    :global(body) {
      margin: 0;

      font-family:
        Inter,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

      color: #334155;

      background: #fff;
    }


    :global(body.modal-open) {
      overflow: hidden;
    }


    :global(a) {
      text-decoration: none;
    }


    .container {
      width: min(
        1180px,
        calc(100% - 40px)
      );

      margin-inline: auto;
    }


    /* =====================================================
       HERO
    ====================================================== */

    .ppid-hero {
      position: relative;

      overflow: hidden;

      padding:
        78px 0 82px;

      background:
        linear-gradient(
          135deg,
          #eff6ff 0%,
          #ffffff 62%,
          #f8fafc 100%
        );
    }


    .ppid-hero::before {
      content: "";

      position: absolute;

      width: 520px;
      height: 520px;

      top: -310px;
      right: -110px;

      border-radius: 50%;

      background:
        rgba(37, 99, 235, .065);
    }


    .hero-grid {
      position: relative;

      z-index: 2;

      display: grid;

      grid-template-columns:
        minmax(0, 1fr)
        350px;

      align-items: center;

      gap: 70px;
    }


    .hero-badge {
      display: inline-flex;

      align-items: center;

      gap: 9px;

      margin-bottom: 18px;

      color: #2563eb;

      font-size: 10px;

      font-weight: 900;

      letter-spacing: .12em;
    }


    .hero-badge-icon {
      width: 27px;
      height: 27px;

      display: grid;

      place-items: center;

      border-radius: 8px;

      background: #dbeafe;

      font-size: 12px;
    }


    .hero-content h1 {
      max-width: 700px;

      margin: 0;

      color: #172554;

      font-size:
        clamp(40px, 6vw, 64px);

      line-height: 1.02;

      letter-spacing: -.045em;

      font-weight: 900;
    }


    .hero-content h1 span {
      display: block;

      color: #2563eb;
    }


    .hero-content > p {
      max-width: 680px;

      margin:
        23px 0 0;

      color: #64748b;

      font-size: 15px;

      line-height: 1.8;
    }


    .hero-actions {
      display: flex;

      flex-wrap: wrap;

      gap: 10px;

      margin-top: 27px;
    }


    .hero-button {
      min-height: 45px;

      display: inline-flex;

      align-items: center;

      justify-content: center;

      gap: 8px;

      padding:
        0 17px;

      border-radius: 10px;

      font-size: 11px;

      font-weight: 800;

      transition: .2s ease;
    }


    .hero-button.primary {
      background: #2563eb;

      color: #fff;
    }


    .hero-button.secondary {
      background: #fff;

      color: #2563eb;

      border:
        1px solid #dbeafe;
    }


    .hero-information {
      display: flex;

      align-items: flex-start;

      gap: 16px;

      padding: 24px;

      border:
        1px solid #dbeafe;

      border-radius: 18px;

      background:
        rgba(255,255,255,.82);

      box-shadow:
        0 18px 50px
        rgba(15,23,42,.06);
    }


    .hero-information-icon {
      width: 48px;
      height: 48px;

      flex-shrink: 0;

      display: grid;

      place-items: center;

      border-radius: 13px;

      background: #dbeafe;

      color: #2563eb;

      font-size: 20px;
    }


    .hero-information span {
      display: block;

      margin-bottom: 4px;

      color: #64748b;

      font-size: 10px;

      line-height: 1.5;
    }


    .hero-information strong {
      display: block;

      color: #172554;

      font-size: 18px;

      font-weight: 900;
    }


    .hero-information p {
      margin:
        6px 0 0;

      color: #64748b;

      font-size: 11px;

      line-height: 1.6;
    }


    /* =====================================================
       SECTION
    ====================================================== */

    .category-section {
      padding:
        75px 0 80px;

      background: #fff;
    }


    .section-heading {
      display: flex;

      align-items: flex-end;

      justify-content: space-between;

      gap: 40px;

      margin-bottom: 35px;
    }


    .section-heading.left {
      display: block;

      margin-bottom: 28px;
    }


    .section-eyebrow {
      display: block;

      margin-bottom: 8px;

      color: #2563eb;

      font-size: 10px;

      font-weight: 900;

      letter-spacing: .13em;
    }


    .section-heading h2 {
      margin: 0;

      color: #172554;

      font-size:
        clamp(27px, 4vw, 38px);

      line-height: 1.15;

      letter-spacing: -.035em;

      font-weight: 900;
    }


    .section-heading h2 span {
      color: #2563eb;
    }


    .section-heading > p {
      max-width: 360px;

      margin: 0;

      color: #64748b;

      font-size: 12px;

      line-height: 1.7;
    }


    /* =====================================================
       CATEGORY
    ====================================================== */

    .category-grid {
      display: grid;

      grid-template-columns:
        repeat(4, minmax(0, 1fr));

      gap: 16px;
    }


    .category-card {
      position: relative;

      display: block;

      padding: 22px;

      overflow: hidden;

      border:
        1px solid #e5e7eb;

      border-radius: 15px;

      background: #fff;

      transition: .25s ease;
    }


    .category-card:hover {
      border-color: #bfdbfe;

      transform:
        translateY(-4px);

      box-shadow:
        0 15px 35px
        rgba(15,23,42,.07);
    }


    .category-icon {
      width: 44px;
      height: 44px;

      display: grid;

      place-items: center;

      margin-bottom: 18px;

      border-radius: 11px;

      background: #eff6ff;

      color: #2563eb;

      font-size: 17px;
    }


    .category-content h3 {
      margin: 0;

      color: #172554;

      font-size: 15px;

      line-height: 1.3;

      font-weight: 900;
    }


    .category-content p {
      min-height: 64px;

      margin:
        8px 0 18px;

      color: #64748b;

      font-size: 11px;

      line-height: 1.65;
    }


    .category-bottom {
      display: flex;

      align-items: center;

      justify-content: space-between;

      padding-top: 12px;

      border-top:
        1px solid #f1f5f9;

      color: #2563eb;

      font-size: 10px;

      font-weight: 800;
    }


    /* =====================================================
       INFORMATION
    ====================================================== */

    .information-section {
      padding:
        75px 0 85px;

      background: #f8fafc;
    }


    .information-layout {
      display: grid;

      grid-template-columns:
        minmax(0, 1fr)
        330px;

      align-items: start;

      gap: 45px;
    }


    /* =====================================================
       DB CATEGORY
    ====================================================== */

    .db-category {
      margin-bottom: 22px;

      padding: 20px;

      border:
        1px solid #e2e8f0;

      border-radius: 16px;

      background: #fff;
    }


    .db-category-header {
      display: flex;

      align-items: center;

      gap: 13px;

      margin-bottom: 16px;

      padding-bottom: 15px;

      border-bottom:
        1px solid #f1f5f9;
    }


    .db-category-icon {
      width: 42px;
      height: 42px;

      display: grid;

      place-items: center;

      flex-shrink: 0;

      border-radius: 11px;

      background: #eff6ff;

      color: #2563eb;
    }


    .db-category-header span {
      display: block;

      margin-bottom: 2px;

      color: #2563eb;

      font-size: 8px;

      font-weight: 900;

      letter-spacing: .1em;
    }


    .db-category-header h3 {
      margin: 0;

      color: #172554;

      font-size: 17px;

      font-weight: 900;
    }


    .db-item-list {
      display: flex;

      flex-direction: column;

      gap: 8px;
    }


    .db-item {
      display: flex;

      align-items: center;

      gap: 12px;

      padding: 12px;

      border:
        1px solid #f1f5f9;

      border-radius: 11px;

      background: #fff;

      transition: .2s ease;
    }


    .db-item:hover {
      border-color: #dbeafe;

      background: #f8fbff;
    }


    .db-item-icon {
      width: 38px;
      height: 38px;

      display: grid;

      place-items: center;

      flex-shrink: 0;

      border-radius: 9px;

      background: #eff6ff;

      color: #2563eb;

      font-size: 13px;
    }


    .db-item-content {
      min-width: 0;

      flex: 1;
    }


    .db-item-content h4 {
      margin: 0;

      color: #172554;

      font-size: 12px;

      line-height: 1.45;

      font-weight: 900;
    }


    .db-item-content p {
      margin:
        4px 0;

      color: #64748b;

      font-size: 10px;

      line-height: 1.6;

      display: -webkit-box;

      -webkit-line-clamp: 2;

      -webkit-box-orient: vertical;

      overflow: hidden;
    }


    .db-item-content small {
      color: #94a3b8;

      font-size: 8px;
    }


    .download-button,
    .detail-button {
      min-width: 72px;

      height: 34px;

      display: inline-flex;

      align-items: center;

      justify-content: center;

      gap: 6px;

      flex-shrink: 0;

      border: 0;

      border-radius: 8px;

      background: #eff6ff;

      color: #2563eb;

      font-family: inherit;

      font-size: 9px;

      font-weight: 900;

      cursor: pointer;

      transition: .2s ease;
    }


    .download-button:hover,
    .detail-button:hover {
      background: #2563eb;

      color: #fff;
    }


    .empty-data {
      padding: 28px;

      text-align: center;

      color: #94a3b8;
    }


    .empty-data i {
      margin-bottom: 8px;

      font-size: 25px;
    }


    .empty-data p {
      margin: 0;

      font-size: 10px;
    }


    /* =====================================================
       SIDEBAR
    ====================================================== */

    .ppid-sidebar {
      position: sticky;

      top: 25px;

