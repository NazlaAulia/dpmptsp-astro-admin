---
import MainLayout from "../layouts/MainLayout.astro";
import { getRegulations } from "../lib/services/content.service";

const regulasi = await getRegulations();
---

<MainLayout title="DPMPTSP Kota Surabaya">
<section class="relative overflow-hidden gradient-flow bg-gradient-to-r from-blue-800 via-blue-700 to-blue-600">
            <div class="absolute inset-0 z-0">
                <div class="absolute top-0 right-0 w-64 h-64 bg-yellow-400 rounded-full opacity-10 -translate-y-32 translate-x-32 animate-pulse-soft"></div>
                <div class="absolute bottom-0 left-0 w-96 h-96 bg-blue-600 rounded-full opacity-10 -translate-x-64 translate-y-64 animate-pulse-soft"></div>
                <div class="absolute top-1/2 left-1/4 w-48 h-48 bg-white rounded-full opacity-5 animate-float-subtle"></div>
            </div>
            <div class="container mx-auto px-4 py-20 relative z-10">
                <div class="text-center text-white animate-fade-in-scale">
                    <h1 class="text-5xl md:text-6xl font-bold mb-6 animate-text-reveal">
                        Regulasi DPM-PTSP Surabaya
                    </h1>
                    <p class="text-xl opacity-90 max-w-3xl mx-auto animate-slide-in-left">
                        Informasi Visi Misi Sambutan Maklumat dan Organisasi
                    </p>
                    <div class="mt-8 flex justify-center">
                        <div class="animate-bounce-soft">
                            <i class="fas fa-chevron-down text-2xl text-yellow-400"></i>
                        </div>
                    </div>
                </div>
            </div>
        </section>

  <section class="reg-section">

    <div class="reg-container">

      <!-- =====================================================
           HEADER
      ====================================================== -->

      <div class="reg-header">

        <div class="reg-heading">

          <div class="reg-eyebrow">
            <span class="reg-dot"></span>
            DOKUMEN PUBLIK
          </div>

          <h2>
            Regulasi <span>Terbaru</span>
          </h2>

          <p>
            Akses regulasi, standar pelayanan, SOP dan dasar hukum
            penyelenggaraan pelayanan DPMPTSP Kota Surabaya.
          </p>

        </div>

        <a
          href="/"
          class="reg-all"
        >
          <span>Kembali ke Beranda</span>
          <strong>→</strong>
        </a>

      </div>


      <!-- =====================================================
           LIST REGULASI
      ====================================================== -->

      {regulasi.length > 0 ? (

        <div class="reg-list">

          {regulasi.map((item, index) => (

            <article
              class="reg-card"
              style={`--delay:${index * 80}ms`}
            >

              <!-- NUMBER -->

              <div class="reg-number">
                {String(index + 1).padStart(2, "0")}
              </div>


              <!-- ICON -->

              <div class="reg-icon">

                {item.jenis === "SOP" && "▤"}

                {item.jenis === "SK" && "▥"}

                {item.jenis === "PERWALI" && "§"}

                {item.jenis === "UU" && "⚖"}

                {!["SOP", "SK", "PERWALI", "UU"].includes(item.jenis) &&
                  "▧"
                }

              </div>


              <!-- CONTENT -->

              <div class="reg-content">

                <div class="reg-meta">

                  <span
                    class={`reg-badge ${item.jenis?.toLowerCase() || ""}`}
                  >
                    {item.jenis}
                  </span>

                  {item.nomor && (

                    <span class="reg-nomor">
                      {item.nomor}
                    </span>

                  )}

                  {item.tahun && (

                    <>

                      <span class="reg-separator">
                        /
                      </span>

                      <span class="reg-year">
                        {item.tahun}
                      </span>

                    </>

                  )}

                </div>


                <h3>
                  {item.judul}
                </h3>

              </div>


              <!-- DOWNLOAD -->

              {item.file ? (

                <a
                  href={item.file}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="reg-download"
                  aria-label={`Unduh ${item.judul}`}
                >

                  <span>
                    Unduh
                  </span>

                  <strong>
                    ↓
                  </strong>

                </a>

              ) : (

                <span class="reg-download disabled">

                  <span>
                    Belum tersedia
                  </span>

                </span>

              )}

            </article>

          ))}

        </div>

      ) : (

        <!-- EMPTY -->

        <div class="reg-empty">

          <div class="reg-empty-icon">
            ▧
          </div>

          <div>

            <strong>
              Belum ada regulasi
            </strong>

            <p>
              Dokumen regulasi akan ditampilkan di sini.
            </p>

          </div>

        </div>

      )}

    </div>

  </section>

</MainLayout>


<style>

/* =========================================================
   REGULASI SECTION
========================================================= */

.reg-section {

  position: relative;

  padding: 100px 20px;

  overflow: hidden;

  background:
    radial-gradient(
      circle at 5% 20%,
      rgba(8,120,201,.12),
      transparent 28%
    ),
    radial-gradient(
      circle at 95% 80%,
      rgba(245,196,0,.10),
      transparent 25%
    ),
    #f5f8fc;

}


/* =========================================================
   DECORATION
========================================================= */

.reg-section::before {

  content: "";

  position: absolute;

  width: 600px;
  height: 600px;

  right: -330px;
  top: -300px;

  border: 1px solid rgba(8,64,130,.08);

  border-radius: 50%;

  box-shadow:
    0 0 0 70px rgba(8,64,130,.025),
    0 0 0 140px rgba(8,64,130,.018),
    0 0 0 210px rgba(8,64,130,.012);

}


/* =========================================================
   CONTAINER
========================================================= */

.reg-container {

  position: relative;

  z-index: 2;

  width: 100%;

  max-width: 1200px;

  margin: auto;

}


/* =========================================================
   HEADER
========================================================= */

.reg-header {

  display: flex;

  justify-content: space-between;

  align-items: flex-end;

  gap: 40px;

  margin-bottom: 40px;

}


.reg-heading {

  max-width: 720px;

}


.reg-eyebrow {

  display: flex;

  align-items: center;

  gap: 10px;

  margin-bottom: 15px;

  color: #0878c9;

  font-size: 11px;

  font-weight: 900;

  letter-spacing: 2px;

}


.reg-dot {

  width: 9px;
  height: 9px;

  display: inline-block;

  border-radius: 50%;

  background: #f5c400;

  box-shadow:
    0 0 0 6px rgba(245,196,0,.13);

}


.reg-heading h2 {

  margin: 0;

  color: #082b57;

  font-size:
    clamp(38px, 5vw, 58px);

  line-height: .95;

  letter-spacing: -2.5px;

}


.reg-heading h2 span {

  color: #0878c9;

}


.reg-heading p {

  max-width: 650px;

  margin: 18px 0 0;

  color: #718096;

  font-size: 14px;

  line-height: 1.8;

}


/* =========================================================
   HEADER BUTTON
========================================================= */

.reg-all {

  display: inline-flex;

  align-items: center;

  justify-content: center;

  gap: 13px;

  min-width: 205px;

  padding: 14px 20px;

  border-radius: 12px;

  background: #082b57;

  color: white;

  text-decoration: none;

  font-size: 12px;

  font-weight: 800;

  white-space: nowrap;

  transition: .3s;

}


.reg-all strong {

  font-size: 20px;

  font-weight: 400;

  transition: .3s;

}


.reg-all:hover {

  background: #f5c400;

  color: #082b57;

  transform: translateY(-4px);

  box-shadow:
    0 15px 30px rgba(245,196,0,.20);

}


.reg-all:hover strong {

  transform: translateX(5px);

}


/* =========================================================
   LIST
========================================================= */

.reg-list {

  display: grid;

  gap: 12px;

}


/* =========================================================
   CARD
========================================================= */

.reg-card {

  position: relative;

  display: grid;

  grid-template-columns:
    55px
    62px
    minmax(0,1fr)
    auto;

  align-items: center;

  gap: 20px;

  min-height: 112px;

  padding: 20px 24px;

  overflow: hidden;

  border: 1px solid #e3eaf2;

  border-radius: 18px;

  background: rgba(255,255,255,.88);

  box-shadow:
    0 8px 30px rgba(7,48,90,.055);

  opacity: 0;

  transform:
    translateY(20px);

  animation:
    regIn .65s
    var(--delay)
    ease forwards;

  transition:
    transform .3s ease,
    box-shadow .3s ease,
    border-color .3s ease;

}


@keyframes regIn {

  to {

    opacity: 1;

    transform: translateY(0);

  }

}


.reg-card::before {

  content: "";

  position: absolute;

  left: 0;
  top: 0;

  width: 4px;
  height: 100%;

  background:
    linear-gradient(
      #0878c9,
      #f5c400
    );

  transform:
    scaleY(0);

  transform-origin:
    center;

  transition:
    transform .3s ease;

}


.reg-card:hover {

  transform:
    translateY(-4px);

  border-color:
    rgba(8,120,201,.22);

  box-shadow:
    0 18px 45px rgba(7,48,90,.11);

}


.reg-card:hover::before {

  transform:
    scaleY(1);

}


/* =========================================================
   NUMBER
========================================================= */

.reg-number {

  color: #b8c5d3;

  font-size: 13px;

  font-weight: 900;

  letter-spacing: 1px;

}


/* =========================================================
   ICON
========================================================= */

.reg-icon {

  width: 55px;
  height: 55px;

  display: flex;

  align-items: center;
  justify-content: center;

  border-radius: 15px;

  background:
    linear-gradient(
      135deg,
      #edf7ff,
      #dceeff
    );

  color: #0878c9;

  font-size: 24px;

  font-weight: 800;

  box-shadow:
    inset 0 0 0 1px
    rgba(8,120,201,.07);

}


/* =========================================================
   CONTENT
========================================================= */

.reg-content {

  min-width: 0;

}


.reg-meta {

  display: flex;

  align-items: center;

  flex-wrap: wrap;

  gap: 8px;

  margin-bottom: 8px;

}


.reg-badge {

  display: inline-flex;

  align-items: center;

  justify-content: center;

  min-width: 65px;

  height: 25px;

  padding: 0 9px;

  border-radius: 6px;

  background: #082b57;

  color: white;

  font-size: 9px;

  font-weight: 900;

  letter-spacing: .8px;

}


.reg-badge.sop {

  background: #0878c9;

}


.reg-badge.sk {

  background: #0b8a72;

}


.reg-badge.perwali {

  background: #7556c7;

}


.reg-badge.uu {

  background: #bd7b00;

}


.reg-nomor,
.reg-year {

  color: #718096;

  font-size: 10px;

  font-weight: 700;

  letter-spacing: .4px;

}


.reg-separator {

  color: #c2ccd7;

  font-size: 12px;

}


.reg-content h3 {

  margin: 0;

  color: #082b57;

  font-size: 16px;

  line-height: 1.4;

  font-weight: 800;

}


/* =========================================================
   DOWNLOAD
========================================================= */

.reg-download {

  display: inline-flex;

  align-items: center;

  justify-content: center;

  gap: 9px;

  min-width: 95px;

  height: 42px;

  padding: 0 14px;

  border: 1px solid #dce5ee;

  border-radius: 10px;

  background: #f8fafc;

  color: #082b57;

  text-decoration: none;

  font-size: 11px;

  font-weight: 900;

  transition: .3s;

}


.reg-download strong {

  font-size: 18px;

  font-weight: 400;

  transition: .3s;

}


.reg-download:hover {

  border-color: #f5c400;

  background: #f5c400;

  color: #082b57;

  transform: translateY(-2px);

  box-shadow:
    0 10px 20px rgba(245,196,0,.18);

}


.reg-download:hover strong {

  transform: translateY(3px);

}


.reg-download.disabled {

  cursor: not-allowed;

  opacity: .45;

}


/* =========================================================
   EMPTY
========================================================= */

.reg-empty {

  display: flex;

  align-items: center;

  gap: 20px;

  padding: 35px;

  border:
    1px dashed #ccd8e4;

  border-radius: 18px;

  background: white;

}


.reg-empty-icon {

  width: 55px;
  height: 55px;

  display: flex;

  align-items: center;
  justify-content: center;

  border-radius: 15px;

  background: #edf4fa;

  color: #0878c9;

  font-size: 25px;

}


.reg-empty strong {

  color: #082b57;

  font-size: 15px;

}


.reg-empty p {

  margin: 5px 0 0;

  color: #718096;

  font-size: 12px;

}


/* =========================================================
   TABLET
========================================================= */

@media (max-width: 800px) {

  .reg-section {

    padding: 75px 18px;

  }


  .reg-header {

    align-items: flex-start;

    flex-direction: column;

  }


  .reg-card {

    grid-template-columns:
      45px
      55px
      minmax(0,1fr);

  }


  .reg-download {

    grid-column: 3;

    justify-self: start;

    margin-top: 4px;

  }

}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 560px) {

  .reg-section {

    padding: 60px 15px;

  }


  .reg-heading h2 {

    font-size: 38px;

  }


  .reg-heading p {

    font-size: 13px;

  }


  .reg-all {

    width: 100%;

  }


  .reg-card {

    grid-template-columns:
      44px
      minmax(0,1fr);

    gap: 13px;

    padding: 17px;

  }


  .reg-number {

    grid-column: 1;

    grid-row: 1;

  }


  .reg-icon {

    grid-column: 1;

    grid-row: 2;

    width: 44px;
    height: 44px;

    font-size: 19px;

  }


  .reg-content {

    grid-column: 2;

    grid-row:
      1 / span 2;

  }


  .reg-content h3 {

    font-size: 14px;

  }


  .reg-download {

    grid-column: 2;

    grid-row: 3;

    width: 100%;

  }

}

</style>