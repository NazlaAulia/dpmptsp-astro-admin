---
import { MEDIA_BASE_URL } from "../lib/media";
import MainLayout from "../layouts/MainLayout.astro";
import { slugify } from "../utils/slugify";
import { listArticles, PER_PAGE, type ListType } from "../lib/services/article.service";

export const prerender = false;

// Data access lives in src/lib/services. This page previously built a WHERE
// clause by string concatenation, ran its own COUNT and SELECT, and
// interpolated LIMIT/OFFSET straight into the SQL.
const url = new URL(Astro.request.url);
const q = url.searchParams.get("q") || "";
const type = (url.searchParams.get("type") || "all") as ListType;
const lang = url.searchParams.get("lang") || "id";

const result = await listArticles(url.searchParams.get("page"), type, q);
const rows = result.items;
const totalItems = result.total;
const totalPages = result.totalPages;
const page = result.page;
const limit = PER_PAGE;

const getLink = (p, t = type) => {
  const up = new URLSearchParams(url.searchParams);
  up.set("page", p.toString());
  up.set("type", t);
  if (q) up.set("q", q); else up.delete("q");
  return `?${up.toString()}`;
};
---

<MainLayout title="Media Center | DPMPTSP">
  
  <div class="relative bg-slate-900 pt-20 pb-32 overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-0 left-0 w-72 h-72 bg-blue-500 rounded-full mix-blend-multiply filter blur-3xl animate-blob"></div>
      <div class="absolute bottom-0 right-0 w-72 h-72 bg-indigo-500 rounded-full mix-blend-multiply filter blur-3xl animate-blob animation-delay-2000"></div>
    </div>
    
    <div class="relative container mx-auto px-6 text-center">
      <h1 class="text-4xl md:text-6xl font-black text-white mb-4 tracking-tight">
        Media <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-emerald-400">Pusat Informasi</span>
      </h1>
      <p class="text-slate-400 max-w-xl mx-auto text-lg">
        Berita terkini, artikel perizinan, dan informasi penanaman modal Kota Surabaya.
      </p>
    </div>
  </div>

  <div class="container mx-auto px-6 -mt-16 relative z-10">
    <div class="bg-white/80 backdrop-blur-xl border border-white shadow-2xl rounded-[2.5rem] p-4 md:p-8">
      <div class="flex flex-col lg:flex-row gap-6 items-center">
        
        <div class="relative w-full lg:flex-1">
          <input 
            id="searchBox"
            type="text" 
            placeholder="Cari berita..." 
            value={q}
            class="w-full pl-14 pr-6 py-4 bg-slate-100/50 border-transparent rounded-2xl focus:bg-white focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 outline-none transition-all font-medium"
          />
          <svg class="w-6 h-6 absolute left-5 top-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>

        <div class="flex p-1.5 bg-slate-100 rounded-2xl w-full lg:w-auto overflow-x-auto">
          {['all', 'berita', 'artikel'].map(t => (
            <a 
              href={getLink(1, t)}
              class={`flex-1 lg:flex-none px-8 py-3 rounded-xl text-xs font-black tracking-widest uppercase transition-all whitespace-nowrap ${
                type === t ? 'bg-white text-blue-600 shadow-sm scale-105' : 'text-slate-500 hover:text-slate-800'
              }`}
            >
              {t}
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>

  <main class="container mx-auto px-6 py-20">
    
    <div class="flex justify-between items-center mb-10">
      <div class="text-slate-500 text-sm font-medium">
        Menampilkan <span class="text-slate-900 font-bold">{rows.length}</span> dari <span class="text-slate-900 font-bold">{totalItems}</span> rilis
      </div>
    </div>

    {rows.length === 0 && (
      <div class="text-center py-32">
        <div class="inline-flex p-6 bg-slate-50 rounded-full mb-6">
           <svg class="w-12 h-12 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
        </div>
        <h3 class="text-xl font-bold text-slate-800">Ups, Tidak Ada Hasil</h3>
        <p class="text-slate-500 mt-2">Coba gunakan kata kunci lain atau reset filter.</p>
        <a href="/media" class="inline-block mt-6 text-blue-600 font-bold underline">Reset Semua</a>
      </div>
    )}

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-8">
      {rows.map(item => (
        <article class="group relative flex flex-col h-full">
          <a href={`/media/${slugify(item.title)}`} class="flex flex-col h-full bg-white rounded-3xl border border-slate-100 shadow-sm hover:shadow-2xl transition-all duration-500 overflow-hidden">
            
            <div class="relative aspect-[4/3] overflow-hidden">
            <img 
  src={item.picture ? `/uploads/${item.picture}` : '/no-image.jpg'}
  alt={item.title}
  loading="lazy"
  class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
  onerror={`this.onerror=null; this.src='${MEDIA_BASE_URL}/fileberita/${item.picture}'`}
/>
              <div class="absolute inset-0 bg-gradient-to-t from-slate-900/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            </div>

            <div class="p-6 flex flex-col flex-1">
              <div class="flex items-center gap-3 mb-4">
                <span class="w-2 h-2 rounded-full bg-blue-500"></span>
                <span class="text-[10px] font-black uppercase tracking-tighter text-slate-400 italic">
                  {new Date(item.date).toLocaleDateString('id-ID', {day:'numeric', month:'short', year:'numeric'})}
                </span>
              </div>
              
              <h2 class="text-lg font-bold text-slate-800 leading-tight mb-3 line-clamp-2 group-hover:text-blue-600 transition-colors">
                {lang === 'en' ? (item.title_en || item.title) : item.title}
              </h2>
              
              <p class="text-slate-500 text-xs leading-relaxed line-clamp-3 mb-6">
                {item.content?.replace(/<[^>]+>/g, '')}
              </p>

              <div class="mt-auto pt-4 border-t border-slate-50 flex items-center text-blue-600 font-black text-[10px] uppercase tracking-widest">
                Selengkapnya 
                <svg class="w-4 h-4 ml-2 group-hover:translate-x-2 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              </div>
            </div>
          </a>
        </article>
      ))}
    </div>

    {totalPages > 1 && (
      <nav class="mt-20 flex justify-center items-center gap-2">
        <a 
          href={page > 1 ? getLink(page - 1) : "#"} 
          class={`w-12 h-12 flex items-center justify-center rounded-2xl border transition-all ${page <= 1 ? 'opacity-20 pointer-events-none' : 'hover:bg-slate-900 hover:text-white border-slate-200 shadow-sm'}`}
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
        </a>

        <div class="flex items-center gap-2 bg-slate-100 p-1.5 rounded-[1.25rem]">
          {Array.from({ length: totalPages }, (_, i) => i + 1)
            .filter(p => p === 1 || p === totalPages || Math.abs(p - page) <= 1)
            .map((p, i, arr) => (
              <>
                {i > 0 && arr[i-1] !== p - 1 && <span class="px-2 text-slate-400 text-xs">...</span>}
                <a 
                  href={getLink(p)}
                  class={`w-10 h-10 flex items-center justify-center rounded-xl text-xs font-black transition-all ${
                    page === p ? 'bg-white text-blue-600 shadow-sm scale-110' : 'text-slate-500 hover:text-slate-800'
                  }`}
                >
                  {p}
                </a>
              </>
            ))
          }
        </div>

        <a 
          href={page < totalPages ? getLink(page + 1) : "#"} 
          class={`w-12 h-12 flex items-center justify-center rounded-2xl border transition-all ${page >= totalPages ? 'opacity-20 pointer-events-none' : 'hover:bg-slate-900 hover:text-white border-slate-200 shadow-sm'}`}
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </a>
      </nav>
    )}
  </main>
</MainLayout>

<style>
  @keyframes blob {
    0% { transform: translate(0px, 0px) scale(1); }
    33% { transform: translate(30px, -50px) scale(1.1); }
    66% { transform: translate(-20px, 20px) scale(0.9); }
    100% { transform: translate(0px, 0px) scale(1); }
  }
  .animate-blob {
    animation: blob 7s infinite;
  }
  .animation-delay-2000 {
    animation-delay: 2s;
  }
</style>

<script is:inline>
  const searchBox = document.getElementById('searchBox');
  searchBox?.addEventListener('keypress', (e) => {
    if (e.key === 'Enter') {
      const val = searchBox.value.trim();
      const params = new URLSearchParams(window.location.search);
      if (val) params.set('q', val); else params.delete('q');
      params.set('page', '1');
      window.location.search = params.toString();
    }
  });
</script>