---
import "@dpmptsp/ui/styles/global.css";
import MainLayout from "../layouts/MainLayout.astro";
import { getPelayananContent } from "../lib/services/content.service";
import { getPelayananContent } from "../lib/services/content.service";

export const prerender = false;

const { pelayananData, info, infoItems } = await getPelayananContent();

const {
  title = "Pelayanan DPMPTSP Kota Surabaya",
  description = "Daftar layanan yang tersedia di DPMPTSP Kota Surabaya",
} = Astro.props;

// Static tiles, not database content.
const layanan = [
  {
    name: "Perizinan Usaha",
    img: "https://epmal.surabaya.go.id/simpedal/assets2/Perizinan.png",
    link: "#",
  },
  {
    name: "Pelaporan Pajak",
    img: "https://epmal.surabaya.go.id/simpedal/assets2/Pajak.png",
    link: "#",
  },
  {
    name: "Wani Ngurus Izin",
    img: "https://epmal.surabaya.go.id/simpedal/assets2/Wani%20Ngurus%20Izin.jpeg",
    link: "#",
  },
  {
    name: "MPP Virtual",
    img: "https://mpp.surabaya.go.id/mppvirtual/skin/Image_7DB3C373_7065_34DE_41BA_CF5206137DED.png?v=1696700959324",
    link: "#",
  },
  {
    name: "Takon Sobat",
    img: "https://epmal.surabaya.go.id/simpedal/assets2/TAKON-SOBAT.png",
    link: "#",
  },
];

---

    
<MainLayout title="DPMPTSP Kota Surabaya">

    <main class="min-h-screen bg-gray-50">
      <!-- Hero Section -->
      <section class="relative overflow-hidden bg-blue-800 py-20">
        <div class="container mx-auto px-4 text-center relative z-10 text-white">
          <h1 class="text-4xl md:text-5xl font-bold mb-4">Pelayanan DPMPTSP</h1>
          <p class="text-xl opacity-90 max-w-3xl mx-auto">
            Temukan berbagai layanan yang tersedia untuk mendukung masyarakat Surabaya
          </p>
        </div>
      </section>

     <section id="stdjenis-sec" class="py-16 bg-white">
  <div class="container mx-auto px-4">

    <!-- HEADER -->
    <div class="text-center mb-12">
      <div class="flex items-center justify-center mb-6">
        <div class="w-12 h-12 bg-blue-600 rounded-full flex items-center justify-center mr-4 shadow-md">
          <i class="fas fa-clipboard-check text-white text-xl"></i>
        </div>

        <h2 class="text-3xl md:text-4xl font-bold text-blue-800">
          Standar Jenis Pelayanan
        </h2>
      </div>

      <p class="text-gray-600 max-w-2xl mx-auto">
        Informasi lengkap tentang standar, prosedur, waktu, dan biaya
        pelayanan yang disediakan oleh DPM-PTSP Surabaya.
      </p>
    </div>

    <!-- TAB NAVIGATION -->
    <div class="flex flex-wrap justify-center gap-3 mb-8">

      {
        pelayananData.map((item, index) => (
          <button
            type="button"
            class={`tab-button px-6 py-3 rounded-xl font-semibold transition-all duration-300 flex items-center gap-2 ${
              index === 0
                ? "bg-blue-600 text-white shadow-md"
                : "bg-gray-100 text-gray-700 hover:bg-blue-50 hover:text-blue-700"
            }`}
            data-tab={item.tab_key}
          >
            <i class={item.tab_icon || "fas fa-circle"}></i>
            {item.tab_judul}
          </button>
        ))
      }

    </div>

    <!-- TAB CONTENT -->
    <div class="tab-content">

      {
        pelayananData.map((item, index) => (
          <div
            id={item.tab_key}
            class={`tab-pane ${index === 0 ? "" : "hidden"}`}
          >

            <div class="bg-white rounded-3xl shadow-lg border border-gray-100 p-6 md:p-8">

              <!-- JUDUL -->
              <div class="mb-8">
                <div class="flex items-center gap-3 mb-4">
                  <div class="w-11 h-11 rounded-xl bg-blue-100 flex items-center justify-center">
                    <i class={item.tab_icon || "fas fa-circle"} class="text-blue-600"></i>
                  </div>

                  <h3 class="text-2xl font-bold text-blue-800">
                    {item.judul}
                  </h3>
                </div>

                <p class="text-gray-600 leading-relaxed">
                  {item.deskripsi}
                </p>
              </div>


              <!-- STANDAR -->
              {item.tab_key === "standar" && (
                <div>

                  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">

                    {
                      Array.isArray(item.isi) &&
                      item.isi.map((card) => (
                        <div class={`p-6 rounded-2xl border transition-all duration-300 hover:-translate-y-1 hover:shadow-md ${
                          card.warna === "yellow"
                            ? "bg-yellow-50 border-yellow-100"
                            : "bg-blue-50 border-blue-100"
                        }`}>

                          <div class="flex items-center mb-4">

                            <div class={`w-12 h-12 rounded-full flex items-center justify-center mr-4 ${
                              card.warna === "yellow"
                                ? "bg-yellow-400"
                                : "bg-blue-600"
                            }`}>
                              <i class={`${card.icon} ${
                                card.warna === "yellow"
                                  ? "text-blue-900"
                                  : "text-white"
                              } text-xl`}></i>
                            </div>

                            <h4 class="text-lg font-bold text-blue-800">
                              {card.judul}
                            </h4>

                          </div>

                          <p class="text-gray-700 leading-relaxed">
                            {card.deskripsi}
                          </p>

                        </div>
                      ))
                    }

                  </div>


                  <!-- IFRAME -->
                  <div class="mt-10">

                    <div class="flex items-center justify-between flex-wrap gap-4 mb-4">

                      <div>
                        <h4 class="text-xl font-bold text-blue-800">
                          Dokumen Standar Pelayanan
                        </h4>

                        <p class="text-sm text-gray-500 mt-1">
                          Akses informasi pelayanan melalui SSW dan OSS.
                        </p>
                      </div>

                      <div class="flex gap-2">

                        <button
                          type="button"
                          id="btn-ssw"
                          class="px-5 py-2.5 bg-blue-600 text-white rounded-xl font-semibold shadow-sm"
                          onclick="showFrame('ssw')"
                        >
                          <i class="fas fa-globe mr-2"></i>
                          SSW
                        </button>

                        <button
                          type="button"
                          id="btn-oss"
                          class="px-5 py-2.5 bg-gray-100 text-gray-700 rounded-xl font-semibold hover:bg-gray-200"
                          onclick="showFrame('oss')"
                        >
                          <i class="fas fa-building mr-2"></i>
                          OSS
                        </button>

                      </div>

                    </div>

                    <div class="border border-gray-200 rounded-2xl overflow-hidden shadow-sm">

                      <iframe
                        id="ssw-frame"
                        src="https://sswalfa.surabaya.go.id/info/daftar-perizinan"
                        class="w-full"
                        style="height:800px"
                        frameborder="0"
                      ></iframe>

                      <iframe
                        id="oss-frame"
                        src="https://oss.go.id/id/kbli"
                        class="w-full"
                        style="height:800px;display:none"
                        frameborder="0"
                      ></iframe>

                    </div>

                    <div class="mt-3 text-sm text-gray-500">
                      <i class="fas fa-link mr-1"></i>
                      <span id="link-text">
                        SSW — Surabaya Single Window
                      </span>
                    </div>

                  </div>

                </div>
              )}


              <!-- PROSEDUR -->
              {item.tab_key === "prosedur" && (
                <div class="space-y-5">

                  {
                    Array.isArray(item.isi) &&
                    item.isi.map((step, stepIndex) => (
                      <div class="flex items-start gap-4 p-5 rounded-2xl bg-gray-50 hover:bg-blue-50 transition">

                        <div class={`w-11 h-11 shrink-0 rounded-full flex items-center justify-center font-bold ${
                          stepIndex % 2 === 0
                            ? "bg-blue-600 text-white"
                            : "bg-yellow-400 text-blue-900"
                        }`}>
                          {stepIndex + 1}
                        </div>

                        <div>
                          <h4 class="text-lg font-bold text-blue-800 mb-1">
                            {step.judul}
                          </h4>

                          <p class="text-gray-600 leading-relaxed">
                            {step.deskripsi}
                          </p>
                        </div>

                      </div>
                    ))
                  }

                </div>
              )}


              <!-- WAKTU -->
              {item.tab_key === "waktu" && (
                <div>

                  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">

                    <div class="bg-blue-50 border border-blue-100 rounded-2xl p-6">

                      <div class="flex items-center gap-4 mb-4">
                        <div class="w-12 h-12 rounded-xl bg-blue-600 flex items-center justify-center">
                          <i class="fas fa-clock text-white text-xl"></i>
                        </div>

                        <h4 class="font-bold text-blue-800">
                          Hari Kerja
                        </h4>
                      </div>

                      <p class="text-gray-700">
                        {item.isi.jam_operasional?.hari_kerja}
                      </p>

                      <p class="font-bold text-blue-700 mt-1">
                        {item.isi.jam_operasional?.jam}
                      </p>

                    </div>


                    <div class="bg-yellow-50 border border-yellow-100 rounded-2xl p-6">

                      <div class="flex items-center gap-4 mb-4">
                        <div class="w-12 h-12 rounded-xl bg-yellow-400 flex items-center justify-center">
                          <i class="fas fa-calendar-xmark text-blue-900 text-xl"></i>
                        </div>

                        <h4 class="font-bold text-blue-800">
                          Hari Libur
                        </h4>
                      </div>

                      <p class="text-gray-700">
                        {item.isi.jam_operasional?.hari_libur}
                      </p>

                      <p class="font-bold text-red-600 mt-1">
                        {item.isi.jam_operasional?.status_libur}
                      </p>

                    </div>

                  </div>


                  <h4 class="text-xl font-bold text-blue-800 mb-5">
                    Waktu Penyelesaian Perizinan
                  </h4>

                  <div class="overflow-x-auto rounded-2xl border border-gray-200">

                    <table class="min-w-full bg-white">

                      <thead>
                        <tr class="bg-blue-600 text-white">
                          <th class="py-4 px-5 text-left">Jenis Perizinan</th>
                          <th class="py-4 px-5 text-left">Waktu</th>
                          <th class="py-4 px-5 text-left">Keterangan</th>
                        </tr>
                      </thead>

                      <tbody>

                        {
                          item.isi.perizinan?.map((row) => (
                            <tr class="border-b border-gray-100 hover:bg-blue-50 transition">

                              <td class="py-4 px-5 font-medium text-gray-800">
                                {row.jenis}
                              </td>

                              <td class="py-4 px-5 font-semibold text-blue-700 whitespace-nowrap">
                                {row.waktu}
                              </td>

                              <td class="py-4 px-5 text-gray-600">
                                {row.keterangan}
                              </td>

                            </tr>
                          ))
                        }

                      </tbody>

                    </table>

                  </div>

                </div>
              )}


              <!-- BIAYA -->
              {item.tab_key === "biaya" && (
                <div>

                  <div class="bg-green-50 border border-green-100 rounded-2xl p-6 mb-8">

                    <div class="flex items-start gap-4">

                      <div class="w-12 h-12 shrink-0 rounded-xl bg-green-600 flex items-center justify-center">
                        <i class="fas fa-shield-check text-white text-xl"></i>
                      </div>

                      <div>
                        <h4 class="font-bold text-green-800 text-lg mb-1">
                          Transparansi Biaya
                        </h4>

                        <p class="text-green-700">
                          {item.isi.peringatan}
                        </p>
                      </div>

                    </div>

                  </div>


                  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

                    {
                      item.isi.biaya?.map((biaya) => (
                        <div class="group border border-gray-200 rounded-2xl p-6 hover:border-blue-300 hover:shadow-lg transition-all duration-300">

                          <div class="flex items-center justify-between mb-4">

                            <div class="w-10 h-10 rounded-xl bg-blue-50 flex items-center justify-center">
                              <i class="fas fa-file-invoice-dollar text-blue-600"></i>
                            </div>

                            <i class="fas fa-arrow-up-right-from-square text-gray-300 group-hover:text-blue-500"></i>

                          </div>

                          <h5 class="font-bold text-blue-800 mb-3">
                            {biaya.jenis}
                          </h5>

                          <div class="text-2xl font-bold text-blue-600 mb-3">
                            {biaya.nominal}
                          </div>

                          <p class="text-gray-600 text-sm leading-relaxed">
                            {biaya.keterangan}
                          </p>

                        </div>
                      ))
                    }

                  </div>


                  <div class="mt-8 p-5 bg-blue-50 border border-blue-100 rounded-2xl">

                    <p class="text-gray-700">
                      <i class="fas fa-circle-info text-blue-600 mr-2"></i>

                      Untuk informasi biaya lengkap sesuai dengan jenis
                      perizinan, silakan konsultasi dengan tim kami atau
                      kunjungi halaman standar pelayanan.
                    </p>

                  </div>

                </div>
              )}

            </div>

          </div>
        ))
      }

    </div>

  </div>
</section>
   {
  info && (
    <section
      id="info-sec"
      class="relative py-20 overflow-hidden bg-gradient-to-b from-white to-blue-50"
    >

      <!-- Dekorasi -->
      <div class="absolute -top-24 -right-24 w-72 h-72 bg-blue-100 rounded-full opacity-60"></div>

      <div class="absolute -bottom-32 -left-24 w-80 h-80 bg-yellow-100 rounded-full opacity-50"></div>


      <div class="container mx-auto px-4 relative z-10">


        <!-- HEADING -->
        <div class="max-w-3xl mx-auto text-center mb-12">

          <div class="inline-flex items-center gap-2 px-4 py-2 mb-4 rounded-full bg-blue-100 text-blue-700 text-sm font-semibold">
            <i class={info.icon || "fas fa-circle-info"}></i>

            {info.badge}
          </div>


          <h2 class="text-3xl md:text-4xl font-bold text-blue-900 mb-4">

            {info.judul}

            <span class="text-blue-600">
              {info.judul_highlight}
            </span>

          </h2>


          <p class="text-gray-600 leading-relaxed">
            {info.deskripsi}
          </p>

        </div>



        <!-- KONTEN -->
        <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-6">


          <!-- CARD UTAMA -->
          <div class="lg:col-span-2 bg-white rounded-3xl shadow-lg border border-blue-100 p-8 md:p-10">


            <div class="flex items-start gap-5 mb-7">

              <div class="w-14 h-14 shrink-0 rounded-2xl bg-blue-600 flex items-center justify-center shadow-md">

                <i class={`${info.icon || "fas fa-building-columns"} text-white text-2xl`}></i>

              </div>


              <div>

                <h3 class="text-2xl font-bold text-blue-900 mb-2">
                  {info.subjudul}
                </h3>

                <p class="text-sm text-blue-600 font-medium">
                  {info.subjudul_keterangan}
                </p>

              </div>

            </div>



            <!-- ISI -->
            <div class="space-y-4 text-gray-600 leading-relaxed">

              {
                info.isi
                  ?.split(/\n\s*\n/)
                  .filter((paragraph) => paragraph.trim())
                  .map((paragraph) => (
                    <p>
                      {paragraph}
                    </p>
                  ))
              }

            </div>



            <!-- HIGHLIGHT -->
            <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-4">

              {
                infoItems.map((item) => (

                  <div
                    class={`rounded-2xl p-5 border transition-all duration-300 hover:-translate-y-1 hover:shadow-md ${
                      item.warna === "yellow"
                        ? "bg-yellow-50 border-yellow-100"
                        : "bg-blue-50 border-blue-100"
                    }`}
                  >

                    <div
                      class={`w-10 h-10 rounded-xl flex items-center justify-center mb-4 ${
                        item.warna === "yellow"
                          ? "bg-yellow-400"
                          : "bg-blue-600"
                      }`}
                    >

                      <i
                        class={`${item.icon || "fas fa-circle-info"} ${
                          item.warna === "yellow"
                            ? "text-blue-900"
                            : "text-white"
                        }`}
                      ></i>

                    </div>


                    <h4 class="font-bold text-blue-900 mb-1">
                      {item.judul}
                    </h4>


                    <p class="text-sm text-gray-600">
                      {item.deskripsi}
                    </p>

                  </div>

                ))
              }

            </div>

          </div>



          <!-- SIDEBAR -->
          <div class="space-y-6">


            <!-- AKSES INFORMASI -->
            <div class="bg-blue-900 rounded-3xl p-7 text-white shadow-lg">

              <div class="w-12 h-12 rounded-2xl bg-white/15 flex items-center justify-center mb-5">

                <i class="fas fa-unlock-keyhole text-xl"></i>

              </div>


              <h3 class="text-xl font-bold mb-3">
                {info.akses_judul}
              </h3>


              <p class="text-blue-100 text-sm leading-relaxed mb-6">
                {info.akses_deskripsi}
              </p>


              <a
                href={info.akses_link || "#"}
                class="flex items-center justify-between w-full px-5 py-3 rounded-xl bg-white text-blue-900 font-semibold hover:bg-yellow-400 transition"
              >

                <span>
                  {info.akses_button}
                </span>

                <i class="fas fa-arrow-right"></i>

              </a>

            </div>



            <!-- EMAIL -->
            <div class="bg-white rounded-3xl p-7 shadow-md border border-gray-100">

              <div class="flex items-center gap-4 mb-5">

                <div class="w-12 h-12 rounded-2xl bg-blue-100 flex items-center justify-center">

                  <i class="fas fa-envelope text-blue-600 text-xl"></i>

                </div>


                <div>

                  <p class="text-sm text-gray-500">
                    {info.email_label}
                  </p>

                  <p class="font-bold text-blue-900 break-all">
                    {info.email}
                  </p>

                </div>

              </div>


              <a
                href={`mailto:${info.email}`}
                class="block text-center w-full px-5 py-3 rounded-xl bg-blue-600 text-white font-semibold hover:bg-blue-700 transition"
              >

                <i class="fas fa-paper-plane mr-2"></i>

                {info.email_button}

              </a>

            </div>



            <!-- LOKASI -->
            <div class="bg-white rounded-3xl p-7 shadow-md border border-gray-100">

              <div class="flex items-start gap-4">

                <div class="w-12 h-12 shrink-0 rounded-2xl bg-yellow-100 flex items-center justify-center">

                  <i class="fas fa-location-dot text-yellow-600 text-xl"></i>

                </div>


                <div>

                  <p class="text-sm text-gray-500 mb-1">
                    {info.alamat_label}
                  </p>


                  <h4 class="font-bold text-blue-900 mb-1">
                    {info.nama_instansi}
                  </h4>


                  <p class="text-sm text-gray-600 leading-relaxed">
                    {info.alamat}
                  </p>

                </div>

              </div>

            </div>

          </div>

        </div>



        <!-- CTA -->
        <div class="max-w-6xl mx-auto mt-8">

          <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-blue-700 to-blue-900 p-7 md:p-8 text-white shadow-lg">


            <div class="absolute -right-10 -top-10 w-40 h-40 rounded-full bg-white/10"></div>

            <div class="absolute -right-20 -bottom-20 w-52 h-52 rounded-full bg-white/5"></div>


            <div class="relative flex flex-col md:flex-row md:items-center md:justify-between gap-6">


              <div class="flex items-start gap-4">

                <div class="hidden sm:flex w-12 h-12 shrink-0 rounded-2xl bg-yellow-400 text-blue-900 items-center justify-center">

                  <i class="fas fa-circle-question text-xl"></i>

                </div>


                <div>

                  <h3 class="text-xl font-bold mb-1">
                    {info.cta_judul}
                  </h3>


                  <p class="text-blue-100 text-sm">
                    {info.cta_deskripsi}
                  </p>

                </div>

              </div>


              <a
                href={info.cta_link || "#"}
                class="shrink-0 inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-yellow-400 text-blue-900 font-bold hover:bg-yellow-300 transition shadow-md"
              >

                {info.cta_button}

                <i class="fas fa-arrow-right"></i>

              </a>

            </div>

          </div>

        </div>

      </div>

    </section>
  )
}
  <footer />
    </main>
<script is:inline>
            function showFrame(type) {
            if(type === 'ssw') {
                document.getElementById('ssw-frame').style.display = 'block';
                document.getElementById('oss-frame').style.display = 'none';
                
                // Update button style
                document.getElementById('btn-ssw').className = 'px-4 py-2 bg-blue-600 text-white rounded-lg font-medium';
                document.getElementById('btn-oss').className = 'px-4 py-2 bg-gray-200 text-gray-700 rounded-lg font-medium hover:bg-gray-300';
                
                // Update link text
                document.getElementById('link-text').textContent = 'SSW: Surabaya Single Window';
            } 
            else if(type === 'oss') {
                document.getElementById('oss-frame').style.display = 'block';
                document.getElementById('ssw-frame').style.display = 'none';
                
                // Update button style
                document.getElementById('btn-oss').className = 'px-4 py-2 bg-blue-600 text-white rounded-lg font-medium';
                document.getElementById('btn-ssw').className = 'px-4 py-2 bg-gray-200 text-gray-700 rounded-lg font-medium hover:bg-gray-300';
                
                // Update link text
                document.getElementById('link-text').textContent = 'OSS: Online Single Submission';
            }
        }
</script>
</MainLayout>
