---
import { MEDIA_BASE_URL } from "../lib/media";
import MainLayout from "../layouts/MainLayout.astro";
import "@dpmptsp/ui/styles/global.css";
import { isRenderTemplateResult } from "astro/runtime/server/render/astro/render-template.js";
import { getAboutContent } from "../lib/services/content.service";

export const prerender = false;

// Data access lives in src/lib/services.
const { tentangdp, slider, tabs, dbError } = await getAboutContent();

const ICON_MAP = {
  sambutan: "fas fa-microphone",
  visi_misi: "fas fa-bullseye",
  budaya_pelayanan: "fas fa-handshake",
  motto_pelayanan: "fas fa-quote-right",
  maklumat_pelayanan: "fas fa-scroll",
  kompensasi_layanan: "fas fa-hand-holding-usd",
  ikm: "far fa-smile",
  zona_integritas: "fas fa-shield-alt",
  struktur_organisasi: "fas fa-sitemap",
};

---

<MainLayout title="DPMPTSP Kota Surabaya">

    <!-- Content -->
    <main class="min-h-screen bg-gray-50">
   
        <section class="relative overflow-hidden gradient-flow bg-gradient-to-r from-blue-800 via-blue-700 to-blue-600">
            <div class="absolute inset-0 z-0">
                <div class="absolute top-0 right-0 w-64 h-64 bg-yellow-400 rounded-full opacity-10 -translate-y-32 translate-x-32 animate-pulse-soft"></div>
                <div class="absolute bottom-0 left-0 w-96 h-96 bg-blue-600 rounded-full opacity-10 -translate-x-64 translate-y-64 animate-pulse-soft"></div>
                <div class="absolute top-1/2 left-1/4 w-48 h-48 bg-white rounded-full opacity-5 animate-float-subtle"></div>
            </div>
            <div class="container mx-auto px-4 py-20 relative z-10">
                <div class="text-center text-white animate-fade-in-scale">
                    <h1 class="text-5xl md:text-6xl font-bold mb-6 animate-text-reveal">
                        Tentang DPM-PTSP Surabaya
                    </h1>
                    <p class="text-xl opacity-90 max-w-3xl mx-auto animate-slide-in-left">
                        Informasi Visi Misi Sambutan Maklumat dan Organisasi
                    </p>
                    <div class="mt-8 flex justify-center">
                        <div class="animate-bounce-soft">
                            <i class="fas fa-chevron-down text-2xl text-yellow-400"></i>
                        </div>
                    </div>
                </div>
            </div>
        </section>


        <section id="gambar-sec" class="py-16 bg-white">
            <div class="container mx-auto px-4">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
                    <div class="animate-fadeInUp">
                        <h2 class="text-3xl font-bold text-blue-800 mb-6">{tentangdp.find(t => t.tipe === 'judul')?.konten}</h2>
                    
            {tentangdp
            .filter(t => t.tipe === 'paragraf')
            .map(p => (
                <p class="text-gray-700 text-justify mb-6" set:html={p.konten} />
            ))}
                    </div>

                    <div class="relative animate-fadeInUp">
                        <!-- Main container with blue basket effect -->
                        <div class="relative bg-gradient-to-br from-blue-600 via-blue-700 to-blue-800 p-6 rounded-3xl shadow-2xl shadow-blue-900/30 transform transition-all duration-500 hover:scale-105">
                            <!-- Basket weave pattern -->
                            <div class="absolute inset-0 rounded-3xl overflow-hidden">
                                <div class="absolute w-full h-2 bg-blue-500/30 top-4 left-0"></div>
                                <div class="absolute w-full h-2 bg-blue-500/30 top-10 left-0"></div>
                                <div class="absolute w-full h-2 bg-blue-500/30 top-16 left-0"></div>
                                <div class="absolute w-full h-2 bg-blue-500/30 top-22 left-0"></div>
                                <div class="absolute w-2 h-full bg-blue-500/30 left-4 top-0"></div>
                                <div class="absolute w-2 h-full bg-blue-500/30 left-10 top-0"></div>
                                <div class="absolute w-2 h-full bg-blue-500/30 left-16 top-0"></div>
                                <div class="absolute w-2 h-full bg-blue-500/30 left-22 top-0"></div>
                            </div>
                            
                            <!-- Photo gallery with floating effect -->
                            <div class="relative h-96 flex items-center justify-center">
                                <!-- Main highlighted photo slideshow (center) -->
                                <div class="relative z-30 transform transition-all duration-700 hover:scale-110 animate-float">
                                    <div class="bg-white p-2 rounded-xl shadow-2xl">
                                        <div id="main-slideshow" class="relative w-64 h-48 overflow-hidden rounded-lg">
                                            {slider.map(item => (
                                                <!-- Slide 1 - Active -->
                                                <div class="main-slide absolute inset-0 transition-opacity duration-1000 opacity-100" data-index="0">
                                                    <img src={item.gambar} alt={item.judul}class="w-full h-full object-cover" />
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- Floating fingers (left side) -->
                                <div class="absolute left-4 top-8 z-20 animate-float-delay-1">
                                    <div class="bg-white p-1.5 rounded-lg shadow-lg transform -rotate-6 cursor-pointer hover:scale-105 transition-transform duration-300" onclick="showSlideByIndex(0)">
                                        <img 
                                            src="https://asset.kompas.com/crops/6q-7FSxzfAMHFktDmzCzVP_2LqE=/0x0:780x520/375x240/data/photo/2024/04/05/660fc824b8d72.jpg" 
                                            alt="Pelayanan Publik"
                                            class="w-32 h-24 object-cover rounded-md"
                                            data-slide-index="0"
                                        >
                                    </div>
                                </div>

                                <div class="absolute left-8 bottom-8 z-20 animate-float-delay-2">
                                    <div class="bg-white p-1.5 rounded-lg shadow-lg transform rotate-3 cursor-pointer hover:scale-105 transition-transform duration-300" onclick="showSlideByIndex(1)">
                                        <img 
                                            src="https://www.menpan.go.id/site/images/berita_foto_backup/2022/20221005_-_Kunjungan_ke_Balai_Kota_dan_MPP_Kota_Surabaya_7.jpeg" 
                                            alt="Investasi Surabaya"
                                            class="w-28 h-20 object-cover rounded-md"
                                            data-slide-index="1"
                                        >
                                    </div>
                                </div>

                                <!-- Floating fingers (right side) -->
                                <div class="absolute right-4 top-8 z-20 animate-float-delay-3">
                                    <div class="bg-white p-1.5 rounded-lg shadow-lg transform rotate-6 cursor-pointer hover:scale-105 transition-transform duration-300" onclick="showSlideByIndex(2)">
                                        <img 
                                            src="https://static.promediateknologi.id/crop/0x0:0x0/0x0/webp/photo/sapanusa/2023/07/IMG_20230331_134644.jpg" 
                                            alt="Teknologi Informasi"
                                            class="w-32 h-24 object-cover rounded-md"
                                            data-slide-index="2"
                                        >
                                    </div>
                                </div>

                                <div class="absolute right-8 bottom-8 z-20 animate-float-delay-4">
                                    <div class="bg-white p-1.5 rounded-lg shadow-lg transform -rotate-3 cursor-pointer hover:scale-105 transition-transform duration-300" onclick="showSlideByIndex(3)">
                                        <img 
                                            src="https://pdiperjuangan-jatim.com/wp-content/uploads/2024/05/PDIP-Jatim-Eri-Cahyadi-22052024.jpg" 
                                            alt="Perizinan Digital"
                                            class="w-28 h-20 object-cover rounded-md"
                                            data-slide-index="3"
                                        >
                                    </div>
                                </div>
                            
                            <!-- Floating icons -->
                            <div class="absolute -top-12 -left-12 w-16 h-16 bg-yellow-400 rounded-full flex items-center justify-center shadow-2xl z-40">
                                <i class="fas fa-dollar-sign text-blue-800 text-2xl"></i>
                            </div>
                            
                            <div class="absolute -top-12 -right-12 w-20 h-20 bg-white rounded-full flex items-center justify-center shadow-2xl animate-spin-slow z-40">
                                <div class="w-16 h-16 bg-red-600 rounded-full flex items-center justify-center">
                                    <span class="text-white font-bold text-sm">SBY</span>
                                </div>
                            </div>
                            
                            <div class="absolute -bottom-14 left-1/4 w-14 h-14 bg-yellow-400 rounded-full flex items-center justify-center shadow-2xl z-40">
                                <i class="fu fu fa fa-building text-blue-700 text-xl"></i>
                            </div>
                            
                            <div class="absolute -bottom-14 right-1/4 w-14 h-14 bg-yellow-400 rounded-full flex items-center justify-center shadow-2xl z-40">
                                <i class="fas fa-chart-line text-blue-700 text-lg"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>


        <!-- Tab Navigation Section -->
<section class="py-20 bg-gradient-to-b from-gray-50 to-white">
  <div class="container mx-auto px-4">

    <!-- HEADER -->
    <div class="text-center mb-16">
      <h2 class="text-4xl font-bold text-blue-800 mb-6">
        Visi Misi Sambutan Tim Organisasi
      </h2>
      <p class="text-gray-600 max-w-2xl mx-auto text-lg">
        Informasi lengkap tentang organisasi, visi misi, dan pelayanan
        DPMPTSP Kota Surabaya
      </p>
    </div>

    {dbError && (
      <p class="text-center text-red-600 font-semibold">
        ⚠️ Gagal memuat data
      </p>
    )}

    {!dbError && tabs.length > 0 && (
      <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">

        <!-- ================= SIDEBAR ================= -->
        <aside class="bg-white rounded-2xl shadow-custom p-6 sticky top-24 h-fit">

          <div class="flex items-center mb-6">
            <div class="w-10 h-10 bg-blue-600 text-white rounded-full flex items-center justify-center mr-3">
              <i class="fas fa-bars"></i>
            </div>
            <h3 class="text-lg font-bold text-blue-800">
              Menu Informasi
            </h3>
          </div>

          <div class="space-y-2 max-h-[500px] overflow-y-auto">
            {tabs.map((t, i) => (
              <button
                class={`tab-btn w-full flex items-center gap-3 px-4 py-3 rounded-xl font-medium transition-all duration-300
                  ${i === 0
                    ? "bg-blue-600 text-white shadow-lg"
                    : "bg-gray-100 text-gray-700 hover:bg-blue-50 hover:translate-x-1 hover:shadow"
                  }`}
                data-tab={t.tags}
              >
                <div
                  class={`w-9 h-9 rounded-full flex items-center justify-center text-sm
                    ${i === 0
                      ? "bg-white text-blue-600"
                      : "bg-blue-100 text-blue-600"
                    }`}
                >
                 <i class={ICON_MAP[t.tags] || "fas fa-circle"}></i>

                </div>

                <span>{t.Nama_Konten}</span>
              </button>
            ))}
          </div>
        </aside>

        <!-- ================= CONTENT ================= -->
        <div class="lg:col-span-3 space-y-6">

          {tabs.map((t, i) => (
            <div
              id={t.tags}
              class={`tab-content ${i === 0 ? "block" : "hidden"}`}
            >
              <div class="bg-white rounded-2xl shadow-custom p-8">

                <!-- HEADER KONTEN -->
                <div class="flex items-center mb-8">
                  <div
                    class={`w-14 h-14 rounded-full flex items-center justify-center mr-4 shadow-lg
                      ${t.Warna === "yellow"
                        ? "bg-yellow-400 text-blue-800"
                        : t.Warna === "green"
                        ? "bg-green-500 text-white"
                        : "bg-blue-600 text-white"
                      }`}
                  >
                    <i class={`${t.Icon || "fas fa-info"} text-xl`}></i>
                  </div>

                  <div>
                    <h3 class="text-3xl font-bold text-blue-800">
                      {t.Judul_Konten}
                    </h3>
                    {t.Keterangan && (
                      <p class="text-gray-600">{t.Keterangan}</p>
                    )}
                  </div>
                </div>

                <!-- ISI -->
                {t.Isi_Konten && (
                  <div class="bg-gradient-to-r from-blue-50 to-yellow-50 p-8 rounded-2xl border-l-4 border-blue-600">
                    <div
                      class="prose max-w-none text-gray-700"
                      set:html={t.Isi_Konten}
                    />
                  </div>
                )}

                <!-- IMAGE -->
                {t.Foto_Konten && (
                  <div class="flex justify-center mt-10">
                    <div class="relative overflow-hidden rounded-xl cursor-zoom-in group">
                      <img
                        src={`${MEDIA_BASE_URL}/tentangfile/${t.Foto_Konten}`}
                        alt={t.Judul_Konten}
                        class="max-w-96 rounded-xl shadow-lg border-4 border-white transition duration-300 group-hover:scale-105"
                        loading="lazy"
                      />
                      <div class="absolute top-4 right-4 bg-blue-600 text-white p-2 rounded-full shadow">
                        <i class="fas fa-search-plus"></i>
                      </div>
                    </div>
                  </div>
                )}

              </div>
            </div>
          ))}

        </div>
      </div>
    )}
  </div>
</section>

        <!-- FAQ Section dengan animasi baru -->
        <section id="kontak-sec" class="py-20 bg-gradient-to-b from-white to-blue-50">
            <div class="container mx-auto px-4">
                <div class="text-center mb-16 animate-scale-in">
                    <div class="inline-block mb-6">
                        <span class="text-sm font-semibold text-blue-600 bg-blue-50 px-4 py-2 rounded-full ">
                            Bantuan & Dukungan
                        </span>
                    </div>
                    <h2 class="text-4xl font-bold text-blue-800 mb-6 animate-text-shadow">
                        Frequently Asked Questions (FAQ)
                    </h2>
                    <p class="text-gray-600 max-w-2xl mx-auto text-lg animate-fade-up">
                        Pertanyaan yang sering diajukan seputar pelayanan DPM-PTSP Surabaya
                    </p>
                </div>
                
                <div class="max-w-4xl mx-auto">
                    <!-- FAQ 1 -->
                    <div class="mb-6 animate-fade-up delay-1">
                        <button class="accordion-button w-full text-left bg-gradient-to-r from-blue-50 to-gray-50 hover:from-blue-100 hover:to-gray-100 p-8 rounded-2xl flex justify-between items-center card-lift ripple" data-target="faq1">
                            <div class="flex items-center">
                                <div class="w-10 h-10 bg-blue-600 rounded-full flex items-center justify-center mr-4 animate-pulse-soft">
                                    <i class="fas fa-question text-white"></i>
                                </div>
                                <span class="font-bold text-blue-800 text-xl">Bagaimanakah proses agar mendapatkan NIB?</span>
                            </div>
                            <i class="fas fa-chevron-down text-blue-600 text-xl transition-transform duration-300 animate-bounce-soft"></i>
                        </button>
                        <div id="faq1" class="accordion-content hidden bg-white p-8 rounded-b-2xl border border-gray-200 animate-fold-unfold">
                            <ul class="space-y-4 text-gray-700">
                                <li class="flex items-start animate-fade-up delay-1">
                                    <div class="w-6 h-6 bg-green-100 rounded-full flex items-center justify-center mr-3 mt-1 animate-pulse-soft">
                                        <i class="fas fa-check text-green-600 text-sm"></i>
                                    </div>
                                    <span>Login / masuk ke oss.go.id</span>
                                </li>
                                <li class="flex items-start animate-fade-up delay-2">
                                    <div class="w-6 h-6 bg-green-100 rounded-full flex items-center justify-center mr-3 mt-1 animate-pulse-soft">
                                        <i class="fas fa-check text-green-600 text-sm"></i>
                                    </div>
                                    <span>Membuat akun OSS dengan cara klik daftar pada halaman oss.go.id</span>
                                </li>
                                <li class="flex items-start animate-fade-up delay-3">
                                    <div class="w-6 h-6 bg-green-100 rounded-full flex items-center justify-center mr-3 mt-1 animate-pulse-soft">
                                        <i class="fas fa-check text-green-600 text-sm"></i>
                                    </div>
                                    <span>Menyiapkan data pelaku usaha untuk dimasukkan pada Form Registrasi</span>
                                </li>
                                <li class="flex items-start animate-fade-up delay-4">
                                    <div class="w-6 h-6 bg-green-100 rounded-full flex items-center justify-center mr-3 mt-1 animate-pulse-soft">
                                        <i class="fas fa-check text-green-600 text-sm"></i>
                                    </div>
                                    <span>Setelah aktivasi masuk di inbox email maka klik aktivasi dan cek kembali inbox</span>
                                </li>
                                <li class="flex items-start animate-fade-up delay-5">
                                    <div class="w-6 h-6 bg-green-100 rounded-full flex items-center justify-center mr-3 mt-1 animate-pulse-soft">
                                        <i class="fas fa-check text-green-600 text-sm"></i>
                                    </div>
                                    <span>Gunakan User Id dan Password tersebut untuk masuk dalam sistem OSS</span>
                                </li>
                            </ul>
                        </div>
                    </div>
                    
                    <!-- FAQ 2 -->
                    <div class="mb-6 animate-fade-up delay-2">
                        <button class="accordion-button w-full text-left bg-gradient-to-r from-blue-50 to-gray-50 hover:from-blue-100 hover:to-gray-100 p-8 rounded-2xl flex justify-between items-center card-lift ripple" data-target="faq2">
                            <div class="flex items-center">
                                <div class="w-10 h-10 bg-yellow-400 rounded-full flex items-center justify-center mr-4 animate-pulse-soft">
                                    <i class="fas fa-file-contract text-blue-800"></i>
                                </div>
                                <span class="font-bold text-blue-800 text-xl">Apa kegunaan NIB?</span>
                            </div>
                            <i class="fas fa-chevron-down text-blue-600 text-xl transition-transform duration-300 animate-bounce-soft"></i>
                        </button>
                        <div id="faq2" class="accordion-content hidden bg-white p-8 rounded-b-2xl border border-gray-200 animate-fold-unfold">
                            <ul class="space-y-4 text-gray-700">
                                <li class="flex items-start animate-fade-up delay-1">
                                    <div class="w-6 h-6 bg-blue-100 rounded-full flex items-center justify-center mr-3 mt-1 animate-pulse-soft">
                                        <i class="fas fa-file-contract text-blue-600 text-sm"></i>
                                    </div>
                                    <span>Sesuai dengan peraturan pemerintah no 5 Tahun 2021 bahwa perizinan berusaha seluruh Kabupaten/Kota di Indonesia menggunakan NIB oss.go.id</span>
                                </li>
                                <li class="flex items-start animate-fade-up delay-2">
                                    <div class="w-6 h-6 bg-blue-100 rounded-full flex items-center justify-center mr-3 mt-1 animate-pulse-soft">
                                        <i class="fas fa-file-contract text-blue-600 text-sm"></i>
                                    </div>
                                    <span>Sesuai dengan perwali no 41 Tahun 2021 TDP (Tanda Daftar Perusahaan) dan Izin usaha lainnya (perhubungan, real estate, perdagangan, industri, dll) menggunakan satu pintu yaitu portal oss.go.id</span>
                                </li>
                                <li class="flex items-start animate-fade-up delay-3">
                                    <div class="w-6 h-6 bg-blue-100 rounded-full flex items-center justify-center mr-3 mt-1 animate-pulse-soft">
                                        <i class="fas fa-file-contract text-blue-600 text-sm"></i>
                                    </div>
                                    <span>Hak akses kepabeanan sebagaimana dimaksud dalam peraturan perundang-undangan di bidang kepabeanan</span>
                                </li>
                            </ul>
                        </div>
                    </div>
                    
                    <!-- FAQ 3 -->
                    <div class="mb-6 animate-fade-up delay-3">
                        <button class="accordion-button w-full text-left bg-gradient-to-r from-blue-50 to-gray-50 hover:from-blue-100 hover:to-gray-100 p-8 rounded-2xl flex justify-between items-center card-lift ripple" data-target="faq3">
                            <div class="flex items-center">
                                <div class="w-10 h-10 bg-green-500 rounded-full flex items-center justify-center mr-4 animate-pulse-soft">
                                    <i class="fas fa-handshake-angle text-white"></i>
                                </div>
                                <span class="font-bold text-blue-800 text-xl">Dimanakah saya dapat meminta bantuan untuk mengakses NIB?</span>
                            </div>
                            <i class="fas fa-chevron-down text-blue-600 text-xl transition-transform duration-300 animate-bounce-soft"></i>
                        </button>
                        <div id="faq3" class="accordion-content hidden bg-white p-8 rounded-b-2xl border border-gray-200 animate-fold-unfold">
                            <p class="text-gray-700 mb-6 animate-fade-up">
                                Pemohon berhak mendapatkan fasilitas layanan bantuan berupa pendampingan OSS di Kantor DPMPTSP Kota Surabaya (Klinik Investasi) atau Pendampingan OSS di Gedung Siola Lantai 1 (Mall Pelayanan Publik) DPMPTSP Kota Surabaya. Pemohon perlu membawa Kartu Identitas berupa KTP (untuk WNI) atau Passpor (untuk WNA) serta dokumen-dokumen perusahaan pendukung lainnya.
                            </p>
                            <div class="mt-6 p-6 bg-gradient-to-r from-yellow-50 to-yellow-100 rounded-xl border-l-4 border-yellow-500 animate-fade-up delay-2">
                                <div class="flex items-center">
                                    <i class="fas fa-map-marker-alt text-yellow-500 text-2xl mr-4 animate-pulse-soft"></i>
                                    <div>
                                        <p class="font-medium text-blue-800 text-lg">📍 Lokasi Layanan</p>
                                        <p class="text-gray-700">Mal Pelayanan Publik Lt.3, Jl. Tunjungan No. 1-3 Genteng, Surabaya</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- FAQ 4 -->
                    <div class="mb-6 animate-fade-up delay-4">
                        <button class="accordion-button w-full text-left bg-gradient-to-r from-blue-50 to-gray-50 hover:from-blue-100 hover:to-gray-100 p-8 rounded-2xl flex justify-between items-center card-lift ripple" data-target="faq4">
                            <div class="flex items-center">
                                <div class="w-10 h-10 bg-red-500 rounded-full flex items-center justify-center mr-4 animate-pulse-soft">
                                    <i class="fas fa-headset text-white"></i>
                                </div>
                                <span class="font-bold text-blue-800 text-xl">Bagaimana jika saya menghadapi kendala saat melakukan perizinan online?</span>
                            </div>
                            <i class="fas fa-chevron-down text-blue-600 text-xl transition-transform duration-300 animate-bounce-soft"></i>
                        </button>
                        <div id="faq4" class="accordion-content hidden bg-white p-8 rounded-b-2xl border border-gray-200 animate-fold-unfold">
                            <p class="text-gray-700 mb-6 animate-fade-up">
                                Anda dapat menghubungi kami melalui berbagai saluran yang tersedia:
                            </p>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6 stagger-children">
                                <div class="bg-gradient-to-r from-blue-50 to-blue-100 p-6 rounded-xl card-lift">
                                    <div class="flex items-center mb-4">
                                        <div class="w-12 h-12 bg-blue-600 rounded-full flex items-center justify-center mr-4 animate-pulse-soft">
                                            <i class="fas fa-phone text-white text-xl"></i>
                                        </div>
                                        <div>
                                            <h4 class="font-bold text-blue-800">Telepon</h4>
                                            <p class="text-gray-700 text-lg font-semibold">+62 (031) 99243924</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="bg-gradient-to-r from-yellow-50 to-yellow-100 p-6 rounded-xl card-lift">
                                    <div class="flex items-center mb-4">
                                        <div class="w-12 h-12 bg-yellow-400 rounded-full flex items-center justify-center mr-4 animate-pulse-soft">
                                            <i class="fas fa-envelope text-blue-800 text-xl"></i>
                                        </div>
                                        <div>
                                            <h4 class="font-bold text-blue-800">Email</h4>
                                            <p class="text-gray-700 text-lg font-semibold">dpm-ptsp@surabaya.go.id</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="p-6 bg-gradient-to-r from-green-50 to-green-100 rounded-xl border-l-4 border-green-500 animate-fade-up delay-2">
                                <div class="flex items-center">
