---
import { uploadUrl } from "../lib/media";
import MainLayout from "../layouts/MainLayout.astro";
import { getPhotoPage } from "../lib/services/content.service";

export const prerender = false;

const url = new URL(Astro.request.url);
const limit = 8;
const result = await getPhotoPage(url.searchParams.get("page"), limit);

const rows = result.items;
const totalItems = result.total;
const totalPages = result.totalPages;
const page = result.page;

const getLink = (p) => {
  const up = new URLSearchParams(url.searchParams);
  up.set("page", String(p));
  return `?${up.toString()}`;
};
---

<MainLayout title="Tempat Pelayanan | DPMPTSP">

  <!-- HERO -->
  <div class="relative bg-slate-900 pt-20 pb-32 overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-0 left-0 w-72 h-72 bg-blue-500 rounded-full blur-3xl animate-blob"></div>
      <div class="absolute bottom-0 right-0 w-72 h-72 bg-indigo-500 rounded-full blur-3xl animate-blob animation-delay-2000"></div>
    </div>

    <div class="relative container mx-auto px-6 text-center">
      <h1 class="text-4xl md:text-6xl font-black text-white mb-4">
        Tempat <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-emerald-400">Pelayanan</span>
      </h1>
      <p class="text-slate-400 max-w-xl mx-auto">
        Lokasi pelayanan DPMPTSP Kota Surabaya untuk memudahkan masyarakat dan investor.
      </p>
    </div>
  </div>

  <!-- CONTENT -->
  <main class="container mx-auto px-6 py-20 -mt-16 relative z-10">

    <!-- INFO -->
    <div class="mb-10 text-sm text-slate-500">
      Menampilkan <b class="text-slate-900">{rows.length}</b> dari 
      <b class="text-slate-900">{totalItems}</b> lokasi
    </div>

    <!-- EMPTY -->
    {rows.length === 0 && (
      <div class="text-center py-32">
        <h3 class="text-xl font-bold text-slate-800">Tidak ada data</h3>
        <p class="text-slate-500 mt-2">Belum ada lokasi pelayanan tersedia.</p>
      </div>
    )}

    <!-- GRID -->
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-8">

      {rows.map(item => (
        <div class="group">

          <div class="bg-white/80 backdrop-blur-xl rounded-3xl overflow-hidden shadow-sm hover:shadow-2xl transition-all duration-500">

            <!-- IMAGE -->
            <div class="relative aspect-[4/3] overflow-hidden">
              <img
                src={uploadUrl(item.image_path, '/no-image.jpg')}
                alt={item.alt_text || item.title}
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-110 transition duration-700"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition"></div>
            </div>

            <!-- CONTENT -->
            <div class="p-5">

              <!-- LOCATION BADGE -->
              <span class="inline-block text-[10px] px-3 py-1 bg-blue-100 text-blue-600 rounded-full font-semibold mb-2">
                {item.location}
              </span>

              <!-- TITLE -->
              <h3 class="font-bold text-lg text-slate-800 mb-2 line-clamp-2">
                {item.title}
              </h3>

              <!-- ALAMAT -->
              <p class="text-xs text-slate-500 line-clamp-3">
                {item.alamat}
              </p>

              <!-- TANGGAL -->
              <div class="mt-4 text-[10px] text-slate-400">
                {new Date(item.created_at).toLocaleDateString('id-ID', {
                  day: 'numeric',
                  month: 'short',
                  year: 'numeric'
                })}
              </div>

            </div>

          </div>

        </div>
      ))}

    </div>

    <!-- PAGINATION -->
    {totalPages > 1 && (
      <div class="mt-20 flex justify-center gap-2">

        <!-- PREV -->
        <a href={page > 1 ? getLink(page - 1) : "#"}
           class={`px-4 py-2 rounded-xl border ${page <= 1 ? 'opacity-30 pointer-events-none' : 'hover:bg-slate-900 hover:text-white'}`}>
          Prev
        </a>

        <!-- NUMBER -->
        {Array.from({ length: totalPages }, (_, i) => i + 1)
          .filter(p => p === 1 || p === totalPages || Math.abs(p - page) <= 1)
          .map((p, i, arr) => (
            <>
              {i > 0 && arr[i-1] !== p - 1 && <span class="px-2">...</span>}
              <a href={getLink(p)}
                 class={`px-4 py-2 rounded-xl ${page === p ? 'bg-blue-600 text-white' : 'bg-slate-100'}`}>
                {p}
              </a>
            </>
        ))}

        <!-- NEXT -->
        <a href={page < totalPages ? getLink(page + 1) : "#"}
           class={`px-4 py-2 rounded-xl border ${page >= totalPages ? 'opacity-30 pointer-events-none' : 'hover:bg-slate-900 hover:text-white'}`}>
          Next
        </a>

      </div>
    )}

  </main>

</MainLayout>

<style>
@keyframes blob {
  0% { transform: translate(0px, 0px) scale(1); }
  33% { transform: translate(30px, -50px) scale(1.1); }
  66% { transform: translate(-20px, 20px) scale(0.9); }
  100% { transform: translate(0px, 0px) scale(1); }
}
.animate-blob {
  animation: blob 7s infinite;
}
.animation-delay-2000 {
  animation-delay: 2s;
}
</style>