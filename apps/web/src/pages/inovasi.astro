];

const totalInovasi = inovasi.length;

const totalDigital = inovasi.filter(
  (item) => item.jenis === "Digital"
).length;

const totalInvestasi = inovasi.filter(
  (item) => item.kategori === "Investasi"
).length;

const totalPerizinan = inovasi.filter(
  (item) => item.kategori === "Perizinan"
).length;
---

<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8" />

  <title>Inovasi Pelayanan | DPMPTSP Kota Surabaya</title>

  <meta
    name="description"
    content="Inovasi pelayanan publik DPMPTSP Kota Surabaya."
  />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1"
  />

  <meta name="theme-color" content="#1d4ed8" />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
  />
</head>

<body>

  <Header />

  <main>

    <!-- =================================================
         HERO
    ================================================== -->

    <section class="innovation-hero">

      <div class="hero-decoration hero-decoration-1"></div>
      <div class="hero-decoration hero-decoration-2"></div>

      <div class="container">

        <div class="hero-inner">

          <div class="hero-badge">
            <i class="fa-solid fa-lightbulb"></i>
            INOVASI PELAYANAN PUBLIK
          </div>

          <h1>
            Inovasi Layanan
            <span>DPMPTSP Surabaya</span>
          </h1>

          <p>
            Berbagai terobosan pelayanan untuk menghadirkan
            pelayanan publik yang lebih mudah, cepat,
            transparan dan dekat dengan masyarakat.
          </p>

          <div class="hero-buttons">

            <a
              href="#daftar-inovasi"
              class="hero-btn hero-btn-primary"
            >
              <i class="fa-solid fa-rocket"></i>
              Jelajahi Inovasi
            </a>

            <a
              href="#cari-layanan"
              class="hero-btn hero-btn-outline"
            >
              <i class="fa-solid fa-magnifying-glass"></i>
              Cari Layanan
            </a>

          </div>

        </div>

      </div>

    </section>


    <!-- =================================================
         STATISTIK
    ================================================== -->

    <section class="statistics">

      <div class="container">

        <div class="statistics-grid">

          <div class="statistics-card">

            <div class="statistics-icon blue">
              <i class="fa-solid fa-lightbulb"></i>
            </div>

            <div>
              <strong>{totalInovasi}+</strong>
              <span>Inovasi Layanan</span>
            </div>

          </div>


          <div class="statistics-card">

            <div class="statistics-icon green">
              <i class="fa-solid fa-globe"></i>
            </div>

            <div>
              <strong>{totalDigital}</strong>
              <span>Layanan Digital</span>
            </div>

          </div>


          <div class="statistics-card">

            <div class="statistics-icon orange">
              <i class="fa-solid fa-chart-line"></i>
            </div>

            <div>
              <strong>{totalInvestasi}</strong>
              <span>Layanan Investasi</span>
            </div>

          </div>


          <div class="statistics-card">

            <div class="statistics-icon purple">
              <i class="fa-solid fa-file-circle-check"></i>
            </div>

            <div>
              <strong>{totalPerizinan}</strong>
              <span>Layanan Perizinan</span>
            </div>

          </div>

        </div>

      </div>

    </section>


    <!-- =================================================
         SEARCH
    ================================================== -->

    <section
      id="cari-layanan"
      class="search-section"
    >

      <div class="container">

        <div class="search-panel">

          <div class="search-title">

            <div class="search-title-icon">
              <i class="fa-solid fa-magnifying-glass"></i>
            </div>

            <div>

              <h2>
                Cari Layanan yang Anda Butuhkan
              </h2>

              <p>
                Cari berdasarkan nama inovasi,
                kategori atau jenis layanan.
              </p>

            </div>

          </div>


          <div class="search-input">

            <i class="fa-solid fa-search"></i>

            <input
              id="searchInput"
              type="search"
              placeholder="Contoh: izin usaha, pengaduan, investasi..."
              autocomplete="off"
            />

            <button
              type="button"
              id="clearSearch"
              aria-label="Hapus pencarian"
            >
              <i class="fa-solid fa-xmark"></i>
            </button>

          </div>

        </div>

      </div>

    </section>


    <!-- =================================================
         DAFTAR INOVASI
    ================================================== -->

    <section
      id="daftar-inovasi"
      class="innovation-section"
    >

      <div class="container">

        <div class="section-header">

          <div>

            <span class="section-kicker">
              <i class="fa-solid fa-star"></i>
              INOVASI UNGGULAN
            </span>

            <h2>
              Jelajahi Inovasi
              <span>Layanan</span>
            </h2>

          </div>

          <p>
            Temukan berbagai inovasi yang dirancang
            untuk memberikan pengalaman pelayanan
            yang lebih baik.
          </p>

        </div>


        <!-- FILTER -->

        <div class="filter-row">

          <div class="filters">

            {
              categories.map((category, index) => (
                <button
                  type="button"
                  class:list={[
                    "filter-button",
                    { active: index === 0 },
                  ]}
                  data-category={category}
                >
                  {category}
                </button>
              ))
            }

          </div>

          <div class="result-total">
            <span id="resultCount">
              {totalInovasi}
            </span>
            inovasi
          </div>

        </div>


        <!-- GRID -->

        <div
          id="innovationGrid"
          class="innovation-grid"
        >

          {
            inovasi.map((item) => (
              <article
                class="innovation-card"
                data-category={item.kategori}
                data-search={`${item.nama} ${item.singkatan} ${item.kategori} ${item.jenis} ${item.deskripsi}`}
              >

                <div class="card-image">

                  {
                    item.gambar ? (
                      <img
                        src={item.gambar}
                        alt={item.nama}
                        loading="lazy"
                      />
                    ) : (
                      <div
                        class:list={[
                          "card-placeholder",
                          item.warna,
                        ]}
                      >
                        <i class={`fa-solid ${item.icon}`}></i>
                      </div>
                    )
                  }

                  <span class="card-category">
                    {item.kategori}
                  </span>

                  <span class="card-type">
                    {item.jenis}
                  </span>

                </div>


                <div class="card-content">

                  <div class="card-meta">
                    <span>
                      <i class="fa-regular fa-calendar"></i>
                      {item.tahun}
                    </span>
                  </div>

                  <h3>
                    {item.nama}
                  </h3>

                  <div class="card-subtitle">
                    {item.singkatan}
                  </div>

                  <p>
                    {item.deskripsi}
                  </p>


                  <div class="card-bottom">

                    <button
                      type="button"
                      class="detail-button"
                      data-detail={item.slug}
                    >
                      Lihat Detail
                      <i class="fa-solid fa-arrow-right"></i>
                    </button>


                    {
                      item.url && (
                        <a
                          href={item.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="external-button"
                          aria-label={`Buka ${item.nama}`}
                        >
                          <i class="fa-solid fa-arrow-up-right-from-square"></i>
                        </a>
                      )
                    }

                  </div>

                </div>

              </article>
            ))
          }

        </div>


        <!-- EMPTY -->

        <div
          id="emptyState"
          class="empty-state hidden"
        >

          <div class="empty-icon">
            <i class="fa-solid fa-magnifying-glass"></i>
          </div>

          <h3>
            Inovasi Tidak Ditemukan
          </h3>

          <p>
            Coba gunakan kata kunci lain
            atau pilih kategori berbeda.
          </p>

          <button
            type="button"
            id="resetSearch"
          >
            Reset Pencarian
          </button>

        </div>

      </div>

    </section>


    <!-- =================================================
         CTA
    ================================================== -->

    <section class="cta-section">

      <div class="container">

        <div class="cta-box">

          <div class="cta-icon">
            <i class="fa-solid fa-headset"></i>
          </div>

          <div class="cta-content">

            <span>
              MEMBUTUHKAN BANTUAN?
            </span>

            <h2>
              Tidak menemukan layanan yang Anda cari?
            </h2>

            <p>
              Konsultasikan kebutuhan perizinan dan
              pelayanan Anda kepada DPMPTSP Kota Surabaya.
            </p>

          </div>

          <a
            href="/kontak"
            class="cta-button"
          >
            Hubungi Kami
            <i class="fa-solid fa-arrow-right"></i>
          </a>

        </div>

      </div>

    </section>

  </main>


  <!-- =================================================
       MODAL
  ================================================== -->

  <div
    id="innovationModal"
    class="innovation-modal"
    aria-hidden="true"
  >

    <div
      id="modalOverlay"
      class="modal-overlay"
    ></div>


    <div
      class="modal-container"
      role="dialog"
      aria-modal="true"
      aria-labelledby="modalTitle"
    >

      <button
        id="closeModal"
        type="button"
        class="modal-close"
        aria-label="Tutup"
      >
        <i class="fa-solid fa-xmark"></i>
      </button>


      <div
        id="modalScroll"
        class="modal-scroll"
      >

        <div id="modalContent"></div>

      </div>

    </div>

  </div>


  <Footer />


  <!-- =================================================
       JAVASCRIPT
  ================================================== -->

  <script define:vars={{ inovasi }}>

    const searchInput =
      document.getElementById("searchInput");

    const clearSearch =
      document.getElementById("clearSearch");

    const resetSearch =
      document.getElementById("resetSearch");

    const resultCount =
      document.getElementById("resultCount");

    const emptyState =
      document.getElementById("emptyState");

    const cards =
      document.querySelectorAll(".innovation-card");

    const filterButtons =
      document.querySelectorAll(".filter-button");

    const modal =
      document.getElementById("innovationModal");

    const modalContent =
      document.getElementById("modalContent");

    const closeModal =
      document.getElementById("closeModal");

    const modalOverlay =
      document.getElementById("modalOverlay");

    let activeCategory = "Semua";


    /* =================================================
       FILTER
    ================================================= */

    function filterCards() {

      const keyword =
        searchInput.value
          .toLowerCase()
          .trim();

      let visible = 0;

      cards.forEach((card) => {

        const category =
          card.dataset.category || "";

        const text =
          card.dataset.search
            .toLowerCase();

        const categoryMatch =
          activeCategory === "Semua" ||
          category === activeCategory;

        const searchMatch =
          keyword === "" ||
          text.includes(keyword);

        if (categoryMatch && searchMatch) {

          card.classList.remove(
            "hidden-card"
          );

          visible++;

        } else {

          card.classList.add(
            "hidden-card"
          );

        }

      });

      resultCount.textContent =
        visible;

      emptyState.classList.toggle(
        "hidden",
        visible !== 0
      );

    }


    filterButtons.forEach((button) => {

      button.addEventListener(
        "click",
        () => {

          filterButtons.forEach(
            (item) => {
              item.classList.remove("active");
            }
          );

          button.classList.add("active");

          activeCategory =
            button.dataset.category;

          filterCards();

        }
      );

    });


    searchInput.addEventListener(
      "input",
      filterCards
    );


    clearSearch.addEventListener(
      "click",
      () => {

        searchInput.value = "";

        filterCards();

        searchInput.focus();

      }
    );


    resetSearch.addEventListener(
      "click",
      () => {

        searchInput.value = "";

        activeCategory = "Semua";

        filterButtons.forEach(
          (button) => {
            button.classList.remove("active");
          }
        );

        filterButtons[0].classList.add("active");

        filterCards();

      }
    );


    /* =================================================
       ESCAPE HTML
    ================================================= */

    function escapeHtml(value) {

      if (
        value === null ||
        value === undefined
      ) {
        return "";
      }

      return String(value)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");

    }


    /* =================================================
       MODAL
    ================================================= */

    function openModal(slug) {

      const item =
        inovasi.find(
          (data) => data.slug === slug
        );

      if (!item) {
        return;
      }


      let imageHTML = "";

      if (item.gambar) {

        imageHTML = `
          <div class="modal-image">
            <img
              src="${escapeHtml(item.gambar)}"
              alt="${escapeHtml(item.nama)}"
            />
          </div>
        `;

      } else {

        imageHTML = `
          <div class="modal-image">
            <div class="modal-placeholder ${escapeHtml(item.warna)}">
              <i class="fa-solid ${escapeHtml(item.icon)}"></i>
            </div>
          </div>
        `;

      }


      const actionHTML =
        item.url
          ? `
            <div class="modal-actions">

              <a
                href="${escapeHtml(item.url)}"
                target="_blank"
                rel="noopener noreferrer"
                class="modal-action"
              >

                <span class="modal-action-icon">
                  <i class="fa-solid fa-rocket"></i>
                </span>

                <span>
                  ${escapeHtml(
                    item.urlLabel || "Gunakan Layanan"
                  )}
                </span>

                <i class="fa-solid fa-arrow-up-right-from-square"></i>

              </a>

            </div>
          `
          : "";


      modalContent.innerHTML = `

        ${imageHTML}


        <div class="modal-body">

          <div class="modal-heading">

            <div class="modal-tags">

              <span class="modal-tag primary">
                <i class="fa-solid fa-layer-group"></i>
                ${escapeHtml(item.kategori)}
              </span>

              <span class="modal-tag">
                ${escapeHtml(item.jenis)}
              </span>

              <span class="modal-tag">
                <i class="fa-regular fa-calendar"></i>
                ${item.tahun}
              </span>

            </div>


            <h2
              id="modalTitle"
              class="modal-title"
            >
              ${escapeHtml(item.nama)}
            </h2>


            <p class="modal-subtitle">
              ${escapeHtml(item.singkatan || "")}
            </p>

          </div>


          <div class="modal-info main-info">

            <div class="info-icon blue">
              <i class="fa-solid fa-circle-info"></i>
            </div>

            <div>

              <h3>
                Tentang Inovasi
              </h3>

              <p>
                ${escapeHtml(
                  item.deskripsi ||
                  "Informasi belum tersedia."
                )}
              </p>

            </div>

          </div>


          <div class="modal-info">

            <div class="info-icon indigo">
              <i class="fa-solid fa-bullseye"></i>
            </div>

            <div>

              <h3>
                Tujuan
              </h3>

              <p>
                ${escapeHtml(
                  item.tujuan ||
                  "Informasi belum tersedia."
                )}
              </p>

            </div>

          </div>


          <div class="modal-info">

            <div class="info-icon green">
              <i class="fa-solid fa-star"></i>
            </div>

            <div>

              <h3>
                Manfaat
              </h3>

              <p>
                ${escapeHtml(
                  item.manfaat ||
                  "Informasi belum tersedia."
                )}
              </p>

            </div>

          </div>


          <div class="modal-info">

            <div class="info-icon orange">
              <i class="fa-solid fa-chart-line"></i>
            </div>

            <div>

              <h3>
                Hasil / Dampak
              </h3>

              <p>
                ${escapeHtml(
                  item.hasil ||
                  "Informasi hasil belum tersedia."
                )}
              </p>

            </div>

          </div>

        </div>


        ${actionHTML}

      `;


      modal.classList.add("show");

      modal.setAttribute(
        "aria-hidden",
        "false"
      );

      document.body.classList.add(
        "modal-open"
      );


      const modalScroll =
        document.getElementById("modalScroll");

      if (modalScroll) {
        modalScroll.scrollTop = 0;
      }


      setTimeout(() => {
        closeModal.focus();
      }, 50);

    }


    function closeInnovationModal() {

      modal.classList.remove("show");

      modal.setAttribute(
        "aria-hidden",
        "true"
      );

      document.body.classList.remove(
        "modal-open"
      );

    }


    document
      .querySelectorAll(".detail-button")
      .forEach((button) => {

        button.addEventListener(
          "click",
          () => {

            openModal(
              button.dataset.detail
            );

          }
        );

      });


    closeModal.addEventListener(
      "click",
      closeInnovationModal
    );


    modalOverlay.addEventListener(
      "click",
      closeInnovationModal
    );


    document.addEventListener(
      "keydown",
      (event) => {

        if (
          event.key === "Escape" &&
          modal.classList.contains("show")
        ) {

          closeInnovationModal();

        }

      }
    );

  </script>

</body>
