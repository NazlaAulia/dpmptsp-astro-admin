---
import { db } from "../lib/db.js";

/*
|--------------------------------------------------------------------------
| WEBSITE PENGATURAN
|--------------------------------------------------------------------------
*/

const [settingRows] = await db.query(`
  SELECT
    nama,
    logo
  FROM website_pengaturan
  WHERE id = 1
  LIMIT 1
`);

const setting = settingRows?.[0] || {
  nama: "DPM-PTSP Surabaya",
  logo: "https://github.com/arbagasdanangh/pps/blob/main/logo.png?raw=true"
};


/*
|--------------------------------------------------------------------------
| AMBIL SEMUA MENU HEADER DARI DATABASE
|--------------------------------------------------------------------------
*/

const [allMenuRows] = await db.query(`
  SELECT
    id,
    parent_id,
    nama,
    url,
    urutan,
    aktif,
    tipe,
    tombol_kontak
  FROM header_menu
  WHERE aktif = 1
  ORDER BY
    COALESCE(parent_id, 0) ASC,
    urutan ASC,
    id ASC
`);


/*
|--------------------------------------------------------------------------
| BENTUK TREE MENU
|--------------------------------------------------------------------------
*/

const menuMap = new Map();

for (const item of allMenuRows) {

  menuMap.set(Number(item.id), {
    ...item,

    id: Number(item.id),

    parent_id:
      item.parent_id === null ||
      Number(item.parent_id) === 0
        ? null
        : Number(item.parent_id),

    children: []
  });

}


/*
|--------------------------------------------------------------------------
| MASUKKAN CHILD KE PARENT
|--------------------------------------------------------------------------
*/

const menuTree = [];

for (const item of menuMap.values()) {

  if (
    item.parent_id !== null &&
    menuMap.has(item.parent_id)
  ) {

    menuMap
      .get(item.parent_id)
      .children
      .push(item);

  } else {

    menuTree.push(item);

  }

}


/*
|--------------------------------------------------------------------------
| SORT REKURSIF
|--------------------------------------------------------------------------
*/

const sortMenu = (items) => {

  items.sort(
    (a, b) => {

      const urutanA = Number(a.urutan || 0);
      const urutanB = Number(b.urutan || 0);

      if (urutanA !== urutanB) {
        return urutanA - urutanB;
      }

      return Number(a.id || 0) - Number(b.id || 0);

    }
  );


  for (const item of items) {

    if (
      item.children &&
      item.children.length
    ) {

      sortMenu(item.children);

    }

  }

};

sortMenu(menuTree);


/*
|--------------------------------------------------------------------------
| PISAHKAN TOMBOL KONTAK
|--------------------------------------------------------------------------
*/

const contactMenus = menuTree.filter(
  (menu) =>
    Number(menu.tombol_kontak) === 1
);


const navigationMenus = menuTree.filter(
  (menu) =>
    Number(menu.tombol_kontak) !== 1
);

---


<!-- =========================================================
     HEADER
========================================================== -->

<header
  id="site-header"
  class="
    fixed
    top-0
    left-0
    w-full

    z-[9999]

    bg-[#F7F7F7]

    animate-slide-in-left
  "
>

  <div
    class="
      container
      mx-auto

      px-4
      sm:px-6
      md:px-8
    "
  >

    <!-- =====================================================
         HEADER WRAPPER
    ====================================================== -->

    <div
      class="
        flex
        items-center
        justify-between

        py-3
        md:py-4

        relative
      "
    >


      <!-- ===================================================
           LOGO
      ==================================================== -->

      <div
        class="
          flex
          items-center

          z-10
        "
      >

        <a
          href="/"

          class="
            flex
            items-center
            space-x-3

            ripple
          "
        >

          <img
            src={setting.logo}

            alt={setting.nama}

            class="
              h-8
              sm:h-10
              md:h-12

              w-auto

              max-w-[140px]
              sm:max-w-[180px]

              object-contain

              transition
              duration-300

              hover:scale-105
            "
          />

        </a>

      </div>


      <!-- ===================================================
           DESKTOP NAV
      ==================================================== -->

      <nav
        class="
          hidden
          lg:block

          absolute

          left-1/2

          transform
          -translate-x-1/2
        "
      >

        <ul
          class="
            flex
            items-center

            space-x-8

            stagger-children
          "
        >

          {

            navigationMenus.map(
              (menu) => {

                const hasChildren =
                  menu.children &&
                  menu.children.length > 0;


                /*
                |--------------------------------------------------------------------------
                | MENU DROPDOWN
                |--------------------------------------------------------------------------
                */

                if (hasChildren) {

                  return (

                    <li
                      class="
                        relative
                        group
                      "

                      key={menu.id}
                    >

                      <!-- MENU UTAMA -->

                      <a
                        href={
                          menu.url &&
                          menu.url !== "#"
                            ? menu.url
                            : "#"
                        }

                        class="
                          text-gray-700

                          font-semibold

                          hover:text-yellow-400

                          transition
                          duration-300

                          flex
                          items-center

                          whitespace-nowrap

                          animate-pulse-soft
                        "
                      >

                        {menu.nama}

                        <i
                          class="
                            fas
                            fa-chevron-down

                            ml-1

                            text-xs
                          "
                        ></i>

                      </a>


                      <!-- =================================================
                           DROPDOWN
                      ================================================== -->

                      <div
                        class="
                          absolute

                          left-0

                          mt-2

                          w-64

                          bg-white

                          rounded-b-lg

                          translate-y-5

                          shadow-lg

                          opacity-0
                          invisible

                          group-hover:opacity-100
                          group-hover:visible

                          transition-all
                          duration-300

                          z-[9999]

                          animate-drop-in
                        "
                      >

                        {

                          menu.children.map(
                            (child, childIndex) => {

                              const childHasChildren =
                                child.children &&
                                child.children.length > 0;


                              /*
                              |--------------------------------------------------------------------------
                              | CHILD DENGAN NESTED MENU
                              |--------------------------------------------------------------------------
                              */

                              if (childHasChildren) {

                                return (

                                  <div
                                    class="
                                      relative

                                      group/artikel

                                      border-t
                                    "

                                    key={child.id}
                                  >

                                    <div
                                      class="
                                        px-4
                                        py-3

                                        flex
                                        justify-between

                                        cursor-pointer

                                        hover:bg-[#FFD41D]
                                      "
                                    >

                                      <span>
                                        {child.nama}
                                      </span>

                                      <i
                                        class="
                                          fas
                                          fa-chevron-down

                                          text-xs
                                        "
                                      ></i>

                                    </div>


                                    <!-- NESTED DROPDOWN -->

                                    <div
                                      class="
                                        opacity-0
                                        invisible

                                        max-h-0

                                        group-hover/artikel:opacity-100
                                        group-hover/artikel:visible
                                        group-hover/artikel:max-h-40

                                        transition-all
                                        duration-300

                                        overflow-hidden

                                        bg-white
                                      "
                                    >

                                      {

                                        child.children.map(
                                          (grandchild) => (

                                            <a
                                              href={
                                                grandchild.url ||
                                                "#"
                                              }

                                              class="
                                                block

                                                px-4
                                                py-2
                                                pl-8

                                                text-[#001BB7]

                                                hover:bg-gray-50
                                              "

                                              key={
                                                grandchild.id
                                              }
                                            >

                                              {
                                                grandchild.nama
                                              }

                                            </a>

                                          )
                                        )

                                      }

                                    </div>

                                  </div>

                                );

                              }


                              /*
                              |--------------------------------------------------------------------------
                              | CHILD BIASA
                              |--------------------------------------------------------------------------
                              */

                              return (

                                <a
                                  href={
                                    child.url ||
                                    "#"
                                  }

                                  class={`
                                    block

                                    font-medium
                                    text-gray-700

                                    px-4
                                    py-3

                                    hover:bg-[#FFD41D]

                                    transition
                                    duration-200

                                    ${
                                      childIndex ===
                                      menu.children.length - 1
                                        ? "rounded-b-lg"
                                        : ""
                                    }
                                  `}

                                  key={
                                    child.id
                                  }
                                >

                                  {child.nama}

                                </a>

                              );

                            }
                          )

                        }

                      </div>

                    </li>

                  );

                }


                /*
                |--------------------------------------------------------------------------
                | MENU BIASA
                |--------------------------------------------------------------------------
                */

                return (

                  <li
                    key={menu.id}
                  >

                    <a
                      href={
                        menu.url ||
                        "#"
                      }

                      class="
                        text-gray-700

                        font-semibold

                        hover:text-yellow-400

                        transition
                        duration-300

                        hover-scale-shadow

                        whitespace-nowrap
                      "
                    >

                      {menu.nama}

                    </a>

                  </li>

                );

              }
            )

          }

        </ul>

      </nav>


      <!-- ===================================================
           TOMBOL KONTAK
      ==================================================== -->

      <div
        class="
          hidden
          lg:flex

          items-center

          gap-3

          z-10

          shrink-0
        "
      >

        {

          contactMenus.map(
            (menu) => (

              <a
                href={
                  menu.url ||
                  "#"
                }

                class="
                  desktop-contact

                  bg-[#FFD41D]

                  text-[#0900C3]

                  font-bold

                  rounded-lg

                  whitespace-nowrap

                  transition-all
                  duration-300

                  hover:shadow-lg

                  hover:-translate-y-0.5
                "

                key={menu.id}
              >

                {menu.nama}

              </a>

            )
          )

        }

      </div>


      <!-- ===================================================
           MOBILE BUTTON
      ==================================================== -->

      <button
        id="mobile-menu-button"

        type="button"

        class="
          lg:hidden

          text-blue-600

          ml-2
        "

        aria-label="Buka menu"
      >

        <i
          class="
            fas
            fa-bars

            text-2xl
          "
        ></i>

      </button>

    </div>


    <!-- =====================================================
         MOBILE MENU
    ====================================================== -->

    <div
      id="mobile-menu"

      class="
        hidden

        lg:hidden

        pb-4

        border-t

        mt-2

        space-y-2
      "
    >

      {

        navigationMenus.map(
          (menu) => {

            const hasChildren =
              menu.children &&
              menu.children.length > 0;


            /*
            |--------------------------------------------------------------------------
            | MOBILE DROPDOWN
            |--------------------------------------------------------------------------
            */

            if (hasChildren) {

              return (

                <div
                  key={menu.id}
                >

                  <button
                    type="button"

                    class="
                      mobile-dropdown-btn

                      w-full

                      flex
                      justify-between

                      py-2

                      font-semibold

                      text-gray-700
                    "
                  >

                    <span>
                      {menu.nama}
                    </span>

                    <i
                      class="
                        fas
                        fa-chevron-down

                        text-xs
                      "
                    ></i>

                  </button>


                  <div
                    class="
                      hidden

                      pl-4

                      space-y-1
                    "
                  >

                    {

                      menu.children.map(
                        (child) => {

                          const childHasChildren =
                            child.children &&
                            child.children.length > 0;


                          /*
                          |--------------------------------------------------------------------------
                          | MOBILE NESTED
                          |--------------------------------------------------------------------------
                          */

                          if (
                            childHasChildren
                          ) {

                            return (

                              <div
                                key={
                                  child.id
                                }
                              >

                                <button
                                  type="button"

                                  class="
                                    mobile-dropdown-btn

                                    w-full

                                    flex
                                    justify-between

                                    py-1
                                    pl-2

                                    text-sm

                                    text-gray-700
                                  "
                                >

                                  <span>
                                    {child.nama}
                                  </span>

                                  <i
                                    class="
                                      fas
                                      fa-chevron-down

                                      text-xs
                                    "
                                  ></i>

                                </button>


                                <div
                                  class="
                                    hidden

                                    pl-4
                                  "
                                >

                                  {

                                    child.children.map(
                                      (grandchild) => (

                                        <a
                                          href={
                                            grandchild.url ||
                                            "#"
                                          }

                                          class="
                                            block

                                            py-1

                                            text-[#001BB7]
                                          "

                                          key={
                                            grandchild.id
                                          }
                                        >

                                          {
                                            grandchild.nama
                                          }

                                        </a>

                                      )
                                    )

                                  }

                                </div>

                              </div>

                            );

                          }


                          /*
                          |--------------------------------------------------------------------------
                          | MOBILE CHILD BIASA
                          |--------------------------------------------------------------------------
                          */

                          return (

                            <a
                              href={
                                child.url ||
                                "#"
                              }

                              class="
                                block

                                py-1

                                text-gray-700

                                hover:text-yellow-400
                              "

                              key={
                                child.id
                              }
                            >

                              {child.nama}

                            </a>

                          );

                        }
                      )

                    }

                  </div>

                </div>

              );

            }


            /*
            |--------------------------------------------------------------------------
            | MOBILE MENU BIASA
            |--------------------------------------------------------------------------
            */

            return (

              <a
                href={
                  menu.url ||
                  "#"
                }

                class="
                  block

                  py-2

                  font-semibold

                  text-gray-700

                  hover:text-yellow-400
                "

                key={menu.id}
              >

                {menu.nama}

              </a>

            );

          }
        )

      }


      <!-- ===================================================
           MOBILE KONTAK
      ==================================================== -->

      {

        contactMenus.map(
          (menu) => (

            <a
              href={
                menu.url ||
                "#"
              }

              class="
                block

                py-2

                font-bold

                text-[#0900C3]
              "

              key={menu.id}
            >

              {menu.nama}

            </a>

          )
        )

      }

    </div>

  </div>

</header>


<!-- =========================================================
     SPACER HEADER
     
     Karena header fixed keluar dari flow,
     spacer menjaga konten tidak ketutup header.
========================================================== -->

<div
  id="header-spacer"
  aria-hidden="true"
></div>


<!-- =========================================================
     STYLE
========================================================== -->

<style>

  /*
  |--------------------------------------------------------------------------
  | HEADER FIXED
  |--------------------------------------------------------------------------
  */

  #site-header {

    width: 100%;

    left: 0;
    right: 0;

    transition:
      box-shadow 0.25s ease;

  }


  /*
  |--------------------------------------------------------------------------
  | SPACER
  |--------------------------------------------------------------------------
  */

  #header-spacer {

    width: 100%;

    height: 80px;

  }


  /*
  |--------------------------------------------------------------------------
  | TOMBOL KONTAK
  |--------------------------------------------------------------------------
  */

  .desktop-contact {

    padding: 12px 16px;

    font-size: 14px;

  }


  /*
  |--------------------------------------------------------------------------
  | DROPDOWN
  |--------------------------------------------------------------------------
  */

  nav > ul > li > div {

    min-height: 0;

  }


  /*
  |--------------------------------------------------------------------------
  | IPAD / TABLET
  |--------------------------------------------------------------------------
  */

  @media (
    min-width: 1024px
  ) and (
    max-width: 1279px
  ) {

    .desktop-contact {

      padding: 10px 12px;

      font-size: 12px;

    }

  }


  /*
  |--------------------------------------------------------------------------
  | IPAD PRO
  |--------------------------------------------------------------------------
  */

  @media (
    min-width: 1100px
  ) and (
    max-width: 1279px
  ) {

    .desktop-contact {

      padding: 10px 13px;

      font-size: 12.5px;

    }

  }


  /*
  |--------------------------------------------------------------------------
  | DESKTOP NORMAL
  |--------------------------------------------------------------------------
  */

  @media (
    min-width: 1280px
  ) {

    .desktop-contact {

      padding: 12px 16px;

      font-size: 14px;

    }

  }


  /*
  |--------------------------------------------------------------------------
  | DESKTOP BESAR
  |--------------------------------------------------------------------------
  */

  @media (
    min-width: 1536px
  ) {

    .desktop-contact {

      padding: 13px 18px;

      font-size: 14px;

    }

  }


  /*
  |--------------------------------------------------------------------------
  | MOBILE
  |--------------------------------------------------------------------------
  */

  @media (
    max-width: 1023px
  ) {

    .desktop-contact {

      display: none;

    }

  }

</style>


<!-- =========================================================
     JAVASCRIPT
========================================================== -->

<script is:inline>

document.addEventListener(
  "DOMContentLoaded",
  function () {


    /*
    |--------------------------------------------------------------------------
    | HEADER
    |--------------------------------------------------------------------------
    */

    const siteHeader =
      document.getElementById(
        "site-header"
      );


    const headerSpacer =
      document.getElementById(
        "header-spacer"
      );


    /*
    |--------------------------------------------------------------------------
    | ATUR TINGGI SPACER OTOMATIS
    |--------------------------------------------------------------------------
    */

    function setHeaderHeight() {

      if (
        siteHeader &&
        headerSpacer
      ) {

        headerSpacer.style.height =
          siteHeader.offsetHeight + "px";

      }

    }


    setHeaderHeight();


    window.addEventListener(
      "resize",
      setHeaderHeight
    );


    /*
    |--------------------------------------------------------------------------
    | MOBILE MENU
    |--------------------------------------------------------------------------
    */

    const mobileBtn =
      document.getElementById(
        "mobile-menu-button"
      );


    const mobileMenu =
      document.getElementById(
        "mobile-menu"
      );


    if (
      mobileBtn &&
      mobileMenu
    ) {

      mobileBtn.addEventListener(
        "click",
        function () {

          mobileMenu.classList.toggle(
            "hidden"
          );

        }
      );

    }


    /*
    |--------------------------------------------------------------------------
    | MOBILE DROPDOWN
    |--------------------------------------------------------------------------
    */

    const mobileDropdownBtns =
      document.querySelectorAll(
        ".mobile-dropdown-btn"
      );


    mobileDropdownBtns.forEach(
      function (btn) {

        btn.addEventListener(
          "click",
          function () {

            const content =
              this.nextElementSibling;


            const icon =
              this.querySelector(
                "i"
              );


            if (content) {

              content.classList.toggle(
                "hidden"
              );

            }


            if (icon) {

              icon.classList.toggle(
                "rotate-180"
              );

            }

          }
        );

      }
    );


    /*
    |--------------------------------------------------------------------------
    | EFEK SHADOW SAAT SCROLL
    |--------------------------------------------------------------------------
    |
    | Navbar TETAP DI ATAS.
    | Tidak disembunyikan.
    | Tidak naik turun.
    |
    */

    function handleScroll() {

      if (!siteHeader) {
        return;
      }


      if (window.scrollY > 5) {

        siteHeader.style.boxShadow =
          "0 4px 18px rgba(0,0,0,0.10)";

      } else {

        siteHeader.style.boxShadow =
          "none";

      }

    }


    window.addEventListener(
      "scroll",
      handleScroll,
      {
        passive: true
      }
    );


    handleScroll();

  }
);

</script>