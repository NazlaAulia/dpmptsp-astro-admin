---
import Sidebar from "./Sidebar.astro";
import Navbar from "./Navbar.astro";

const { title, subtitle = "Kelola konten dan operasional DPM-PTSP dengan lebih terarah.", actionLabel = "Tambah Artikel", actionHref = "/admin/tambah-artikel", actionIcon = "+", showHeader = true } = Astro.props;
---

<div class="admin-shell">
  <Sidebar />

  <div class="main-panel">
    <Navbar />

    <main class="content">
      {showHeader && (
        <section class="page-header">
          <div>
            <p class="eyebrow">PANEL ADMINISTRASI</p>
            <h1>{title}</h1>
            <p class="subtitle">{subtitle}</p>
          </div>
          <div class="page-actions">
            <a href={actionHref} class="primary-action">{actionIcon} {actionLabel}</a>
          </div>
        </section>
      )}

      <div class="content-body">
        <slot />
      </div>
    </main>
  </div>
</div>

<style>
/* BACKGROUND UTAMA DIBUAT ABU-ABU LEMBUT SEPERTI GAMBAR 2 */
.admin-shell {
  display: flex;
  min-height: 100vh;
  background: #f4f7fb !important; 
}

.main-panel {
  flex: 1;
  display: flex;
  flex-direction: column;
  height: 100vh;
  min-height: 0;
}

/* PADDING DIPERLEBAR AGAR KONTEN TENGAH */
.content {
  flex: 1;
  min-height: 0;
  overflow: hidden;
  padding: 32px 40px 0 !important; 
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.content-body {
  flex: 1;
  min-height: 0; 
  overflow-y: auto;
  padding-bottom: 40px;
  display: flex;
  flex-direction: column;
}

/* KARTU HEADER (JUDUL) */
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28px 32px !important;
  border-radius: 24px !important; 
  background: white !important;
  border: none !important;
  box-shadow: 0 10px 30px rgba(15,23,42,0.03) !important; 
  flex-shrink: 0;
}

.eyebrow {
  margin: 0 0 8px;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.15em;
  color: #2563eb;
}

.page-header h1 {
  margin: 0;
  font-size: 1.8rem !important;
  font-weight: 800;
  color: #0f172a;
}

.subtitle {
  margin: 8px 0 0;
  color: #64748b;
  font-size: 0.95rem;
}

.page-actions a {
  text-decoration: none;
  border-radius: 12px; 
  padding: 12px 24px;
  font-size: 0.95rem;
  font-weight: 600;
  transition: all 0.2s ease;
}

.primary-action {
  background: #2563eb;
  color: white;
  box-shadow: 0 8px 20px rgba(37, 99, 235, 0.2);
}

.primary-action:hover {
  background: #1d4ed8;
  transform: translateY(-2px);
}

/* MEMASTIKAN KOTAK TABEL MENGAMBIL TINGGI PENUH */
:global(.content-body > .artikel-box) {
  flex: 1;
  min-height: 0;
}

@media (max-width: 900px) {
  .admin-shell { flex-direction: column; }
  .content { padding: 20px !important; }
  .page-header { flex-direction: column; align-items: flex-start; gap: 20px; }
}
</style>