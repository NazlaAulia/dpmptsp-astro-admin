---
import Sidebar from "./Sidebar.astro";
import Navbar from "./Navbar.astro";

const { title, subtitle = "Kelola konten dan operasional DPM-PTSP dengan lebih terarah.", actionLabel = "Tambah Artikel", actionHref = "/admin/tambah-artikel" } = Astro.props;
---

<div class="admin-shell">
  <Sidebar />

  <div class="main-panel">
    <Navbar />

    <main class="content">
      <section class="page-header">
        <div>
          <p class="eyebrow">Panel Administrasi</p>
          <h1>{title}</h1>
          <p class="subtitle">{subtitle}</p>
        </div>

        <div class="page-actions">
          <a href="/admin/artikel" class="ghost-action">Kelola Konten</a>
          <a href={actionHref} class="primary-action">+ {actionLabel}</a>
        </div>
      </section>

      <slot />
    </main>
  </div>
</div>

<style>
.admin-shell {
  display: flex;
  min-height: 100vh;
  background: linear-gradient(135deg, #eef4ff 0%, #f8fafc 100%);
  color: #0f172a;
}

.main-panel {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.content {
  padding: 24px 28px 32px;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  padding: 22px 24px;
  border-radius: 22px;
  background: white;
  box-shadow: 0 16px 35px rgba(15, 23, 42, 0.08);
}

.eyebrow {
  margin: 0 0 6px;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: #2563eb;
}

.page-header h1 {
  margin: 0;
  font-size: 1.45rem;
  font-weight: 800;
}

.subtitle {
  margin: 6px 0 0;
  color: #64748b;
  font-size: 0.95rem;
}

.page-actions {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.page-actions a {
  text-decoration: none;
  border-radius: 999px;
  padding: 10px 14px;
  font-size: 0.9rem;
  font-weight: 700;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.page-actions a:hover {
  transform: translateY(-1px);
}

.ghost-action {
  background: #f8fafc;
  color: #334155;
  border: 1px solid #e2e8f0;
}

.primary-action {
  background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
  color: white;
  box-shadow: 0 12px 24px rgba(37, 99, 235, 0.22);
}

@media (max-width: 900px) {
  .admin-shell {
    flex-direction: column;
  }

  .content {
    padding: 18px;
  }

  .page-header {
    flex-direction: column;
    align-items: flex-start;
  }
}
</style>
