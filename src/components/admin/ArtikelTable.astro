---
export const prerender = false;

import { db } from "../../lib/db";

// 1. Ambil parameter halaman aktif dari URL (?page=X)
const url = new URL(Astro.request.url);
const currentPage = parseInt(url.searchParams.get("page") || "1");
const limit = 10;
const offset = (currentPage - 1) * limit;

// 2. Hitung total data untuk pagination
const [countResult]: any = await db.query(`SELECT COUNT(*) as total FROM post`);
const totalData = countResult[0].total;
const totalPages = Math.ceil(totalData / limit);

// 3. Ambil data artikel sesuai halaman
const [artikel] = await db.query(`
SELECT 
post.*,
category_berita.title AS kategori
FROM post
LEFT JOIN category_berita 
ON post.id_category = category_berita.id_category
ORDER BY post.id_post DESC
LIMIT ? OFFSET ?
`, [limit, offset]);

const dataArtikel = artikel as any[];

// Hitung teks "Showing X to Y of Z entries"
const showingStart = totalData === 0 ? 0 : offset + 1;
const showingEnd = Math.min(offset + limit, totalData);

// Logika batasan maksimal 5 angka halaman yang tampil
let startPage = Math.max(1, currentPage - 2);
let endPage = Math.min(totalPages, startPage + 4);

if (endPage - startPage < 4) {
    startPage = Math.max(1, endPage - 4);
}

const visiblePages = Array.from({ length: (endPage - startPage) + 1 }, (_, i) => startPage + i);
---

<style>
.box {
    background: white;
    border-radius: 14px;
    padding: 16px 0 0;
    border: 1px solid #eef1f6;
    box-shadow: 0 1px 2px rgba(15,23,42,.03), 0 14px 28px -18px rgba(15,23,42,.08);
    box-sizing: border-box;
    height: 100%;
    display: flex;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
}

.header-title {
    font-size: 19px;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: #0f172a;
    margin: 0 0 14px 18px;
    flex-shrink: 0;
}

.btn-tambah {
    background: linear-gradient(135deg,#2563eb,#1d4ed8);
    color: white;
    border: none;
    padding: 11px 20px;
    border-radius: 12px;
    cursor: pointer;
    font-weight: 600;
    font-size: 13.5px;
    display: inline-block;
    text-decoration: none;
    margin: 0 0 16px 18px;
    box-shadow: 0 8px 18px -8px rgba(37,99,235,.5);
    transition: transform .15s ease, box-shadow .15s ease;
    flex-shrink: 0;
}

.btn-tambah:hover {
    transform: translateY(-1px);
    box-shadow: 0 12px 22px -8px rgba(37,99,235,.55);
}

.table-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 0 18px 12px;
    font-size: 14px;
    color: #475569;
    flex-shrink: 0;
}

.entries select, .search-box input {
    border: 1.5px solid #e2e8f0;
    border-radius: 10px;
    padding: 7px 10px;
    font-size: 13px;
    background: #f8fafc;
    outline: none;
    transition: border-color .15s ease, box-shadow .15s ease, background .15s ease;
}

.entries select:focus, .search-box input:focus {
    border-color: #2563eb;
    background: #ffffff;
    box-shadow: 0 0 0 3px rgba(37,99,235,.12);
}

.search-box input {
    width: 240px;
}

/* Box tabel: ini yang punya tinggi terbatas & scroll sendiri */
.table-wrap {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    border-top: 1px solid #eef1f6;
    border-bottom: 1px solid #eef1f6;
    border-radius: 0;
}

table {
    width: 100%;
    border-collapse: collapse;
}

th {
    background: #f8fafc;
    color: #64748b;
    font-weight: 700;
    font-size: 11.5px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    position: sticky;
    top: 0;
    z-index: 1;
    box-shadow: inset 0 -1px 0 #eef1f6;
}

th, td {
    padding: 12px 12px;
    border-bottom: 1px solid #f1f5f9;
    text-align: left;
    font-size: 13px;
    color: #334155;
    vertical-align: top;
}

tbody tr {
    transition: background .15s ease;
}

tbody tr:hover {
    background: #f8fafc;
}

tbody tr:last-child td {
    border-bottom: none;
}

.judul-cell {
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 4px;
}

.status-text {
    font-size: 12px;
    color: #64748b;
}

.isi-preview {
    color: #64748b;
    max-width: 250px;
    line-height: 1.4;
}

img.thumbnail {
    width: 120px;
    height: 70px;
    object-fit: cover;
    border-radius: 8px;
}

.badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #e8f2ff;
    color: #1d4ed8;
    padding: 4px 11px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 700;
}

.badge::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #2563eb;
}

/* AKSI */
.aksi {
    white-space: nowrap;
    display: flex;
    gap: 8px;
    align-items: center;
}

.aksi .edit, .aksi .hapus {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 11px;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: transform .15s ease, background .15s ease;
}

.aksi .edit:hover, .aksi .hapus:hover {
    transform: translateY(-1px);
}

.aksi .edit {
    background: #e8f2ff;
    color: #2563eb;
}

.aksi .edit:hover {
    background: #dbe9ff;
}

.aksi .hapus {
    background: #fee2e2;
    color: #dc2626;
}

.aksi .hapus:hover {
    background: #fecaca;
}

.aksi svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
}

/* MODAL HAPUS */
.modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.5);
    backdrop-filter: blur(3px);
    z-index: 9999;
    align-items: center;
    justify-content: center;
}

.modal-overlay.show {
    display: flex;
}

.modal-box {
    width: 560px;
    max-width: calc(100% - 40px);
    background: white;
    border-radius: 28px;
    padding: 40px 30px;
    text-align: center;
    box-sizing: border-box;
    box-shadow: 0 30px 60px -12px rgba(15,23,42,.25);
}

.modal-icon {
    width: 80px;
    height: 80px;
    margin: 0 auto 22px;
    border-radius: 50%;
    background: #fee2e2;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 0 10px #fef2f2;
}

.modal-icon svg {
    width: 38px;
    height: 38px;
    stroke: #ef4444;
}

.modal-box h2 {
    margin: 0 0 16px;
    font-size: 26px;
    font-weight: 800;
    color: #0f172a;
}

.modal-box p {
    margin: 0;
    color: #64748b;
    font-size: 16px;
    line-height: 1.5;
}

.modal-buttons {
    display: flex;
    justify-content: center;
    gap: 16px;
    margin-top: 28px;
}

.btn-modal {
    border: none;
    border-radius: 13px;
    padding: 13px 32px;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    transition: transform .15s ease;
}

.btn-modal:hover {
    transform: translateY(-1px);
}

.btn-modal-batal {
    background: #f1f5f9;
    color: #334155;
}

.btn-modal-hapus {
    background: linear-gradient(135deg,#ef4444,#dc2626);
    color: white;
    box-shadow: 0 8px 18px -8px rgba(239,68,68,.5);
}

.btn-modal-batal:hover {
    background: #e2e8f0;
}

.btn-modal-hapus:hover {
    background: linear-gradient(135deg,#ef4444,#dc2626);
}

.btn-modal-edit {
    background: linear-gradient(135deg,#2563eb,#1d4ed8);
    color: white;
    box-shadow: 0 8px 18px -8px rgba(37,99,235,.5);
}

.btn-modal-edit:hover {
    background: linear-gradient(135deg,#2563eb,#1d4ed8);
}


.pagination-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 12px 18px 18px;
    font-size: 13px;
    color: #64748b;
    flex-shrink: 0;
}

.pages {
    display: flex;
    align-items: center;
    gap: 8px;
}

/* Mengubah tag button di pagination menjadi a agar bisa diklik sebagai link */
.pages a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border: 1.5px solid #e2e8f0;
    background: #f8fafc;
    color: #64748b;
    border-radius: 10px;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    transition: 0.15s;
}

.pages a:hover {
    background: #e2e8f0;
}

.pages a.active {
    background: linear-gradient(135deg,#2563eb,#1d4ed8);
    color: white;
    border: 1.5px solid transparent;
    box-shadow: 0 6px 14px -6px rgba(37,99,235,.5);
}
</style>


<div class="box">
    <div class="header-title">Daftar Posting Website</div>

    <div>
        <a href="/admin/tambah-artikel" class="btn-tambah">
            Tambah Artikel/Berita
        </a>
    </div>

    <div class="table-controls">
        <div class="entries">
            Tampilkan 
            <select>
                <option>10</option>
                <option>25</option>
                <option>50</option>
            </select> entri
        </div>

        <div class="search-box">
            Cari: <input type="text" placeholder="">
        </div>
    </div>


    <div class="table-wrap">
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Judul</th>
                <th>Isi</th>
                <th>Kategori</th>
                <th>Tanggal</th>
                <th>Gambar</th>
                <th>Aksi</th>
            </tr>
        </thead>

        <tbody>

        {
        dataArtikel.map((item)=>(

        <tr>

            <td>
                {item.id_post}
            </td>


            <td>
                <div class="judul-cell">
                    {item.title}
                </div>

                <div class="status-text">
                    Status Berita : {item.active === "Y" ? "Aktif":"Nonaktif"}
                </div>
            </td>


            <td>
                <div class="isi-preview">
                    {item.content ? item.content.substring(0,80) : ''}...
                </div>
            </td>


            <td>
                <span class="badge">
                    {item.kategori}
                </span>
            </td>


            <td>
                {item.date}
            </td>


            <td>
      <img 
    src={`/uploads/${item.picture}`}
    class="thumbnail"
    alt={item.title}
    onerror={`this.onerror=null; this.src='https://dpm-ptsp.surabaya.go.id/fileberita/${item.picture}'`}
/>
            </td>


<td class="aksi">
    <button 
        type="button"
        class="edit"
        data-id={item.id_post}
        title="Edit"
    >
        <!-- ICON PENSIL -->
        <svg 
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
        >
            <path d="M12 20h9"></path>
            <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
        </svg>
    </button>

    <button 
        type="button"
        class="hapus"
        data-id={item.id_post}
        data-title={item.title}
        title="Hapus"
    >
        <!-- ICON TONG SAMPAH -->
        <svg 
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
        >
            <path d="M3 6h18"></path>
            <path d="M8 6V4h8v2"></path>
            <path d="M19 6l-1 14H6L5 6"></path>
            <path d="M10 11v5"></path>
            <path d="M14 11v5"></path>
        </svg>
    </button>
</td>

        </tr>

        ))
        }

        </tbody>
    </table>
    </div>


    <div class="pagination-footer">
        <div>Showing {showingStart} to {showingEnd} of {totalData} entries</div>

        <div class="pages">
            <!-- Tombol Panah Kiri -->
            {currentPage > 1 ? (
                <a href={`/admin/artikel?page=${currentPage - 1}`}>&lt;</a>
            ) : (
                <a href="#" style="opacity: 0.4; pointer-events: none;">&lt;</a>
            )}

            <!-- List Angka Halaman (Maksimal tampil 5 angka dan bergeser otomatis) -->
            {visiblePages.map((p) => (
                <a href={`/admin/artikel?page=${p}`} class={p === currentPage ? "active" : ""}>
                    {p}
                </a>
            ))}

            <!-- Tombol Panah Kanan -->
            {currentPage < totalPages ? (
                <a href={`/admin/artikel?page=${currentPage + 1}`}>&gt;</a>
            ) : (
                <a href="#" style="opacity: 0.4; pointer-events: none;">&gt;</a>
            )}
        </div>
    </div>

</div>


<!-- MODAL KONFIRMASI HAPUS -->
<div class="modal-overlay" id="hapusModal">

    <div class="modal-box">

        <div class="modal-icon">

            <!-- ICON TANDA SERU -->
            <svg 
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>

        </div>


        <h2>Hapus Artikel?</h2>

        <p>
            Apakah Anda yakin ingin menghapus artikel ini?
        </p>


        <div class="modal-buttons">

            <button 
                type="button"
                class="btn-modal btn-modal-batal"
                id="btnBatal"
            >
                Batal
            </button>


            <button 
                type="button"
                class="btn-modal btn-modal-hapus"
                id="btnKonfirmasiHapus"
            >
                Hapus
            </button>

        </div>

    </div>

</div>

<!-- MODAL KONFIRMASI EDIT -->
<div class="modal-overlay" id="editModal">

    <div class="modal-box">

        <div class="modal-icon">

            <!-- ICON TANDA SERU -->
            <svg 
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>

        </div>

        <h2>Edit Artikel?</h2>

        <p>
            Apakah Anda yakin ingin mengedit artikel ini?
        </p>

        <div class="modal-buttons">

            <button 
                type="button"
                class="btn-modal btn-modal-batal"
                id="btnBatalEdit"
            >
                Batal
            </button>

            <button 
                type="button"
                class="btn-modal btn-modal-edit"
                id="btnKonfirmasiEdit"
            >
                Ya, Edit
            </button>

        </div>

    </div>

</div>

<script>
    const modalHapus = document.getElementById("hapusModal");
    const btnBatal = document.getElementById("btnBatal");
    const btnHapus = document.querySelectorAll(".hapus");
    const btnKonfirmasiHapus = document.getElementById("btnKonfirmasiHapus");

    let idArtikelHapus: string | null = null;

    btnHapus.forEach((button) => {
        button.addEventListener("click", () => {
            idArtikelHapus = button.getAttribute("data-id");
            modalHapus?.classList.add("show");
        });
    });

    btnBatal?.addEventListener("click", () => {
        modalHapus?.classList.remove("show");
        idArtikelHapus = null;
    });

    btnKonfirmasiHapus?.addEventListener("click", () => {
        if (idArtikelHapus) {
            window.location.href = `/admin/hapus-artikel?id=${idArtikelHapus}`;
        }
    });

    modalHapus?.addEventListener("click", (event) => {
        if (event.target === modalHapus) {
            modalHapus.classList.remove("show");
            idArtikelHapus = null;
        }
    });

    /* =========================
       MODAL EDIT
    ========================= */
    const modalEdit = document.getElementById("editModal");
    const btnEdit = document.querySelectorAll(".edit");
    const btnBatalEdit = document.getElementById("btnBatalEdit");
    const btnKonfirmasiEdit = document.getElementById("btnKonfirmasiEdit");

    let idArtikelEdit: string | null = null;

    btnEdit.forEach((button) => {
        button.addEventListener("click", () => {
            idArtikelEdit = button.getAttribute("data-id");
            modalEdit?.classList.add("show");
        });
    });

    btnBatalEdit?.addEventListener("click", () => {
        modalEdit?.classList.remove("show");
        idArtikelEdit = null;
    });

    btnKonfirmasiEdit?.addEventListener("click", () => {
        if (idArtikelEdit) {
            window.location.href = `/admin/edit-artikel?id=${idArtikelEdit}`;
        }
    });

    modalEdit?.addEventListener("click", (event) => {
        if (event.target === modalEdit) {
            modalEdit.classList.remove("show");
            idArtikelEdit = null;
        }
    });
</script>