---
export const prerender = false;
import { db } from "../../lib/db";

const url = new URL(Astro.request.url);
const currentPage = parseInt(url.searchParams.get("page") || "1");
const limit = 10;
const offset = (currentPage - 1) * limit;

const [countResult]: any = await db.query(`SELECT COUNT(*) as total FROM post`);
const totalData = countResult[0].total;
const totalPages = Math.ceil(totalData / limit);

const [artikel] = await db.query(`
SELECT post.*, category_berita.title AS kategori
FROM post
LEFT JOIN category_berita ON post.id_category = category_berita.id_category
ORDER BY post.id_post DESC
LIMIT ? OFFSET ?
`, [limit, offset]);

const dataArtikel = artikel as any[];
const showingStart = totalData === 0 ? 0 : offset + 1;
const showingEnd = Math.min(offset + limit, totalData);

let startPage = Math.max(1, currentPage - 2);
let endPage = Math.min(totalPages, startPage + 4);
if (endPage - startPage < 4) { startPage = Math.max(1, endPage - 4); }
const visiblePages = Array.from({ length: (endPage - startPage) + 1 }, (_, i) => startPage + i);
---

<style>
/* =========================================
   1. VARIABEL WARNA (LIGHT MODE - ASLI)
   ========================================= */
.card-table {
    --bg-card: #ffffff;
    --bg-header: #f1f5f9;
    --bg-hover: #f8fafc;
    --text-main: #0f172a;
    --text-muted: #64748b;
    --text-light: #475569;
    --border-main: #d1d5db;
    --border-sub: #e2e8f0;
    --border-th: #cbd5e1;
    --input-bg: #ffffff;
    
    background: var(--bg-card) !important;
    border-radius: 16px !important;
    padding: 24px 32px !important; 
    border: 1px solid var(--border-main) !important;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05) !important;
    display: flex !important;
    flex-direction: column !important;
    box-sizing: border-box !important;
    transition: background 0.3s ease, border-color 0.3s ease;
}

/* =========================================
   2. DETEKSI DARK MODE (OTOMATIS GANTI WARNA)
   ========================================= */
html.dark .card-table, 
body.dark .card-table, 
.dark .card-table,
[data-theme="dark"] .card-table,
@media (prefers-color-scheme: dark) .card-table {
    --bg-card: #1e293b !important;
    --bg-header: #0f172a !important;
    --bg-hover: #334155 !important;
    --text-main: #f8fafc !important;
    --text-muted: #94a3b8 !important;
    --text-light: #cbd5e1 !important;
    --border-main: #334155 !important;
    --border-sub: #334155 !important;
    --border-th: #334155 !important;
    --input-bg: #0f172a !important;
}

/* =========================================
   3. TERAPKAN VARIABEL KE DESAIN ASLI KAMU
   ========================================= */
.top-controls { display: flex !important; justify-content: space-between !important; align-items: center !important; margin-bottom: 20px !important; }
.entries { font-size: 14px !important; color: var(--text-light) !important; display: flex !important; align-items: center !important; gap: 8px !important; }
.entries select { border: 1px solid var(--border-th) !important; border-radius: 6px !important; padding: 8px 12px !important; background: var(--input-bg) !important; color: var(--text-main) !important; outline: none !important; }
.search-box input { border: 1px solid var(--border-th) !important; border-radius: 8px !important; padding: 10px 16px !important; font-size: 13px !important; background: var(--input-bg) !important; outline: none !important; color: var(--text-main) !important; width: 280px !important; }
.table-wrapper { border: 1px solid var(--border-th) !important; border-radius: 8px !important; overflow: hidden !important; }
table { width: 100% !important; border-collapse: collapse !important; table-layout: fixed !important; }
th { background: var(--bg-header) !important; color: var(--text-light) !important; font-weight: 700 !important; font-size: 12px !important; text-transform: uppercase !important; padding: 16px !important; text-align: left !important; border-bottom: 2px solid var(--border-th) !important; }
td { padding: 16px !important; border-bottom: 1px solid var(--border-sub) !important; text-align: left !important; font-size: 13px !important; color: var(--text-light) !important; vertical-align: middle !important; background: var(--bg-card) !important; word-wrap: break-word !important; }
tbody tr:hover td { background: var(--bg-hover) !important; }
tbody tr:last-child td { border-bottom: none !important; }

th:nth-child(1) { width: 5%; } th:nth-child(2) { width: 25%; } th:nth-child(3) { width: 20%; } th:nth-child(4) { width: 12%; } th:nth-child(5) { width: 20%; } th:nth-child(6) { width: 10%; } th:nth-child(7) { width: 8%; text-align: right; }   

.id-text { font-weight: 600 !important; color: var(--text-muted) !important; }
.judul-cell { font-weight: 600 !important; color: var(--text-main) !important; display: block !important; margin-bottom: 4px !important; font-size: 14px !important; }
.status-text { font-size: 11.5px !important; color: var(--text-muted) !important; display: flex !important; align-items: center !important; gap: 6px !important; }
.status-text::before { content: "" !important; display: block !important; width: 6px !important; height: 6px !important; border-radius: 50% !important; background: #22c55e !important; }
.isi-preview { color: var(--text-muted) !important; font-size: 13px !important; display: -webkit-box !important; -webkit-line-clamp: 2 !important; -webkit-box-orient: vertical !important; overflow: hidden !important; }
.tanggal-text { font-size: 12.5px !important; line-height: 1.5 !important; color: var(--text-light) !important; }
img.thumbnail { width: 100% !important; max-width: 70px !important; height: auto !important; aspect-ratio: 16/9 !important; object-fit: cover !important; border-radius: 4px !important; border: 1px solid var(--border-th) !important; }
.badge { display: inline-block !important; background: rgba(37, 99, 235, 0.1) !important; color: #3b82f6 !important; padding: 6px 10px !important; border-radius: 6px !important; font-size: 11px !important; font-weight: 600 !important; }
.aksi { display: flex !important; gap: 6px !important; justify-content: flex-end !important; }
.aksi button { display: inline-flex !important; align-items: center !important; justify-content: center !important; width: 32px !important; height: 32px !important; border-radius: 6px !important; border: 1px solid var(--border-th) !important; background: var(--bg-card) !important; color: var(--text-muted) !important; cursor: pointer !important; transition: 0.2s !important; }
.aksi .edit:hover { background: #eff6ff !important; color: #2563eb !important; border-color: #2563eb !important; }
.aksi .hapus:hover { background: #fef2f2 !important; color: #ef4444 !important; border-color: #ef4444 !important; }
.aksi svg { width: 15px !important; height: 15px !important; }
.pagination { display: flex !important; justify-content: space-between !important; align-items: center !important; margin-top: 24px !important; font-size: 13.5px !important; color: var(--text-muted) !important; }
.pages { display: flex !important; gap: 6px !important; }
.pages a { display: flex !important; align-items: center !important; justify-content: center !important; min-width: 32px !important; height: 32px !important; border: 1px solid var(--border-th) !important; background: var(--bg-card) !important; color: var(--text-muted) !important; border-radius: 6px !important; text-decoration: none !important; font-size: 13px !important; }
.pages a.active { background: #2563eb !important; color: white !important; border-color: #2563eb !important; }
</style>

<div class="card-table">
    <div class="top-controls">
        <div class="entries">
            Tampilkan 
            <select>
                <option>10</option>
                <option>25</option>
                <option>50</option>
            </select> entri
        </div>
        <div class="search-box">
            <input type="text" placeholder="Cari data...">
        </div>
    </div>

    <div class="table-wrapper">
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Judul</th>
                    <th>Isi</th>
                    <th>Kategori</th>
                    <th>Tanggal</th>
                    <th>Gambar</th>
                    <th style="text-align: right;">Aksi</th>
                </tr>
            </thead>
            <tbody>
                {dataArtikel.map((item)=>(
                <tr>
                    <td><span class="id-text">#{item.id_post}</span></td>
                    <td>
                        <span class="judul-cell">{item.title}</span>
                        <span class="status-text">Berita {item.active === "Y" ? "Aktif":"Nonaktif"}</span>
                    </td>
                    <td><div class="isi-preview">{item.content ? item.content.substring(0,80) : ''}...</div></td>
                    <td><span class="badge">{item.kategori}</span></td>
                    <td><div class="tanggal-text">{item.date}</div></td>
                    <td>
                        <img src={`/uploads/${item.picture}`} class="thumbnail" alt={item.title} onerror={`this.onerror=null; this.src='https://dpm-ptsp.surabaya.go.id/fileberita/${item.picture}'`} />
                    </td>
                    <td>
                        <div class="aksi">
                            <button type="button" class="edit" data-id={item.id_post}><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"></path></svg></button>
                            <button type="button" class="hapus" data-id={item.id_post}><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"></path><path d="M8 6V4h8v2"></path><path d="M19 6l-1 14H6L5 6"></path><path d="M10 11v5"></path><path d="M14 11v5"></path></svg></button>
                        </div>
                    </td>
                </tr>
                ))}
            </tbody>
        </table>
    </div>

    <div class="pagination">
        <div>Menampilkan {showingStart} - {showingEnd} dari {totalData}</div>
        <div class="pages">
            {currentPage > 1 ? <a href={`/admin/artikel?page=${currentPage - 1}`}>&lt;</a> : <a href="#" style="opacity: 0.5; pointer-events: none;">&lt;</a>}
            {visiblePages.map((p) => <a href={`/admin/artikel?page=${p}`} class={p === currentPage ? "active" : ""}>{p}</a>)}
            {currentPage < totalPages ? <a href={`/admin/artikel?page=${currentPage + 1}`}>&gt;</a> : <a href="#" style="opacity: 0.5; pointer-events: none;">&gt;</a>}
        </div>
    </div>
</div>

<!-- MODALS -->
<div class="modal-overlay" id="hapusModal" style="display:none; position:fixed; inset:0; background:rgba(15,23,42,0.6); z-index:9999; align-items:center; justify-content:center;">
    <div class="modal-box" style="width:400px; background:#fff; border-radius:12px; padding:24px; text-align:center;">
        <h2 style="margin:0 0 8px; font-size:18px; color:#0f172a;">Hapus Artikel?</h2>
        <p style="margin:0; color:#64748b; font-size:14px;">Data yang dihapus tidak dapat dikembalikan.</p>
        <div style="display:flex; justify-content:center; gap:12px; margin-top:24px;">
            <button type="button" id="btnBatal" style="border:none; border-radius:8px; padding:10px 20px; font-size:14px; font-weight:600; cursor:pointer; flex:1; background:#f1f5f9; color:#475569;">Batal</button>
            <button type="button" id="btnKonfirmasiHapus" style="border:none; border-radius:8px; padding:10px 20px; font-size:14px; font-weight:600; cursor:pointer; flex:1; background:#ef4444; color:white;">Hapus</button>
        </div>
    </div>
</div>

<div class="modal-overlay" id="editModal" style="display:none; position:fixed; inset:0; background:rgba(15,23,42,0.6); z-index:9999; align-items:center; justify-content:center;">
    <div class="modal-box" style="width:400px; background:#fff; border-radius:12px; padding:24px; text-align:center;">
        <h2 style="margin:0 0 8px; font-size:18px; color:#0f172a;">Edit Artikel?</h2>
        <p style="margin:0; color:#64748b; font-size:14px;">Anda akan diarahkan ke halaman edit.</p>
        <div style="display:flex; justify-content:center; gap:12px; margin-top:24px;">
            <button type="button" id="btnBatalEdit" style="border:none; border-radius:8px; padding:10px 20px; font-size:14px; font-weight:600; cursor:pointer; flex:1; background:#f1f5f9; color:#475569;">Batal</button>
            <button type="button" id="btnKonfirmasiEdit" style="border:none; border-radius:8px; padding:10px 20px; font-size:14px; font-weight:600; cursor:pointer; flex:1; background:#2563eb; color:white;">Edit</button>
        </div>
    </div>
</div>

<script>
    const modalHapus = document.getElementById("hapusModal");
    const btnBatal = document.getElementById("btnBatal");
    const btnHapus = document.querySelectorAll(".hapus");
    const btnKonfirmasiHapus = document.getElementById("btnKonfirmasiHapus");
    let idArtikelHapus: string | null = null;

    btnHapus.forEach((button) => {
        button.addEventListener("click", () => {
            idArtikelHapus = button.getAttribute("data-id") as string;
            if (modalHapus) modalHapus.style.display = "flex";
        });
    });

    btnBatal?.addEventListener("click", () => {
        if (modalHapus) modalHapus.style.display = "none";
        idArtikelHapus = null;
    });

    btnKonfirmasiHapus?.addEventListener("click", () => {
        if (idArtikelHapus) window.location.href = `/admin/hapus-artikel?id=${idArtikelHapus}`;
    });

    const modalEdit = document.getElementById("editModal");
    const btnEdit = document.querySelectorAll(".edit");
    const btnBatalEdit = document.getElementById("btnBatalEdit");
    const btnKonfirmasiEdit = document.getElementById("btnKonfirmasiEdit");
    let idArtikelEdit: string | null = null;

    btnEdit.forEach((button) => {
        button.addEventListener("click", () => {
            idArtikelEdit = button.getAttribute("data-id") as string;
            if (modalEdit) modalEdit.style.display = "flex";
        });
    });

    btnBatalEdit?.addEventListener("click", () => {
        if (modalEdit) modalEdit.style.display = "none";
        idArtikelEdit = null;
    });

    btnKonfirmasiEdit?.addEventListener("click", () => {
        if (idArtikelEdit) window.location.href = `/admin/edit-artikel?id=${idArtikelEdit}`;
    });
</script>