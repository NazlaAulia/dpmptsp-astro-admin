---
import MainLayout from "../layouts/MainLayoutgratifikasi.astro";

/* =========================
   DATA 2025
========================= */
/* =========================
   DATA 2025
========================= */
const rekap2025 = [
  { bulan:"Jan", pegawai:96, menyatakan:96 },
  { bulan:"Feb", pegawai:96, menyatakan:96 },
  { bulan:"Mar", pegawai:96, menyatakan:96 },
  { bulan:"Apr", pegawai:96, menyatakan:96 },
  { bulan:"Mei", pegawai:96, menyatakan:96 },
  { bulan:"Jun", pegawai:96, menyatakan:96 },
  { bulan:"Jul", pegawai:96, menyatakan:96 },
  { bulan:"Agu", pegawai:96, menyatakan:96 },
  { bulan:"Sep", pegawai:96, menyatakan:96 },
  { bulan:"Okt", pegawai:96, menyatakan:96 },
  { bulan:"Nov", pegawai:96, menyatakan:96 },
  { bulan:"Des", pegawai:96, menyatakan:96 }
];

/* =========================
   DATA 2026
========================= */
const rekap2026 = [
  { bulan:"Jan", pegawai:96, menyatakan:96 },
  { bulan:"Feb", pegawai:96, menyatakan:96 },
  { bulan:"Mar", pegawai:96, menyatakan:96 },
  { bulan:"Apr", pegawai:96, menyatakan:96 },
  { bulan:"Mei", pegawai:96, menyatakan:96 },
  { bulan:"Jun", pegawai:96, menyatakan:96 }
];

/* =========================
   FIX VALUE (SESUAI REQUEST)
========================= */
const DUgaan = 0;
const TERUSKAN = 0;
const PELANGGARAN = 0;
---

<MainLayout title="Monitoring Gratifikasi">

<div class="max-w-7xl mx-auto px-6 py-8">

  <!-- HEADER -->
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-slate-800">
      📊 Monitoring Gratifikasi Pegawai
    </h1>
    <p class="text-slate-500">
      Rekap kepatuhan & pelaporan
    </p>
  </div>

  <!-- TAB BUTTON -->
  <div class="flex gap-2 mb-6">
    <button onclick="showYear('2025')"
      class="tab px-5 py-2 rounded-lg bg-blue-600 text-white">
      2025
    </button>

    <button onclick="showYear('2026')"
      class="tab px-5 py-2 rounded-lg bg-slate-200">
      2026 (Jan–Jun)
    </button>
  </div>

  <!-- ================= 2025 ================= -->
  <div id="year-2025">

    <div class="bg-white rounded-xl shadow overflow-hidden">

      <div class="p-4 font-semibold text-blue-700">
        📅 Rekap 2025
      </div>

      <table class="w-full text-sm">
        <thead class="bg-slate-100">
          <tr>
           <th class="p-3 text-left">Bulan</th>
            <th class="p-3 text-center">Jumlah Pegawai</th>
            <th class="p-3 text-center text-blue-600">Menyatakan</th>
            <th class="p-3 text-center text-yellow-600">Laporan dugaan gratifikasi</th>
            <th class="p-3 text-center text-purple-600">Laporan yg diteruskan ke UPG/KPK</th>
            <th class="p-3 text-center text-red-600">Pelanggaran yang ditemukan</th>
         </tr>
        </thead>

        <tbody>
          {rekap2025.map(r => (
            <tr class="border-b hover:bg-slate-50">
              <td class="p-3 font-medium">{r.bulan}</td>
              <td class="text-center">{r.pegawai}</td>
              <td class="text-center text-blue-600 font-bold">{r.menyatakan}</td>
              <td class="text-center">{DUgaan}</td>
              <td class="text-center">{TERUSKAN}</td>
              <td class="text-center">{PELANGGARAN}</td>
            </tr>
          ))}
        </tbody>
      </table>

    </div>
  </div>

  <!-- ================= 2026 ================= -->
  <div id="year-2026" class="hidden">

    <div class="bg-white rounded-xl shadow overflow-hidden">

      <div class="p-4 font-semibold text-blue-700"> 
        📅 Rekap 2026 (Update 27 Juni)
      </div>

      <table class="w-full text-sm">
        <thead class="bg-slate-100">
          <tr>
            <th class="p-3 text-left">Bulan</th>
            <th class="p-3 text-center">Jumlah Pegawai</th>
            <th class="p-3 text-center text-blue-600">Menyatakan</th>
            <th class="p-3 text-center text-yellow-600">Laporan dugaan gratifikasi</th>
            <th class="p-3 text-center text-purple-600">Laporan yg diteruskan ke UPG/KPK</th>
            <th class="p-3 text-center text-red-600">Pelanggaran yang ditemukan</th>
          </tr>
        </thead>

        <tbody>
          {rekap2026.map(r => (
            <tr class="border-b hover:bg-slate-50">
              <td class="p-3 font-medium">{r.bulan}</td>
              <td class="text-center">{r.pegawai}</td>
              <td class="text-center text-blue-600 font-bold">{r.menyatakan}</td>
              <td class="text-center">{DUgaan}</td>
              <td class="text-center">{TERUSKAN}</td>
              <td class="text-center">{PELANGGARAN}</td>
            </tr>
          ))}
        </tbody>
      </table>

    </div>
  </div>

</div>

<!-- TAB SCRIPT -->
<script is:inline>
function showYear(year) {
  document.getElementById("year-2025").classList.add("hidden");
  document.getElementById("year-2026").classList.add("hidden");

  document.getElementById("year-" + year).classList.remove("hidden");

  document.querySelectorAll(".tab").forEach(t => {
    t.classList.remove("bg-blue-600", "text-white");
    t.classList.add("bg-slate-200");
  });

  event.target.classList.add("bg-blue-600", "text-white");
  event.target.classList.remove("bg-slate-200");
}
</script>

</MainLayout>