---
// Server-side logout: clear cookie then redirect to login
export const prerender = false;

// Clear the admin-auth cookie
Astro.cookies.set('admin-auth', '', { path: '/', maxAge: 0, httpOnly: true, sameSite: 'lax' });

// Use Astro.redirect (as used in login) to navigate to login page
return Astro.redirect('/admin/login');
---
