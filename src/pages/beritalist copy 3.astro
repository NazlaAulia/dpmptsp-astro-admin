---
import MainLayout from "../layouts/MainLayout.astro";
import { db } from "../lib/db.js";
import { slugify } from "../utils/slugify";

/* ================== MAIN PAGING ================== */
const limit = 20;
let page = Number(Astro.url.searchParams.get("page") || 1);
if (page < 1) page = 1;

const [[{ total }]] = await db.query(
  "SELECT COUNT(*) AS total FROM post WHERE active='Y'"
);

const totalPages = Math.max(1, Math.ceil(total / limit));
if (page > totalPages) page = totalPages;

const offset = (page - 1) * limit;

const [rows] = await db.query(
  `
  SELECT *
  FROM post
  WHERE active='Y'
  ORDER BY date DESC, time DESC, id_post DESC
  LIMIT ? OFFSET ?
  `,
  [limit, offset]
);

/* ================== SIDEBAR PAGING ================== */
const relatedLimit = 8;
let rpage = Number(Astro.url.searchParams.get("rpage") || 1);
if (rpage < 1) rpage = 1;

const [[{ rtotal }]] = await db.query(
  "SELECT COUNT(*) AS rtotal FROM post WHERE active='Y'"
);

const rtotalPages = Math.max(1, Math.ceil(rtotal / relatedLimit));
if (rpage > rtotalPages) rpage = rtotalPages;

const roffset = (rpage - 1) * relatedLimit;

const [relatedAll] = await db.query(
  `
  SELECT *
  FROM post
  WHERE active='Y'
  ORDER BY date DESC, time DESC
  LIMIT ? OFFSET ?
  `,
  [relatedLimit, roffset]
);
---

<MainLayout title="DPMPTSP Surabaya - Media">

<!-- HERO -->
<section class="bg-gradient-to-r from-blue-800 to-blue-900 py-16 text-center text-white">
  <h1 class="text-4xl font-bold mb-2">Media Berita & Artikel</h1>
  <p class="opacity-90">Informasi terkini DPMPTSP Kota Surabaya</p>
</section>

<div class="container mx-auto px-4 py-12 grid grid-cols-1 lg:grid-cols-4 gap-8">

  <!-- SIDEBAR -->
  <aside class="bg-white rounded-2xl shadow p-6">
    <h2 class="font-bold text-lg mb-4">Media Terkait</h2>

    <input
      id="search-related"
      placeholder="Cari judul..."
      class="w-full px-4 py-2 border rounded-xl mb-4 text-sm"
    />

    <div class="flex gap-2 mb-4 bg-slate-100 p-1 rounded-xl">
      <button data-type="berita" class="tab-btn active">Berita</button>
      <button data-type="artikel" class="tab-btn">Artikel</button>
    </div>

    <div id="related-list">
      {relatedAll.map(b => {
        const type =
          [1, 8].includes(b.id_category) ? "berita" : "artikel";
        return (
          <a
            href={`/media/${b.id_post}-${slugify(b.title)}`}
            class="related-item flex gap-3 mb-4"
            data-type={type}
          >
            <img
              src={`https://dpm-ptsp.surabaya.go.id/fileberita/${b.picture}`}
              class="w-16 h-16 rounded-lg object-cover"
            />
            <div>
              <span
                class={`text-xs px-2 py-1 rounded ${
                  type === "berita"
                    ? "bg-blue-100 text-blue-700"
                    : "bg-emerald-100 text-emerald-700"
                }`}
              >
                {type === "berita" ? "Berita" : "Artikel"}
              </span>
              <h3 class="text-sm font-semibold line-clamp-2">{b.title}</h3>
              <p class="text-xs text-slate-500">
                {new Date(b.date).toLocaleDateString("id-ID")}
              </p>
            </div>
          </a>
        );
      })}
    </div>

    <!-- PAGING SIDEBAR -->
    <div class="flex justify-between text-xs mt-4">
      {rpage > 1 && (
        <a href={`?page=${page}&rpage=${rpage - 1}`}>← Prev</a>
      )}
      <span>{rpage} / {rtotalPages}</span>
      {rpage < rtotalPages && (
        <a href={`?page=${page}&rpage=${rpage + 1}`}>Next →</a>
      )}
    </div>
  </aside>

  <!-- GRID UTAMA -->
  <section class="lg:col-span-3 grid grid-cols-1 md:grid-cols-2 gap-6">
    {rows.map(row => (
      <article class="bg-white rounded-2xl shadow hover:shadow-xl transition">
        <a href={`/media/${row.id_post}-${slugify(row.title)}`}>
          <img
            src={`https://dpm-ptsp.surabaya.go.id/fileberita/${row.picture}`}
            class="w-full h-56 object-cover"
          />
          <div class="p-6">
            <h3 class="font-bold text-blue-800 line-clamp-2">{row.title}</h3>
            <p class="text-sm text-gray-600 line-clamp-3 mt-2">
              {(row.ref_content || row.content || "").replace(/<[^>]+>/g, "")}
            </p>
          </div>
        </a>
      </article>
    ))}
  </section>
</div>

<!-- PAGINATION MAIN -->
<div class="flex justify-center my-12 gap-3 text-sm">
  {page > 1 && <a href={`?page=${page - 1}&rpage=${rpage}`}>← Prev</a>}
  <span>{page} / {totalPages}</span>
  {page < totalPages && <a href={`?page=${page + 1}&rpage=${rpage}`}>Next →</a>}
</div>

<script>
  const tabs = document.querySelectorAll(".tab-btn");
  const items = document.querySelectorAll(".related-item");
  const search = document.getElementById("search-related");
  let active = "berita";

  function render() {
    const q = search.value.toLowerCase();
    items.forEach(i => {
      const title = i.querySelector("h3").innerText.toLowerCase();
      i.classList.toggle(
        "hidden",
        !(i.dataset.type === active && title.includes(q))
      );
    });
  }

  tabs.forEach(t => {
    t.onclick = () => {
      active = t.dataset.type;
      tabs.forEach(b => b.classList.remove("active"));
      t.classList.add("active");
      render();
    };
  });

  search.oninput = render;
  render();
</script>

<style>
  .tab-btn {
    padding: 6px 14px;
    border-radius: 10px;
    font-size: 12px;
    background: #e5e7eb;
  }
  .tab-btn.active {
    background: #2563eb;
    color: white;
  }
</style>

</MainLayout>
