---
import MainLayout from "../layouts/MainLayout.astro";
import { db } from "../lib/db.js";
import { slugify } from "../utils/slugify";

/* ================== PAGING ================== */
const limit = 20;
let page = Number(Astro.url.searchParams.get("page") || 1);
if (page < 1) page = 1;

/* total data */
const [countRows] = await db.query(
  "SELECT COUNT(*) AS total FROM post WHERE active='Y'"
);
const total = countRows[0].total;
const totalPages = Math.max(1, Math.ceil(total / limit));
if (page > totalPages) page = totalPages;

const offset = (page - 1) * limit;

/* ================== DATA ================== */
let rows = [];
let beritaList = [];
let artikelList = [];

/* berita utama (paging) */
try {
  const [rowsData] = await db.query(
    `
    SELECT *
    FROM post
    WHERE active='Y'
    ORDER BY date DESC, time DESC, id_post DESC
    LIMIT ? OFFSET ?
    `,
    [limit, offset]
  );
  rows = rowsData;
} catch (e) {
  console.error("DB paging error:", e);
}

/* sidebar berita & artikel */
try {
  const [all] = await db.execute(
    "SELECT * FROM post WHERE active='Y' ORDER BY date DESC LIMIT 1000"
  );

  beritaList = all.filter(b => [1, 8].includes(b.id_category)).slice(0, 5);
  artikelList = all.filter(b => [2, 3].includes(b.id_category)).slice(0, 5);
} catch (e) {
  console.error("Sidebar error:", e);
}
---

<MainLayout title="DPMPTSP Surabaya - Berita & Artikel">

<!-- HERO -->
<section class="bg-gradient-to-r from-blue-800 to-blue-900 py-16 text-center text-white">
  <h1 class="text-4xl md:text-5xl font-bold mb-4">Media Berita & Artikel</h1>
  <p class="max-w-3xl mx-auto text-lg opacity-90">
    Informasi terkini seputar kegiatan dan artikel DPMPTSP Kota Surabaya
  </p>
</section>

<!-- CONTENT -->
<div class="container mx-auto px-4 py-12 grid grid-cols-1 lg:grid-cols-4 gap-8">

  <!-- SIDEBAR -->
  <aside class="bg-white rounded-2xl shadow p-6">
    <h2 class="text-xl font-bold mb-4 border-b pb-2">Media Terkait</h2>

    <input
      id="search-related"
      type="text"
      placeholder="Cari judul..."
      class="w-full mb-4 px-4 py-2 border rounded-xl text-sm"
    />

    <div class="flex gap-2 mb-4 bg-slate-100 p-1 rounded-xl w-fit">
      <button class="tab-btn bg-blue-600 text-white px-4 py-2 rounded-lg text-sm" data-category="berita">
        Berita
      </button>
      <button class="tab-btn px-4 py-2 rounded-lg text-sm text-slate-600" data-category="artikel">
        Artikel
      </button>
    </div>

    <div id="related-list">
      {beritaList.map(b => (
        <a
          href={`/media/${b.id_post}-${slugify(b.title)}`}
          class="related-item flex gap-3 mb-4"
          data-type="berita"
        >
          <img
            src={`https://dpm-ptsp.surabaya.go.id/fileberita/${b.picture}`}
            class="w-16 h-16 rounded-lg object-cover"
          />
          <div>
            <span class="text-xs bg-blue-100 text-blue-700 px-2 py-1 rounded">Berita</span>
            <h3 class="text-sm font-semibold line-clamp-2">{b.title}</h3>
            <p class="text-xs text-slate-500">
              {new Date(b.date).toLocaleDateString("id-ID")}
            </p>
          </div>
        </a>
      ))}

      {artikelList.map(b => (
        <a
          href={`/media/${b.id_post}-${slugify(b.title)}`}
          class="related-item hidden flex gap-3 mb-4"
          data-type="artikel"
        >
          <img
            src={`https://dpm-ptsp.surabaya.go.id/fileberita/${b.picture}`}
            class="w-16 h-16 rounded-lg object-cover"
          />
          <div>
            <span class="text-xs bg-emerald-100 text-emerald-700 px-2 py-1 rounded">Artikel</span>
            <h3 class="text-sm font-semibold line-clamp-2">{b.title}</h3>
            <p class="text-xs text-slate-500">
              {new Date(b.date).toLocaleDateString("id-ID")}
            </p>
          </div>
        </a>
      ))}
    </div>
  </aside>

  <!-- GRID BERITA -->
  <section id="berita-content" class="lg:col-span-3 grid grid-cols-1 md:grid-cols-2 gap-6">
    {rows.map(row => (
      <article
        key={row.id_post}
        class="bg-white rounded-2xl shadow hover:shadow-xl transition-all overflow-hidden"
      >
        <a href={`/media/${row.id_post}-${slugify(row.title)}`} class="block h-full">
          <img
            src={`https://dpm-ptsp.surabaya.go.id/fileberita/${row.picture}`}
            class="w-full h-56 object-cover"
            alt={row.title}
          />
          <div class="p-6 flex flex-col h-full">
            <h3 class="text-lg font-bold text-blue-800 mb-2 line-clamp-2">
              {row.title}
            </h3>
            <p class="text-sm text-gray-600 line-clamp-3 mb-4">
              {(row.ref_content || row.content || "").replace(/<[^>]+>/g, "")}
            </p>
            <div class="mt-auto flex justify-between text-xs text-gray-500">
              <span>{new Date(row.date).toLocaleDateString("id-ID")}</span>
              <span class="text-blue-600 font-semibold">Baca →</span>
            </div>
          </div>
        </a>
      </article>
    ))}
  </section>
</div>

<!-- PAGINATION -->
<div class="flex justify-center my-12">
  <nav class="flex gap-3 text-sm">
    {page > 1 && (
      <a href={`?page=${page - 1}`} class="px-4 py-2 bg-white shadow rounded-lg">
        ← Prev
      </a>
    )}

    <span class="px-4 py-2 text-gray-600">
      Halaman {page} / {totalPages}
    </span>

    {page < totalPages && (
      <a href={`?page=${page + 1}`} class="px-4 py-2 bg-white shadow rounded-lg">
        Next →
      </a>
    )}
  </nav>
</div>

<script>
  const tabs = document.querySelectorAll(".tab-btn");
  const items = document.querySelectorAll(".related-item");
  const search = document.getElementById("search-related");
  let active = "berita";

  function render() {
    const q = search.value.toLowerCase();
    items.forEach(i => {
      const title = i.querySelector("h3").innerText.toLowerCase();
      i.classList.toggle(
        "hidden",
        !(i.dataset.type === active && title.includes(q))
      );
    });
  }

  tabs.forEach(t => {
    t.onclick = () => {
      active = t.dataset.category;
      tabs.forEach(b => b.classList.remove("bg-blue-600", "text-white"));
      t.classList.add("bg-blue-600", "text-white");
      render();
    };
  });

  search.oninput = render;
</script>

</MainLayout>
