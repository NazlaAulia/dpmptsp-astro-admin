    <script is:inline>
      const formPengaduan =
        document.getElementById("formPengaduan");

      const hasilTiket =
        document.getElementById("hasilTiket");

      const nomorTiketElement =
        document.getElementById("nomorTiket");

      const copyTiket =
        document.getElementById("copyTiket");

      const statusPengiriman =
        document.getElementById("statusPengiriman");

      const formTracking =
        document.getElementById("formTracking");

      const inputTracking =
        document.getElementById("inputTracking");

      const hasilTracking =
        document.getElementById("hasilTracking");


      /* =====================================================
         SUBMIT PENGADUAN
      ====================================================== */

      formPengaduan?.addEventListener(
        "submit",
        async (event) => {

          event.preventDefault();

          const button =
            document.getElementById("btnKirim");

          const nama =
            document.getElementById("nama")
              ?.value
              .trim() || "";

          const telepon =
            document.getElementById("telepon")
              ?.value
              .trim() || "";

          const kategori =
            document.getElementById("kategori")
              ?.value || "";

          const email =
            document.getElementById("email")
              ?.value
              .trim() || "";

          const subjek =
            document.getElementById("subjek")
              ?.value
              .trim() || "";

          const pesan =
            document.getElementById("pesan")
              ?.value
              .trim() || "";


          /* VALIDASI */

          if (
            !nama ||
            !telepon ||
            !kategori ||
            !email ||
            !subjek ||
            !pesan
          ) {

            alert(
              "Mohon lengkapi seluruh data pengaduan."
            );

            return;
          }


          /* LOADING */

          if (button) {

            button.disabled = true;

            button.innerHTML =
              '<i class="fas fa-spinner fa-spin"></i> Mengirim...';

          }


          if (statusPengiriman) {

            statusPengiriman.textContent =
              "Sedang menyimpan pengaduan...";

          }


          try {

            /*
             * PENTING
             *
             * Tidak ada:
             *
             * wa.me
             * whatsapp.com
             * window.open()
             * location.href
             *
             * Pengiriman dilakukan oleh SERVER
             */

            const response =
              await fetch(
                "/api/kontak",
                {
                  method: "POST",

                  headers: {
                    "Content-Type":
                      "application/json",

                    "Accept":
                      "application/json"
                  },

                  body: JSON.stringify({
                    nama,
                    telepon,
                    kategori,
                    email,
                    subjek,
                    pesan
                  })
                }
              );


            let result = null;

            try {

              result =
                await response.json();

            } catch {

              result = null;

            }


            /* ERROR */

            if (!response.ok) {

              throw new Error(
                result?.message ||
                "Terjadi kesalahan saat menyimpan pengaduan."
              );

            }


            /* TIKET */

            const tiket =
              result?.tiket ||
              result?.data?.tiket ||
              "";


            if (!tiket) {

              throw new Error(
                "Pengaduan tersimpan tetapi nomor tiket tidak diterima dari server."
              );

            }


            /* TAMPILKAN TIKET */

            if (nomorTiketElement) {

              nomorTiketElement.textContent =
                tiket;

            }


            /* STATUS */

            if (statusPengiriman) {

              statusPengiriman.innerHTML =
                '<i class="fas fa-circle-check mr-1"></i> Pengaduan berhasil diterima sistem.';

            }


            /* HASIL */

            if (hasilTiket) {

              hasilTiket.classList.remove(
                "hidden"
              );

            }


            /* RESET */

            formPengaduan.reset();


            /* SCROLL */

            hasilTiket?.scrollIntoView({
              behavior: "smooth",
              block: "center"
            });


          } catch (error) {

            console.error(
              "ERROR PENGADUAN:",
              error
            );


            if (statusPengiriman) {

              statusPengiriman.innerHTML =
                '<span class="text-red-600"><i class="fas fa-circle-xmark mr-1"></i> Pengaduan gagal dikirim.</span>';

            }


            alert(
              error instanceof Error
                ? error.message
                : "Terjadi kesalahan saat mengirim pengaduan."
            );


          } finally {

            if (button) {

              button.disabled = false;

              button.innerHTML =
                '<i class="fas fa-paper-plane"></i> Kirim Pengaduan';

            }

          }

        }
      );


      /* =====================================================
         COPY TIKET
      ====================================================== */

      copyTiket?.addEventListener(
        "click",
        async () => {

          const tiket =
            nomorTiketElement
              ?.textContent
              ?.trim();


          if (!tiket) {

            return;

          }


          try {

            await navigator.clipboard.writeText(
              tiket
            );


            copyTiket.innerHTML =
              '<i class="fas fa-check"></i> Tersalin';


            setTimeout(
              () => {

                copyTiket.innerHTML =
                  '<i class="fas fa-copy"></i> Salin Tiket';

              },
              2000
            );


          } catch {

            alert(
              "Nomor tiket: " + tiket
            );

          }

        }
      );


      /* =====================================================
         TRACKING
      ====================================================== */

      formTracking?.addEventListener(
        "submit",
        async (event) => {

          event.preventDefault();


          const tiket =
            inputTracking
              ?.value
              ?.trim()
              .toUpperCase();


          if (!tiket) {

            tampilkanTrackingError(
              "Silakan masukkan nomor tiket."
            );

            return;

          }


          hasilTracking?.classList.remove(
            "hidden"
          );


          if (hasilTracking) {

            hasilTracking.innerHTML = `
              <div class="rounded-xl border border-blue-200 bg-blue-50 p-4 text-blue-800">
                <div class="flex items-center gap-3">
                  <i class="fas fa-spinner fa-spin"></i>
                  <span>Memeriksa tiket...</span>
                </div>
              </div>
            `;

          }


          try {

            const response =
              await fetch(
                "/api/kontak?tiket=" +
                encodeURIComponent(tiket),
                {
                  method: "GET",

                  headers: {
                    "Accept":
                      "application/json"
                  }
                }
              );


            let result = null;

            try {

              result =
                await response.json();

            } catch {

              result = null;

            }


            if (!response.ok) {

              throw new Error(
                result?.message ||
                "Tiket tidak ditemukan."
              );

            }


            const data =
              result?.data ||
              result;


            if (!data?.tiket) {

              throw new Error(
                "Data tiket tidak ditemukan."
              );

            }


            let tanggal = "-";


            if (data.tanggal) {

              const parsedDate =
                new Date(
                  data.tanggal
                );


              if (
                !Number.isNaN(
                  parsedDate.getTime()
                )
              ) {

                tanggal =
                  parsedDate.toLocaleString(
                    "id-ID",
                    {
                      dateStyle:
                        "long",

                      timeStyle:
                        "short"
                    }
                  );

              }

            }


            if (hasilTracking) {

              hasilTracking.innerHTML = `

                <div class="rounded-2xl border border-blue-200 bg-blue-50 p-5 md:p-6">

                  <div class="flex items-start gap-4">

                    <div class="w-11 h-11 shrink-0 rounded-full bg-blue-100 text-blue-700 flex items-center justify-center">

                      <i class="fas fa-ticket"></i>

                    </div>


                    <div class="flex-1">

                      <div class="flex flex-wrap items-center justify-between gap-3">

                        <div>

                          <p class="text-xs text-gray-500">
                            Nomor Tiket
                          </p>

                          <h3 class="text-lg font-bold text-blue-800">
                            ${escapeHtml(data.tiket)}
                          </h3>

                        </div>


                        <span class="inline-flex items-center gap-2 px-3 py-2 rounded-full bg-yellow-100 text-yellow-800 text-sm font-semibold">

                          <i class="fas fa-clock"></i>

                          ${escapeHtml(
                            data.status ||
                            "Diterima"
                          )}

                        </span>

                      </div>


                      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-5">


                        <div class="rounded-xl bg-white p-4 border border-blue-100">

                          <p class="text-xs text-gray-500">
                            Nama Pelapor
                          </p>

                          <p class="font-semibold text-gray-800 mt-1">
                            ${escapeHtml(data.nama)}
                          </p>

                        </div>


                        <div class="rounded-xl bg-white p-4 border border-blue-100">

                          <p class="text-xs text-gray-500">
                            Nomor Telepon / WhatsApp
                          </p>

                          <p class="font-semibold text-gray-800 mt-1">
                            ${escapeHtml(data.telepon)}
                          </p>

                        </div>


                        <div class="rounded-xl bg-white p-4 border border-blue-100">

                          <p class="text-xs text-gray-500">
                            Kategori
                          </p>

                          <p class="font-semibold text-gray-800 mt-1">
                            ${escapeHtml(
                              data.kategori ||
                              "-"
                            )}
                          </p>

                        </div>


                        <div class="rounded-xl bg-white p-4 border border-blue-100">

                          <p class="text-xs text-gray-500">
                            Subjek
                          </p>

                          <p class="font-semibold text-gray-800 mt-1">
                            ${escapeHtml(
                              data.subjek
                            )}
                          </p>

                        </div>


                        <div class="rounded-xl bg-white p-4 border border-blue-100 sm:col-span-2">

                          <p class="text-xs text-gray-500">
                            Tanggal Pengaduan
                          </p>

                          <p class="font-semibold text-gray-800 mt-1">
                            ${escapeHtml(tanggal)}
                          </p>

                        </div>


                      </div>


                      <div class="mt-4 rounded-xl bg-white p-4 border border-blue-100">

                        <p class="text-xs text-gray-500">
                          Pesan
                        </p>

                        <p class="text-gray-700 mt-1 leading-relaxed whitespace-pre-line">
                          ${escapeHtml(
                            data.pesan
                          )}
                        </p>

                      </div>


                      <p class="text-xs text-gray-500 mt-4">

                        Status akan diperbarui sesuai proses
                        tindak lanjut pengaduan.

                      </p>

                    </div>

                  </div>

                </div>

              `;

            }


          } catch (error) {

            console.error(
              "ERROR TRACKING:",
              error
            );


            tampilkanTrackingError(
              error instanceof Error
                ? error.message
                : "Tiket tidak ditemukan."
            );

          }

        }
      );


      /* =====================================================
         ERROR TRACKING
      ====================================================== */

      function tampilkanTrackingError(
        message
      ) {

        if (!hasilTracking) {

          return;

        }


        hasilTracking.classList.remove(
          "hidden"
        );


        hasilTracking.innerHTML = `

          <div class="rounded-xl border border-red-200 bg-red-50 p-4 text-red-700">

            <div class="flex items-start gap-3">

              <i class="fas fa-circle-xmark mt-1"></i>

              <div>

                <p class="font-bold">
                  Tiket tidak ditemukan
                </p>

                <p class="text-sm mt-1">
                  ${escapeHtml(message)}
                </p>

              </div>

            </div>

          </div>

        `;

      }


      /* =====================================================
         ESCAPE HTML
      ====================================================== */

      function escapeHtml(
        value
      ) {

        return String(
          value ?? ""
        )
          .replaceAll(
            "&",
            "&amp;"
          )
          .replaceAll(
            "<",
            "&lt;"
          )
          .replaceAll(
            ">",
            "&gt;"
          )
          .replaceAll(
            '"',
            "&quot;"
          )
          .replaceAll(
            "'",
            "&#039;"
          );

      }
    </script>

