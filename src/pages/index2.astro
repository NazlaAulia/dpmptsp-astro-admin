  <style>
  .fadeChange {
    animation: fadeChange .5s ease;
  }
  @keyframes fadeChange {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Entrance animation: masuk dari luar layar */
  .hero-slide-left {
    animation: heroSlideLeft 1.8s cubic-bezier(.22,1,.36,1) both;
  }
  .hero-slide-right {
    animation: heroSlideRight 1.8s cubic-bezier(.22,1,.36,1) both;
    animation-delay: .25s;
  }
  @keyframes heroSlideLeft {
    from { opacity: 0; transform: translateX(-100vw); }
    to { opacity: 1; transform: translateX(0); }
  }
  @keyframes heroSlideRight {
    from { opacity: 0; transform: translateX(100vw); }
    to { opacity: 1; transform: translateX(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    #bg { transition: none !important; }
    .fadeChange { animation: none !important; }
    .hero-slide-left, .hero-slide-right { animation: none !important; }
  }
  </style>

  <script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const track = document.getElementById('appTrack');
    const slides = document.querySelectorAll('.app-slide');
    const dotsWrap = document.getElementById('appDots');
    const prevBtn = document.getElementById('appPrev');
    const nextBtn = document.getElementById('appNext');
    const heroBg = document.getElementById('bg');
    const heroTitle = document.getElementById('heroTitle');
    const heroSub = document.getElementById('heroSub');

    if (!track || slides.length === 0) return;

    let idx = 0;

    // buat dot indicator sejumlah slide
    slides.forEach((_, i) => {
      const dot = document.createElement('button');
      dot.setAttribute('aria-label', `Ke item ${i + 1}`);
      dot.className = 'w-2.5 h-2.5 rounded-full transition-all duration-300 ' +
        (i === 0 ? 'bg-[#FFC72C] w-6' : 'bg-white/30');
      dot.addEventListener('click', () => goTo(i));
      dotsWrap.appendChild(dot);
    });
    const dots = dotsWrap.querySelectorAll('button');

    function updateHeroText(el) {
      if (el.dataset.bg) heroBg.src = el.dataset.bg;
      [heroTitle, heroSub].forEach(t => {
        t.classList.remove('fadeChange');
        void t.offsetWidth;
        t.classList.add('fadeChange');
      });
      heroTitle.textContent = el.dataset.title;
      heroSub.textContent = el.dataset.sub;
    }

    function goTo(i) {
      idx = (i + slides.length) % slides.length;
      track.style.transform = `translateX(-${idx * 100}%)`;

      dots.forEach((d, di) => {
        d.className = 'h-2.5 rounded-full transition-all duration-300 ' +
          (di === idx ? 'bg-[#FFC72C] w-6' : 'bg-white/30 w-2.5');
      });

      updateHeroText(slides[idx]);
    }

    prevBtn.addEventListener('click', () => goTo(idx - 1));
    nextBtn.addEventListener('click', () => goTo(idx + 1));

    goTo(0);

    // Auto-slide
    let autoSlide = setInterval(() => goTo(idx + 1), 4000);

    const wrapper = track.closest('.hero-slide-right');
    wrapper?.addEventListener('mouseenter', () => clearInterval(autoSlide));
    wrapper?.addEventListener('mouseleave', () => {
      autoSlide = setInterval(() => goTo(idx + 1), 4000);
    });
  });
  </script>

