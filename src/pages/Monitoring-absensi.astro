---

<MainLayout title="Monitoring Absensi 2025">

<div class="max-w-7xl mx-auto p-6">

    <h1 class="text-3xl font-bold text-blue-700 mb-6">
        📋 Monitoring Absensi Pegawai (Semua Hadir)
    </h1>

    <!-- TABLE -->
    <div class="bg-white rounded-xl shadow overflow-hidden mb-10">
        <table class="min-w-full">
            <thead class="bg-blue-700 text-white">
                <tr>
                    <th class="p-3">No</th>
                    <th>NIP</th>
                    <th>Nama</th>
                    <th>Jam Masuk</th>
                    <th>Status</th>
                </tr>
            </thead>

            <tbody>
                {pegawai.map((p, i) => (
                    <tr class="border-b hover:bg-gray-50">
                        <td class="p-3 text-center">{i+1}</td>
                        <td>{p.nip}</td>
                        <td>{p.nama}</td>
                        <td>{p.jam}</td>
                        <td>
                            {p.status === "Tepat Waktu" && (
                                <span class="bg-green-100 text-green-700 px-3 py-1 rounded-full">
                                    Tepat Waktu
                                </span>
                            )}

                            {p.status === "Terlambat" && (
                                <span class="bg-yellow-100 text-yellow-700 px-3 py-1 rounded-full">
                                    Terlambat ({p.telat} menit)
                                </span>
                            )}
                        </td>
                    </tr>
                ))}
            </tbody>
        </table>
    </div>

    <!-- REKAP -->
    <div class="bg-white rounded-xl shadow overflow-hidden">
        <div class="p-4 font-bold text-blue-700 text-xl">
            📊 Rekapitulasi Absensi Per Bulan (2025)
        </div>

        <table class="min-w-full">
            <thead class="bg-gray-100">
                <tr>
                    <th class="p-3">Bulan</th>
                    <th>Jumlah Pegawai</th>
                    <th>Tepat Waktu</th>
                    <th>Terlambat</th>
                </tr>
            </thead>

            <tbody>
                {rekap.map((r) => (
                    <tr class="border-b hover:bg-gray-50">
                        <td class="p-3 font-semibold">{r.bulan}</td>
                        <td class="text-center">{r.pegawai}</td>
                        <td class="text-center text-green-600 font-bold">{r.tepat}</td>
                        <td class="text-center text-yellow-600 font-bold">{r.terlambat}</td>
                    </tr>
                ))}
            </tbody>
        </table>
    </div>

</div>

</MainLayout>