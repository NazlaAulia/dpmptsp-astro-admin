const total = pegawai.length;
const lapor = pegawai.filter(p => p.status === "Lapor").length;
const belum = pegawai.filter(p => p.status === "Belum Lapor").length;
const verif = pegawai.filter(p => p.status === "Terverifikasi").length;
---



<MainLayout title="Monitoring Gratifikasi">

<div class="max-w-7xl mx-auto p-6">

    <!-- HEADER -->
    <div class="mb-6">
        <h1 class="text-3xl font-bold text-blue-700">
            📊 Monitoring Gratifikasi Pegawai
        </h1>
        <p class="text-gray-500">
            Rekapitulasi seluruh pegawai 
        </p>
    </div>

    <!-- SUMMARY -->
    <div class="grid md:grid-cols-4 gap-4 mb-8">

        <div class="bg-blue-600 text-white rounded-xl p-5">
            <div class="text-3xl font-bold">{total}</div>
            <div>Total Pegawai</div>
        </div>

        <div class="bg-yellow-500 text-white rounded-xl p-5">
            <div class="text-3xl font-bold">{belum}</div>
            <div>Belum Lapor</div>
        </div>

        <div class="bg-green-600 text-white rounded-xl p-5">
            <div class="text-3xl font-bold">{lapor}</div>
            <div>Sudah Lapor</div>
        </div>

        <div class="bg-purple-600 text-white rounded-xl p-5">
            <div class="text-3xl font-bold">{verif}</div>
            <div>Terverifikasi</div>
        </div>

    </div>

    <!-- TABLE -->
    <div class="bg-white rounded-xl shadow overflow-hidden">

        <table class="w-full">

            <thead class="bg-slate-800 text-white">
                <tr>
                    <th class="p-3 text-left">No</th>
                    <th class="p-3 text-left">NIP</th>
                    <th class="p-3 text-left">Nama Pegawai</th>
                    <th class="p-3 text-center">Status</th>
                    <th class="p-3 text-center">Waktu Lapor</th>
                </tr>
            </thead>

            <tbody>

                {pegawai.map((p, i) => (

                    <tr class="border-b hover:bg-gray-50">

                        <td class="p-3">{i + 1}</td>
                        <td class="p-3">{p.nip}</td>
                        <td class="p-3 font-medium">{p.nama}</td>

                        <td class="p-3 text-center">

                            {p.status === "Belum Lapor" && (
                                <span class="bg-red-100 text-red-700 px-3 py-1 rounded-full text-sm">
                                    ❌ Belum Lapor
                                </span>
                            )}

                            {p.status === "Lapor" && (
                                <span class="bg-yellow-100 text-yellow-700 px-3 py-1 rounded-full text-sm">
                                    ⏳ Lapor
                                </span>
                            )}

                            {p.status === "Terverifikasi" && (
                                <span class="bg-green-100 text-green-700 px-3 py-1 rounded-full text-sm">
                                    ✅ Terverifikasi
                                </span>
                            )}

                        </td>

                        <td class="p-3 text-center text-gray-600">
                            {p.waktu}
                        </td>

                    </tr>

                ))}

            </tbody>

        </table>

    </div>

</div>

</MainLayout>