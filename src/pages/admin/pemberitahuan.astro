---
import AdminShell from "../../components/admin/AdminShell.astro";
import { db } from "../../lib/db.js";

const [semuaPemberitahuan] = await db.query(
  "SELECT id, judul, foto, link_url, status_aktif, tipe, urutan, created_at, updated_at FROM pemberitahuan ORDER BY urutan ASC, created_at DESC"
);
---

<AdminShell title="Pemberitahuan" subtitle="Kelola pemberitahuan, popup modal, dan notifikasi yang ditampilkan di website publik." actionLabel="Tambah Pemberitahuan" actionHref="/admin/tambah-pemberitahuan">
  <div class="table-container">
    <div class="table-scroll">
    <table class="data-table">
      <thead>
        <tr>
          <th>ID</th>
          <th>Judul</th>
          <th>Tipe</th>
          <th>Status</th>
          <th>Foto</th>
          <th>Aksi</th>
        </tr>
      </thead>
      <tbody>
        {semuaPemberitahuan.map((item) => (
          <tr>
            <td>{item.id}</td>
            <td class="judul-cell">{item.judul}</td>
            <td>
              <span class={`badge badge-${item.tipe === 'modal' ? 'warning' : 'info'}`}>
                {item.tipe === 'modal' ? 'Popup Modal' : 'Notifikasi'}
              </span>
            </td>
            <td>
              <span class={`status ${item.status_aktif === 'Y' ? 'aktif' : 'nonaktif'}`}>
                {item.status_aktif === 'Y' ? 'Aktif' : 'Nonaktif'}
              </span>
            </td>
            <td>
              {item.foto && (
                <img src={`/uploads/${item.foto}`} alt={item.judul} class="thumb-img" />
              )}
              {!item.foto && <span class="text-muted">-</span>}
            </td>
            <td>
              <div class="action-buttons">
                <button class="btn-icon btn-edit" title="Edit" data-id={item.id}>
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                </button>
                <button class="btn-icon btn-delete" title="Hapus" data-id={item.id}>
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                </button>
              </div>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>

    <div class="pagination-footer">
      <span class="page-info">Total: {semuaPemberitahuan.length} pemberitahuan</span>
    </div>
  </div>

  <!-- Modal Konfirmasi Hapus -->
  <div class="modal-overlay" id="delete-modal" style="display: none;">
    <div class="modal-card">
      <div class="modal-icon-wrapper delete-icon-bg">
        <span class="modal-exclamation">!</span>
      </div>
      <h2>Hapus Pemberitahuan?</h2>
      <p>Apakah Anda yakin ingin menghapus pemberitahuan ini?</p>
      <div class="modal-actions">
        <button class="modal-btn btn-batal" id="delete-batal">Batal</button>
        <button class="modal-btn btn-hapus" id="delete-ya">Hapus</button>
      </div>
    </div>
  </div>

  <!-- Modal Konfirmasi Edit -->
  <div class="modal-overlay" id="edit-modal" style="display: none;">
    <div class="modal-card">
      <div class="modal-icon-wrapper edit-icon-bg">
        <span class="modal-exclamation">!</span>
      </div>
      <h2>Edit Pemberitahuan?</h2>
      <p>Apakah Anda yakin ingin mengedit pemberitahuan ini?</p>
      <div class="modal-actions">
        <button class="modal-btn btn-batal" id="edit-batal">Batal</button>
        <button class="modal-btn btn-ya-edit" id="edit-ya">Ya, Edit</button>
      </div>
    </div>
  </div>
</AdminShell>

<style>
  .table-container {
    background: white;
    border-radius: 16px;
    box-shadow: 0 12px 30px rgba(15, 23, 42, 0.06);
    padding: 16px;
  }

  .table-scroll {
    max-height: calc(100vh - 330px);
    min-height: 220px;
    overflow: auto;
    border: 1px solid #e5eaf2;
    border-radius: 12px;
  }

  :global(.data-table) {
    width: 100%;
    border-collapse: collapse;
    table-layout: auto;
    font-size: 0.9rem;
  }

  :global(.data-table th),
  :global(.data-table td) {
    padding: 14px 12px;
    border-bottom: 1px solid #f1f5f9;
    vertical-align: top;
  }

  :global(.data-table th) {
    position: sticky;
    top: 0;
    z-index: 1;
    background: #f8fafc;
  }

  .judul-cell {
    font-weight: 600;
    color: #0f172a;
  }

  .badge {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 12px;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .badge-info {
    background: #dbeafe;
    color: #0369a1;
  }

  .badge-warning {
    background: #fef3c7;
    color: #b45309;
  }

  .status {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 12px;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .status.aktif {
    background: #dcfce7;
    color: #166534;
  }

  .status.nonaktif {
    background: #fee2e2;
    color: #991b1b;
  }

  .thumb-img {
    width: 60px;
    height: 60px;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid #e2e8f0;
  }

  .text-muted {
    color: #94a3b8;
  }

  :global(.action-buttons) {
    display: flex;
    gap: 12px;
    align-items: center;
  }

  :global(.btn-icon) {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    width: 42px !important;
    height: 42px !important;
    padding: 0 !important;
    border: none !important;
    border-radius: 12px !important;
    cursor: pointer !important;
    transition: all 0.2s ease !important;
    box-sizing: border-box !important;
  }

  :global(.btn-icon svg) {
    width: 22px !important;
    height: 22px !important;
    display: block !important;
  }

  :global(.btn-edit) {
    color: #2563eb !important;
    background: #dbeafe !important;
  }

  :global(.btn-edit:hover) {
    background: #bfdbfe !important;
  }

  :global(.btn-delete) {
    color: #ef4444 !important;
    background: #fee2e2 !important;
  }

  :global(.btn-delete:hover) {
    background: #fecaca !important;
  }

  .pagination-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 16px;
    margin-top: 8px;
    border-top: 1px solid #f1f5f9;
    font-size: 0.85rem;
    color: #64748b;
  }

  .page-info {
    font-weight: 600;
  }

  .modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(15, 23, 42, 0.5);
    backdrop-filter: blur(4px);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 9999;
  }

  .modal-card {
    background: white;
    width: 100%;
    max-width: 480px;
    border-radius: 24px;
    padding: 36px 32px;
    text-align: center;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    animation: modalScaleIn 0.25s ease-out;
  }

  @keyframes modalScaleIn {
    from {
      transform: scale(0.95);
      opacity: 0;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }

  .modal-icon-wrapper {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    margin: 0 auto 20px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .edit-icon-bg {
    background: #fee2e2;
  }

  .delete-icon-bg {
    background: #fee2e2;
  }

  .modal-exclamation {
    font-size: 40px;
    font-weight: 800;
    color: #ef4444;
    line-height: 1;
  }

  .modal-card h2 {
    font-size: 1.5rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 12px;
  }

  .modal-card p {
    font-size: 0.95rem;
    color: #64748b;
    margin: 0 0 28px;
    line-height: 1.5;
  }

  .modal-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
  }

  .modal-btn {
    padding: 12px 28px;
    border-radius: 12px;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
    border: none;
  }

  .btn-batal {
    background: #e2e8f0;
    color: #1e293b;
  }

  .btn-batal:hover {
    background: #cbd5e1;
  }

  .btn-ya-edit {
    background: #2563eb;
    color: white;
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
  }

  .btn-ya-edit:hover {
    background: #1d4ed8;
  }

  .btn-hapus {
    background: #ef4444;
    color: white;
    box-shadow: 0 4px 12px rgba(239, 68, 68, 0.25);
  }

  .btn-hapus:hover {
    background: #dc2626;
  }
</style>

<script>
  let selectedId = null;

  document.querySelectorAll(".btn-edit").forEach(btn => {
    btn.addEventListener("click", () => {
      selectedId = parseInt(btn.getAttribute("data-id"));
      document.getElementById("edit-modal").style.display = "flex";
    });
  });

  document.querySelectorAll(".btn-delete").forEach(btn => {
    btn.addEventListener("click", () => {
      selectedId = parseInt(btn.getAttribute("data-id"));
      document.getElementById("delete-modal").style.display = "flex";
    });
  });

  document.getElementById("edit-batal").addEventListener("click", () => {
    document.getElementById("edit-modal").style.display = "none";
    selectedId = null;
  });

  document.getElementById("edit-ya").addEventListener("click", () => {
    if (selectedId) {
      window.location.href = `/admin/edit-pemberitahuan?id=${selectedId}`;
    }
  });

  document.getElementById("delete-batal").addEventListener("click", () => {
    document.getElementById("delete-modal").style.display = "none";
    selectedId = null;
  });

  document.getElementById("delete-ya").addEventListener("click", async () => {
    if (selectedId) {
      try {
        const response = await fetch("/api/pemberitahuan", {
          method: "DELETE",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ id: selectedId })
        });

        const result = await response.json();
        if (result.success) {
          window.location.reload();
        } else {
          alert("Gagal menghapus pemberitahuan");
        }
      } catch (error) {
        console.error("Error:", error);
        alert("Terjadi kesalahan saat menghapus pemberitahuan");
      }
    }
  });
</script>
