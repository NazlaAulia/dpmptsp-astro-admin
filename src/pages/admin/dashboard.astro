---
import Sidebar from "../../components/admin/Sidebar.astro";
import Navbar from "../../components/admin/Navbar.astro";
import AdminShell from "../../components/admin/AdminShell.astro";

// Sample data
const chartData = [
  { label: "Jan", value: 45 },
  { label: "Feb", value: 52 },
  { label: "Mar", value: 48 },
  { label: "Apr", value: 61 },
  { label: "Mei", value: 55 },
];

const quickActions = [
  { href: "/admin/artikel", title: "Tambah Artikel", caption: "Buat artikel baru" },
  { href: "/admin/kinerja", title: "Lihat Kinerja", caption: "Analisis konten" },
  { href: "/admin/layanan", title: "Kelola Layanan", caption: "Update layanan" },
];

const activity = [
  { title: "Artikel diterbitkan", detail: "2 artikel baru dipublikasikan hari ini" },
  { title: "Komentar baru", detail: "5 komentar menunggu moderasi" },
  { title: "Backup sistem", detail: "Backup otomatis selesai dengan sukses" },
];
---

<div class="admin">
  <Sidebar />

  <div class="main">
    <Navbar />

    <div class="content">
      <h1>Dashboard Admin</h1>

      <!-- Kartu Statistik -->
      <div class="cards">
        <div class="card">
          <div class="card-header-info">
            <h3>Artikel</h3>
            <span class="badge-blue">Total</span>
          </div>
          <p>20</p>
        </div>
      </div>

  <div class="main-grid">
    <section class="panel">
      <div class="panel-header">
        <div>
          <p class="panel-eyebrow">Kinerja konten</p>
          <h3>Tren publikasi bulan ini</h3>
        </div>
        <a href="/admin/artikel">Lihat detail</a>
      </div>

      <div class="chart-container">
        {chartData.map((item) => (
          <div class="bar-column">
            <div class="bar" style={`height: ${item.value}%`} />
            <span>{item.label}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="panel">
      <div class="panel-header">
        <div>
          <p class="panel-eyebrow">Aksi cepat</p>
          <h3>Perintah yang sering dipakai</h3>
        </div>
      </div>

      <div class="action-list">
        {quickActions.map((item) => (
          <a href={item.href} class="action-item">
            <strong>{item.title}</strong>
            <span>{item.caption}</span>
          </a>
        ))}
      </div>
    </section>
  </div>

  <section class="panel activity-panel">
    <div class="panel-header">
      <div>
        <p class="panel-eyebrow">Aktivitas terkini</p>
        <h3>Riwayat terbaru admin</h3>
      </div>
    </div>

    <div class="activity-list">
      {activity.map((item) => (
        <article class="activity-item">
          <div class="dot" />
          <div>
            <h4>{item.title}</h4>
            <p>{item.detail}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</AdminShell>

<style>
.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 16px;
}

.stat-card {
  padding: 18px 20px;
  border-radius: 18px;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12px;
  box-shadow: 0 12px 30px rgba(15, 23, 42, 0.06);
}

.stat-card h2 {
  margin: 4px 0 0;
  font-size: 1.7rem;
}

.stat-label {
  margin: 0;
  font-size: 0.84rem;
  font-weight: 700;
  color: #64748b;
  text-transform: uppercase;
  letter-spacing: 0.12em;
}

.stat-pill {
  font-size: 0.78rem;
  padding: 7px 10px;
  border-radius: 999px;
  white-space: nowrap;
  font-weight: 700;
}

.stat-card.blue {
  background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
  color: #1d4ed8;
}

.stat-card.blue .stat-pill {
  background: rgba(37, 99, 235, 0.12);
  color: #1d4ed8;
}

.stat-card.purple {
  background: linear-gradient(135deg, #f5f3ff 0%, #ede9fe 100%);
  color: #6d28d9;
}

.stat-card.purple .stat-pill {
  background: rgba(109, 40, 217, 0.12);
  color: #6d28d9;
}

.stat-card.green {
  background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
  color: #15803d;
}

.stat-card.green .stat-pill {
  background: rgba(21, 128, 61, 0.12);
  color: #15803d;
}

.stat-card.amber {
  background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%);
  color: #b45309;
}

.stat-card.amber .stat-pill {
  background: rgba(180, 83, 9, 0.12);
  color: #b45309;
}

.main-grid {
  display: grid;
  grid-template-columns: 1.4fr 1fr;
  gap: 16px;
}

.panel {
  padding: 20px;
  border-radius: 20px;
  background: white;
  box-shadow: 0 12px 30px rgba(15, 23, 42, 0.06);
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
}

.panel-header h3 {
  margin: 2px 0 0;
  font-size: 1rem;
}

.panel-eyebrow {
  margin: 0;
  font-size: 0.76rem;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  font-weight: 700;
  color: #2563eb;
}

.panel-header a {
  text-decoration: none;
  color: #2563eb;
  font-weight: 700;
}

.chart-container {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 10px;
  height: 220px;
  padding-top: 8px;
}

.bar-column {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}

.bar {
  width: 100%;
  max-width: 38px;
  border-radius: 999px 999px 8px 8px;
  background: linear-gradient(180deg, #60a5fa 0%, #2563eb 100%);
  min-height: 10px;
}

.bar-column span {
  font-size: 0.76rem;
  color: #64748b;
  font-weight: 600;
}

.action-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.action-item {
  display: flex;
  flex-direction: column;
  gap: 3px;
  padding: 12px 14px;
  border-radius: 14px;
  text-decoration: none;
  background: #f8fafc;
  color: #0f172a;
  border: 1px solid #e2e8f0;
}

.action-item strong {
  font-size: 0.95rem;
}

.action-item span {
  font-size: 0.84rem;
  color: #64748b;
}

.activity-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.activity-item {
  display: flex;
  gap: 10px;
  align-items: flex-start;
  padding: 10px 2px;
}

.dot {
  width: 10px;
  height: 10px;
  border-radius: 99px;
  margin-top: 7px;
  background: linear-gradient(135deg, #2563eb 0%, #38bdf8 100%);
  box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.14);
}

.activity-item h4 {
  margin: 0 0 3px;
  font-size: 0.95rem;
}

.activity-item p {
  margin: 0;
  color: #64748b;
  font-size: 0.9rem;
}

@media (max-width: 1000px) {
  .main-grid {
    grid-template-columns: 1fr;
  }
}
</style>