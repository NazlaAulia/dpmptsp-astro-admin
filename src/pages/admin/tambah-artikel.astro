---
import AdminShell from "../../components/admin/AdminShell.astro";
---

<AdminShell 
    title="Tambah Artikel / Berita" 
    subtitle="Buat dan publikasikan artikel atau berita terbaru ke website publik."
    actionLabel="Kembali"
    actionHref="/admin/artikel"
>

<div class="form-container">
  
  <div class="form-box">
    
    <div class="form-header">
      <div class="header-icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
      </div>
      <div>
        <h2>Form Publikasi Artikel</h2>
        <p>Isi detail informasi artikel, tanggal, kategori, dan atur konten menggunakan rich text editor.</p>
      </div>
    </div>

    <form 
      method="POST" 
      action="/api/artikel"
      enctype="multipart/form-data"
    >

      <div class="form-group">
        <label for="title">Judul Artikel</label>
        <input
          type="text"
          id="title"
          name="title"
          placeholder="Masukkan judul artikel"
          required
        />
      </div>

      <div class="form-group">
        <label for="tanggal">Tanggal Posting</label>
        <input 
          type="date"
          id="tanggal"
          name="tanggal"
          required
        />
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="category">Kategori</label>
          <select id="category" name="category">
            <option value="8">Berita Baru</option>
            <option value="2">Artikel Penanaman Modal</option>
            <option value="3">Artikel Perizinan</option>
          </select>
        </div>

        <div class="form-group">
          <label for="active">Status Berita</label>
          <select id="active" name="active">
            <option value="Y">Aktif</option>
            <option value="N">Nonaktif</option>
          </select>
        </div>
      </div>

      <div class="form-group">
        <label>Isi Artikel</label>
        <!-- Toolbar Editor -->
        <div class="editor-toolbar">
          <div class="toolbar-group">
            <button type="button" onclick="document.execCommand('undo', false, null)" title="Undo">↩</button>
            <button type="button" onclick="document.execCommand('redo', false, null)" title="Redo">↪</button>
          </div>
          <div class="toolbar-divider"></div>
          <div class="toolbar-group">
            <button type="button" onclick="let block = prompt('Format (p, h1, h2, h3):', 'p'); if(block) document.execCommand('formatBlock', false, block);" title="Format Block">Paragraf</button>
          </div>
          <div class="toolbar-divider"></div>
          <div class="toolbar-group">
            <button type="button" onclick="document.execCommand('bold', false, null)" title="Bold"><b>B</b></button>
            <button type="button" onclick="document.execCommand('italic', false, null)" title="Italic"><i>I</i></button>
            <button type="button" onclick="document.execCommand('underline', false, null)" title="Underline"><u>U</u></button>
            <button type="button" onclick="document.execCommand('strikeThrough', false, null)" title="Strikethrough"><s>S</s></button>
          </div>
          <div class="toolbar-divider"></div>
          <div class="toolbar-group">
            <button type="button" onclick="document.execCommand('insertUnorderedList', false, null)" title="Bullet List">• List</button>
            <button type="button" onclick="document.execCommand('insertOrderedList', false, null)" title="Numbered List">1. List</button>
          </div>
          <div class="toolbar-divider"></div>
          <div class="toolbar-group">
            <button type="button" onclick="let url = prompt('Masukkan URL Link:'); if(url) document.execCommand('createLink', false, url);" title="Link">Link</button>
            <button type="button" onclick="document.execCommand('unlink', false, null)" title="Unlink">Unlink</button>
            <button type="button" onclick="document.execCommand('removeFormat', false, null)" title="Clear Formatting">Tx</button>
          </div>
        </div>

        <!-- Area Editor -->
        <div 
          id="editorContent" 
          class="editor-editable" 
          contenteditable="true"
        ></div>

        <!-- Hidden input untuk backend -->
        <textarea id="hiddenContent" name="content" style="display:none;"></textarea>
        <span class="file-hint">Gunakan editor di atas untuk mengatur format tulisan artikel.</span>
      </div>

      <div class="form-group">
        <label for="picture">Upload Gambar Utama</label>
        <div class="file-upload-box">
          <input type="file" id="picture" name="picture" accept="image/*">
        </div>
        <span class="file-hint">Format yang didukung: .jpg, .png, .webp</span>
      </div>

      <div class="form-actions">
        <a href="/admin/artikel" class="btn-batal">Batal</a>
        <button type="submit" class="btn-simpan">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
          Simpan Artikel
        </button>
      </div>

    </form>

  </div>
</div>

</AdminShell>

<style>
@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');

.form-container {
  font-family: 'Plus Jakarta Sans', sans-serif;
  width: 100%;
  animation: fadeIn 0.3s ease-in-out;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(6px); }
  to { opacity: 1; transform: translateY(0); }
}

.form-box {
  background: white;
  padding: 35px 40px;
  border-radius: 24px;
  box-shadow: 0 14px 35px rgba(15, 23, 42, 0.05);
  border: 1px solid #e2e8f0;
  width: 100%;
  box-sizing: border-box;
}

.form-header {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-bottom: 30px;
  padding-bottom: 20px;
  border-bottom: 2px solid #f1f5f9;
}

.header-icon {
  width: 48px;
  height: 48px;
  background: #eff6ff;
  color: #2563eb;
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.form-header h2 {
  margin: 0 0 4px 0;
  font-size: 20px;
  font-weight: 800;
  color: #0f172a;
  letter-spacing: -0.02em;
}

.form-header p {
  margin: 0;
  font-size: 13px;
  color: #64748b;
  font-weight: 500;
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 24px;
}

label {
  font-weight: 700;
  font-size: 13px;
  color: #334155;
  letter-spacing: 0.01em;
}

input[type="text"],
input[type="date"],
select {
  width: 100%;
  padding: 14px 16px;
  border: 1.5px solid #cbd5e1;
  border-radius: 14px;
  font-size: 14px;
  font-family: inherit;
  color: #0f172a;
  background: #f8fafc;
  transition: all 0.2s ease;
  box-sizing: border-box;
  outline: none;
}

input[type="text"]:focus,
input[type="date"]:focus,
select:focus {
  border-color: #2563eb;
  background: #ffffff;
  box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.1);
}

.editor-toolbar {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6px;
  background: #f1f5f9;
  padding: 8px 12px;
  border: 1.5px solid #cbd5e1;
  border-bottom: none;
  border-radius: 14px 14px 0 0;
}

.toolbar-group {
  display: flex;
  gap: 4px;
}

.editor-toolbar button {
  background: white;
  border: 1px solid #cbd5e1;
  padding: 6px 10px;
  border-radius: 8px;
  font-size: 13px;
  font-weight: 600;
  color: #334155;
  cursor: pointer;
  transition: all 0.15s ease;
}

.editor-toolbar button:hover {
  background: #e2e8f0;
  color: #0f172a;
}

.toolbar-divider {
  width: 1px;
  height: 22px;
  background: #cbd5e1;
  margin: 0 4px;
}

.editor-editable {
  width: 100%;
  min-height: 220px;
  max-height: 450px;
  overflow-y: auto;
  padding: 16px;
  border: 1.5px solid #cbd5e1;
  border-radius: 0 0 14px 14px;
  background: #f8fafc;
  font-size: 14px;
  font-family: inherit;
  color: #0f172a;
  box-sizing: border-box;
  outline: none;
  transition: all 0.2s ease;
}

.editor-editable:focus {
  border-color: #2563eb;
  background: #ffffff;
  box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.1);
}

.editor-editable:empty:before {
  content: "Tulis isi artikel di sini...";
  color: #94a3b8;
  pointer-events: none;
  display: block;
}

.file-upload-box {
  background: #f8fafc;
  border: 1.5px dashed #cbd5e1;
  border-radius: 14px;
  padding: 14px;
  transition: all 0.2s ease;
}

.file-upload-box:hover {
  border-color: #2563eb;
  background: #f1f5f9;
}

input[type="file"] {
  width: 100%;
  font-family: inherit;
  font-size: 13px;
  color: #475569;
}

.file-hint {
  font-size: 11.5px;
  color: #94a3b8;
  margin-top: 4px;
}

.form-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12px;
  margin-top: 35px;
  padding-top: 20px;
  border-top: 1px solid #f1f5f9;
}

.btn-batal {
  background: #f1f5f9;
  color: #475569;
  padding: 12px 22px;
  border-radius: 12px;
  text-decoration: none;
  font-weight: 700;
  font-size: 14px;
  transition: all 0.2s ease;
  display: inline-flex;
  align-items: center;
}

.btn-batal:hover {
  background: #e2e8f0;
  color: #0f172a;
}

.btn-simpan {
  background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
  color: white;
  border: none;
  padding: 12px 24px;
  border-radius: 12px;
  cursor: pointer;
  font-weight: 700;
  font-size: 14px;
  font-family: inherit;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  box-shadow: 0 8px 20px rgba(37, 99, 235, 0.25);
  transition: all 0.2s ease;
}

.btn-simpan:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 24px rgba(37, 99, 235, 0.35);
}

@media (max-width: 768px) {
  .form-row {
    grid-template-columns: 1fr;
    gap: 0;
  }
}
</style>

<script is:inline>
  document.querySelector('form')?.addEventListener('submit', function(e) {
    const editorContent = document.getElementById('editorContent');
    const hiddenContent = document.getElementById('hiddenContent');
    if(editorContent && hiddenContent) {
      hiddenContent.value = editorContent.innerHTML;
    }
  });

  const dateInput = document.getElementById('tanggal');
  if (dateInput && !dateInput.value) {
    const today = new Date().toISOString().split('T')[0];
    dateInput.value = today;
  }
</script>