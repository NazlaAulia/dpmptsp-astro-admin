---
import AdminShell from "../../components/admin/AdminShell.astro";
import { db } from "../../lib/db";

export const prerender = false;

const url = new URL(Astro.request.url);
const id = url.searchParams.get("id");

if (!id) {
  return Astro.redirect("/admin/inovasi");
}

let dataInovasi: any = null;
let errorMessage = "";

// 1. Ambil data berdasarkan ID yang dikirim dari halaman daftar inovasi
try {
  const [rows]: any = await db.query("SELECT * FROM inovasi_layanan WHERE id = ?", [id]);
  if (rows.length > 0) {
    dataInovasi = rows[0];
  }
} catch (error) {
  console.error("Gagal mengambil data:", error);
}

if (!dataInovasi) {
  return Astro.redirect("/admin/inovasi");
}

// 2. Handle Update Data (POST Request)
if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();

    const nama = formData.get("nama")?.toString() || "";
    const singkatan = formData.get("singkatan")?.toString() || "";
    const kategori = formData.get("kategori")?.toString() || "";
    const deskripsi = formData.get("deskripsi")?.toString() || "";
    const url_layanan = formData.get("url_layanan")?.toString() || null;
    const warna = formData.get("warna")?.toString() || "blue";
    const icon = formData.get("icon")?.toString() || "fa-lightbulb";

    const fileGambar = formData.get("foto") as File;
    let gambarPath = dataInovasi.gambar || dataInovasi.foto;

    if (fileGambar && fileGambar.name && fileGambar.size > 0) {
      gambarPath = fileGambar.name;
    }

    await db.query(
      `UPDATE inovasi_layanan SET nama = ?, singkatan = ?, kategori = ?, deskripsi = ?, url_layanan = ?, warna = ?, icon = ?, gambar = ? WHERE id = ?`,
      [nama, singkatan, kategori, deskripsi, url_layanan, warna, icon, gambarPath, id]
    );

    return Astro.redirect("/admin/inovasi");
  } catch (error: any) {
    console.error("Gagal update data:", error);
    errorMessage = "Gagal menyimpan perubahan: " + error.message;
  }
}
---

<AdminShell title="" subtitle="" showHeader={false}>
  <div class="page-header-simple">
    <h2>Edit Inovasi Astro (ID: {dataInovasi.id})</h2>
  </div>

  {errorMessage && <div style="color: red; margin-bottom: 12px;">{errorMessage}</div>}

  <div class="card-form-container">
    <form method="POST" enctype="multipart/form-data">
      <div class="form-grid">
        <!-- Kolom Kiri -->
        <div class="form-column">
          <div class="form-group">
            <label for="nama">Nama Inovasi</label>
            <input type="text" id="nama" name="nama" value={dataInovasi.nama || ''} required />
          </div>

          <div class="form-group">
            <label for="singkatan">Singkatan / Kepanjangan</label>
            <input type="text" id="singkatan" name="singkatan" value={dataInovasi.singkatan || ''} />
          </div>

          <div class="form-group">
            <label for="kategori">Kategori</label>
            <input type="text" id="kategori" name="kategori" value={dataInovasi.kategori || ''} />
          </div>

          <div class="form-group">
            <label for="url_layanan">URL Layanan</label>
            <input type="text" id="url_layanan" name="url_layanan" value={dataInovasi.url_layanan || ''} />
          </div>
        </div>

        <!-- Kolom Kanan -->
        <div class="form-column">
          <div class="form-group">
            <label for="deskripsi">Deskripsi</label>
            <textarea id="deskripsi" name="deskripsi" required>{dataInovasi.deskripsi || ''}</textarea>
          </div>

          <div class="form-group">
            <label for="warna">Warna Aksen</label>
            <input type="text" id="warna" name="warna" value={dataInovasi.warna || ''} />
          </div>

          <div class="form-group">
            <label for="icon">Icon Class</label>
            <input type="text" id="icon" name="icon" value={dataInovasi.icon || ''} />
          </div>

          <div class="form-group">
            <label for="foto">Ganti Foto Inovasi</label>
            <div class="file-info-box">
              <span class="file-name">File aktif: <b>{dataInovasi.gambar || dataInovasi.foto || '-'}</b></span>
              <input type="file" id="foto" name="foto" accept="image/*" />
            </div>
          </div>
        </div>
      </div>

      <!-- Tombol Aksi di Bawah -->
      <div class="form-actions">
        <a href="/admin/inovasi" class="btn-back">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
          Kembali
        </a>
        <button type="submit" class="btn-submit">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
          Simpan Perubahan
        </button>
      </div>
    </form>
  </div>
</AdminShell>

<style>
.page-header-simple {
  margin-bottom: 12px;
}

.page-header-simple h2 {
  font-size: 20px;
  font-weight: 700;
  color: #1e293b;
  margin: 0;
}

.card-form-container {
  background: white;
  border-radius: 16px;
  padding: 20px;
  box-shadow: 0 10px 25px rgba(15, 23, 42, 0.04);
  border: 1px solid #f1f5f9;
}

.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}

.form-group {
  margin-bottom: 12px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.form-group label {
  font-size: 13px;
  font-weight: 600;
  color: #1e293b;
}

.form-group input[type="text"],
.form-group textarea {
  padding: 8px 12px;
  border-radius: 8px;
  border: 1px solid #cbd5e1;
  font-size: 13px;
  outline: none;
  color: #334155;
  width: 100%;
  box-sizing: border-box;
  background-color: #f8fafc;
}

.form-group textarea {
  resize: none;
  height: 95px;
}

.form-group input:focus,
.form-group textarea:focus {
  border-color: #2563eb;
  background-color: #fff;
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
}

.file-info-box {
  background: #f8fafc;
  border: 1px dashed #cbd5e1;
  padding: 8px 12px;
  border-radius: 8px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.file-name {
  font-size: 12px;
  color: #64748b;
}

.file-name b {
  color: #2563eb;
}

.form-group input[type="file"] {
  font-size: 12px;
  color: #475569;
}

.form-actions {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 10px;
  margin-top: 16px;
  padding-top: 14px;
  border-top: 1px solid #f1f5f9;
}

.btn-back {
  background: #f1f5f9;
  color: #475569;
  padding: 8px 16px;
  border-radius: 8px;
  text-decoration: none;
  font-size: 13px;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  transition: all 0.2s;
}

.btn-back:hover {
  background: #e2e8f0;
  color: #1e293b;
}

.btn-submit {
  background: #2563eb;
  color: white;
  padding: 8px 18px;
  border-radius: 8px;
  border: none;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  box-shadow: 0 4px 12px rgba(37, 99, 235, 0.2);
  transition: all 0.2s;
}

.btn-submit:hover {
  background: #1d4ed8;
  box-shadow: 0 6px 15px rgba(37, 99, 235, 0.3);
}
</style>