---
import AdminShell from "../../components/admin/AdminShell.astro";

const daftarInovasi = [
  {
    id: 10,
    namaKonten: "KLINIK INVESTASI",
    isi: "Lokasi strategis pusat kota, fasilitas nyaman (cafe, ruang tamu, CS, TV Display, WiFi) Konsultasi, matchmaking, data ekonomi, forum komunikasi.",
    foto: "KLINIK-INVESTASI-2025-07-15._0.png",
    judul: "Klinik Investasi",
    keterangan: "Inovasi pelayanan investasi terpadu",
    tags: "klinik-investasi",
  },
];

const dataInovasi = daftarInovasi[0];
---

<AdminShell title="" subtitle="" showHeader={false}>
  <div class="page-header-simple">
    <h2>Edit Inovasi Astro</h2>
  </div>

  <div class="card-form-container">
    <form action="/admin/inovasi" method="POST">
      <div class="form-grid">
        <!-- Kolom Kiri -->
        <div class="form-column">
          <div class="form-group">
            <label for="namaKonten">Nama Konten</label>
            <input type="text" id="namaKonten" name="namaKonten" value={dataInovasi.namaKonten} required />
          </div>

          <div class="form-group">
            <label for="judul">Judul</label>
            <input type="text" id="judul" name="judul" value={dataInovasi.judul} required />
          </div>

          <div class="form-group">
            <label for="keterangan">Keterangan</label>
            <input type="text" id="keterangan" name="keterangan" value={dataInovasi.keterangan} />
          </div>

          <div class="form-group">
            <label for="tags">Tags</label>
            <input type="text" id="tags" name="tags" value={dataInovasi.tags} />
          </div>
        </div>

        <!-- Kolom Kanan -->
        <div class="form-column">
          <div class="form-group">
            <label for="isi">Isi</label>
            <textarea id="isi" name="isi" required>{dataInovasi.isi}</textarea>
          </div>

          <div class="form-group">
            <label for="foto">Ganti Foto Inovasi</label>
            <div class="file-info-box">
              <span class="file-name">File aktif: <b>{dataInovasi.foto}</b></span>
              <input type="file" id="foto" name="foto" accept="image/*" />
            </div>
          </div>
        </div>
      </div>

      <!-- Tombol Aksi di Bawah -->
      <div class="form-actions">
        <a href="/admin/inovasi" class="btn-back">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
          Kembali
        </a>
        <button type="submit" class="btn-submit">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
          Simpan Perubahan
        </button>
      </div>
    </form>
  </div>
</AdminShell>

<style>
.page-header-simple {
  margin-bottom: 12px;
}

.page-header-simple h2 {
  font-size: 20px;
  font-weight: 700;
  color: #1e293b;
  margin: 0;
}

.card-form-container {
  background: white;
  border-radius: 16px;
  padding: 20px;
  box-shadow: 0 10px 25px rgba(15, 23, 42, 0.04);
  border: 1px solid #f1f5f9;
}

.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}

.form-group {
  margin-bottom: 12px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.form-group label {
  font-size: 13px;
  font-weight: 600;
  color: #1e293b;
}

.form-group input[type="text"],
.form-group textarea {
  padding: 8px 12px;
  border-radius: 8px;
  border: 1px solid #cbd5e1;
  font-size: 13px;
  outline: none;
  color: #334155;
  width: 100%;
  box-sizing: border-box;
  background-color: #f8fafc;
}

.form-group textarea {
  resize: none;
  height: 95px;
}

.form-group input:focus,
.form-group textarea:focus {
  border-color: #2563eb;
  background-color: #fff;
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
}

.file-info-box {
  background: #f8fafc;
  border: 1px dashed #cbd5e1;
  padding: 8px 12px;
  border-radius: 8px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.file-name {
  font-size: 12px;
  color: #64748b;
}

.file-name b {
  color: #2563eb;
}

.form-group input[type="file"] {
  font-size: 12px;
  color: #475569;
}

/* Bagian Tombol di Bawah */
.form-actions {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 10px;
  margin-top: 16px;
  padding-top: 14px;
  border-top: 1px solid #f1f5f9;
}

.btn-back {
  background: #f1f5f9;
  color: #475569;
  padding: 8px 16px;
  border-radius: 8px;
  text-decoration: none;
  font-size: 13px;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  transition: all 0.2s;
}

.btn-back:hover {
  background: #e2e8f0;
  color: #1e293b;
}

.btn-submit {
  background: #2563eb;
  color: white;
  padding: 8px 18px;
  border-radius: 8px;
  border: none;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  box-shadow: 0 4px 12px rgba(37, 99, 235, 0.2);
  transition: all 0.2s;
}

.btn-submit:hover {
  background: #1d4ed8;
  box-shadow: 0 6px 15px rgba(37, 99, 235, 0.3);
}
</style>