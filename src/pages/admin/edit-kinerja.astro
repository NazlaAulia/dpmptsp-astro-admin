---
import AdminShell from "../../components/admin/AdminShell.astro";
import { db } from "../../lib/db";
import { writeFile } from "fs/promises";
import path from "path";

const id = Number(Astro.url.searchParams.get("id"));

const [rows] = await db.query(
  `
  SELECT *
  FROM twdata
  WHERE id = ?
  `,
  [id]
);

const data = (rows as Array<{
  id: number;
  tw_option: string;
  file_path: string;
}>)[0];

if (!data) {
  return Astro.redirect("/admin/kinerja");
}


if (Astro.request.method === "POST") {

  const formData = await Astro.request.formData();

  const judul = formData.get("judul") as string;
  const file = formData.get("file") as File;


  if (file && file.size > 0) {

    const buffer = Buffer.from(await file.arrayBuffer());

    const namaFile = file.name;

    const lokasi = path.join(
      process.cwd(),
      "public/pdf",
      namaFile
    );

    await writeFile(
      lokasi,
      buffer
    );


    await db.query(
      `
      UPDATE twdata
      SET tw_option = ?, file_path = ?
      WHERE id = ?
      `,
      [
        judul,
        namaFile,
        id
      ]
    );

  } else {

    await db.query(
      `
      UPDATE twdata
      SET tw_option = ?
      WHERE id = ?
      `,
      [
        judul,
        id
      ]
    );

  }


  return Astro.redirect("/admin/kinerja");
}

---

<AdminShell
  title="Edit Kinerja Investasi"
  subtitle="Perbarui data kinerja investasi."
  showHeader={false}
>


<div class="form-box">


<h2>Edit Kinerja</h2>


<form method="POST" enctype="multipart/form-data">


<div class="form-group">

<label>
Judul Kinerja
</label>

<input 
type="text"
name="judul"
value={data.tw_option}
/>

</div>


<div class="form-group">

<label>
Dokumen Saat Ini
</label>

<input 
type="text"
value={data.file_path}
readonly
/>

</div>


<div class="form-group">

<label>
Upload Dokumen Baru
</label>

<input 
type="file"
name="file"
accept=".pdf"
/>

</div>


<button type="submit">
Simpan Perubahan
</button>


</form>


</div>


</AdminShell>



<style>

.form-box{

background:white;

padding:30px;

border-radius:20px;

box-shadow:0 12px 30px rgba(15,23,42,.06);

}


.form-group{

display:flex;

flex-direction:column;

gap:8px;

margin-bottom:20px;

}


input{

padding:12px;

border-radius:10px;

border:1px solid #ddd;

}


button{

background:#2563eb;

color:white;

border:none;

padding:12px 20px;

border-radius:10px;

cursor:pointer;

}

</style>