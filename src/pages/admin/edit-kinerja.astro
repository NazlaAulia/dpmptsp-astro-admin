---
import AdminShell from "../../components/admin/AdminShell.astro";
---


<AdminShell
title="Edit Kinerja Investasi"
subtitle="Perbarui data kinerja investasi."
>


<div class="form-box">


<h2>Edit Kinerja</h2>


<form>


<div class="form-group">

<label>
Judul Kinerja
</label>

<input 
type="text"
value="2025-2026"
/>

</div>


<div class="form-group">

<label>
Upload Dokumen Baru
</label>

<input 
type="file"
accept=".pdf"
/>

</div>


<button>
Simpan Perubahan
</button>


</form>


</div>


</AdminShell>



<style>

.form-box{

background:white;

padding:30px;

border-radius:20px;

box-shadow:0 12px 30px rgba(15,23,42,.06);

}


.form-group{

display:flex;

flex-direction:column;

gap:8px;

margin-bottom:20px;

}


input{

padding:12px;

border-radius:10px;

border:1px solid #ddd;

}


button{

background:#2563eb;

color:white;

border:none;

padding:12px 20px;

border-radius:10px;

}

</style>