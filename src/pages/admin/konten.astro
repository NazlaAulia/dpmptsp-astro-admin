---
import AdminShell from "../../components/admin/AdminShell.astro";
import { db } from "../../lib/db.js"; // Langsung import DB agar tidak perlu API endpoint terpisah

let konten: any[] = [];

try {
  // Query langsung ke MySQL database
  const [rows]: any = await db.execute(
    "SELECT * FROM tentangkamiswebv5 ORDER BY Id_Konten DESC"
  );
  konten = rows || [];
} catch (error) {
  console.error("Gagal memuat data konten dari Database:", error);
}

const items = [
  { title: "Artikel unggulan", value: konten.length.toString(), icon: "article" },
  { title: "Dokumen publik", value: "14", icon: "document" },
  { title: "Berita hari ini", value: "2", icon: "news" },
];
---

<AdminShell
  title="Konten"
  subtitle="Kelola dokumen dan informasi yang tampil di publik."
  actionLabel="Tambah Konten"
  actionHref="/admin/tambah-konten"
>

  <!-- ================= SUMMARY ================= -->
  <div class="card-grid">
    {items.map((item) => (
      <article class="info-card">
        <div class="card-icon">
          {item.icon === "article" && (
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16v16H4z"></path>
              <path d="M8 8h8"></path>
              <path d="M8 12h8"></path>
              <path d="M8 16h5"></path>
            </svg>
          )}
          {item.icon === "document" && (
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 2h9l5 5v15H6z"></path>
              <path d="M14 2v6h6"></path>
              <path d="M9 13h6"></path>
              <path d="M9 17h6"></path>
            </svg>
          )}
          {item.icon === "news" && (
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16v16H4z"></path>
              <path d="M8 8h8"></path>
              <path d="M8 12h3"></path>
              <path d="M8 16h8"></path>
              <path d="M14 11h2"></path>
            </svg>
          )}
        </div>
        <div>
          <h3>{item.title}</h3>
          <p>{item.value}</p>
        </div>
      </article>
    ))}
  </div>

  <!-- ================= CONTENT ================= -->
  <section class="content-card">
    <div class="table-header">
      <div>
        <h2>Daftar Konten</h2>
        <p>Informasi dan konten yang tersedia pada website publik.</p>
      </div>

      <div class="search-box">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-4-4"></path>
        </svg>
        <input type="text" placeholder="Cari konten..." />
      </div>
    </div>

    <!-- TABLE -->
    <div class="table-wrapper">
      <table>
        <thead>
          <tr>
            <th>Id_Konten</th>
            <th>Nama_Konten</th>
            <th>Isi_konten</th>
            <th>Foto_konten</th>
            <th>Judul_konten</th>
            <th>Keterangan</th>
            <th>Tags</th>
            <th class="aksi-column">Aksi</th>
          </tr>
        </thead>
  <tbody>
          {konten.length === 0 ? (
            <tr>
              <td colspan="8" style="text-align: center; padding: 20px;">
                Belum ada data konten.
              </td>
            </tr>
          ) : (
            konten.map((item: any) => (
              <tr>
                <td><span class="id-badge">{item.Id_Konten}</span></td>
                <td>
                  <div class="nama-konten">
                    <div class="content-avatar">
                      {item.Nama_Konten ? item.Nama_Konten.charAt(0).toUpperCase() : "-"}
                    </div>
                    <strong>{item.Nama_Konten}</strong>
                  </div>
                </td>
                <td><div class="isi-text">{item.Isi_Konten || "-"}</div></td>
                
                <!-- BAGIAN FOTO/GAMBAR KONTEN (SUDAH DIPERBAIKI) -->
                <td>
                  {item.Foto_Konten ? (
                    <div class="file-box">
                      <img 
                        src={`/uploads/konten/${item.Foto_Konten}`} 
                        alt={item.Nama_Konten}
                        class="thumb-img"
                        onerror="this.style.display='none'"
                      />
                      <span class="file-name">{item.Foto_Konten}</span>
                    </div>
                  ) : (
                    <span style="color: #94a3b8;">Tanpa File</span>
                  )}
                </td>

                <td><span class="judul-text">{item.Judul_Konten}</span></td>
                <td><span class="keterangan">{item.Keterangan || "-"}</span></td>
                <td>{item.tags ? <span class="tag">{item.tags}</span> : "-"}</td>
                <td>
                  <div class="action-buttons">
                    <!-- EDIT -->
                    <button type="button" class="action-btn edit-btn" title="Edit konten">
                      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 20h9"></path>
                        <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z"></path>
                      </svg>
                    </button>

                    <!-- DELETE -->
                    <button type="button" class="action-btn delete-btn" title="Hapus konten">
                      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 6h18"></path>
                        <path d="M8 6V4h8v2"></path>
                        <path d="M19 6l-1 15H6L5 6"></path>
                        <path d="M10 11v6"></path>
                        <path d="M14 11v6"></path>
                      </svg>
                    </button>
                  </div>
                </td>
              </tr>
            ))
          )}
        </tbody>
      </table>
    </div>

    <!-- FOOTER -->
    <div class="table-footer">
      <span>
        Menampilkan <strong>{konten.length > 0 ? 1 : 0}-{konten.length}</strong> dari <strong>{konten.length}</strong> konten
      </span>

      <div class="pagination">
        <button type="button" class="page-arrow" disabled>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m15 18-6-6 6-6"></path>
          </svg>
        </button>
        <button type="button" class="page-number active">1</button>
        <button type="button" class="page-arrow">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m9 18 6-6-6-6"></path>
          </svg>
        </button>
      </div>
    </div>
  </section>
</AdminShell>


<style>

/* ================================================= */
/* SUMMARY CARD */
/* ================================================= */

.card-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
  margin-bottom: 24px;
}

.info-card {
  background: #ffffff;
  border: 1px solid #edf1f5;
  border-radius: 18px;
  padding: 22px 24px;

  display: flex;
  align-items: center;
  gap: 16px;

  box-shadow: 0 8px 24px rgba(15, 23, 42, 0.05);
}

.card-icon {
  width: 52px;
  height: 52px;
  flex-shrink: 0;

  border-radius: 14px;

  display: flex;
  align-items: center;
  justify-content: center;

  color: #2563eb;
  background: #eff6ff;
}

.info-card h3 {
  margin: 0 0 5px;

  color: #64748b;

  font-size: 14px;
  font-weight: 600;
}

.info-card p {
  margin: 0;

  color: #0f172a;

  font-size: 26px;
  font-weight: 800;
}


/* ================================================= */
/* CONTENT CARD */
/* ================================================= */

.content-card {
  background: #ffffff;

  border: 1px solid #edf1f5;
  border-radius: 20px;

  box-shadow: 0 8px 28px rgba(15, 23, 42, 0.05);

  overflow: hidden;
}


/* ================================================= */
/* TABLE HEADER */
/* ================================================= */

.table-header {
  padding: 24px 28px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 20px;

  border-bottom: 1px solid #edf1f5;
}

.table-header h2 {
  margin: 0 0 5px;

  color: #0f172a;

  font-size: 20px;
  font-weight: 750;
}

.table-header p {
  margin: 0;

  color: #94a3b8;

  font-size: 13px;
}


/* ================================================= */
/* SEARCH */
/* ================================================= */

.search-box {
  width: 240px;
  height: 42px;

  display: flex;
  align-items: center;

  gap: 9px;

  padding: 0 13px;

  border: 1px solid #dbe3ec;
  border-radius: 10px;

  background: #f8fafc;

  color: #64748b;
}

.search-box input {
  width: 100%;

  border: none;
  outline: none;

  background: transparent;

  color: #334155;

  font-size: 13px;
}

.search-box input::placeholder {
  color: #94a3b8;
}


/* ================================================= */
/* TABLE */
/* ================================================= */

/* Pembungkus Tabel: Agar bisa di-scroll Horizontal & Vertikal */
.table-wrapper {
  width: 100%;
  max-height: 480px; /* Batas tinggi tabel (sesuaikan kalau mau lebih tinggi/pendek) */
  overflow-x: auto;  /* Mengaktifkan scroll kiri-kanan */
  overflow-y: auto;  /* Mengaktifkan scroll atas-bawah */
  border: 1px solid #e2e8f0;
  border-radius: 8px;
}

/* Memastikan tabel memakai lebar penuh dan tidak collapse */
table {
  width: 100%;
  min-width: 900px; /* Memaksa tabel punya lebar minimal agar kolom tidak menumpuk */
  border-collapse: collapse;
}

/* Menjaga Header Tabel Tetap Menempel di Atas saat Di-scroll Vertikal */
thead th {
  position: sticky;
  top: 0;
  background-color: #f8fafc; /* Warna background header */
  z-index: 10;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
}

/* Kerapihan Teks di Kolom Isi Konten */
.isi-text {
  max-width: 200px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis; /* Menampilkan '...' jika teks terlalu panjang */
}


/* ================================================= */
/* ID */
/* ================================================= */

.id-badge {
  display: inline-flex;

  align-items: center;
  justify-content: center;

  padding: 6px 9px;

  border-radius: 8px;

  background: #f1f5f9;

  color: #64748b;

  font-size: 12px;
  font-weight: 700;
}


/* ================================================= */
/* NAMA KONTEN */
/* ================================================= */

.nama-konten {
  display: flex;
  align-items: center;

  gap: 10px;

  min-width: 150px;
}

.content-avatar {
  width: 36px;
  height: 36px;

  flex-shrink: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 10px;

  background: #dbeafe;

  color: #2563eb;

  font-size: 14px;
  font-weight: 800;
}

.nama-konten strong {
  color: #1e293b;

  font-size: 13px;
}


/* ================================================= */
/* ISI */
/* ================================================= */

.isi-text {
  width: 235px;

  color: #64748b;

  line-height: 1.55;

  display: -webkit-box;
  -webkit-line-clamp: 4;
  -webkit-box-orient: vertical;

  overflow: hidden;
}


/* ================================================= */
/* FILE */
/* ================================================= */

.file-box {
  display: flex;
  align-items: center;

  gap: 9px;

  width: 190px;

  color: #475569;

  line-height: 1.4;

  word-break: break-word;
}

.file-icon {
  width: 32px;
  height: 32px;

  flex-shrink: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 9px;

  background: #fef3c7;

  color: #d97706;
}


/* ================================================= */
/* JUDUL */
/* ================================================= */

.judul-text {
  color: #1e293b;

  white-space: nowrap;
}


/* ================================================= */
/* KETERANGAN */
/* ================================================= */

.keterangan {
  display: block;

  width: 170px;

  color: #64748b;

  line-height: 1.5;
}


/* ================================================= */
/* TAG */
/* ================================================= */

.tag {
  display: inline-flex;

  padding: 6px 10px;

  border-radius: 20px;

  background: #eff6ff;

  color: #2563eb;

  font-size: 11px;
  font-weight: 700;

  white-space: nowrap;
}


/* ================================================= */
/* AKSI */
/* ================================================= */

.aksi-column {
  text-align: center;
}

.action-buttons {
  display: flex;

  align-items: center;
  justify-content: center;

  gap: 7px;
}

.action-btn {
  width: 34px;
  height: 34px;

  display: flex;
  align-items: center;
  justify-content: center;

  border: none;
  border-radius: 9px;

  cursor: pointer;

  transition:
    transform 0.2s ease,
    background 0.2s ease;
}

.action-btn:hover {
  transform: translateY(-2px);
}

.edit-btn {
  background: #eff6ff;
  color: #2563eb;
}

.edit-btn:hover {
  background: #dbeafe;
}

.delete-btn {
  background: #fef2f2;
  color: #dc2626;
}

.delete-btn:hover {
  background: #fee2e2;
}


/* ================================================= */
/* FOOTER */
/* ================================================= */

/* ================================================= */
/* AKSI */
/* ================================================= */

.aksi-column {
  text-align: center;
}

.action-buttons {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
}

.action-btn {
  width: 40px;
  height: 40px;

  display: flex;
  align-items: center;
  justify-content: center;

  border: none;
  border-radius: 10px;

  cursor: pointer;

  color: #111827;
  background: #f1f3f5;

  transition:
    transform 0.2s ease,
    background 0.2s ease,
    box-shadow 0.2s ease;
}

.action-btn:hover {
  transform: translateY(-2px);
  background: #e5e7eb;
  box-shadow: 0 4px 10px rgba(15, 23, 42, 0.08);
}

/* Pensil */
.edit-btn {
  background: #f1f3f5;
  color: #111827;
}

.edit-btn:hover {
  background: #e2e5e9;
  color: #000000;
}

/* Tempat sampah */
.delete-btn {
  background: #f1f3f5;
  color: #111827;
}

.delete-btn:hover {
  background: #e2e5e9;
  color: #000000;
}

/* ================================================= */
/* PAGINATION */
/* ================================================= */

.pagination {
  display: flex;
  align-items: center;

  gap: 6px;
}

.pagination button {
  width: 34px;
  height: 34px;

  display: flex;
  align-items: center;
  justify-content: center;

  border: 1px solid #dbe3ec;
  border-radius: 8px;

  background: #ffffff;

  color: #64748b;

  cursor: pointer;
}

.pagination button:hover:not(:disabled) {
  background: #f8fafc;
}

.pagination .active {
  background: #2563eb;
  border-color: #2563eb;

  color: #ffffff;
}

.pagination button:disabled {
  opacity: 0.4;

  cursor: not-allowed;
}


/* ================================================= */
/* RESPONSIVE */
/* ================================================= */

@media (max-width: 900px) {

  .card-grid {
    grid-template-columns: 1fr;
  }

  .table-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .search-box {
    width: 100%;
  }

  .table-footer {
    align-items: flex-start;
    flex-direction: column;
  }

}

.thumb-img {
  width: 45px;
  height: 45px;
  object-fit: cover;
  border-radius: 8px;
  border: 1px solid #e2e8f0;
  flex-shrink: 0;
}

.file-name {
  font-size: 11px;
  color: #64748b;
  word-break: break-all;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
</style>