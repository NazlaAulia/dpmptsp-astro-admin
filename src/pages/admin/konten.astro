---
import AdminShell from "../../components/admin/AdminShell.astro";
import { db } from "../../lib/db.js";

// Tambahkan baris ini di bagian paling atas script Astro halaman depan Anda
export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate, proxy-revalidate');

// === 1. TANGKAP PERINTAH HAPUS & EDIT DI SINI ===
if (Astro.request.method === "POST") {
  try {
    const data = await Astro.request.formData();
    const deleteId = data.get("deleteId");
    const editId = data.get("editId");

    if (deleteId) {
      await db.execute("DELETE FROM tentangkamiswebv5 WHERE Id_Konten = ?", [deleteId]);
      return Astro.redirect("/admin/konten");
    }

    if (editId) {
      return Astro.redirect(`/admin/edit-konten?id=${editId}`);
    }
  } catch (error) {
    console.error("Gagal memproses data dari Database:", error);
  }
}

let konten: any[] = [];

try {
  const [rows]: any = await db.execute(
    "SELECT * FROM tentangkamiswebv5 ORDER BY Id_Konten DESC"
  );
  konten = rows || [];
} catch (error) {
  console.error("Gagal memuat data konten dari Database:", error);
}

const items = [
  { title: "Artikel unggulan", value: konten.length.toString(), icon: "article" },
  { title: "Dokumen publik", value: "14", icon: "document" },
  { title: "Berita hari ini", value: "2", icon: "news" },
];
---

<AdminShell
  title="Konten"
  subtitle="Kelola dokumen dan informasi yang tampil di publik."
  actionLabel="Tambah Konten"
  actionHref="/admin/tambah-konten"
>

  <!-- ================= SUMMARY ================= -->
  <div class="card-grid">
    {items.map((item) => (
      <article class="info-card">
        <div class="card-icon">
          {item.icon === "article" && (
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16v16H4z"></path>
              <path d="M8 8h8"></path>
              <path d="M8 12h8"></path>
              <path d="M8 16h5"></path>
            </svg>
          )}
          {item.icon === "document" && (
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 2h9l5 5v15H6z"></path>
              <path d="M14 2v6h6"></path>
              <path d="M9 13h6"></path>
              <path d="M9 17h6"></path>
            </svg>
          )}
          {item.icon === "news" && (
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16v16H4z"></path>
              <path d="M8 8h8"></path>
              <path d="M8 12h3"></path>
              <path d="M8 16h8"></path>
              <path d="M14 11h2"></path>
            </svg>
          )}
        </div>
        <div>
          <h3>{item.title}</h3>
          <p>{item.value}</p>
        </div>
      </article>
    ))}
  </div>

  <!-- ================= CONTENT ================= -->
  <section class="content-card">
    <div class="table-header">
      <div>
        <h2>Daftar Konten</h2>
        <p>Informasi dan konten yang tersedia pada website publik.</p>
      </div>

      <div class="search-box">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-4-4"></path>
        </svg>
        <input type="text" placeholder="Cari konten..." />
      </div>
    </div>

   <!-- TABLE -->
    <div class="table-wrapper">
      <table class="styled-table" id="tabel-konten">
        <thead>
          <tr>
            <th class="th-id">ID</th>
            <th class="th-nama">Nama Konten</th>
            <th class="th-isi">Isi</th>
            <th class="th-foto">Foto</th>
            <th class="th-judul">Judul</th>
            <th class="th-ket">Keterangan</th>
            <th class="th-tags">Tags</th>
            <th class="th-aksi">Aksi</th>
          </tr>
        </thead>
        <tbody>
          {konten.length === 0 ? (
            <tr>
              <td colspan="8" class="no-data">
                Belum ada data konten.
              </td>
            </tr>
          ) : (
            konten.map((item: any) => (
              <tr>
                <td><span class="id-badge">{item.Id_Konten}</span></td>
                <td>
                  <div class="nama-konten">
                    <div class="content-avatar">
                      {item.Nama_Konten ? item.Nama_Konten.charAt(0).toUpperCase() : "-"}
                    </div>
                    <span class="nama-text" title={item.Nama_Konten}>{item.Nama_Konten}</span>
                  </div>
                </td>
                <td><span class="cell-text" title={item.Isi_Konten}>{item.Isi_Konten || "-"}</span></td>
                
                <td>
                  {item.Foto_Konten ? (
                    <div class="file-box">
                      <img 
                        src={`/uploads/konten/${item.Foto_Konten}`} 
                        alt={item.Nama_Konten}
                        class="thumb-img"
                        onerror="this.style.display='none'"
                      />
                      <span class="file-name" title={item.Foto_Konten}>{item.Foto_Konten}</span>
                    </div>
                  ) : (
                    <span style="color: #94a3b8; font-size: 11.5px;">-</span>
                  )}
                </td>

                <td><span class="cell-text" title={item.Judul_Konten}>{item.Judul_Konten || "-"}</span></td>
                <td><span class="cell-text" title={item.Keterangan}>{item.Keterangan || "-"}</span></td>
                <td>{item.tags ? <span class="tag" title={item.tags}>{item.tags}</span> : <span style="color:#94a3b8">-</span>}</td>
                <td>
                  <div class="action-buttons">
                    <button type="button" class="action-btn edit-btn" title="Edit konten" onclick={`window.openEditModal('${item.Id_Konten}')`}>
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z"></path></svg>
                    </button>
                    <button type="button" class="action-btn delete-btn" title="Hapus konten" onclick={`window.openDeleteModal('${item.Id_Konten}')`}>
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"></path><path d="M8 6V4h8v2"></path><path d="M19 6l-1 15H6L5 6"></path><path d="M10 11v6"></path><path d="M14 11v6"></path></svg>
                    </button>
                  </div>
                </td>
              </tr>
            ))
          )}
        </tbody>
      </table>
    </div>

    <!-- FOOTER -->
    <div class="table-footer">
      <span id="text-info">
        Menampilkan <strong>{konten.length > 0 ? 1 : 0}-{konten.length}</strong> dari <strong>{konten.length}</strong> konten
      </span>

      <div class="pagination" id="pagination-container">
        <!-- Pagination akan di-generate oleh JavaScript -->
      </div>
    </div>
  </section>
</AdminShell>

<!-- MODAL KONFIRMASI HAPUS -->
<div id="deleteModal" class="modal-overlay">
  <div class="modal-card">
    <div class="modal-icon-wrapper"><span class="modal-exclamation">!</span></div>
    <h3>Hapus Data?</h3>
    <p>Apakah Anda yakin ingin menghapus data konten ini?</p>
    <form method="POST" class="modal-actions">
      <input type="hidden" name="deleteId" id="modalDeleteInput" />
      <button type="button" id="cancelDelete" class="modal-btn modal-btn-cancel">Batal</button>
      <button type="submit" class="modal-btn modal-btn-delete">Hapus</button>
    </form>
  </div>
</div>

<!-- MODAL KONFIRMASI EDIT -->
<div id="editModal" class="modal-overlay">
  <div class="modal-card">
    <div class="modal-icon-wrapper"><span class="modal-exclamation">!</span></div>
    <h3>Edit Data?</h3>
    <p>Apakah Anda yakin ingin mengedit data konten ini?</p>
    <form method="POST" class="modal-actions">
      <input type="hidden" name="editId" id="modalEditInput" />
      <button type="button" id="cancelEdit" class="modal-btn modal-btn-cancel">Batal</button>
      <button type="submit" class="modal-btn modal-btn-edit">Ya, Edit</button>
    </form>
  </div>
</div>

<!-- SCRIPT JAVASCRIPT -->
<script>
  declare global {
    interface Window {
      openDeleteModal: (id: string | number) => void;
      openEditModal: (id: string | number) => void;
    }
  }

  window.openDeleteModal = function(id: string | number) {
    const modal = document.getElementById('deleteModal') as HTMLElement | null;
    const input = document.getElementById('modalDeleteInput') as HTMLInputElement | null;
    if (input) input.value = String(id);
    if (modal) modal.classList.add('is-open');
  };

  window.openEditModal = function(id: string | number) {
    const modal = document.getElementById('editModal') as HTMLElement | null;
    const input = document.getElementById('modalEditInput') as HTMLInputElement | null;
    if (input) input.value = String(id);
    if (modal) modal.classList.add('is-open');
  };

  document.addEventListener('DOMContentLoaded', () => {
    const table = document.getElementById('tabel-konten') as HTMLTableElement | null;
    const pagination = document.getElementById('pagination-container') as HTMLElement | null;
    const textInfo = document.getElementById('text-info') as HTMLElement | null;
    
    if (table && pagination && textInfo) {
      const rows = Array.from(table.querySelectorAll('tbody tr')) as HTMLTableRowElement[];
      const itemsPerPage = 10;
      const totalPages = Math.ceil(rows.length / itemsPerPage);
      let currentPage = 1;

      // Style Dasar (Ditempel langsung biar gak bisa ditimpa Tailwind)
      const baseStyle = "display: inline-flex !important; align-items: center !important; justify-content: center !important; min-width: 42px !important; height: 42px !important; padding: 0 12px !important; border-radius: 12px !important; font-size: 15px !important; font-weight: 500 !important; cursor: pointer !important; transition: all 0.2s !important; outline: none !important; margin: 0 !important; box-sizing: border-box !important;";

      function showPage(page: number) {
        currentPage = page;
        const start = (page - 1) * itemsPerPage;
        const end = start + itemsPerPage;

        rows.forEach((row, index) => {
          row.style.display = (index >= start && index < end) ? '' : 'none';
        });

        const displayStart = rows.length === 0 ? 0 : start + 1;
        const displayEnd = Math.min(end, rows.length);
        textInfo!.innerHTML = `Menampilkan <strong>${displayStart}-${displayEnd}</strong> dari <strong>${rows.length}</strong> konten`;

        renderPagination();
      }

      function renderPagination() {
        if (!pagination) return;
        pagination.innerHTML = '';

        // Tombol Prev (<)
        const prevBtn = document.createElement('button');
        prevBtn.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg>`;
        if (currentPage === 1) {
          prevBtn.style.cssText = baseStyle + "background-color: #f8fafc !important; color: #cbd5e1 !important; border: 1px solid #e2e8f0 !important; cursor: not-allowed !important;";
        } else {
          prevBtn.style.cssText = baseStyle + "background-color: #ffffff !important; color: #64748b !important; border: 1px solid #e2e8f0 !important;";
          prevBtn.onclick = () => showPage(currentPage - 1);
        }
        pagination.appendChild(prevBtn);

        // Tombol Angka
        for (let i = 1; i <= totalPages; i++) {
          const btn = document.createElement('button');
          btn.innerText = String(i);
          if (i === currentPage) {
            btn.style.cssText = baseStyle + "background-color: #2563eb !important; color: #ffffff !important; border: 1px solid #2563eb !important; font-weight: 700 !important; box-shadow: 0 4px 10px rgba(37, 99, 235, 0.25) !important;";
          } else {
            btn.style.cssText = baseStyle + "background-color: #ffffff !important; color: #64748b !important; border: 1px solid #e2e8f0 !important;";
          }
          btn.onclick = () => showPage(i);
          pagination.appendChild(btn);
        }

        // Tombol Next (>)
        const nextBtn = document.createElement('button');
        nextBtn.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg>`;
        if (currentPage === totalPages || totalPages === 0) {
          nextBtn.style.cssText = baseStyle + "background-color: #f8fafc !important; color: #cbd5e1 !important; border: 1px solid #e2e8f0 !important; cursor: not-allowed !important;";
        } else {
          nextBtn.style.cssText = baseStyle + "background-color: #ffffff !important; color: #64748b !important; border: 1px solid #e2e8f0 !important;";
          nextBtn.onclick = () => showPage(currentPage + 1);
        }
        pagination.appendChild(nextBtn);
      }

      if (rows.length > 0) showPage(1);
    }

    // --- LOGIKA MODAL ---
    const deleteModal = document.getElementById('deleteModal') as HTMLElement | null;
    const cancelDelete = document.getElementById('cancelDelete');
    const editModal = document.getElementById('editModal') as HTMLElement | null;
    const cancelEdit = document.getElementById('cancelEdit');

    if (cancelDelete && deleteModal) cancelDelete.addEventListener('click', () => deleteModal.classList.remove('is-open'));
    if (cancelEdit && editModal) cancelEdit.addEventListener('click', () => editModal.classList.remove('is-open'));

    window.addEventListener('click', (e) => {
      if (deleteModal && e.target === deleteModal) deleteModal.classList.remove('is-open');
      if (editModal && e.target === editModal) editModal.classList.remove('is-open');
    });
  });
</script>

<style>
/* SEMUA CSS KAMU TETAP UTUH */
.card-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin-bottom: 24px; }
.info-card { background: #ffffff; border: 1px solid #e2e8f0; border-radius: 14px; padding: 18px 22px; display: flex; align-items: center; gap: 16px; box-shadow: 0 4px 16px rgba(15, 23, 42, 0.03); }
.card-icon { width: 46px; height: 46px; flex-shrink: 0; border-radius: 12px; display: flex; align-items: center; justify-content: center; color: #2563eb; background: #eff6ff; }
.info-card h3 { margin: 0 0 4px; color: #64748b; font-size: 13px; font-weight: 600; }
.info-card p { margin: 0; color: #0f172a; font-size: 24px; font-weight: 800; }
.content-card { background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; box-shadow: 0 4px 20px rgba(15, 23, 42, 0.03); display: flex; flex-direction: column; }
.table-header { padding: 20px 24px; display: flex; align-items: center; justify-content: space-between; gap: 16px; border-bottom: 1px solid #e2e8f0; }
.table-header h2 { margin: 0 0 4px; color: #0f172a; font-size: 18px; font-weight: 700; }
.table-header p { margin: 0; color: #94a3b8; font-size: 13px; }
.search-box { width: 240px; height: 38px; display: flex; align-items: center; gap: 8px; padding: 0 12px; border: 1px solid #cbd5e1; border-radius: 10px; background: #f8fafc; color: #64748b; }
.search-box input { width: 100%; border: none; outline: none; background: transparent; color: #334155; font-size: 13px; }
.search-box input::placeholder { color: #94a3b8; }
.table-wrapper { width: 100%; overflow-x: auto; }
.styled-table { width: 100%; table-layout: fixed; border-collapse: collapse; min-width: 1000px; }
.styled-table th.th-id { width: 5%; text-align: center; }
.styled-table th.th-nama { width: 15%; }
.styled-table th.th-isi { width: 15%; }
.styled-table th.th-foto { width: 14%; }
.styled-table th.th-judul { width: 15%; }
.styled-table th.th-ket { width: 14%; }
.styled-table th.th-tags { width: 10%; }
.styled-table th.th-aksi { width: 12%; text-align: center; }
.styled-table th { background-color: #f8fafc; color: #475569; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; padding: 14px 12px; text-align: left; border-bottom: 2px solid #e2e8f0; white-space: nowrap; }
.styled-table td { padding: 14px 12px; color: #334155; font-size: 13px; border-bottom: 1px solid #f1f5f9; vertical-align: middle; white-space: nowrap; }
.styled-table tbody tr:hover { background-color: #f8fafc; }
.no-data { text-align: center; padding: 32px !important; color: #94a3b8; font-style: italic; white-space: normal !important; }
.id-badge { display: inline-flex; align-items: center; justify-content: center; padding: 4px 8px; border-radius: 6px; background: #f1f5f9; color: #475569; font-size: 12px; font-weight: 700; }
.nama-konten { display: flex; align-items: center; gap: 10px; overflow: hidden; }
.content-avatar { width: 28px; height: 28px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 8px; background: #dbeafe; color: #2563eb; font-size: 12px; font-weight: 700; }
.nama-text, .cell-text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: block; width: 100%; }
.nama-text { color: #1e293b; font-weight: 600; }
.cell-text { color: #64748b; }
.file-box { display: flex; align-items: center; gap: 8px; overflow: hidden; }
.thumb-img { width: 32px; height: 32px; object-fit: cover; border-radius: 6px; border: 1px solid #e2e8f0; flex-shrink: 0; }
.file-name { font-size: 12px; color: #64748b; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.tag { display: inline-flex; padding: 4px 10px; border-radius: 12px; background: #eff6ff; color: #2563eb; font-size: 11px; font-weight: 700; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.action-buttons { display: flex; align-items: center; justify-content: center; gap: 6px; }
.action-btn { width: 34px; height: 34px; display: flex; align-items: center; justify-content: center; border: none; border-radius: 8px; cursor: pointer; transition: background 0.15s ease; }
.edit-btn { background: #eff6ff; color: #2563eb; }
.edit-btn:hover { background: #dbeafe; }
.delete-btn { background: #fef2f2; color: #ef4444; }
.delete-btn:hover { background: #fee2e2; }
.table-footer { padding: 16px 24px; display: flex; align-items: center; justify-content: space-between; color: #64748b; font-size: 13px; background: #ffffff; border-top: 1px solid #e2e8f0; border-radius: 0 0 16px 16px; }

/* ================================================= */
/* ✨ CSS FIX UNTUK TOMBOL PAGINATION ✨ */
/* ================================================= */
.pagination {
  display: flex;
  align-items: center;
  gap: 6px;
}

.pagination-btn {
  width: 42px !important;
  height: 42px !important;
  border: 1px solid #e2e8f0 !important;
  border-radius: 12px !important;
  background: #ffffff !important;
  color: #64748b !important;
  font-size: 15px !important;
  font-weight: 500 !important;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  cursor: pointer !important;
  transition: all 0.2s ease !important;
  padding: 0 !important;
}

.pagination-btn:hover:not(:disabled):not(.active) {
  background: #f8fafc !important;
  border-color: #cbd5e1 !important;
}

.pagination-btn.active {
  background: #2563eb !important;
  border-color: #2563eb !important;
  color: #ffffff !important;
  font-weight: 700 !important;
  box-shadow: 0 4px 10px rgba(37, 99, 235, 0.25) !important;
}

.pagination-btn:disabled {
  background: #f8fafc !important;
  color: #cbd5e1 !important;
  border-color: #e2e8f0 !important;
  cursor: not-allowed !important;
  opacity: 0.7 !important;
}

/* MODAL STYLING */
.modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(15, 23, 42, 0.5); backdrop-filter: blur(4px); display: flex; align-items: center; justify-content: center; z-index: 9999; opacity: 0; visibility: hidden; pointer-events: none; transition: opacity 0.2s ease, visibility 0.2s ease; }
.modal-overlay.is-open { opacity: 1; visibility: visible; pointer-events: auto; }
.modal-card { background: #ffffff; width: 100%; max-width: 420px; border-radius: 20px; padding: 32px 24px; text-align: center; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1); transform: scale(0.95); transition: transform 0.2s ease-in-out; }
.modal-overlay.is-open .modal-card { transform: scale(1); }
.modal-icon-wrapper { width: 64px; height: 64px; background: #fee2e2; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; }
.modal-exclamation { color: #ef4444; font-size: 32px; font-weight: 800; line-height: 1; }
.modal-card h3 { margin: 0 0 8px; color: #0f172a; font-size: 22px; font-weight: 700; }
.modal-card p { margin: 0 0 24px; color: #64748b; font-size: 14px; line-height: 1.5; }
.modal-actions { display: flex; gap: 12px; justify-content: center; }
.modal-btn { padding: 10px 24px; border-radius: 10px; font-size: 14px; font-weight: 600; cursor: pointer; border: none; transition: background 0.15s ease; }
.modal-btn-cancel { background: #f1f5f9; color: #334155; }
.modal-btn-cancel:hover { background: #e2e8f0; }
.modal-btn-delete { background: #ef4444; color: #ffffff; }
.modal-btn-delete:hover { background: #dc2626; }
.modal-btn-edit { background: #2563eb; color: #ffffff; }
.modal-btn-edit:hover { background: #1d4ed8; }

@media (max-width: 900px) { .card-grid { grid-template-columns: 1fr; } .table-header { align-items: flex-start; flex-direction: column; } .search-box { width: 100%; } .table-footer { align-items: flex-start; flex-direction: column; gap: 12px; } }
</style>