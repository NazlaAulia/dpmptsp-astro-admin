---
import AdminShell from "../../components/admin/AdminShell.astro";
import { db } from "../../lib/db.js";

const [semuaLayanan] = await db.query(
  "SELECT * FROM tempat_layanan ORDER BY id DESC"
);
---

<AdminShell title="Tempat Layanan" subtitle="Pantau layanan yang tersedia dan status operasional harian." actionLabel="Tambah Tempat Pelayanan" actionHref="/admin/tambah-layanan">
  <div class="table-container">
    <table class="data-table">
      <thead>
        <tr>
          <th>ID</th>
          <th>Judul</th>
          <th>Lokasi</th>
          <th>Alamat</th>
          <th>Gambar</th>
          <th>Aksi</th>
        </tr>
      </thead>
      <tbody id="table-body">
        <!-- Render dinamis via script -->
      </tbody>
    </table>

    <div class="pagination-footer">
      <span class="page-info" id="page-info">Menampilkan 0 dari 0 entri</span>
      <div class="pagination-controls" id="pagination-controls">
        <!-- Tombol paginasi dinamis -->
      </div>
    </div>
  </div>

  <!-- Modal Konfirmasi Edit -->
  <div class="modal-overlay" id="edit-modal" style="display: none;">
    <div class="modal-card">
      <div class="modal-icon-wrapper edit-icon-bg">
        <span class="modal-exclamation">!</span>
      </div>
      <h2>Edit Data?</h2>
      <p>Apakah Anda yakin ingin mengedit data layanan ini?</p>
      <div class="modal-actions">
        <button class="modal-btn btn-batal" id="edit-batal">Batal</button>
        <button class="modal-btn btn-ya-edit" id="edit-ya">Ya, Edit</button>
      </div>
    </div>
  </div>

  <!-- Modal Konfirmasi Hapus -->
  <div class="modal-overlay" id="delete-modal" style="display: none;">
    <div class="modal-card">
      <div class="modal-icon-wrapper delete-icon-bg">
        <span class="modal-exclamation">!</span>
      </div>
      <h2>Hapus Layanan?</h2>
      <p>Apakah Anda yakin ingin menghapus layanan ini?</p>
      <div class="modal-actions">
        <button class="modal-btn btn-batal" id="delete-batal">Batal</button>
        <button class="modal-btn btn-hapus" id="delete-ya">Hapus</button>
      </div>
    </div>
  </div>
</AdminShell>

<script define:vars={{ semuaLayanan: semuaLayanan }}>
  let dataLayanan = [...semuaLayanan];

  const itemsPerPage = 5;
  let currentPage = 1;
  let selectedId = null;

  function renderTable(page) {
    currentPage = page;
    const totalItems = dataLayanan.length;
    const totalPages = Math.ceil(totalItems / itemsPerPage) || 1;
    if (currentPage > totalPages) currentPage = totalPages;

    const start = (currentPage - 1) * itemsPerPage;
    const end = start + itemsPerPage;
    const currentData = dataLayanan.slice(start, end);

    const tbody = document.getElementById("table-body");
    tbody.innerHTML = "";

    currentData.forEach(item => {
      const tr = document.createElement("tr");
      tr.innerHTML = `
        <td>${item.id}</td>
        <td class="fw-bold">${item.judul}</td>
        <td><a href="${item.lokasi}" target="_blank" class="map-link">${item.lokasi}</a></td>
        <td>${item.alamat}</td>
        <td><img src="${item.gambar}" alt="${item.judul}" class="thumb-img" /></td>
        <td>
          <div class="action-buttons">
            <button class="btn-icon btn-edit" title="Edit" data-id="${item.id}">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
            </button>
            <button class="btn-icon btn-delete" title="Hapus" data-id="${item.id}">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
            </button>
          </div>
        </td>
      `;
      tbody.appendChild(tr);
    });

    const displayStart = totalItems === 0 ? 0 : start + 1;
    const displayEnd = Math.min(end, totalItems);
    document.getElementById("page-info").innerText = `Menampilkan ${displayStart} sampai ${displayEnd} dari ${totalItems} entri`;

    renderPaginationControls(totalPages);
    attachActionListeners();
  }

  function renderPaginationControls(totalPages) {
    const controls = document.getElementById("pagination-controls");
    controls.innerHTML = "";

    const prevBtn = document.createElement("button");
    prevBtn.className = `page-btn ${currentPage === 1 ? 'disabled' : ''}`;
    prevBtn.innerHTML = "&lt;";
    prevBtn.onclick = () => {
      if (currentPage > 1) renderTable(currentPage - 1);
    };
    controls.appendChild(prevBtn);

    for (let i = 1; i <= totalPages; i++) {
      const pageBtn = document.createElement("button");
      pageBtn.className = `page-btn ${currentPage === i ? 'active' : ''}`;
      pageBtn.innerText = i;
      pageBtn.onclick = () => renderTable(i);
      controls.appendChild(pageBtn);
    }

    const nextBtn = document.createElement("button");
    nextBtn.className = `page-btn ${currentPage === totalPages ? 'disabled' : ''}`;
    nextBtn.innerHTML = "&gt;";
    nextBtn.onclick = () => {
      if (currentPage < totalPages) renderTable(currentPage + 1);
    };
    controls.appendChild(nextBtn);
  }

  function attachActionListeners() {
    document.querySelectorAll(".btn-edit").forEach(btn => {
      btn.addEventListener("click", () => {
        selectedId = parseInt(btn.getAttribute("data-id"));
        document.getElementById("edit-modal").style.display = "flex";
      });
    });

    document.querySelectorAll(".btn-delete").forEach(btn => {
      btn.addEventListener("click", () => {
        selectedId = parseInt(btn.getAttribute("data-id"));
        document.getElementById("delete-modal").style.display = "flex";
      });
    });
  }

  document.getElementById("edit-batal").addEventListener("click", () => {
    document.getElementById("edit-modal").style.display = "none";
    selectedId = null;
  });

document.getElementById("edit-ya").addEventListener("click", () => {
  if (selectedId !== null) {
    window.location.href = `/admin/edit-layanan?id=${selectedId}`;
  }
});

  document.getElementById("delete-batal").addEventListener("click", () => {
    document.getElementById("delete-modal").style.display = "none";
    selectedId = null;
  });

document.getElementById("delete-ya").addEventListener("click", async () => {
  if (selectedId !== null) {

    try {
      const response = await fetch("/api/hapus-layanan", {
        method: "DELETE",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify({
          id: selectedId
        })
      });

      const result = await response.json();

      if (result.success) {

        dataLayanan = dataLayanan.filter(item => item.id !== selectedId);

        document.getElementById("delete-modal").style.display = "none";
        selectedId = null;

        renderTable(currentPage);

      } else {
        console.error("Gagal menghapus layanan");
      }

    } catch (error) {

      console.error("Terjadi error saat menghapus layanan:", error);

    }
  }
});

  renderTable(1);
</script>

<style>
.table-container {
  background: white;
  border-radius: 16px;
  box-shadow: 0 12px 30px rgba(15, 23, 42, 0.06);
  overflow-x: auto;
  padding: 16px;
}

.data-table {
  width: 100%;
  border-collapse: collapse;
  table-layout: fixed; /* PENTING: Ini memaksa kolom tabel tidak melebar */
  font-size: 0.9rem;
}

.data-table th,
.data-table td {
  padding: 14px 12px;
  border-bottom: 1px solid #f1f5f9;
  vertical-align: middle;
}

.data-table th {
  font-weight: 700;
  color: #1e293b;
  background: #f8fafc;
}

.fw-bold {
  font-weight: 700;
  color: #0f172a;
}

.map-link {
  color: #2563eb;
  text-decoration: none;
  max-width: 180px;
  display: inline-block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.map-link:hover {
  text-decoration: underline;
}

.thumb-img {
  width: 80px;
  height: 50px;
  object-fit: cover;
  border-radius: 8px;
}

.action-buttons {
  display: flex;
  gap: 8px;
  align-items: center;
}

/* TOMBOL AKSI */
:global(.action-buttons) {
  display: flex;
  gap: 12px;
  align-items: center;
}

:global(.btn-icon) {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  width: 42px !important;
  height: 42px !important;
  padding: 0 !important;
  border: none !important;
  border-radius: 12px !important;
  cursor: pointer !important;
  transition: all 0.2s ease !important;
  box-sizing: border-box !important;
}

:global(.btn-icon svg) {
  width: 22px !important;
  height: 22px !important;
  display: block !important;
}

:global(.btn-edit) {
  color: #2563eb !important;
  background: #dbeafe !important;
}

:global(.btn-edit:hover) {
  background: #bfdbfe !important;
}

:global(.btn-delete) {
  color: #ef4444 !important;
  background: #fee2e2 !important;
}

:global(.btn-delete:hover) {
  background: #fecaca !important;
}

.pagination-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16px;
  margin-top: 8px;
  border-top: 1px solid #f1f5f9;
  font-size: 0.85rem;
  color: #64748b;
}

/* Ganti seluruh bagian pagination di dalam tag <style> dengan ini: */

.pagination-controls {
  display: flex;
  gap: 8px; 
  align-items: center;
}

.page-btn {
  min-width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid #e2e8f0;
  background: white;
  color: #334155;
  border-radius: 8px; /* Mengubah sudut menjadi kotak yang rapi */
  font-size: 0.95rem;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s ease-in-out;
  padding: 0 12px;
}

/* Efek saat kursor diarahkan ke tombol */
.page-btn:hover:not(.disabled):not(.active) {
  background: #f1f5f9;
  border-color: #cbd5e1;
}

/* BAGIAN INI UNTUK MENGUBAH TOMBOL AKTIF MENJADI BIRU */
.page-btn.active {
  background: #2563eb !important; 
  color: #ffffff !important;
  border-color: #2563eb !important;
  font-weight: 700;
}

/* Tombol panah/navigasi saat tidak bisa diklik */
.page-btn.disabled {
  color: #94a3b8;
  background: #f8fafc;
  border-color: #e2e8f0;
  cursor: not-allowed;
}

/* Modal Styling */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(15, 23, 42, 0.5);
  backdrop-filter: blur(4px);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 9999;
}

.modal-card {
  background: white;
  width: 100%;
  max-width: 480px;
  border-radius: 24px;
  padding: 36px 32px;
  text-align: center;
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  animation: modalScaleIn 0.25s ease-out;
}

@keyframes modalScaleIn {
  from {
    transform: scale(0.95);
    opacity: 0;
  }
  to {
    transform: scale(1);
    opacity: 1;
  }
}

.modal-icon-wrapper {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  margin: 0 auto 20px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.edit-icon-bg {
  background: #fee2e2;
}

.delete-icon-bg {
  background: #fee2e2;
}

.modal-exclamation {
  font-size: 40px;
  font-weight: 800;
  color: #ef4444;
  line-height: 1;
}

.modal-card h2 {
  font-size: 1.5rem;
  font-weight: 800;
  color: #0f172a;
  margin: 0 0 12px;
}

.modal-card p {
  font-size: 0.95rem;
  color: #64748b;
  margin: 0 0 28px;
  line-height: 1.5;
}

.modal-actions {
  display: flex;
  gap: 12px;
  justify-content: center;
}

.modal-btn {
  padding: 12px 28px;
  border-radius: 12px;
  font-size: 0.95rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s;
  border: none;
}

.btn-batal {
  background: #e2e8f0;
  color: #1e293b;
}

.btn-batal:hover {
  background: #cbd5e1;
}

.btn-ya-edit {
  background: #2563eb;
  color: white;
  box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
}

.btn-ya-edit:hover {
  background: #1d4ed8;
}

.btn-hapus {
  background: #ef4444;
  color: white;
  box-shadow: 0 4px 12px rgba(239, 68, 68, 0.25);
}

.btn-hapus:hover {
  background: #dc2626;
}
</style>