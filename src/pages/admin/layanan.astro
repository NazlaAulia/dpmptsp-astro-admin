---
import AdminShell from "../../components/admin/AdminShell.astro";
import { db } from "../../lib/db.js";

const [semuaLayanan] = await db.query(
  "SELECT * FROM tempat_layanan ORDER BY id DESC"
);
---

<AdminShell title="Tempat Layanan" subtitle="Pantau layanan yang tersedia dan status operasional harian." actionLabel="Tambah Tempat Pelayanan" actionHref="/admin/tambah-layanan">
  <div class="table-container">
    <!-- Class diubah agar scroll hanya ke samping jika layar kecil -->
    <div class="table-scroll-custom">
      <table class="data-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Judul</th>
            <th>Lokasi</th>
            <th>Alamat</th>
            <th>Gambar</th>
            <th>Aksi</th>
          </tr>
        </thead>
        <tbody id="table-body">
          <!-- Render dinamis via script -->
        </tbody>
      </table>
    </div>

    <div class="pagination-footer">
      <span class="page-info" id="page-info">Menampilkan 0 dari 0 entri</span>
      <div class="pagination-controls" id="pagination-controls">
        <!-- Tombol paginasi dinamis -->
      </div>
    </div>
  </div>

  <!-- Modal Konfirmasi Edit -->
  <div class="modal-overlay" id="edit-modal" style="display: none;">
    <div class="modal-card">
      <div class="modal-icon-wrapper edit-icon-bg">
        <span class="modal-exclamation">!</span>
      </div>
      <h2>Edit Data?</h2>
      <p>Apakah Anda yakin ingin mengedit data layanan ini?</p>
      <div class="modal-actions">
        <button class="modal-btn btn-batal" id="edit-batal">Batal</button>
        <button class="modal-btn btn-ya-edit" id="edit-ya">Ya, Edit</button>
      </div>
    </div>
  </div>

  <!-- Modal Konfirmasi Hapus -->
  <div class="modal-overlay" id="delete-modal" style="display: none;">
    <div class="modal-card">
      <div class="modal-icon-wrapper delete-icon-bg">
        <span class="modal-exclamation">!</span>
      </div>
      <h2>Hapus Layanan?</h2>
      <p>Apakah Anda yakin ingin menghapus layanan ini?</p>
      <div class="modal-actions">
        <button class="modal-btn btn-batal" id="delete-batal">Batal</button>
        <button class="modal-btn btn-hapus" id="delete-ya">Hapus</button>
      </div>
    </div>
  </div>
</AdminShell>

<script define:vars={{ semuaLayanan: semuaLayanan }}>
  let dataLayanan = [...semuaLayanan];

  const itemsPerPage = 5;
  let currentPage = 1;
  let selectedId = null;

  function renderTable(page) {
    currentPage = page;
    const totalItems = dataLayanan.length;
    const totalPages = Math.ceil(totalItems / itemsPerPage) || 1;
    if (currentPage > totalPages) currentPage = totalPages;

    const start = (currentPage - 1) * itemsPerPage;
    const end = start + itemsPerPage;
    const currentData = dataLayanan.slice(start, end);

    const tbody = document.getElementById("table-body");
    tbody.innerHTML = "";

    currentData.forEach(item => {
      const tr = document.createElement("tr");
      tr.innerHTML = `
        <td>${item.id}</td>
        <td class="fw-bold">${item.judul}</td>
        <td><a href="${item.lokasi}" target="_blank" class="map-link" title="${item.lokasi}">${item.lokasi}</a></td>
        <td>${item.alamat}</td>
        <td><img src="${item.gambar}" alt="${item.judul}" class="thumb-img" /></td>
        <td>
          <div class="action-buttons">
            <button class="btn-icon btn-edit" title="Edit" data-id="${item.id}">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
            </button>
            <button class="btn-icon btn-delete" title="Hapus" data-id="${item.id}">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
            </button>
          </div>
        </td>
      `;
      tbody.appendChild(tr);
    });

    const displayStart = totalItems === 0 ? 0 : start + 1;
    const displayEnd = Math.min(end, totalItems);
    document.getElementById("page-info").innerText = `Menampilkan ${displayStart} sampai ${displayEnd} dari ${totalItems} entri`;

    renderPaginationControls(totalPages);
    attachActionListeners();
  }

  function renderPaginationControls(totalPages) {
    const controls = document.getElementById("pagination-controls");
    controls.innerHTML = "";

    // Style dasar Inline CSS (Paling kuat, anti ditimpa framework)
    const baseStyle = "display: inline-flex; align-items: center; justify-content: center; min-width: 44px; height: 44px; padding: 0 12px; border-radius: 12px; font-size: 1rem; font-weight: 500; cursor: pointer; transition: all 0.2s ease; outline: none; margin: 0; box-sizing: border-box;";

    // Tombol Prev (<)
    const prevBtn = document.createElement("button");
    prevBtn.innerHTML = "&lt;";
    if (currentPage === 1) {
      prevBtn.style.cssText = baseStyle + "background-color: #ffffff; color: #cbd5e1; border: 1px solid #e2e8f0; cursor: not-allowed;";
    } else {
      prevBtn.style.cssText = baseStyle + "background-color: #ffffff; color: #64748b; border: 1px solid #e2e8f0;";
      prevBtn.onclick = () => renderTable(currentPage - 1);
    }
    controls.appendChild(prevBtn);

    // Tombol Angka (1, 2, 3...)
    for (let i = 1; i <= totalPages; i++) {
      const pageBtn = document.createElement("button");
      pageBtn.innerText = i;
      if (currentPage === i) {
        // Jika AKTIF (Warna BIRU)
        pageBtn.style.cssText = baseStyle + "background-color: #2563eb; color: #ffffff; border: 1px solid #2563eb; font-weight: 700; box-shadow: 0 4px 10px rgba(37, 99, 235, 0.2);";
      } else {
        // Jika TIDAK AKTIF
        pageBtn.style.cssText = baseStyle + "background-color: #ffffff; color: #64748b; border: 1px solid #e2e8f0;";
      }
      pageBtn.onclick = () => renderTable(i);
      controls.appendChild(pageBtn);
    }

    // Tombol Next (>)
    const nextBtn = document.createElement("button");
    nextBtn.innerHTML = "&gt;";
    if (currentPage === totalPages) {
      nextBtn.style.cssText = baseStyle + "background-color: #ffffff; color: #cbd5e1; border: 1px solid #e2e8f0; cursor: not-allowed;";
    } else {
      nextBtn.style.cssText = baseStyle + "background-color: #ffffff; color: #64748b; border: 1px solid #e2e8f0;";
      nextBtn.onclick = () => renderTable(currentPage + 1);
    }
    controls.appendChild(nextBtn);
  }

  function attachActionListeners() {
    document.querySelectorAll(".btn-edit").forEach(btn => {
      btn.addEventListener("click", () => {
        selectedId = parseInt(btn.getAttribute("data-id"));
        document.getElementById("edit-modal").style.display = "flex";
      });
    });

    document.querySelectorAll(".btn-delete").forEach(btn => {
      btn.addEventListener("click", () => {
        selectedId = parseInt(btn.getAttribute("data-id"));
        document.getElementById("delete-modal").style.display = "flex";
      });
    });
  }

  document.getElementById("edit-batal").addEventListener("click", () => {
    document.getElementById("edit-modal").style.display = "none";
    selectedId = null;
  });

  document.getElementById("edit-ya").addEventListener("click", () => {
    if (selectedId !== null) {
      window.location.href = `/admin/edit-layanan?id=${selectedId}`;
    }
  });

  document.getElementById("delete-batal").addEventListener("click", () => {
    document.getElementById("delete-modal").style.display = "none";
    selectedId = null;
  });

  document.getElementById("delete-ya").addEventListener("click", async () => {
    if (selectedId !== null) {
      try {
        const response = await fetch("/api/hapus-layanan", {
          method: "DELETE",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify({
            id: selectedId
          })
        });

        const result = await response.json();

        if (result.success) {
          dataLayanan = dataLayanan.filter(item => item.id !== selectedId);
          document.getElementById("delete-modal").style.display = "none";
          selectedId = null;
          renderTable(currentPage);
        } else {
          console.error("Gagal menghapus layanan");
        }
      } catch (error) {
        console.error("Terjadi error saat menghapus layanan:", error);
      }
    }
  });

  renderTable(1);
</script>

<style>
/* =========================================
   1. STYLING TABEL (TETAP SEPERTI SEBELUMNYA)
   ========================================= */
.table-container {
  background: white;
  border-radius: 16px;
  box-shadow: 0 12px 30px rgba(15, 23, 42, 0.06);
  padding: 24px;
  display: flex;
  flex-direction: column;
}

.table-scroll-custom {
  width: 100%;
  overflow-x: auto; 
  margin-bottom: 20px;
  border: 1px solid #e5eaf2;
  border-radius: 12px;
}

:global(.data-table) {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.9rem;
  min-width: 900px;
}

:global(.data-table th:nth-child(1)), :global(.data-table td:nth-child(1)) { width: 60px; text-align: center; }
:global(.data-table th:nth-child(2)), :global(.data-table td:nth-child(2)) { width: 15%; }
:global(.data-table th:nth-child(3)), :global(.data-table td:nth-child(3)) { width: 25%; }
:global(.data-table th:nth-child(4)), :global(.data-table td:nth-child(4)) { width: 20%; }
:global(.data-table th:nth-child(5)), :global(.data-table td:nth-child(5)) { width: 130px; text-align: center; }
:global(.data-table th:nth-child(6)), :global(.data-table td:nth-child(6)) { width: 120px; text-align: center; }

:global(.data-table th),
:global(.data-table td) {
  padding: 16px 12px;
  border-bottom: 1px solid #f1f5f9;
  vertical-align: middle;
}

:global(.data-table th) {
  background: #f8fafc;
  font-weight: 600;
  color: #475569;
  text-align: left;
}

:global(.data-table td) {
  text-align: left;
}

:global(.fw-bold) { font-weight: 600; color: #0f172a; }

:global(.map-link) {
  display: block;
  width: 100%;
  white-space: normal;
  word-break: break-word;
  color: #2563eb;
  text-decoration: none;
  line-height: 1.4;
}

:global(.map-link:hover) { text-decoration: underline; }

:global(.thumb-img) {
  width: 110px;
  height: 65px;
  object-fit: cover;
  border-radius: 8px;
  display: block;
  margin: 0 auto;
  border: 1px solid #e2e8f0;
}

:global(.action-buttons) {
  display: flex;
  gap: 8px;
  align-items: center;
  justify-content: center;
}

:global(.btn-icon) {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 38px;
  height: 38px;
  border: none;
  border-radius: 10px;
  cursor: pointer;
  transition: all 0.2s ease;
}

:global(.btn-icon svg) { width: 18px; height: 18px; }
:global(.btn-edit) { color: #2563eb; background: #e0e7ff; }
:global(.btn-edit:hover) { background: #c7d2fe; }
:global(.btn-delete) { color: #ef4444; background: #fee2e2; }
:global(.btn-delete:hover) { background: #fecaca; }

/* =========================================
   STYLING PAGINATION (FIX TOTAL - GAMBAR 2)
   ========================================= */
.pagination-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16px;
  font-size: 0.85rem;
  color: #64748b;
}

.pagination-controls {
  display: flex;
  gap: 8px; 
  align-items: center;
}

/* Trik: Panggil parent-nya dulu (.pagination-controls) baru button-nya. 
   Ini bikin tingkat prioritasnya sangat tinggi, mengalahkan Tailwind. */
.pagination-controls button.page-btn {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  min-width: 42px !important;
  height: 42px !important;
  padding: 0 14px !important;
  background-color: #ffffff !important; /* Latar putih */
  color: #64748b !important; /* Teks abu-abu */
  border: 1px solid #e2e8f0 !important; /* Border tipis */
  border-radius: 12px !important; /* Sudut membulat */
  font-size: 0.95rem !important;
  font-weight: 500 !important;
  cursor: pointer !important;
  box-shadow: none !important;
  outline: none !important;
  transition: all 0.2s ease !important;
}

/* Efek Hover (saat mouse diarahkan) */
.pagination-controls button.page-btn:hover:not(.disabled):not(.active) {
  background-color: #f8fafc !important;
  border-color: #cbd5e1 !important;
  color: #334155 !important;
}

/* TOMBOL AKTIF (ANGKA 1 WARNA BIRU) */
.pagination-controls button.page-btn.active {
  background-color: #2563eb !important; 
  color: #ffffff !important;
  border-color: #2563eb !important;
  font-weight: 600 !important;
  box-shadow: 0 4px 10px rgba(37, 99, 235, 0.25) !important;
}

/* TOMBOL PANAH DISABLED (< dan >) */
.pagination-controls button.page-btn.disabled {
  color: #cbd5e1 !important;
  background-color: #ffffff !important;
  border-color: #e2e8f0 !important;
  cursor: not-allowed !important;
  opacity: 0.7 !important;
}

/* =========================================
   3. STYLING MODAL (TETAP)
   ========================================= */
.modal-overlay {
  position: fixed;
  top: 0; left: 0; width: 100%; height: 100%;
  background: rgba(15, 23, 42, 0.5);
  backdrop-filter: blur(4px);
  display: flex; justify-content: center; align-items: center;
  z-index: 9999;
}

.modal-card {
  background: white; width: 100%; max-width: 480px;
  border-radius: 24px; padding: 36px 32px; text-align: center;
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
  animation: modalScaleIn 0.25s ease-out;
}

@keyframes modalScaleIn {
  from { transform: scale(0.95); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

.modal-icon-wrapper {
  width: 80px; height: 80px; border-radius: 50%;
  margin: 0 auto 20px; display: flex; align-items: center; justify-content: center;
}

.edit-icon-bg, .delete-icon-bg { background: #fee2e2; }
.modal-exclamation { font-size: 40px; font-weight: 800; color: #ef4444; line-height: 1; }
.modal-card h2 { font-size: 1.5rem; font-weight: 800; color: #0f172a; margin: 0 0 12px; }
.modal-card p { font-size: 0.95rem; color: #64748b; margin: 0 0 28px; line-height: 1.5; }
.modal-actions { display: flex; gap: 12px; justify-content: center; }
.modal-btn {
  padding: 12px 28px; border-radius: 12px; font-size: 0.95rem;
  font-weight: 600; cursor: pointer; transition: all 0.2s; border: none;
}
.btn-batal { background: #e2e8f0; color: #1e293b; }
.btn-batal:hover { background: #cbd5e1; }
.btn-ya-edit { background: #2563eb; color: white; box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25); }
.btn-ya-edit:hover { background: #1d4ed8; }
.btn-hapus { background: #ef4444; color: white; box-shadow: 0 4px 12px rgba(239, 68, 68, 0.25); }
.btn-hapus:hover { background: #dc2626; }
</style>