---
import AdminShell from "../../components/admin/AdminShell.astro";
import { db } from "../../lib/db";
import { writeFile } from "fs/promises";
import path from "path";

if (Astro.request.method === "POST") {
    const formData = await Astro.request.formData();
    const judul = formData.get("judul") as string;
    const file = formData.get("file") as File;

    const buffer = Buffer.from(await file.arrayBuffer());
    const namaFile = file.name;

    const lokasi = path.join(
        process.cwd(),
        "public/pdf",
        namaFile
    );

    await writeFile(
        lokasi,
        buffer
    );

    await db.query(
        `
        INSERT INTO twdata
        (tw_option, file_path)
        VALUES (?, ?)
        `,
        [
            judul,
            namaFile
        ]
    );

    return Astro.redirect("/admin/kinerja");
}
---

<AdminShell 
title="Tambah Kinerja Investasi"
subtitle="Tambahkan dokumen kinerja investasi baru ke dalam sistem."
showHeader={false}
>

<div class="form-container">
  
  <!-- Header Kustom agar sejajar dan serasi dengan kotak form -->
  <div class="page-top-header">
    <div>
      <span class="badge-top">PANEL ADMINISTRASI</span>
      <h1>Tambah Kinerja Investasi</h1>
      <p>Tambahkan dokumen kinerja investasi baru ke dalam sistem.</p>
    </div>
    <a href="/admin/kinerja" class="btn-back-header">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
      Kembali ke Daftar
    </a>
  </div>

  <div class="form-box">
    
    <div class="form-header">
      <div class="header-icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="18" x2="12" y2="12"></line><line x1="9" y1="15" x2="15" y2="15"></line></svg>
      </div>
      <div>
        <h2>Form Tambah Kinerja</h2>
        <p>Lengkapi informasi judul dan unggah dokumen format PDF dengan benar.</p>
      </div>
    </div>

    <form method="POST" enctype="multipart/form-data">

      <div class="form-group">
        <label for="judul">Judul Kinerja</label>
        <div class="input-wrapper">
          <input 
            type="text"
            id="judul"
            name="judul"
            placeholder="Contoh: Laporan Kinerja Triwulan I"
            required
          />
        </div>
      </div>

      <div class="form-group">
        <label for="file">Upload Dokumen PDF</label>
        <div class="file-upload-box">
          <input 
            type="file"
            id="file"
            name="file"
            accept=".pdf"
            required
          />
        </div>
        <span class="file-hint">Format yang didukung: .pdf (Maksimal ukuran sesuai server)</span>
      </div>

      <div class="form-actions">
        <a href="/admin/kinerja" class="btn-cancel">Batal</a>
        <button type="submit" class="btn-submit">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
          Simpan Kinerja
        </button>
      </div>

    </form>

  </div>
</div>

</AdminShell>

<style>
