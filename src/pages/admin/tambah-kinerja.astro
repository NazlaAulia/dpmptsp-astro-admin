---
import AdminShell from "../../components/admin/AdminShell.astro";
import { db } from "../../lib/db";
import { writeFile } from "fs/promises";
import path from "path";


if (Astro.request.method === "POST") {

    const formData = await Astro.request.formData();

    const judul = formData.get("judul") as string;
    const file = formData.get("file") as File;


    const buffer = Buffer.from(await file.arrayBuffer());


    const namaFile = file.name;


    const lokasi = path.join(
        process.cwd(),
        "public/pdf",
        namaFile
    );


    await writeFile(
        lokasi,
        buffer
    );


    await db.query(
        `
        INSERT INTO twdata
        (tw_option, file_path)
        VALUES (?, ?)
        `,
        [
            judul,
            namaFile
        ]
    );


    return Astro.redirect("/admin/kinerja");

}

---

<AdminShell 
title="Tambah Kinerja Investasi"
subtitle="Tambahkan dokumen kinerja investasi baru."
>


<div class="form-box">


<h2>Form Tambah Kinerja</h2>


<form method="POST" enctype="multipart/form-data">


<div class="form-group">

<label>
Judul Kinerja
</label>

<input 
type="text"
name="judul"
placeholder="Masukkan judul kinerja"
/>

</div>



<div class="form-group">

<label>
Upload Dokumen PDF
</label>

<input 
type="file"
name="file"
accept=".pdf"
/>

</div>



<button type="submit">
Simpan Kinerja
</button>


</form>


</div>



</AdminShell>



