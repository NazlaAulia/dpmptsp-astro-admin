---
import AdminShell from "../../components/admin/AdminShell.astro";
---


<AdminShell 
title="Tambah Kinerja Investasi"
subtitle="Tambahkan dokumen kinerja investasi baru."
>


<div class="form-box">


<h2>Form Tambah Kinerja</h2>


<form>


<div class="form-group">

<label>
Judul Kinerja
</label>

<input 
type="text"
placeholder="Masukkan judul kinerja"
/>

</div>



<div class="form-group">

<label>
Upload Dokumen PDF
</label>

<input 
type="file"
accept=".pdf"
/>

</div>



<button type="submit">
Simpan Kinerja
</button>


</form>


</div>



</AdminShell>



<style>

.form-box {

background:white;

padding:30px;

border-radius:20px;

box-shadow:0 12px 30px rgba(15,23,42,.06);

max-width:700px;

}



h2 {

margin-bottom:25px;

}



.form-group {

display:flex;

flex-direction:column;

gap:8px;

margin-bottom:20px;

}



label {

font-weight:600;

}



input {

padding:12px;

border:1px solid #ddd;

border-radius:10px;

}



button {

background:#2563eb;

color:white;

border:none;

padding:12px 25px;

border-radius:10px;

cursor:pointer;

}



</style>