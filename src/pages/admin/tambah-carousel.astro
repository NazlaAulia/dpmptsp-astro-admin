---
import AdminShell from "../../components/admin/AdminShell.astro";
import { db } from "../../lib/db.js";
import fs from "fs/promises";
import path from "path";

let errorMsg = "";

if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();
    const file = formData.get("gambar");
    const judul = formData.get("judul") || "";
    const deskripsi = formData.get("deskripsi") || "";
    const urutan = Number(formData.get("urutan")) || 0;

    if (!file || typeof file === "string" || file.size === 0) {
      errorMsg = "File gambar wajib diisi.";
    } else {
      const allowedTypes = ["image/jpeg", "image/png", "image/webp"];
      if (!allowedTypes.includes(file.type)) {
        errorMsg = "Format file tidak didukung (jpg/png/webp saja).";
      } else if (file.size > 5 * 1024 * 1024) {
        errorMsg = "Ukuran file maksimal 5MB.";
      } else {
        const ext = file.name.split(".").pop();
        const fileName =
          Date.now() +
          "-" +
          Math.random().toString(36).slice(2, 8) +
          "." +
          ext;
        const uploadDir = path.join(
          process.cwd(),
          "public",
          "uploads",
          "slider"
        );
        await fs.mkdir(uploadDir, { recursive: true });
        const buffer = Buffer.from(await file.arrayBuffer());
        await fs.writeFile(
          path.join(uploadDir, fileName),
          buffer
        );
        const publicPath = "/uploads/slider/" + fileName;
        
        await db.execute(
          "INSERT INTO beranda_slider (gambar, judul, deskripsi, urutan) VALUES (?, ?, ?, ?)",
          [publicPath, judul, deskripsi, urutan]
        );
        return Astro.redirect("/admin/carousel");
      }
    }
  } catch (error) {
    console.error("Tambah slider error:", error);
    errorMsg = "Terjadi kesalahan saat menyimpan data.";
  }
}
---

<AdminShell
  title="Tambah Slide"
  subtitle="Tambahkan banner baru untuk carousel beranda."
  actionLabel="Kembali"
  actionHref="/admin/carousel"
  actionIcon={`<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block; vertical-align:middle; margin-right: 6px;"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>`}
>
  <div class="page-wrapper">
    
    <div class="panel">
      {errorMsg && <p class="error">{errorMsg}</p>}
      
      <form method="POST" enctype="multipart/form-data" class="slide-form">
        
        <!-- GAMBAR -->
        <div class="field">
          <label>Gambar Banner <span class="required">*</span></label>
          <div class="file-upload-box">
            <input type="file" name="gambar" accept="image/jpeg,image/png,image/webp" required />
          </div>
          <small class="help-text">Format: JPG, PNG, WEBP (Maksimal 5MB).</small>
        </div>

        <!-- BARIS 2 KOLOM: JUDUL & URUTAN -->
        <div class="form-row">
          <div class="field">
            <label>Judul Slide</label>
            <input type="text" name="judul" placeholder="Masukkan judul slide" />
          </div>

          <div class="field">
            <label>Urutan Tampil</label>
            <input type="number" name="urutan" value="0" />
            <small class="help-text">Angka lebih kecil tampil lebih awal.</small>
          </div>
        </div>

        <!-- DESKRIPSI (RICH TEXT EDITOR) -->
        <div class="field">
          <label>Deskripsi Singkat</label>
          
          <div class="editor-container">
            <div class="editor-toolbar">
              <div class="toolbar-group">
                <button type="button" onclick="document.execCommand('bold', false, null)" title="Bold"><b>B</b></button>
                <button type="button" onclick="document.execCommand('italic', false, null)" title="Italic"><i>I</i></button>
                <button type="button" onclick="document.execCommand('underline', false, null)" title="Underline"><u>U</u></button>
              </div>
              <div class="toolbar-divider"></div>
              <div class="toolbar-group">
                <button type="button" onclick="let url = prompt('Masukkan URL Link:'); if(url) document.execCommand('createLink', false, url);" title="Link">Link</button>
                <button type="button" onclick="document.execCommand('unlink', false, null)" title="Unlink">Unlink</button>
                <button type="button" onclick="document.execCommand('removeFormat', false, null)" title="Hapus Format">Tx</button>
              </div>
            </div>
            
            <div id="editorDeskripsi" class="editor-editable" contenteditable="true"></div>
          </div>
          <input type="hidden" id="deskripsi" name="deskripsi" />
        </div>

        <!-- TOMBOL AKSI -->
        <div class="form-actions">
          <a href="/admin/carousel" class="btn-cancel">Batal</a>
          <button type="submit" class="btn-primary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block; vertical-align:middle; margin-right: 6px;"><polyline points="20 6 9 17 4 12"></polyline></svg>
            Simpan Slide
          </button>
        </div>
      </form>
    </div>
  </div>
</AdminShell>

<script>
  // Sinkronisasi isi editor ke input hidden saat form disubmit
  document.querySelector('form')?.addEventListener('submit', function() {
    const editorEl = document.getElementById('editorDeskripsi') as HTMLElement;
    const hiddenEl = document.getElementById('deskripsi') as HTMLInputElement;
    if (editorEl && hiddenEl) {
      hiddenEl.value = editorEl.innerHTML;
    }
  });
</script>

<style>
@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');

/* BONGKAR KURUNGAN ADMIN SHELL */
:global(.admin-shell), :global(.main-panel), :global(.content), :global(.content-body) { 
  height: auto !important; 
  min-height: 100vh !important;
  overflow: visible !important; 
}

.page-wrapper {
  font-family: 'Plus Jakarta Sans', sans-serif;
  margin-top: 24px;
  width: 100%;
  padding-bottom: 60px;
}

/* PANEL DISAMAKAN DENGAN LEBAR HEADER (100%) */
.panel {
  background: white;
  padding: 36px 40px;
  border-radius: 24px;
  box-shadow: 0 14px 35px rgba(15, 23, 42, 0.05);
  border: 1px solid #edf1f5;
  width: 100%; /* Memenuhi layar sejajar dengan header atas */
  box-sizing: border-box;
}

.slide-form {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

/* ROW 2 KOLOM UNTUK JUDUL & URUTAN */
.form-row {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 24px;
}

@media (max-width: 640px) {
  .form-row {
    grid-template-columns: 1fr;
  }
}

.field {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.field label {
  font-size: 13.5px;
  font-weight: 700;
  color: #334155;
}

.required {
  color: #ef4444;
}

.help-text {
  color: #94a3b8;
  font-size: 12px;
  margin-top: 2px;
}

.field input[type="text"],
.field input[type="number"] {
  padding: 14px 16px;
  border-radius: 12px;
  border: 1.5px solid #cbd5e1;
  font-size: 14px;
  outline: none;
  color: #0f172a;
  font-family: inherit;
  width: 100%;
  box-sizing: border-box;
  background-color: #f8fafc;
  transition: all 0.2s ease;
}

.field input:focus {
  border-color: #2563eb;
  background-color: #ffffff;
  box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.1);
}

/* BOX UPLOAD FILE */
.file-upload-box {
  background: #f8fafc;
  border: 1.5px dashed #cbd5e1;
  border-radius: 12px;
  padding: 24px;
  text-align: center;
  transition: all 0.2s ease;
}

.file-upload-box:hover {
  border-color: #2563eb;
  background: #f1f5f9;
}

.file-upload-box input {
  width: 100%;
  font-family: inherit;
  font-size: 14px;
  color: #475569;
  cursor: pointer;
}

/* RICH TEXT EDITOR */
.editor-container {
  border-radius: 12px;
  overflow: hidden;
  border: 1.5px solid #cbd5e1;
  background: #f8fafc;
  transition: all 0.2s ease;
}

.editor-container:focus-within {
  border-color: #2563eb;
  background: #ffffff;
  box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.1);
}

.editor-toolbar {
  display: flex;
  align-items: center;
  gap: 4px;
  background: #f1f5f9;
  padding: 10px 14px;
  border-bottom: 1.5px solid #cbd5e1;
}

.toolbar-group {
  display: flex;
  gap: 4px;
}

.editor-toolbar button {
  background: white;
  border: 1px solid #e2e8f0;
  padding: 6px 12px;
  border-radius: 8px;
  font-size: 13px;
  font-weight: 600;
  color: #334155;
  cursor: pointer;
  transition: all 0.15s ease;
}

.editor-toolbar button:hover {
  background: #e2e8f0;
  color: #0f172a;
}

.toolbar-divider {
  width: 1px;
  height: 20px;
  background: #cbd5e1;
  margin: 0 8px;
}

.editor-editable {
  width: 100%;
  min-height: 200px; /* Area ketik lebih luas */
  max-height: 400px; 
  overflow-y: auto;
  padding: 20px;
  font-size: 14px;
  font-family: inherit;
  color: #0f172a;
  box-sizing: border-box;
  outline: none;
  background: transparent;
}

.editor-editable:empty:before {
  content: "Tulis deskripsi singkat di sini...";
  color: #94a3b8;
  pointer-events: none;
  display: block;
}

/* ACTIONS */
.form-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12px;
  margin-top: 10px;
  padding-top: 24px;
  border-top: 1.5px solid #edf1f5;
}

.btn-cancel {
  padding: 12px 24px;
  border-radius: 12px;
  text-decoration: none;
  background: #f1f5f9;
  color: #475569;
  font-weight: 700;
  font-size: 14px;
  transition: all 0.2s;
  display: inline-flex;
  align-items: center;
}

.btn-cancel:hover {
  background: #e2e8f0;
  color: #0f172a;
}

.btn-primary {
  padding: 12px 24px;
  border-radius: 12px;
  border: none;
  background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
  color: white;
  font-weight: 700;
  font-size: 14px;
  font-family: inherit;
  cursor: pointer;
  transition: all 0.2s;
  display: inline-flex;
  align-items: center;
  box-shadow: 0 8px 20px rgba(37, 99, 235, 0.25);
}

.btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 24px rgba(37, 99, 235, 0.35);
}

/* ERROR ALERT */
.error {
  background: #fef2f2;
  border: 1px solid #fecaca;
  color: #b91c1c;
  padding: 14px 16px;
  border-radius: 12px;
  margin-bottom: 20px;
  font-size: 14px;
  font-weight: 500;
}

@media (max-width: 768px) {
  .panel {
    padding: 24px 20px;
  }
  .form-actions {
    flex-direction: column-reverse;
  }
  .btn-cancel, .btn-primary {
    width: 100%;
    justify-content: center;
  }
}
</style>