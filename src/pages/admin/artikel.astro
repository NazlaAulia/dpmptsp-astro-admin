---
import Navbar from "../../components/admin/Navbar.astro";
import Sidebar from "../../components/admin/Sidebar.astro";
import ArtikelTable from "../../components/admin/ArtikelTable.astro";
---

<style>
.wrapper{
    display:flex;
    height:100vh;
    overflow:hidden;
}

.content{
    flex:1;
    display:flex;
    flex-direction:column;
    height:100vh;
    overflow:hidden;
    background:#f5f7fb;
}

.isi{
    flex:1;
    overflow-y:auto;
    padding:14px 16px 16px;
}
</style>

<div class="wrapper">

    <Sidebar />

    <div class="content">

        <Navbar />

        <div class="isi">

            <ArtikelTable />

        </div>

    </div>

</div>