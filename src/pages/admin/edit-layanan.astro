---
import AdminShell from "../../components/admin/AdminShell.astro";
---

<AdminShell title="Edit Tempat Layanan" subtitle="Perbarui data tempat layanan.">

  <div class="form-container">

    <div class="form-header">
      <div class="form-icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="18" height="18" rx="2"></rect>
          <path d="M3 9h18"></path>
          <path d="M9 21V9"></path>
        </svg>
      </div>

      <h1>Edit Tempat Layanan Website</h1>
    </div>

    <form id="layanan-form">

      <div class="form-group">
        <label for="judul">Title <span>*</span></label>
        <input
          type="text"
          id="judul"
          placeholder="Judul"
          required
        />
      </div>

      <div class="form-group">
        <label for="gambar">Gambar Layanan</label>
        <p class="form-info">
          Format Foto: png, jpg, jpeg (Maks: 2 MB)
        </p>

        <div class="file-upload">
          <input
            type="file"
            id="gambar"
            accept=".png,.jpg,.jpeg"
          />

          <label for="gambar" class="file-label">
            <span id="file-name">Pilih gambar baru</span>
          </label>
        </div>
      </div>

      <div class="form-group">
        <label for="alt">Alt Text <span>*</span></label>
        <input
          type="text"
          id="alt"
          placeholder="Alt Text"
          required
        />
      </div>

      <div class="form-group">
        <label for="lokasi">Location <span>*</span></label>
        <input
          type="url"
          id="lokasi"
          placeholder="Lokasi"
          required
        />
      </div>

      <div class="form-group">
        <label for="alamat">Alamat <span>*</span></label>
        <textarea
          id="alamat"
          placeholder="Alamat"
          required
        ></textarea>
      </div>

      <div class="form-actions">

        <button type="button" class="btn-kembali" id="btn-kembali">
          Kembali
        </button>

        <button type="submit" class="btn-simpan">
          Simpan Perubahan
        </button>

      </div>

    </form>

  </div>

</AdminShell>

<script>
  const params = new URLSearchParams(window.location.search);
  const id = Number(params.get("id"));

  const dataLayanan = [
