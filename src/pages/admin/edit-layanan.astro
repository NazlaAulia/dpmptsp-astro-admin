    {
      id: 15,
      judul: "SPP MERR",
      lokasi: "https://maps.app.goo.gl/example10",
      alamat: "Jl. Ir. Soekarno",
      gambar: "https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=150&q=80",
      alt: "SPP MERR"
    }
  ];

  const layananTambahan = JSON.parse(
    localStorage.getItem("layananTambahan") || "[]"
  );

  const semuaData = [...dataLayanan, ...layananTambahan];

  const data = semuaData.find(item => item.id === id);

  if (data) {
    (document.getElementById("judul") as HTMLInputElement).value = data.judul;
    (document.getElementById("alt") as HTMLInputElement).value =
      data.alt || data.judul;
    (document.getElementById("lokasi") as HTMLInputElement).value = data.lokasi;
    (document.getElementById("alamat") as HTMLTextAreaElement).value =
      data.alamat;
  }

  const gambarInput = document.getElementById("gambar") as HTMLInputElement;
  const fileName = document.getElementById("file-name") as HTMLElement;

  gambarInput.addEventListener("change", () => {
    const file = gambarInput.files?.[0];

    if (file) {
      fileName.innerText = file.name;
    } else {
      fileName.innerText = "Pilih gambar baru";
    }
  });

  document.getElementById("btn-kembali")?.addEventListener("click", () => {
    window.location.href = "/admin/layanan";
  });

  document.getElementById("layanan-form")?.addEventListener("submit", (event) => {
    event.preventDefault();

    alert("Halaman edit berhasil digunakan.");
  });
</script>

<style>
  .form-container {
    background: white;
    border-radius: 20px;
    padding: 36px 42px;
    box-shadow: 0 12px 30px rgba(15, 23, 42, 0.06);
    margin-top: 20px;
  }

  .form-header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 42px;
  }

  .form-icon {
    width: 50px;
    height: 50px;
    border-radius: 12px;
    background: #2563eb;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .form-header h1 {
    margin: 0;
    font-size: 1.8rem;
    color: #0f172a;
    font-weight: 700;
  }

  .form-group {
    margin-bottom: 30px;
  }

  .form-group label {
    display: block;
    font-size: 1rem;
    font-weight: 700;
    color: #172033;
    margin-bottom: 10px;
  }

  .form-group label span {
    color: #ef4444;
  }

  .form-info {
    color: #94a3b8;
    margin: 0 0 12px;
    font-size: 0.9rem;
  }

  .form-group input[type="text"],
  .form-group input[type="url"],
  .form-group textarea {
    width: 100%;
    box-sizing: border-box;
    border: none;
    outline: none;
    background: #f1f5f9;
    border-radius: 10px;
    padding: 16px 20px;
    font-size: 1rem;
    color: #172033;
    font-family: inherit;
  }

  .form-group input[type="text"],
  .form-group input[type="url"] {
    height: 60px;
  }

  .form-group textarea {
    min-height: 120px;
    resize: vertical;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    box-shadow: 0 0 0 2px #bfdbfe;
  }

  .file-upload {
    position: relative;
    width: 100%;
    min-height: 160px;
    background: #f8fafc;
    border-radius: 12px;
    border: 2px dashed #e2e8f0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .file-upload input {
    display: none;
  }

  .file-label {
    cursor: pointer;
    width: 100%;
    height: 160px;
    display: flex !important;
    align-items: center;
    justify-content: center;
    color: #94a3b8 !important;
    font-weight: 500 !important;
    margin: 0 !important;
  }

  .file-label:hover {
    background: #f1f5f9;
  }

  .form-actions {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 14px;
    margin-top: 40px;
  }

  .btn-simpan,
  .btn-kembali {
    border: none;
    border-radius: 10px;
    padding: 14px 32px;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-simpan {
    background: #0ea5e9;
    color: white;
  }

  .btn-simpan:hover {
    background: #0284c7;
  }

  .btn-kembali {
    background: #e2e8f0;
    color: #334155;
  }

  .btn-kembali:hover {
    background: #cbd5e1;
  }
</style>