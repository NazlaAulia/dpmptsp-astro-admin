---
import AdminShell from "../../components/admin/AdminShell.astro";
import { db } from "../../lib/db.js";

const id = Astro.url.searchParams.get("id");

let layananData = null;

if (id) {
  const [rows] = (await db.query("SELECT * FROM tempat_layanan WHERE id = ?", [id])) as any;
  if (rows && rows.length > 0) {
    layananData = rows[0];
  }
}
---

<AdminShell title="Edit Tempat Layanan" subtitle="Perbarui data tempat layanan.">

  <div class="form-container">

    <div class="form-header">
      <div class="form-icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="18" height="18" rx="2"></rect>
          <path d="M3 9h18"></path>
          <path d="M9 21V9"></path>
        </svg>
      </div>

      <h1>Edit Tempat Layanan Website</h1>
    </div>

    <form id="layanan-form">

      <div class="form-group">
        <label for="judul">Title <span>*</span></label>
        <input
          type="text"
          id="judul"
          placeholder="Judul"
          value={layananData ? layananData.judul : ""}
          required
        />
      </div>

      <div class="form-group">
        <label for="gambar">Gambar Layanan</label>
        <p class="form-info">
          Format Foto: png, jpg, jpeg (Maks: 2 MB)
        </p>

        <div class="file-upload">
          <input
            type="file"
            id="gambar"
            accept=".png,.jpg,.jpeg"
          />

          <label for="gambar" class="file-label">
            <span id="file-name">Pilih gambar baru</span>
          </label>
        </div>
      </div>

      <div class="form-group">
        <label for="alt">Alt Text <span>*</span></label>
        <input
          type="text"
          id="alt"
          placeholder="Alt Text"
          value={layananData ? (layananData.alt_text || layananData.judul) : ""}
          required
        />
      </div>

      <div class="form-group">
        <label for="lokasi">Location <span>*</span></label>
        <input
          type="url"
          id="lokasi"
          placeholder="Lokasi"
          value={layananData ? layananData.lokasi : ""}
          required
        />
      </div>

      <div class="form-group">
        <label for="alamat">Alamat <span>*</span></label>
        <textarea
          id="alamat"
          placeholder="Alamat"
          required
        >{layananData ? layananData.alamat : ""}</textarea>
      </div>

      <div class="form-actions">

        <button type="button" class="btn-kembali" id="btn-kembali">
          Kembali
        </button>

        <button type="submit" class="btn-simpan">
          Simpan Perubahan
        </button>

      </div>

    </form>

  </div>

</AdminShell>

<script define:vars={{ layananId: id }}>
  const gambarInput = document.getElementById("gambar");
  const fileName = document.getElementById("file-name");

  gambarInput.addEventListener("change", () => {
    const file = gambarInput.files?.[0];

    if (file) {
      fileName.innerText = file.name;
    } else {
      fileName.innerText = "Pilih gambar baru";
    }
  });

  document.getElementById("btn-kembali")?.addEventListener("click", () => {
    window.location.href = "/admin/layanan";
  });

  document.getElementById("layanan-form")?.addEventListener("submit", async (event) => {
    event.preventDefault();

    const judul = document.getElementById("judul").value;
    const alt = document.getElementById("alt").value;
    const lokasi = document.getElementById("lokasi").value;
    const alamat = document.getElementById("alamat").value;
    const file = gambarInput.files?.[0];

    let gambarBase64 = null;

    if (file) {
      if (file.size > 2 * 1024 * 1024) {
        alert("Ukuran gambar maksimal 2MB");
        return;
      }

      gambarBase64 = await new Promise((resolve) => {
        const reader = new FileReader();
        reader.onload = () => resolve(reader.result);
        reader.readAsDataURL(file);
      });
    }

    try {
      const response = await fetch(`/api/layanan?id=${layananId}`, {
        method: "PUT",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify({
          judul,
          alt_text: alt,
          lokasi,
          alamat,
          gambar: gambarBase64
        })
      });

      const result = await response.json();

      if (result.success) {
        // Langsung pindah ke halaman layanan tanpa memunculkan alert sukses
        window.location.href = "/admin/layanan";
      } else {
        alert("Gagal memperbarui data dari server.");
      }
    } catch (error) {
      console.error(error);
      alert("Terjadi kesalahan koneksi ke server API.");
    }
  });
</script>

<style>
  .form-container {
    background: white;
    border-radius: 20px;
    padding: 36px 42px;
    box-shadow: 0 12px 30px rgba(15, 23, 42, 0.06);
    margin-top: 20px;
  }

  .form-header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 42px;
  }

  .form-icon {
    width: 50px;
    height: 50px;
    border-radius: 12px;
    background: #2563eb;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .form-header h1 {
    margin: 0;
    font-size: 1.8rem;
    color: #0f172a;
    font-weight: 700;
  }

  .form-group {
    margin-bottom: 30px;
  }

  .form-group label {
    display: block;
    font-size: 1rem;
    font-weight: 700;
    color: #172033;
    margin-bottom: 10px;
  }

  .form-group label span {
    color: #ef4444;
  }

  .form-info {
    color: #94a3b8;
    margin: 0 0 12px;
    font-size: 0.9rem;
  }

  .form-group input[type="text"],
  .form-group input[type="url"],
  .form-group textarea {
    width: 100%;
    box-sizing: border-box;
    border: none;
    outline: none;
    background: #f1f5f9;
    border-radius: 10px;
    padding: 16px 20px;
    font-size: 1rem;
    color: #172033;
    font-family: inherit;
  }

  .form-group input[type="text"],
  .form-group input[type="url"] {
    height: 60px;
  }

  .form-group textarea {
    min-height: 120px;
    resize: vertical;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    box-shadow: 0 0 0 2px #bfdbfe;
  }

  .file-upload {
    position: relative;
    width: 100%;
    min-height: 160px;
    background: #f8fafc;
    border-radius: 12px;
    border: 2px dashed #e2e8f0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .file-upload input {
    display: none;
  }

  .file-label {
    cursor: pointer;
    width: 100%;
    height: 160px;
    display: flex !important;
    align-items: center;
    justify-content: center;
    color: #94a3b8 !important;
    font-weight: 500 !important;
    margin: 0 !important;
  }

  .file-label:hover {
    background: #f1f5f9;
  }

  .form-actions {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 14px;
    margin-top: 40px;
  }

  .btn-simpan,
  .btn-kembali {
    border: none;
    border-radius: 10px;
    padding: 14px 32px;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-simpan {
    background: #0ea5e9;
    color: white;
  }

  .btn-simpan:hover {
    background: #0284c7;
  }

  .btn-kembali {
    background: #e2e8f0;
    color: #334155;
  }

  .btn-kembali:hover {
    background: #cbd5e1;
  }
</style>