---
import AdminShell from "../../components/admin/AdminShell.astro";
import { db } from "../../lib/db.js";

let slides = [];
try {
  const [rows] = await db.execute(
    `SELECT * FROM beranda_slider ORDER BY urutan ASC, id ASC`
  );
  slides = rows;
} catch (error) {
  console.error("Fetch slider error:", error);
}
---

<AdminShell
  title="Carousel"
  subtitle="Atur banner utama dan visual promosi yang tampil di publik."
  actionLabel="Tambah Slide"
  actionHref="/admin/tambah-carousel"
>
  <div class="panel">
    <h3>Daftar Slide ({slides.length})</h3>

    {slides.length === 0 ? (
      <p class="empty">Belum ada slide.</p>
    ) : (
      <table class="slide-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Foto</th>
            <th>Judul</th>
            <th>Urutan</th>
            <th>Aksi</th>
          </tr>
        </thead>
        <tbody>
          {slides.map((item) => (
            <tr>
              <td>{item.id}</td>
              <td>
                <img src={item.gambar} alt={item.judul || "Slide"} class="thumb" />
              </td>
              <td>
                <strong>{item.judul || "(tanpa judul)"}</strong>
                <p>{item.deskripsi}</p>
              </td>
              <td>{item.urutan}</td>
              <td>
                <div class="action-icons">
                  <a href={`/admin/edit-carousel?id=${item.id}`} class="icon-btn icon-edit" title="Edit">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                      <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                    </svg>
                  </a>

                  <form method="POST" action="/admin/hapus-carousel" class="delete-form" data-delete-form>
                    <input type="hidden" name="id" value={item.id} />
                    <input type="hidden" name="gambar" value={item.gambar} />
                    <button type="button" class="icon-btn icon-delete" title="Hapus" data-delete-trigger>
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="3 6 5 6 21 6"></polyline>
                        <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path>
                        <path d="M10 11v6"></path>
                        <path d="M14 11v6"></path>
                        <path d="M9 6V4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"></path>
                      </svg>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    )}
  </div>

  <!-- MODAL KONFIRMASI HAPUS -->
  <div class="confirm-overlay" id="confirmOverlay">
    <div class="confirm-box"> 
      <p class="confirm-message">Yakin hapus slide ini?</p>
      <div class="confirm-actions">
        <button type="button" class="confirm-ok" id="confirmOk">Oke</button>
        <button type="button" class="confirm-cancel" id="confirmCancel">Batal</button>
      </div>
    </div>
  </div>
</AdminShell>

<style>
.panel {
  background: white;
  padding: 20px;
  border-radius: 18px;
  box-shadow: 0 12px 30px rgba(15, 23, 42, 0.06);
}
.panel h3 { margin: 0 0 14px; }

.slide-table {
  width: 100%;
  border-collapse: collapse;
}

.slide-table thead th {
  text-align: left;
  padding: 12px 14px;
  font-size: 0.78rem;
  font-weight: 800;
  color: #1d4ed8;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  border-bottom: 1px solid #e2e8f0;
}

.slide-table tbody td {
  padding: 16px 14px;
  border-bottom: 1px solid #f1f5f9;
  vertical-align: middle;
}

.slide-table tbody tr:last-child td {
  border-bottom: none;
}

.thumb {
  width: 90px;
  height: 60px;
  object-fit: cover;
  border-radius: 10px;
  display: block;
}

.slide-table strong {
  display: block;
  margin-bottom: 4px;
}

.slide-table p {
  margin: 0;
  color: #64748b;
  font-size: 0.82rem;
}

.action-icons {
  display: flex;
  gap: 8px;
}

.delete-form {
  margin: 0;
}

.icon-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border-radius: 10px;
  border: 0;
  cursor: pointer;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.icon-btn:hover {
  transform: translateY(-1px);
}

.icon-edit {
  background: #dbeafe;
  color: #1d4ed8;
}

.icon-edit:hover {
  box-shadow: 0 6px 14px rgba(29, 78, 216, 0.18);
}

.icon-delete {
  background: #fee2e2;
  color: #b91c1c;
}

.icon-delete:hover {
  box-shadow: 0 6px 14px rgba(185, 28, 28, 0.18);
}

.empty {
  color: #94a3b8;
}

/* MODAL KONFIRMASI */
.confirm-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.45);
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.confirm-overlay.active {
  display: flex;
}

.confirm-box {
  background: #eafaf8;
  border: 2px solid #0d9488;
  border-radius: 12px;
  padding: 24px 26px;
  width: 100%;
  max-width: 360px;
  box-shadow: 0 20px 50px rgba(15, 23, 42, 0.25);
}

.confirm-source {
  margin: 0 0 6px;
  font-size: 0.82rem;
  font-weight: 700;
  color: #0f172a;
}

.confirm-message {
  margin: 0 0 22px;
  font-size: 0.95rem;
  color: #1e293b;
}

.confirm-actions {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
}

.confirm-actions button {
  padding: 8px 20px;
  border-radius: 999px;
  border: 0;
  font-weight: 700;
  font-size: 0.85rem;
  cursor: pointer;
  transition: filter 0.15s ease;
}

.confirm-actions button:hover {
  filter: brightness(0.95);
}

.confirm-ok {
  background: #0d9488;
  color: white;
}

.confirm-cancel {
  background: #bae6fd;
  color: #0c4a6e;
}
</style>

<script>
  let formToSubmit = null;

  const overlay = document.getElementById("confirmOverlay");
  const okBtn = document.getElementById("confirmOk");
  const cancelBtn = document.getElementById("confirmCancel");

  document.querySelectorAll("[data-delete-trigger]").forEach((btn) => {
    btn.addEventListener("click", () => {
      formToSubmit = btn.closest("[data-delete-form]");
      overlay?.classList.add("active");
    });
  });

  okBtn?.addEventListener("click", () => {
    overlay?.classList.remove("active");
    formToSubmit?.submit();
  });

  cancelBtn?.addEventListener("click", () => {
    overlay?.classList.remove("active");
    formToSubmit = null;
  });

  overlay?.addEventListener("click", (e) => {
    if (e.target === overlay) {
      overlay.classList.remove("active");
      formToSubmit = null;
    }
  });
</script>