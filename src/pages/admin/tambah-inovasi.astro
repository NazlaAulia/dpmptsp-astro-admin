---
import AdminShell from "../../components/admin/AdminShell.astro";
import { db } from "../../lib/db";
import fs from "node:fs/promises";
import path from "node:path";

export const prerender = false;

let errorMessage = "";

if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();

    const nama = formData.get("nama")?.toString() || "";
    const singkatan = formData.get("singkatan")?.toString() || "";
    const kategori = formData.get("kategori")?.toString() || "";
    const deskripsi = formData.get("deskripsi")?.toString() || "";
    const rancang_bangun = formData.get("rancang_bangun")?.toString() || "";
    const tujuan = formData.get("tujuan")?.toString() || "";
    const manfaat = formData.get("manfaat")?.toString() || "";
    const hasil = formData.get("hasil")?.toString() || "";
    const tahun_usulan = formData.get("tahun_usulan")?.toString() || new Date().getFullYear().toString();
    const tahapan = formData.get("tahapan")?.toString() || "Penerapan Digital";
    const jenis = formData.get("jenis")?.toString() || "Digital";
    
    const url_layanan = formData.get("url_layanan")?.toString() || null;
    const url_label = formData.get("url_label")?.toString() || null;
    const icon = formData.get("icon")?.toString() || "fa-lightbulb";
    const warna = formData.get("warna")?.toString() || "blue";
    const urutan = parseInt(formData.get("urutan")?.toString() || "0");
    const status = parseInt(formData.get("status")?.toString() || "1");

    const slug = nama.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)+/g, "");

    const fileGambar = formData.get("gambar") as File;
    let gambarPath = null;

    if (fileGambar && fileGambar.name && fileGambar.size > 0) {
      const originalName = fileGambar.name;
      const extension = path.extname(originalName).toLowerCase();
      const safeName = slug + "-" + Date.now() + extension;
      
      gambarPath = `gambar/${safeName}`;
      
      const uploadDir = path.join(process.cwd(), "public", "gambar");
      await fs.mkdir(uploadDir, { recursive: true }); 

      const buffer = Buffer.from(await fileGambar.arrayBuffer());
      await fs.writeFile(path.join(uploadDir, safeName), buffer);
    }

    await db.query(
      `INSERT INTO inovasi_layanan 
      (slug, nama, singkatan, kategori, deskripsi, rancang_bangun, tujuan, manfaat, hasil, tahun_usulan, tahapan, jenis, gambar, url_layanan, url_label, icon, warna, urutan, status) 
      VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
      [
        slug, nama, singkatan, kategori, deskripsi, rancang_bangun, 
        tujuan, manfaat, hasil, tahun_usulan, tahapan, jenis, 
        gambarPath, url_layanan, url_label, icon, warna, urutan, status
      ]
    );

    return Astro.redirect("/admin/inovasi?status=success");

  } catch (error: any) {
    console.error("Gagal menyimpan ke database:", error);
    errorMessage = "Gagal menyimpan data: " + error.message;
  }
}
---

<AdminShell title="" subtitle="" showHeader={false}>
  <div class="page-wrapper">
    
    <div class="page-header-simple">
      <h2>Tambah Inovasi Layanan</h2>
      <a href="/admin/inovasi" class="btn-back">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block; vertical-align:middle; margin-right: 6px;"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
        Kembali
      </a>
    </div>

    {errorMessage && <div class="alert-error">{errorMessage}</div>}

    <div class="card-form-container">
      <form method="POST" enctype="multipart/form-data">
        
        <div class="form-row">
          <div class="form-group flex-1">
            <label for="nama">Nama Inovasi <span>*</span></label>
            <input type="text" id="nama" name="nama" placeholder="Contoh: TAKON SOBAT" required />
          </div>

          <div class="form-group flex-1">
            <label for="kategori">Kategori <span>*</span></label>
            <input type="text" id="kategori" name="kategori" placeholder="Contoh: Perizinan" required />
          </div>
        </div>

        <div class="form-group">
          <label for="singkatan">Kepanjangan / Detail Singkatan</label>
          <input type="text" id="singkatan" name="singkatan" placeholder="Contoh: Tanya Konsultasi Perizinan Solusi Dijawab..." />
        </div>

        <div class="form-row">
          <div class="form-group flex-1">
            <label for="tahun_usulan">Tahun Usulan</label>
            <input type="number" id="tahun_usulan" name="tahun_usulan" value={new Date().getFullYear()} required />
          </div>

          <div class="form-group flex-1">
            <label for="tahapan">Tahapan</label>
            <input type="text" id="tahapan" name="tahapan" placeholder="Contoh: Penerapan Digital" value="Penerapan Digital" />
          </div>

          <div class="form-group flex-1">
            <label for="jenis">Jenis</label>
            <input type="text" id="jenis" name="jenis" placeholder="Contoh: Digital" value="Digital" />
          </div>
        </div>

        <div class="form-row">
          <div class="form-group flex-1">
            <label for="url_layanan">URL Layanan</label>
            <input type="text" id="url_layanan" name="url_layanan" placeholder="https://..." />
          </div>

          <div class="form-group flex-1">
            <label for="url_label">Label URL</label>
            <input type="text" id="url_label" name="url_label" placeholder="Contoh: Akses Layanan" />
          </div>
        </div>

        <div class="form-row">
          <div class="form-group flex-1">
            <label for="icon">Icon Class</label>
            <input type="text" id="icon" name="icon" value="fa-lightbulb" placeholder="fa-lightbulb" />
          </div>

          <div class="form-group flex-1">
            <label for="warna">Warna Aksen</label>
            <input type="text" id="warna" name="warna" value="blue" placeholder="blue" />
          </div>

          <div class="form-group flex-1">
            <label for="urutan">Urutan</label>
            <input type="number" id="urutan" name="urutan" value="0" />
          </div>

          <div class="form-group flex-1">
            <label for="status">Status</label>
            <select id="status" name="status" class="form-select">
              <option value="1">Aktif (1)</option>
              <option value="0">Nonaktif (0)</option>
            </select>
          </div>
        </div>

        <!-- ========================================== -->
        <!-- 1. EDITOR KHUSUS UNTUK DESKRIPSI           -->
        <!-- ========================================== -->
        <div class="form-group">
          <label>Deskripsi</label>
          
          <div class="editor-toolbar">
            <div class="toolbar-group">
              <button type="button" onclick="document.execCommand('undo', false, null)" title="Undo">↩</button>
              <button type="button" onclick="document.execCommand('redo', false, null)" title="Redo">↪</button>
            </div>
            <div class="toolbar-divider"></div>
            <div class="toolbar-group">
              <select onchange="document.execCommand('formatBlock', false, this.value); this.value='';" class="format-select">
                <option value="" disabled selected>Paragraf</option>
                <option value="p">Paragraf (p)</option>
                <option value="h1">Heading 1</option>
                <option value="h2">Heading 2</option>
                <option value="h3">Heading 3</option>
              </select>
            </div>
            <div class="toolbar-divider"></div>
            <div class="toolbar-group">
              <button type="button" onclick="document.execCommand('bold', false, null)" title="Bold"><b>B</b></button>
              <button type="button" onclick="document.execCommand('italic', false, null)" title="Italic"><i>I</i></button>
              <button type="button" onclick="document.execCommand('underline', false, null)" title="Underline"><u>U</u></button>
              <button type="button" onclick="document.execCommand('strikeThrough', false, null)" title="Strikethrough"><s>S</s></button>
            </div>
            <div class="toolbar-divider"></div>
            <div class="toolbar-group">
              <button type="button" onclick="document.execCommand('justifyLeft', false, null)" title="Rata Kiri">«</button>
              <button type="button" onclick="document.execCommand('justifyCenter', false, null)" title="Rata Tengah">↔</button>
              <button type="button" onclick="document.execCommand('justifyRight', false, null)" title="Rata Kanan">»</button>
            </div>
            <div class="toolbar-divider"></div>
            <div class="toolbar-group">
              <button type="button" onclick="document.execCommand('insertUnorderedList', false, null)" title="Bullet List">• List</button>
              <button type="button" onclick="document.execCommand('insertOrderedList', false, null)" title="Numbered List">1. List</button>
            </div>
            <div class="toolbar-divider"></div>
            <div class="toolbar-group">
              <button type="button" onclick="let url = prompt('Masukkan URL Link:'); if(url) document.execCommand('createLink', false, url);" title="Link">Link</button>
              <button type="button" onclick="document.execCommand('unlink', false, null)" title="Unlink">Unlink</button>
              <button type="button" onclick="document.execCommand('removeFormat', false, null)" title="Clear">Tx</button>
            </div>
            <div class="toolbar-divider"></div>
            <div class="toolbar-group">
              <button type="button" onclick="toggleHTML()" title="Lihat HTML" class="btn-html">&lt;/&gt;</button>
            </div>
          </div>

          <div id="editorDeskripsi" class="editor-editable" contenteditable="true"></div>
          <input type="hidden" id="deskripsi" name="deskripsi" />

          <div class="editor-footer">
            <span id="statusText">Siap menulis</span>
            <span id="wordCount">0 kata</span>
          </div>
        </div>

        <!-- ========================================== -->
        <!-- 2. TEXTAREA BIASA UNTUK LAINNYA            -->
        <!-- ========================================== -->
        <div class="form-group">
          <label for="rancang_bangun">Rancang Bangun</label>
          <textarea id="rancang_bangun" name="rancang_bangun" rows="4" placeholder="Tulis rancang bangun di sini..." class="form-textarea"></textarea>
        </div>

        <div class="form-group">
          <label for="tujuan">Tujuan</label>
          <textarea id="tujuan" name="tujuan" rows="3" placeholder="Tulis tujuan di sini..." class="form-textarea"></textarea>
        </div>

        <div class="form-group">
          <label for="manfaat">Manfaat</label>
          <textarea id="manfaat" name="manfaat" rows="3" placeholder="Tulis manfaat di sini..." class="form-textarea"></textarea>
        </div>

        <div class="form-group">
          <label for="hasil">Hasil</label>
          <textarea id="hasil" name="hasil" rows="3" placeholder="Tulis hasil di sini..." class="form-textarea"></textarea>
        </div>

        <!-- UPLOAD -->
        <div class="form-group">
          <label for="gambar">Upload Gambar</label>
          <input type="file" id="gambar" name="gambar" accept="image/*" />
          <small>Format gambar: JPG, PNG, WEBP.</small>
        </div>

        <div class="form-actions">
          <a href="/admin/inovasi" class="btn-cancel">Batal</a>
          <button type="submit" class="btn-submit">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block; vertical-align:middle; margin-right: 6px;"><polyline points="20 6 9 17 4 12"></polyline></svg>
            Simpan Inovasi
          </button>
        </div>
      </form>
    </div>
  </div>
</AdminShell>

<script>
  // Sinkronisasi isi editor ke input hidden saat form disubmit
  document.querySelector('form')?.addEventListener('submit', function() {
    const editorEl = document.getElementById('editorDeskripsi') as HTMLElement;
    const hiddenEl = document.getElementById('deskripsi') as HTMLInputElement;
    if (editorEl && hiddenEl) {
      hiddenEl.value = editorEl.innerHTML;
    }
  });

  // Fitur Counter Kata & Status untuk Editor Deskripsi
  const editorDeskripsi = document.getElementById('editorDeskripsi') as HTMLElement | null;
  const wordCountEl = document.getElementById('wordCount');
  const statusTextEl = document.getElementById('statusText');

  if (editorDeskripsi && wordCountEl && statusTextEl) {
    editorDeskripsi.addEventListener('input', function() {
      const text = this.innerText.trim();
      const words = text ? text.split(/\s+/).length : 0;
      
      wordCountEl.innerText = `${words} kata`;
      
      if (words > 0) {
        statusTextEl.innerText = 'Menulis...';
        statusTextEl.style.color = '#f59e0b'; 
      } else {
        statusTextEl.innerText = 'Siap menulis';
        statusTextEl.style.color = '#64748b'; 
      }
    });
  }

  // Fitur Lihat HTML
  let isHtmlMode = false;
  // @ts-ignore
  window.toggleHTML = function() {
    if (!editorDeskripsi) return;
    
    if (!isHtmlMode) {
      const html = editorDeskripsi.innerHTML;
      editorDeskripsi.innerHTML = `<pre style="white-space: pre-wrap; font-family: monospace; font-size: 13px; padding: 10px; background: #f8fafc; border-radius: 8px;">${html.replace(/</g, '&lt;').replace(/>/g, '&gt;')}</pre>`;
      editorDeskripsi.contentEditable = "false";
      isHtmlMode = true;
    } else {
      const pre = editorDeskripsi.querySelector('pre');
      if (pre) {
        editorDeskripsi.innerHTML = pre.innerText;
      }
      editorDeskripsi.contentEditable = "true";
      isHtmlMode = false;
    }
  }
</script>

<style>
