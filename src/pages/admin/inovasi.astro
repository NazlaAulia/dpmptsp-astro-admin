---
import AdminShell from "../../components/admin/AdminShell.astro";

const fitur = [
  { title: "Integrasi dashboard", detail: "Menyatukan data artikel, layanan, dan notifikasi dalam satu panel." },
  { title: "Respons cepat", detail: "Mempermudah admin mengelola konten tanpa berpindah halaman." },
  { title: "Akses mudah", detail: "Tampilan baru dibuat agar navigasi lebih intuitif untuk tim administrasi." },
];
---

<AdminShell title="Inovasi" subtitle="Lihat fitur-fitur yang memudahkan pengelolaan admin." actionLabel="Tambah Konten" actionHref="/admin/konten">
  <div class="list-card">
    {fitur.map((item) => (
      <article class="item">
        <h3>{item.title}</h3>
        <p>{item.detail}</p>
      </article>
    ))}
  </div>
</AdminShell>

<style>
.list-card {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.item {
  background: white;
  border-radius: 16px;
  padding: 16px 18px;
  box-shadow: 0 12px 30px rgba(15, 23, 42, 0.06);
}

.item h3 {
  margin: 0 0 6px;
}

.item p {
  margin: 0;
  color: #64748b;
}
</style>
