<style>
.item {
  background: transparent;
}
.item.active {
  background: rgba(255,255,255,.12);
}
.item.active img {
  border-color: #FFC72C;
}
.item:hover:not(.active) {
  background: rgba(255,255,255,.06);
}

.fadeChange {
  animation: fadeChange .5s ease;
}
@keyframes fadeChange {
  from { opacity: 0; transform: translateY(8px); }
  to { opacity: 1; transform: translateY(0); }
}

/* Entrance animation: masuk dari luar layar */
.hero-slide-left {
  animation: heroSlideLeft 1.8s cubic-bezier(.22,1,.36,1) both;
}
.hero-slide-right {
  animation: heroSlideRight 1.8s cubic-bezier(.22,1,.36,1) both;
  animation-delay: .25s;
}
@keyframes heroSlideLeft {
  from { opacity: 0; transform: translateX(-100vw); }
  to { opacity: 1; transform: translateX(0); }
}
@keyframes heroSlideRight {
  from { opacity: 0; transform: translateX(100vw); }
  to { opacity: 1; transform: translateX(0); }
}

@media (prefers-reduced-motion: reduce) {
  #bg { transition: none !important; }
  .fadeChange { animation: none !important; }
  .hero-slide-left, .hero-slide-right { animation: none !important; }
}
</style>

<script is:inline>
document.addEventListener('DOMContentLoaded', () => {
  const heroItems = document.querySelectorAll('.item');
  const heroBg = document.getElementById('bg');
  const heroTitle = document.getElementById('heroTitle');
  const heroSub = document.getElementById('heroSub');

  let heroIdx = 0;

  function updateHeroPanel(el) {
    heroItems.forEach(i => i.classList.remove('active'));
    el.classList.add('active');

    if (el.dataset.bg) heroBg.src = el.dataset.bg;

    [heroTitle, heroSub].forEach(t => {
      t.classList.remove('fadeChange');
      void t.offsetWidth;
      t.classList.add('fadeChange');
    });
    heroTitle.textContent = el.dataset.title;
    heroSub.textContent = el.dataset.sub;
  }

  heroItems.forEach((el, i) => {
    el.addEventListener('click', () => {
      heroIdx = i;
      updateHeroPanel(el);
    });
  });
});
</script>

