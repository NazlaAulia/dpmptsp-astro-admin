---
import MainLayout from "../layouts/MainLayout.astro";
import { db } from "../lib/db.js";
import { slugify } from "../utils/slugify";

/* ================= PARAM ================= */
const limit = 6;

let page = Number(Astro.url.searchParams.get("page") || 1);
if (page < 1) page = 1;

const q = Astro.url.searchParams.get("q") || "";
const type = Astro.url.searchParams.get("type") || "all";

/* ================= FILTER SQL ================= */
let where = `WHERE active='Y'`;
let params = [];

if (q) {
  where += ` AND title LIKE ?`;
  params.push(`%${q}%`);
}

if (type === "berita") {
  where += ` AND id_category IN (1,8)`;
}

if (type === "artikel") {
  where += ` AND id_category IN (2,3)`;
}

/* ================= TOTAL ================= */
const [[{ total }]] = await db.query(
  `SELECT COUNT(*) AS total FROM post ${where}`,
  params
);

const totalPages = Math.max(1, Math.ceil(total / limit));
if (page > totalPages) page = totalPages;

const offset = (page - 1) * limit;

/* ================= DATA ================= */
const [rows] = await db.query(
  `
  SELECT *
  FROM post
  ${where}
  ORDER BY date DESC, time DESC, id_post DESC
  LIMIT ? OFFSET ?
  `,
  [...params, limit, offset]
);

/* helper url */
const buildUrl = (p) => {
  const sp = new URLSearchParams();
  if (q) sp.set("q", q);
  if (type !== "all") sp.set("type", type);
  sp.set("page", p);
  return `?${sp.toString()}`;
};
---

<MainLayout title="DPMPTSP Surabaya - Media Terkait">

<!-- HERO -->
<section class="bg-gradient-to-r from-blue-800 to-blue-900 py-20 text-center text-white">
  <h1 class="text-4xl md:text-5xl font-bold mb-3">Media Terkait</h1>
  <p class="opacity-90 max-w-2xl mx-auto">
    Berita dan artikel resmi DPMPTSP Kota Surabaya
  </p>
</section>

<!-- FILTER -->
<section class="container mx-auto px-4 -mt-10 relative z-10">
  <form class="bg-white shadow-xl rounded-2xl p-6 flex flex-col md:flex-row gap-4">

    <input
      type="text"
      name="q"
      value={q}
      placeholder="Cari judul berita / artikel..."
      class="flex-1 px-4 py-3 border rounded-xl text-sm"
    />

    <select
      name="type"
      class="px-4 py-3 border rounded-xl text-sm"
    >
      <option value="all" selected={type === "all"}>Semua</option>
      <option value="berita" selected={type === "berita"}>Berita</option>
      <option value="artikel" selected={type === "artikel"}>Artikel</option>
    </select>

    <button
      class="px-6 py-3 bg-blue-600 text-white rounded-xl font-semibold hover:bg-blue-700"
    >
      Cari
    </button>

  </form>
</section>

<!-- MEDIA LIST -->
<section class="container mx-auto px-4 py-16">

  {rows.length === 0 && (
    <p class="text-center text-slate-500">
      Tidak ada data ditemukan
    </p>
  )}

  <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
    {rows.map(item => {
      const label =
        [1, 8].includes(item.id_category) ? "Berita" : "Artikel";

      return (
        <article class="group bg-white rounded-3xl shadow-lg overflow-hidden hover:shadow-2xl transition">
          <a href={`/media/${item.id_post}-${slugify(item.title)}`}>

            <div class="relative h-72 overflow-hidden">
              <img
                src={`https://dpm-ptsp.surabaya.go.id/fileberita/${item.picture}`}
                alt={item.title}
                class="w-full h-full object-cover group-hover:scale-105 transition"
              />
              <span
                class={`absolute top-4 left-4 text-xs px-3 py-1 rounded-full font-semibold ${
                  label === "Berita"
                    ? "bg-blue-600 text-white"
                    : "bg-emerald-600 text-white"
                }`}
              >
                {label}
              </span>
            </div>

            <div class="p-8">
              <h2 class="text-xl font-bold mb-3 line-clamp-2">
                {item.title}
              </h2>

              <p class="text-sm text-slate-600 line-clamp-3 mb-6">
                {(item.ref_content || item.content || "")
                  .replace(/<[^>]+>/g, "")
                }
              </p>

              <div class="flex justify-between text-xs text-slate-500">
                <span>{new Date(item.date).toLocaleDateString("id-ID")}</span>
                <span class="text-blue-600 font-semibold">
                  Baca →
                </span>
              </div>
            </div>

          </a>
        </article>
      );
    })}
  </div>

  <!-- PAGINATION -->
  <div class="flex justify-center items-center gap-6 mt-16 text-sm">
    {page > 1 && (
      <a href={buildUrl(page - 1)} class="px-4 py-2 bg-white shadow rounded-xl">
        ← Sebelumnya
      </a>
    )}

    <span class="text-slate-600">
      Halaman {page} / {totalPages}
    </span>

    {page < totalPages && (
      <a href={buildUrl(page + 1)} class="px-4 py-2 bg-white shadow rounded-xl">
        Berikutnya →
      </a>
    )}
  </div>

</section>

</MainLayout>
