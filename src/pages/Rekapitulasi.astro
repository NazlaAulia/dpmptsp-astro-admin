---

<MainLayout title="Monitoring Absensi">

<div class="max-w-7xl mx-auto p-6">

    <h1 class="text-3xl font-bold text-blue-700 mb-6">
        📋 Monitoring Absensi Pegawai
    </h1>

    <div class="grid md:grid-cols-3 gap-5 mb-8">

        <div class="bg-green-600 rounded-xl p-6 text-white shadow">
            <div class="text-4xl font-bold">{tepat}</div>
            <div>Tepat Waktu</div>
        </div>

        <div class="bg-yellow-500 rounded-xl p-6 text-white shadow">
            <div class="text-4xl font-bold">{terlambat}</div>
            <div>Terlambat</div>
        </div>

        <div class="bg-red-600 rounded-xl p-6 text-white shadow">
            <div class="text-4xl font-bold">{belum}</div>
            <div>Belum Absen</div>
        </div>

    </div>

    <div class="bg-white rounded-xl shadow overflow-hidden">

        <table class="min-w-full">

            <thead class="bg-blue-700 text-white">

                <tr>
                    <th class="p-3">No</th>
                    <th>NIP</th>
                    <th>Nama Pegawai</th>
                    <th>Jam Masuk</th>
                    <th>Status</th>
                    <th>Keterangan</th>
                </tr>

            </thead>

            <tbody>

                {
                    pegawai.map((p,index)=>(

                    <tr class="border-b hover:bg-gray-50">

                        <td class="p-3 text-center">{index+1}</td>
                        <td>{p.nip}</td>
                        <td>{p.nama}</td>
                        <td class="text-center">{p.jam}</td>

                        <td class="text-center">

                            {
                                p.status=="Tepat Waktu" &&
                                <span class="bg-green-100 text-green-700 px-3 py-1 rounded-full">
                                    ✅ Tepat Waktu
                                </span>
                            }

                            {
                                p.status=="Terlambat" &&
                                <span class="bg-yellow-100 text-yellow-700 px-3 py-1 rounded-full">
                                    ⏰ Terlambat
                                </span>
                            }

                            {
                                p.status=="Belum Absen" &&
                                <span class="bg-red-100 text-red-700 px-3 py-1 rounded-full">
                                    ❌ Belum Absen
                                </span>
                            }

                        </td>

                        <td class="text-center">
                            {p.status=="Terlambat" ? `${p.telat} menit` : "-"}
                        </td>

                    </tr>

                    ))
                }

            </tbody>

        </table>

    </div>

</div>

</MainLayout>