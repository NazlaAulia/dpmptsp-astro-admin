/* =========================================================
   HERO SLIDER
========================================================= */
let notifikasi = [];

try {
  const [rows] = await db.execute(`
     SELECT
    id,
    judul,
    isi,
    gambar,
    tipe,
    icon,
    link,
    teks_link
  FROM notifikasi_beranda
  WHERE active = 'Y'
    AND (mulai IS NULL OR mulai <= NOW())
    AND (selesai IS NULL OR selesai >= NOW())
  ORDER BY urutan ASC, id DESC
  LIMIT 5
  `);

  notifikasi = rows;
} catch (error) {
  console.error("Notifikasi DB Error:", error);
}

let tentang = [];

const [t] = await db.execute(
