  ====================================================== */

  .reg-list {

    display: grid;

    gap: 12px;

  }


  /* =====================================================
     CARD
  ====================================================== */

  .reg-card {

    position: relative;

    display: grid;

    grid-template-columns:
      55px
      62px
      minmax(0,1fr)
      auto;

    align-items: center;

    gap: 20px;

    min-height: 112px;

    padding: 20px 24px;

    overflow: hidden;

