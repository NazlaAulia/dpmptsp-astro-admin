  color: #082b57;

  font-size:
    clamp(36px, 5vw, 52px);

  line-height: 1;

  letter-spacing: -2px;
}

.video-heading h2 span {
  color: #0878c9;
}

.video-heading p {
  max-width: 650px;

  margin: 18px auto 0;

  color: #718096;

  font-size: 14px;

  line-height: 1.8;
}


/* =====================================================
   GRID
===================================================== */

.video-grid {
  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 24px;
}


/* =====================================================
   CARD
===================================================== */

.video-card {
  overflow: hidden;

  border: 1px solid #e3eaf2;

  border-radius: 18px;

  background: #fff;

  box-shadow:
