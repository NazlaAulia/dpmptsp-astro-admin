}

.video-card:hover {
  transform: translateY(-6px);

  border-color:
    rgba(8,120,201,.20);

  box-shadow:
    0 18px 45px rgba(7,48,90,.12);
}


/* =====================================================
   THUMBNAIL
===================================================== */

.video-thumb {
  position: relative;

  display: block;

  width: 100%;

  aspect-ratio: 16 / 9;

  overflow: hidden;

  background: #082b57;

  text-decoration: none;
}

.video-thumb img {
  position: absolute;

  inset: 0;

  width: 100%;
  height: 100%;

  object-fit: cover;

  transition:
    transform .5s ease;
}

.video-card:hover .video-thumb img {
  transform: scale(1.06);
}


/* =====================================================
   OVERLAY
===================================================== */

.video-overlay {
  position: absolute;

  inset: 0;

  background:
    linear-gradient(
      to bottom,
      rgba(8,43,87,.05),
      rgba(8,43,87,.45)
    );

  transition:
    background .3s ease;
}

.video-card:hover .video-overlay {
  background:
    linear-gradient(
      to bottom,
      rgba(8,43,87,.15),
      rgba(8,43,87,.60)
    );
}


/* =====================================================
   PLAY BUTTON
===================================================== */

.video-play {
  position: absolute;

  left: 50%;
  top: 50%;

  transform:
    translate(-50%, -50%);

  width: 62px;
  height: 62px;

  display: flex;

  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background:
    rgba(255,255,255,.94);

  color: #0878c9;

  box-shadow:
    0 8px 25px rgba(0,0,0,.18);

  transition:
    transform .3s ease,
    background .3s ease;
}

.video-play span {
  margin-left: 3px;

  font-size: 21px;
}

.video-card:hover .video-play {
  transform:
    translate(-50%, -50%)
    scale(1.12);

  background: #fff;
}


/* =====================================================
   STATUS
===================================================== */

.video-status {
  position: absolute;

  left: 14px;
  top: 14px;

  display: inline-flex;

  align-items: center;

  gap: 6px;

  padding: 6px 9px;

  border-radius: 7px;

  background: #dc2626;

  color: #fff;

  font-size: 9px;

  font-weight: 900;

  letter-spacing: .5px;
}

.video-status span {
  font-size: 9px;
}


/* =====================================================
   CONTENT
===================================================== */

.video-content {
  padding: 22px;
}

.video-content h3 {
  margin: 0 0 10px;

  color: #082b57;

  font-size: 18px;

  line-height: 1.45;

  font-weight: 800;

  display: -webkit-box;

  -webkit-line-clamp: 2;

  -webkit-box-orient: vertical;

  overflow: hidden;
}

.video-content p {
  margin: 0 0 18px;

  color: #718096;

  font-size: 13px;

  line-height: 1.7;

  display: -webkit-box;

  -webkit-line-clamp: 3;

  -webkit-box-orient: vertical;

  overflow: hidden;
}


/* =====================================================
   WATCH
===================================================== */

.video-watch {
  display: inline-flex;

  align-items: center;

  gap: 9px;

  color: #0878c9;

  text-decoration: none;

  font-size: 13px;

  font-weight: 800;
}

.video-watch strong {
  font-size: 17px;

  font-weight: 400;

  transition:
    transform .25s ease;
}

.video-watch:hover {
  color: #082b57;
}

.video-watch:hover strong {
  transform:
    translateX(5px);
}


/* =====================================================
   FOOTER
===================================================== */

.video-footer {
  display: flex;

  justify-content: center;

  margin-top: 38px;
}

.video-all {
  display: inline-flex;

  align-items: center;

  gap: 12px;

  padding: 13px 22px;

  border-radius: 11px;

  background: #082b57;

  color: #fff;

  text-decoration: none;

  font-size: 12px;

  font-weight: 800;

  transition: .3s;
}

.video-all strong {
  font-size: 19px;

  font-weight: 400;

  transition: .3s;
}

.video-all:hover {
  background: #f5c400;

  color: #082b57;

  transform:
    translateY(-3px);

  box-shadow:
    0 12px 25px rgba(245,196,0,.18);
}

.video-all:hover strong {
  transform:
    translateX(5px);
}


/* =====================================================
   EMPTY
===================================================== */

.video-empty {
  padding: 60px 20px;

  text-align: center;

  border:
    1px dashed #ccd8e4;

  border-radius: 18px;

  background: #fff;

  color: #718096;

  font-size: 14px;
}


/* =====================================================
