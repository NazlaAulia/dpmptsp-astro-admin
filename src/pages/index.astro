    color: white;

    background:
      linear-gradient(
        to top,
        rgba(0, 0, 0, .78),
        rgba(0, 0, 0, 0)
      );
  }


  .slider-caption h3 {
    margin: 0 0 5px;

    color: white;
  }


  .slider-caption p {
    margin: 0;

    color:
      rgba(255,255,255,.85);

    line-height: 1.5;
  }


  /* =========================================================
     NAVIGATION
  ========================================================= */

  .slider-nav {
    position: absolute;

    top: 50%;

    z-index: 20;

    width: 44px;
    height: 44px;

    display: flex;

    align-items: center;
    justify-content: center;

    padding: 0;

    transform: translateY(-50%);

    border: 0;

    border-radius: 50%;

    background:
      rgba(255,255,255,.92);

    box-shadow:
      0 5px 18px rgba(0,0,0,.18);

    cursor: pointer;

    transition:
      transform .2s ease,
      background .2s ease;
  }


  .slider-nav:hover {
    background: white;

    transform:
      translateY(-50%) scale(1.08);
  }


  .slider-prev {
    left: 14px;
  }


  .slider-next {
    right: 14px;
  }


  /* =========================================================
     DOTS
  ========================================================= */

  .slider-dots {
    display: flex;

    justify-content: center;
    align-items: center;

    gap: 7px;

    margin-top: 18px;
  }


  .slider-dot {
    width: 9px;
    height: 9px;

    padding: 0;

    border: 0;

    border-radius: 50%;

    background: #cbd5e1;

    cursor: pointer;

    transition:
      width .25s ease,
      background .25s ease;
  }


  .slider-dot.active {
    width: 26px;

    border-radius: 999px;

    background: #0900C3;
  }


  /* =========================================================
     EMPTY
  ========================================================= */

  .slider-empty {
    display: flex;

    align-items: center;
    justify-content: center;

    color: #64748b;

    font-weight: 600;
  }


  /* =========================================================
     TABLET
  ========================================================= */

