);
tentang = t;
let regulasi = [];

try {
  const [rows] = await db.execute(`
    SELECT
      id,
      jenis,
      nomor,
      tahun,
      judul,
      file
    FROM regulasi
    WHERE active = 'Y'
    ORDER BY urutan ASC, tahun DESC, id DESC
  `);

  regulasi = rows;
} catch (error) {
  console.error("Regulasi DB Error:", error);
}
let slider = [];

try {
  const [result] = await db.execute(`
    SELECT
      id,
      gambar,
      judul,
      deskripsi,
      urutan
    FROM beranda_slider
    ORDER BY urutan ASC, id ASC
  `);

  slider = result;
} catch (error) {
  console.error("Slider DB Error:", error);
}


/* =========================================================
   BERITA & ARTIKEL
========================================================= */

let berita = [];

try {
  const [result] = await db.execute(`
    SELECT
      p.id_post,
      p.id_category,
      p.title,
      p.content,
      p.date,
      p.time,
      p.picture,
      p.hits,
      c.title AS category_title
    FROM post p
    LEFT JOIN category_berita c
      ON c.id_category = p.id_category
    WHERE
      p.active = 'Y'
      AND c.active = 'Y'
    ORDER BY
      p.date DESC,
      p.time DESC
    LIMIT 10
  `);

  berita = result;
} catch (error) {
  console.error("Berita DB Error:", error);
}


/* =========================================================
   HELPER
========================================================= */

function stripHtml(value) {
  if (!value) return "";

  return String(value)
    .replace(/<[^>]*>/g, "")
    .replace(/&nbsp;/gi, " ")
    .replace(/&amp;/gi, "&")
    .replace(/&quot;/gi, '"')
    .replace(/&#39;/gi, "'")
    .replace(/\s+/g, " ")
    .trim();
}


function excerpt(value, length = 220) {
  const text = stripHtml(value);

  if (text.length <= length) {
    return text;
  }

  return text.substring(0, length).trim() + "...";
}


function formatDate(value) {
  if (!value) return "";

  const date = new Date(value);

  if (Number.isNaN(date.getTime())) {
    return value;
  }

  return date.toLocaleDateString("id-ID", {
    day: "2-digit",
    month: "long",
    year: "numeric"
  });
}

