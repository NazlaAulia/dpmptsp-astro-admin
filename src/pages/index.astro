<style>
  /* =========================================================
     SLIDER
  ========================================================= */

  .slider-container {
    position: relative;

    width: 100%;

    overflow: hidden;

    border-radius: 14px;

    background: #f3f4f6;
  }


  .slider-track {
    display: flex;

    width: 100%;

    transform: translateX(0);

    transition:
      transform .55s cubic-bezier(.4, 0, .2, 1);

    will-change: transform;
  }


  .slider-slide {
    position: relative;

    flex: 0 0 100%;

    width: 100%;

    min-width: 100%;

    height: 420px;

    overflow: hidden;

    background: #e5e7eb;
  }


  .slider-img {
