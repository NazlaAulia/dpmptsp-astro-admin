     JAVASCRIPT
========================================================== -->

<script define:vars={{ slider, berita }}>

document.addEventListener(
  "DOMContentLoaded",
  () => {


    /* =====================================================
       HERO
    ===================================================== */

    const heroSlides =
      Array.from(
        document.querySelectorAll(".hero-slide")
      );

    const heroDots =
      Array.from(
        document.querySelectorAll(".hero-dot")
      );

    const heroPrev =
      document.getElementById("heroPrev");

    const heroNext =
      document.getElementById("heroNext");

    const heroCurrent =
      document.getElementById("heroCurrent");

    let heroIndex = 0;

    let heroTimer = null;


    function showHero(index){

      if (!heroSlides.length) {
        return;
      }


      heroIndex =
        (index + heroSlides.length)
        % heroSlides.length;


      heroSlides.forEach(
        (slide, i) => {

          slide.classList.toggle(
            "active",
            i === heroIndex
          );

        }
      );


      heroDots.forEach(
        (dot, i) => {

          dot.classList.toggle(
            "active",
            i === heroIndex
          );

        }
      );


      if (heroCurrent) {

        heroCurrent.textContent =
          String(heroIndex + 1)
            .padStart(2, "0");

      }

    }


    function nextHero(){

      showHero(heroIndex + 1);

    }


    function prevHero(){

      showHero(heroIndex - 1);

    }


    function restartHero(){

      clearInterval(heroTimer);

      if (heroSlides.length > 1) {

        heroTimer =
          setInterval(
            nextHero,
            5000
          );

      }

    }


    heroNext?.addEventListener(
      "click",
      () => {

        nextHero();
        restartHero();

      }
    );


    heroPrev?.addEventListener(
      "click",
      () => {

        prevHero();
        restartHero();

      }
    );


    heroDots.forEach(
      dot => {

        dot.addEventListener(
          "click",
          () => {

            showHero(
              Number(dot.dataset.index)
            );

            restartHero();

          }
        );

      }
    );


    /* =====================================================
       NEWS
    ===================================================== */

    const newsImage =
      document.getElementById("newsImage");

    const newsCategory =
      document.getElementById("newsCategory");

    const newsNumber =
      document.getElementById("newsNumber");

    const newsMeta =
      document.getElementById("newsMeta");

    const newsTitle =
      document.getElementById("newsTitle");

    const newsDescription =
      document.getElementById("newsDescription");

    const newsLink =
      document.getElementById("newsLink");

    const newsProgress =
      document.getElementById("newsProgress");

    const newsPhoto =
      document.querySelector(".news-image");

    const newsThumbs =
      Array.from(
        document.querySelectorAll(".news-thumb")
      );

    const newsNext =
      document.getElementById("newsNext");

    const newsPrev =
      document.getElementById("newsPrev");


    if (
      berita.length &&
      newsImage &&
      newsTitle
    ){

      let newsIndex = 0;

      let newsTimer = null;


      function cleanText(value){

        if (!value) {
          return "";
        }

        return String(value)
          .replace(/<[^>]*>/g, "")
          .replace(/&nbsp;/gi, " ")
          .replace(/&amp;/gi, "&")
          .replace(/&quot;/gi, '"')
          .replace(/&#39;/gi, "'")
          .replace(/\s+/g, " ")
          .trim();

      }


      function shortText(value){

        const text =
          cleanText(value);


        if (text.length <= 220) {
          return text;
        }


        return (
          text.substring(0,220)
          + "..."
        );

      }


      function dateText(value){

        if (!value) {
          return "";
        }


        const date =
          new Date(value);


        if (
          Number.isNaN(
            date.getTime()
          )
        ){

          return value;

        }


        return date.toLocaleDateString(
          "id-ID",
          {
            day:"2-digit",
            month:"long",
            year:"numeric"
          }
        );

      }


      function renderNews(index){

        newsIndex =
          (
            index + berita.length
          )
          % berita.length;


        const item =
          berita[newsIndex];


        /*
         * Hanya satu card.
         * Tidak ada translateX.
         */

        newsPhoto?.classList.add(
          "switching"
        );


        setTimeout(
          () => {

            newsImage.src =
  item.picture
    ? `https://dpm-ptsp.surabaya.go.id/fileberita/${item.picture}`
    : "";


            newsImage.alt =
              item.title || "Berita";


            newsCategory.textContent =
              item.category_title
              || "BERITA";


            newsNumber.textContent =
              String(newsIndex + 1)
                .padStart(2,"0");


            newsMeta.textContent =
              `${
                item.category_title
                || "BERITA"
              } • ${
                dateText(item.date)
              }`;


            newsTitle.textContent =
              item.title || "";


            newsDescription.textContent =
              shortText(
                item.content
              );


            newsLink.href =
              `/media/${slugify(item.content)}`;


            newsThumbs.forEach(
              (thumb, i) => {

                thumb.classList.toggle(
                  "active",
                  i === newsIndex
                );

              }
            );


            if (newsProgress){

              newsProgress.style.animation =
                "none";

              void newsProgress.offsetWidth;

              newsProgress.style.animation =
                "newsProgress 5s linear";

            }


            newsPhoto?.classList.remove(
              "switching"
            );

          },
          180
        );

      }


      function nextNews(){

        renderNews(
          newsIndex + 1
        );

        restartNews();

      }


      function prevNews(){

        renderNews(
          newsIndex - 1
        );

        restartNews();

      }


      function restartNews(){

        clearInterval(newsTimer);


        if (berita.length > 1){

          newsTimer =
            setInterval(
              () => {

                renderNews(
                  newsIndex + 1
                );

              },
              5000
            );

        }

      }


      /* THUMBNAIL */

      newsThumbs.forEach(
        (thumb, index) => {

          thumb.addEventListener(
            "click",
            () => {

              renderNews(index);

              restartNews();

            }
          );

        }
      );


      /* NEXT */

      newsNext?.addEventListener(
        "click",
        () => {

          nextNews();

        }
      );


      /* PREV */

      newsPrev?.addEventListener(
        "click",
        () => {

          prevNews();

        }
      );


      /* SWIPE */

      let startX = 0;


      newsPhoto?.addEventListener(
        "touchstart",
        event => {

          startX =
            event.touches[0].clientX;

        },
        {
          passive:true
        }
      );


      newsPhoto?.addEventListener(
        "touchend",
        event => {

          const endX =
            event.changedTouches[0].clientX;


          const distance =
            startX - endX;


          if (
  Math.abs(distance) < 50
){
  return;
}


          if (distance > 0){

            nextNews();

          }else{

            prevNews();

          }

        },
        {
          passive:true
        }
      );


      /* INIT */

      renderNews(0);

      restartNews();

    }

  }
);
/* =====================================================
   MODAL NOTIFIKASI DATABASE
===================================================== */

</script>
<script>
document.addEventListener("click", function (e) {

  /* ============================
     NEXT
  ============================ */

  const next = e.target.closest("#notificationNext");

  if (next) {

    e.preventDefault();
    e.stopPropagation();

    const slides =
      document.querySelectorAll(
        "#notificationModal .notification-slide"
      );

    const dots =
      document.querySelectorAll(
        "#notificationModal .notification-dot"
      );

    if (slides.length < 2) return;

    let current = 0;

    slides.forEach((slide, i) => {

      if (
        slide.classList.contains("active")
      ) {
        current = i;
      }

    });

    current =
      (current + 1) %
      slides.length;

    slides.forEach((slide, i) => {

      slide.classList.toggle(
        "active",
        i === current
      );

    });

    dots.forEach((dot, i) => {

      dot.classList.toggle(
        "active",
        i === current
      );

    });

    return;
  }


  /* ============================
     PREV
  ============================ */

  const prev = e.target.closest("#notificationPrev");

  if (prev) {

    e.preventDefault();
    e.stopPropagation();

    const slides =
      document.querySelectorAll(
        "#notificationModal .notification-slide"
      );

    const dots =
      document.querySelectorAll(
        "#notificationModal .notification-dot"
      );

    if (slides.length < 2) return;

    let current = 0;

    slides.forEach((slide, i) => {

      if (
        slide.classList.contains("active")
      ) {
        current = i;
      }

    });

    current =
      (current - 1 + slides.length) %
      slides.length;

    slides.forEach((slide, i) => {

      slide.classList.toggle(
        "active",
        i === current
      );

    });

    dots.forEach((dot, i) => {

      dot.classList.toggle(
        "active",
        i === current
      );

    });

    return;
  }


  /* ============================
     DOT
  ============================ */

  const dot =
    e.target.closest(
      "#notificationModal .notification-dot"
    );

  if (dot) {

    e.preventDefault();
    e.stopPropagation();

    const slides =
      document.querySelectorAll(
        "#notificationModal .notification-slide"
      );

    const dots =
      document.querySelectorAll(
        "#notificationModal .notification-dot"
      );

    const index =
      Number(
        dot.dataset.slide
      );

    slides.forEach((slide, i) => {

      slide.classList.toggle(
        "active",
        i === index
      );

    });

    dots.forEach((item, i) => {

      item.classList.toggle(
        "active",
        i === index
      );

    });

    return;
  }


  /* ============================
     CLOSE
  ============================ */

  const close =
    e.target.closest(
      "#notificationClose"
    );

  if (close) {

    e.preventDefault();
    e.stopPropagation();

    const modal =
      document.getElementById(
        "notificationModal"
      );

    if (!modal) return;

    modal.classList.add(
      "notification-hidden"
    );

    modal.setAttribute(
      "aria-hidden",
      "true"
    );

    setTimeout(() => {

      modal.style.display = "none";

    }, 250);

    return;
  }


  /* ============================
     NANTI SAJA
  ============================ */

  const later =
    e.target.closest(
      "#notificationModal .notification-later"
    );

  if (later) {

    e.preventDefault();
    e.stopPropagation();

    const modal =
      document.getElementById(
        "notificationModal"
      );

    if (!modal) return;

    modal.classList.add(
      "notification-hidden"
    );

    modal.setAttribute(
      "aria-hidden",
      "true"
    );

    setTimeout(() => {

      modal.style.display = "none";

    }, 250);

    return;
  }

});
</script>

