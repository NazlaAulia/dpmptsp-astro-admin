# Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------- database ---
# Laravel-style discrete settings. The Go API builds the driver-specific DSN
# from these, so the connection string never appears in this file and switching
# engines does not mean rewriting a DSN by hand.
#
# Kept on mysql during the transition: the Astro apps still query MySQL directly
# through mysql2, so they and the Go API must agree. Flip to postgres once Astro
# no longer touches the database — the signal is `grep -rn "mysql2\|lib/db"
# apps/` returning nothing.
DB_CONNECTION=mysql
COMPOSE_PROFILES=mysql

DB_HOST=database
DB_PORT=3306
DB_DATABASE=ladpm
DB_USERNAME=root
DB_PASSWORD=

# Postgres only: disable | require | verify-ca | verify-full
# DB_SSLMODE=disable
# MySQL only.
# DB_CHARSET=utf8mb4

# Optional escape hatch, as in Laravel: when set it replaces every setting above.
# Useful for a managed provider that hands you a connection string.
# DATABASE_URL=

# ---------------------------------------------------------------- passwords ---
# bcrypt | argon2id. Same idea as Laravel's HASH_DRIVER, and the same default.
# The algorithm is read from each stored hash on verify, so changing this does
# not lock anyone out — old hashes keep working and are upgraded on next login.
HASH_DRIVER=bcrypt
BCRYPT_ROUNDS=12

# Read by `make seed` to create the bootstrap administrator. Hashed at seed
# time; never stored in a file. Not needed outside seeding.
# SEED_ADMIN_PASSWORD=

# ------------------------------------------------------------------ secrets ---
# Astro admin session signing. At least 32 characters.
#   openssl rand -base64 48
SESSION_SECRET=

# Shared key for Astro -> Go. At least 32 characters.
#   openssl rand -base64 48
API_SERVICE_KEY=

# Cookies are Secure unless NODE_ENV=development. Set false only for plain-HTTP
# local runs.
# SESSION_COOKIE_SECURE=true

# ------------------------------------------------------------------ gateway ---
# public | allowed_ips | vps_only | vpn_only
#
# Restricts the CMS paths (/admin, /api) only. /kepegawaian stays reachable with
# application auth so employees can check in from a phone.
#
# Do not use `public` while admin login still compares plaintext passwords.
ADMIN_ACCESS=allowed_ips

# Where legacy article images and photos are served from. The default is the old
# PHP deployment, which is a system nobody here controls — see
# `make legacy-media`. Point this at MinIO or a CDN once the files are archived.
MEDIA_BASE_URL=https://dpm-ptsp.surabaya.go.id

APP_ENV=production

# ------------------------------------------------------------------ storage ---
# Which disk uploads go to. Same idea as Laravel's FILESYSTEM_DISK: several
# disks are defined, one is selected here.
#   local   private files on disk, served only through an authorizing handler
#   public  files on disk with a public URL prefix
#   s3      any S3-compatible bucket (MinIO already runs on this host)
FILESYSTEM_DISK=local

STORAGE_LOCAL_ROOT=/var/lib/dpmptsp/storage
STORAGE_PUBLIC_ROOT=/var/lib/dpmptsp/public
STORAGE_PUBLIC_URL=/storage

# The s3 disk is only configured when S3_ENDPOINT is set, so a local-only
# deployment needs none of these. Endpoint is host:port with no scheme.
# S3_ENDPOINT=minio:9000
# S3_BUCKET=dpmptsp
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1
# S3_USE_SSL=false
# S3_PUBLIC_URL=
